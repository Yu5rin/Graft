<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Graft.Tests</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    本体は WPF (net8.0-windows) のため、そのまま参照すると Windows 以外で
    テストを実行できない。Core / Features / Infra は仕様 A.4 により WPF へ
    依存しないため、ソースを直接取り込んで net8.0 としてテストする。
    これにより「UI から独立して単体テスト可能」であることを機械的に保証する。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Graft\Core\**\*.cs" LinkBase="Linked\Core" />
    <Compile Include="..\..\src\Graft\Features\**\*.cs" LinkBase="Linked\Features" />
    <Compile Include="..\..\src\Graft\Infra\**\*.cs" LinkBase="Linked\Infra" />
    <!--
      Platform層の抽象とNull実装はUIフレームワーク非依存のため取り込む。
      Platform/Windows は WPF・レジストリに依存し、実装を選ぶファクトリ
      （Platform/PlatformServices.cs）はそれを参照するため、いずれも取り込まない。
    -->
    <Compile Include="..\..\src\Graft\Platform\IPlatformServices.cs" LinkBase="Linked\Platform" />
    <Compile Include="..\..\src\Graft\Platform\IUiServices.cs" LinkBase="Linked\Platform" />
    <Compile Include="..\..\src\Graft\Platform\IDialogService.cs" LinkBase="Linked\Platform" />
    <Compile Include="..\..\src\Graft\Platform\ITextEditorAccess.cs" LinkBase="Linked\Platform" />
    <Compile Include="..\..\src\Graft\Platform\Null\**\*.cs" LinkBase="Linked\Platform\Null" />
    <!--
      Linux版クリップボード読み取り不具合の修正（X11ClipboardReader）。P/Invoke宣言
      （X11Interop.cs）自体はどのOSでもコンパイルできる（externの宣言のみのため）。
      実際の呼び出しはOperatingSystem.IsLinux()の判定を通るため、他OSでの単体テスト実行を妨げない。
    -->
    <Compile Include="..\..\src\Graft\Platform\Linux\X11Interop.cs" LinkBase="Linked\Platform\Linux" />
    <Compile Include="..\..\src\Graft\Platform\Linux\X11ClipboardReader.cs" LinkBase="Linked\Platform\Linux" />
    <!--
      書き込み側（X11ClipboardWriter、上記読み取り不具合と対を成す「書き込みが一切効かない」
      不具合の修正）。partialのため2ファイルとも取り込む。
    -->
    <Compile Include="..\..\src\Graft\Platform\Linux\X11ClipboardWriter.cs" LinkBase="Linked\Platform\Linux" />
    <Compile Include="..\..\src\Graft\Platform\Linux\X11ClipboardWriter.SelectionResponder.cs" LinkBase="Linked\Platform\Linux" />
    <!--
      課題3: 自動起動（スタートアップフォルダ方式）。WindowsAutoStartService・
      LinuxAutoStartServiceはいずれもBCLのファイルI/Oのみで構成され、Win32 P/Invoke・
      レジストリ・libX11のいずれにも依存しないため、OSを問わずそのまま検証できる。
    -->
    <Compile Include="..\..\src\Graft\Platform\Windows\WindowsAutoStartService.cs" LinkBase="Linked\Platform\Windows" />
    <Compile Include="..\..\src\Graft\Platform\Linux\LinuxAutoStartService.cs" LinkBase="Linked\Platform\Linux" />
    <!--
      多重起動防止のGlobal\スコープ不具合の修正（LinuxSingleInstanceGuard・X11WindowActivator）。
      いずれもWin32 P/Invoke・WPFに依存せず、BCLのプロセス起動とlibX11のP/Invoke宣言のみで
      構成されるため、他OSでの単体テスト実行を妨げない（実際の呼び出しはOS判定や
      「接続できなければfalse」で静かに縮退する）。
    -->
    <Compile Include="..\..\src\Graft\Platform\Linux\LinuxSingleInstanceGuard.cs" LinkBase="Linked\Platform\Linux" />
    <Compile Include="..\..\src\Graft\Platform\Linux\X11WindowActivator.cs" LinkBase="Linked\Platform\Linux" />
    <!--
      不具合対応: Windowsのフォーカス窃取防止でSetForegroundWindowが拒否される問題への
      AttachThreadInput回避策（WindowsSingleInstanceGuard.ActivateWindowHandle）。回避策を
      試みるべきかどうかの判定（ForegroundActivationDecision）はWin32 P/Invokeを一切含まない
      純粋ロジックのみで構成されるため、Windows実機以外でも単体テストで検証できる
      （ForegroundActivationDecisionTests.cs参照）。
    -->
    <Compile Include="..\..\src\Graft\Platform\Windows\ForegroundActivationDecision.cs" LinkBase="Linked\Platform\Windows" />
    <!--
      ViewModel層は基本的にUIテスト（tests/Graft.UiTests）の担当だが、
      WindowLayoutStore はウィンドウ位置・サイズの幾何計算（8.11・9.6）そのものであり、
      画面を出さずに検証できる。実機で「画面構成が取得できないと最小サイズまで縮む」
      不具合が出たため、単体テストで押さえる。
    -->
    <Compile Include="..\..\src\Graft\ViewModels\WindowLayoutStore.cs" LinkBase="Linked\ViewModels" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
