<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Graft.UiTests</RootNamespace>
    <!-- 課題3: 応答者のいないモーダルダイアログでヘッドレステストが無音のままハングし続ける事故の
         再発防止（詳細はtest.runsettings/LiveSettingsPropagationTests.cs参照）。dotnet testは
         このプロパティを自動で読み、settingsオプションを明示指定しなくてもセッション全体の
         タイムアウトが有効になる。 -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Graft\Graft.csproj" />
  </ItemGroup>

  <!-- リボン（customUI）の読み取りのテスト用に、小さな .xlsm 相当の zip を組み立てる補助。Graft.Tests と同じものを使う（2 か所に書かない）。 -->
  <ItemGroup>
    <Compile Include="..\Graft.Tests\TestSupport\RibbonPackageBuilder.cs" Link="TestSupport\RibbonPackageBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.2.3" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.3" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

</Project>
