<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Graft.App"
             RequestedThemeVariant="Default">
    <!--
        9.1: OSのネイティブな見た目に寄せず、WindowsとLinuxで同一の外観にする。
        Fluentテーマは土台としてのみ使い、色・寸法はTokens/Dark/Light/Controlsで
        上書きする（20章L2）。Icons.axaml・Controls.Base.axamlはControlTemplateを
        差し替えないカスケード適用のStyleを持つため、ルート要素がStylesであり、
        Application.StylesへStyleIncludeで読み込む。Dark.axaml/Light.axamlは
        ThemeManagerが実行時にApplication.Resources.MergedDictionariesへ
        追加・差し替えるため、ここでは読み込まない。
    -->
    <Application.Styles>
        <FluentTheme />
        <!-- AvaloniaEditの既定テーマ。TextEditorの内部テンプレート（TextArea・
             行番号マージン・スクロールビューア）はここが提供する。色や書体は
             Themes/Editor.axamlのControlThemeで9.3のトークンへ上書きする。 -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://Graft/Themes/Icons.axaml" />
        <StyleInclude Source="avares://Graft/Themes/Controls.Base.axaml" />
        <StyleInclude Source="avares://Graft/Themes/Settings.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Graft/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://Graft/Themes/Logo.axaml" />
                <ResourceInclude Source="avares://Graft/Themes/Controls.axaml" />
                <ResourceInclude Source="avares://Graft/Themes/Controls.Input.axaml" />
                <ResourceInclude Source="avares://Graft/Themes/Controls.Layout.axaml" />
                <ResourceInclude Source="avares://Graft/Themes/Editor.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
