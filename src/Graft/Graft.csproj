<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Graft.ico</ApplicationIcon>
    <RootNamespace>Graft</RootNamespace>
    <AssemblyName>Graft</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Graft</Product>
    <!-- Windows 以外のホストでもビルド検証できるようにする -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ライセンス全文はバージョン情報画面から参照する（仕様書8.15）。
      単一exeで配布するため、外部ファイルではなく埋め込みリソースとして持つ。
    -->
    <EmbeddedResource Include="Assets\DiffPlex-LICENSE.txt" />
    <EmbeddedResource Include="Assets\AvalonEdit-LICENSE.txt" />
  </ItemGroup>

</Project>
