<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Graft</RootNamespace>
    <AssemblyName>Graft</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Graft</Product>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      実行ファイルのアイコン。tools/generate-icon.py が Themes/Logo.axaml のベクター定義から
      生成した成果物で、元となる定義はあくまでベクター側にある（附録A.5）。
      Windows以外の発行では単に無視される。
    -->
    <ApplicationIcon>Assets\Graft.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!--
      18章「起動から操作可能まで1秒以内」。ILを事前にネイティブコードへ変換しておくことで
      起動時のJITを大幅に減らす。Linuxでの実測で 約1.85秒 → 約0.66秒 に短縮した。
      引き換えに発行物のサイズが約87MBから約120MBへ増えるが、単一実行ファイルでの
      配布（2.1）に支障はなく、常駐時のメモリ使用量にも影響しない。
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <!--
      Windowsのウィンドウプロシージャへ割り込むAPI（Win32Properties）を参照するために必要。
      Avalonia.Desktopの依存として実行時には既に含まれており、追加で配布物が増えることはない。
      Windows以外では読み込まれない（Platform/WindowMessageBridge.cs のコメント参照）。
    -->
    <PackageReference Include="Avalonia.Win32" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)'=='Debug'" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.1.0" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <!--
      Windowsのテーマ変更通知（SystemEvents.UserPreferenceChanged）に必要。WPF版では
      WindowsBase経由で暗黙に参照されていたが、この版はWPFを参照しないため明示的に足す。
      Windows以外では実行時に読み込まれない。
    -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>


  <ItemGroup>
    <EmbeddedResource Include="Assets\DiffPlex-LICENSE.txt" />
    <EmbeddedResource Include="Assets\AvalonEdit-LICENSE.txt" />
  </ItemGroup>

</Project>
