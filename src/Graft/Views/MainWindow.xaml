<Window x:Class="Graft.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:Graft.Views"
        mc:Ignorable="d"
        Title="Graft"
        MinWidth="{DynamicResource MinWindowWidth}"
        MinHeight="{DynamicResource MinWindowHeight}"
        Background="{DynamicResource BgBase}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        Foreground="{DynamicResource TextPrimary}"
        d:DesignWidth="1280" d:DesignHeight="800">
    <!--
        8.2 レイアウト: メニューバー・ツールバーは持たず、上部40pxのコマンドバーのみを置く。
        3ペイン（プロジェクト+履歴／ブロック一覧／diff）はGridSplitterで比率調整できる。
        下部48pxのステータスバーに件数サマリとプレビュー・適用ボタンを置く。
        AutomationProperties.Nameはすべての操作可能要素に日本語で設定する（8.14）。
    -->
    <Window.Resources>
        <views:CenterPaneStateConverter x:Key="CenterStateConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource CommandBarHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{DynamicResource StatusBarHeight}" />
        </Grid.RowDefinitions>

        <!-- ============== コマンドバー（40px、メニュー・ツールバーなし） ============== -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          MinWidth="180"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding ProjectPane.Items}"
                          SelectedItem="{Binding ProjectPane.SelectedItem, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          AutomationProperties.Name="プロジェクトを選択" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="解析"
                            Command="{Binding PasteAndParseCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="クリップボードのパッチを解析" />
                    <Button Content="適用"
                            Command="{Binding ApplyCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="適用を実行" />
                    <Button Content="履歴"
                            Command="{Binding ShowHistoryCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="履歴ペインへ移動" />
                    <Button Content="設定"
                            Command="{Binding OpenSettingsCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="設定を開く" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============== 3ペイン本体 ============== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="260" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CenterColumn" Width="380" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- 左ペイン: 上段プロジェクト一覧・下段履歴（スプリッタで比率調整、8.2） -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ProjectRow" Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="HistoryRow" Height="*" />
                </Grid.RowDefinitions>
                <views:ProjectPane x:Name="ProjectPaneControl" Grid.Row="0" DataContext="{Binding ProjectPane}" />
                <GridSplitter Grid.Row="1"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource BorderSubtle}"
                              AutomationProperties.Name="プロジェクト一覧と履歴の境界" />
                <views:HistoryPane x:Name="HistoryPaneControl" Grid.Row="2" DataContext="{Binding History}" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderSubtle}"
                          AutomationProperties.Name="プロジェクト一覧とブロック一覧の境界" />

            <!-- 中央ペイン: ブロック一覧。1行目にファイルパス、2行目に変更説明（8.2）。 -->
            <Grid Grid.Column="2" Background="{DynamicResource BgSurface}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,10,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="ブロック"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource PaneHeadingFontSize}"
                               FontWeight="{DynamicResource PaneHeadingFontWeight}"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBox Grid.Column="1"
                             Margin="8,0,0,0"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="ブロック一覧を検索" />
                </Grid>

                <Grid Grid.Row="1">
                    <ListBox x:Name="BlockListBox"
                             ItemsSource="{Binding Blocks}"
                             SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                             Background="{x:Null}"
                             AutomationProperties.Name="ブロック一覧">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Top"
                                              Margin="0,2,4,0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanToggle}"
                                              AutomationProperties.Name="適用可否を切り替え" />

                                    <Path x:Name="StatusIcon"
                                          Grid.Column="1"
                                          Style="{StaticResource IconPathStyle}"
                                          Width="16" Height="16"
                                          VerticalAlignment="Top"
                                          Margin="0,2,6,0" />

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding PathText}"
                                                   FontSize="{DynamicResource BodyFontSize}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DescriptionText}"
                                                   FontSize="{DynamicResource CaptionFontSize}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" />
                                        <!-- 8.8: エラーは赤い帯ではなく該当行のインライン表示。エラーコード＋対処方法併記。 -->
                                        <TextBlock Text="{Binding IssueText}"
                                                   FontSize="{DynamicResource CaptionFontSize}"
                                                   Foreground="{DynamicResource StateError}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasIssue, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding AddedRemovedText}"
                                               VerticalAlignment="Top"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </Grid>

                                <!-- 8.5: 状態は色と形状の両方で区別する（check / alert-triangle / x-circle）。 -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Ok">
                                        <Setter TargetName="StatusIcon" Property="Data" Value="{StaticResource IconCheckGeometry}" />
                                        <Setter TargetName="StatusIcon" Property="Stroke" Value="{DynamicResource StateOk}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Warn">
                                        <Setter TargetName="StatusIcon" Property="Data" Value="{StaticResource IconAlertTriangleGeometry}" />
                                        <Setter TargetName="StatusIcon" Property="Stroke" Value="{DynamicResource StateWarn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                        <Setter TargetName="StatusIcon" Property="Data" Value="{StaticResource IconXCircleGeometry}" />
                                        <Setter TargetName="StatusIcon" Property="Stroke" Value="{DynamicResource StateError}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <views:EmptyStateView State="{Binding State, Converter={StaticResource CenterStateConverter}}"
                                           IconGeometry="{StaticResource IconCopyGeometry}"
                                           Message="AIの出力をコピーして Ctrl+V"
                                           ActionText="解析"
                                           ActionCommand="{Binding PasteAndParseCommand}"
                                           Issue="{Binding CenterError}" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderSubtle}"
                          AutomationProperties.Name="ブロック一覧とdiffの境界" />

            <!-- 右ペイン: diff（担当外。DiffViewModel/DiffViewは別担当が実装する）。 -->
            <Border x:Name="DiffPaneHost"
                    Grid.Column="4"
                    Focusable="True"
                    Background="{DynamicResource BgSurface}"
                    AutomationProperties.Name="差分表示ペイン">
                <views:DiffView DataContext="{Binding Diff}" />
            </Border>
        </Grid>

        <!-- ============== ステータスバー（48px） ============== -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusSummaryText}"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource StatusBarFontSize}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviewCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="プレビューを再実行">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconEyeGeometry}"
                                  Style="{StaticResource IconPathStyle}"
                                  Width="14" Height="14"
                                  Margin="0,0,4,0" />
                            <TextBlock Text="プレビュー" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ApplyCommand}" AutomationProperties.Name="適用を実行">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlayGeometry}"
                                  Style="{StaticResource IconPathStyle}"
                                  Width="14" Height="14"
                                  Margin="0,0,4,0" />
                            <TextBlock Text="適用" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
