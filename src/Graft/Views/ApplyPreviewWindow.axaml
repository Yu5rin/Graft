<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Graft.Views"
        x:Class="Graft.Views.ApplyPreviewWindow"
        x:Name="Root"
        Title="適用前プレビュー"
        Width="880" Height="640"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        Foreground="{DynamicResource TextPrimary}"
        AutomationProperties.Name="適用前プレビュー">
    <!--
        課題1（設定「適用前にプレビューを表示する」/ Settings.ShowPreview）。
        v1.5仕様書6.8「プレビューとインライン編集」に基づき、書き込む前に差分を確認できる
        最終確認ダイアログ。DataContextにはApplyPreviewViewModelを受け取る。

        接ぎ木パネルの「プレビュー」ボタン（ドライランの再実行＝マッチ判定のやり直し）とは
        役割が異なる。あちらはファイル編集後に適用可否を最新化するための操作、こちらは
        適用を実行する直前に「何がどう変わるか」を最終確認するための操作。
    -->
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="{Binding SummaryText}"
                   Margin="0,0,0,12"
                   FontSize="{DynamicResource PaneHeadingFontSize}"
                   FontWeight="{DynamicResource PaneHeadingFontWeight}"
                   Foreground="{DynamicResource TextPrimary}" />

        <Grid Grid.Row="1" ColumnDefinitions="240,4,*">

            <!-- 左: 書き込み対象の一覧。選択すると右側に差分が出る。 -->
            <ListBox Grid.Column="0"
                     x:Name="ItemsListBox"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     Background="{DynamicResource BgSurface}"
                     AutomationProperties.Name="適用対象の一覧"
                     views:HelpTip.Standard="これから書き込まれるファイルの一覧です。選ぶと右側にそのファイルの差分が表示されます。"
                     views:HelpTip.Detailed="下の「適用」を押した場合に、実際に書き込まれる予定のファイルの一覧です。1件選ぶと右側にそのファイルの変更前・変更後の差分が表示されるので、書き込む前に内容をよく確認してください。ここではまだ何もファイルへ書き込まれていません。">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding PathText}"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DescriptionText}"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AddedRemovedText}"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderSubtle}"
                          AutomationProperties.Name="一覧と差分の境界" />

            <!-- 右: 選択中ブロックの差分（既存のDiffView/DiffViewModelをそのまま流用）。 -->
            <views:DiffView Grid.Column="2"
                            DataContext="{Binding Diff}"
                            AutomationProperties.Name="適用前の差分表示" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="キャンセル"
                    Click="OnCancelClicked"
                    Margin="0,0,8,0"
                    views:HelpTip.Standard="適用を取りやめ、接ぎ木パネルに戻ります。まだ何も書き込まれていません（Esc）。"
                    AutomationProperties.Name="適用をキャンセル" />
            <Button x:Name="ApplyConfirmButton"
                    Content="適用"
                    Click="OnApplyClicked"
                    views:HelpTip.Standard="表示した内容で実際のファイルへ書き込みます。書き込む前に自動でバックアップを取るので、履歴からいつでも元に戻せます。"
                    AutomationProperties.Name="この内容で適用" />
        </StackPanel>
    </Grid>
</Window>
