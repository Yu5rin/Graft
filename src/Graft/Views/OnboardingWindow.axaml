<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Graft.Views"
        x:Class="Graft.Views.OnboardingWindow"
        Title="Graftへようこそ"
        Width="560" Height="420" MinWidth="560" MinHeight="420"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        AutomationProperties.Name="初回起動ガイド">
    <!--
        初回起動ガイド（3画面）。v2.0のWPF版からの差分: ResizeMode="NoResize" は CanResize="False"、
        Visibility は IsVisible（bool）へ。
    -->
    <Grid Margin="24" RowDefinitions="*,Auto">

        <!-- 画面1: 導入 -->
        <StackPanel x:Name="Screen1" Grid.Row="0" VerticalAlignment="Center">
            <Image Source="{DynamicResource LogoImage}" Width="72" Height="72" HorizontalAlignment="Center"
                   AutomationProperties.Name="Graftロゴ" />
            <TextBlock Text="Graftへようこそ" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,8" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                       Text="GraftはAIが提案したコードの変更を、安全にファイルへ適用するためのツールです。&#10;最初にプロジェクトを登録し、AI向けのプロンプトをコピーする方法を確認しましょう。" />
        </StackPanel>

        <!-- 画面2: プロジェクト登録 -->
        <StackPanel x:Name="Screen2" Grid.Row="0" VerticalAlignment="Center" IsVisible="False">
            <TextBlock Text="プロジェクトを登録" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"
                       Text="変更を適用したいプロジェクトのフォルダを登録します。あとから設定画面でいつでも追加・変更できます。" />
            <StackPanel Orientation="Horizontal">
                <Button Content="フォルダを選択して登録" Click="OnRegisterProjectClicked"
                        AutomationProperties.Name="フォルダを選択してプロジェクトを登録"
                        views:HelpTip.Standard="AIに変更してもらいたいプロジェクトのフォルダを選んで、Graftに登録します。"
                        views:HelpTip.Detailed="フォルダ選択ダイアログが開くので、これから変更を適用したいプロジェクトのルートフォルダ（例: 普段VS Codeなどで開いているフォルダ）を選んでください。選ぶとGraftのプロジェクト一覧に登録され、以降そのフォルダの中のファイルをエディタで開いたり、パッチを適用したりできるようになります。フォルダの中身自体は変更されません。あとから設定画面や画面左のプロジェクト一覧からも追加・変更できます。" />
            </StackPanel>
            <TextBlock x:Name="ProjectResultText" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <!-- 画面3: プロンプトテンプレートのコピー -->
        <StackPanel x:Name="Screen3" Grid.Row="0" VerticalAlignment="Center" IsVisible="False">
            <TextBlock Text="プロンプトをコピー" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       Text="AIに出力形式を守らせるための指示文をクリップボードへコピーできます。会話の最初にAIへ貼り付けてください。" />
            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    Background="{DynamicResource BgSurface}">
                <TextBox x:Name="TemplatePreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="120" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent"
                         FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource CodeFontSize}"
                         AutomationProperties.Name="初回用プロンプトのプレビュー"
                         views:HelpTip.Standard="AIへ最初に伝える指示文の内容です（読み取り専用のプレビュー）。下の「クリップボードにコピー」で実際にコピーできます。"
                         views:HelpTip.Detailed="AIに「Graftが読み取れる決まった形式で回答してください」と伝えるための指示文の中身を、ここでそのまま確認できます（編集はできません）。この文面自体を書き換えたい場合は、あとから設定画面の「プロンプトテンプレート」タブで調整できます。" />
            </Border>
            <Button Content="クリップボードにコピー" Click="OnCopyTemplateClicked" Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="プロンプトをクリップボードにコピー"
                    views:HelpTip.Standard="上のプロンプトをクリップボードへコピーします。AIとの会話の最初に貼り付けてください。"
                    views:HelpTip.Detailed="上に表示されている指示文をクリップボードへコピーします。ChatGPTやClaudeなどのAIとの会話を始めるときに最初に貼り付けてから、直してほしい内容を伝えてください。こうしておくと、AIの回答をあとでGraftの「解析」ボタンが正しく読み取れるようになります。コマンドバーの「プロンプト」ボタン（Ctrl+Shift+C）でも、あとからいつでも同じ内容をコピーできます。" />
            <TextBlock x:Name="CopyResultText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" />
            <!--
                課題2: コピーだけではこのあと何をすればいいか分からず終わってしまうため、
                次の一歩（AIへ貼り付け→AIの回答をコピー→ツールバーの「解析」）を短く案内する。
                文言はGraftPanel.axamlの空状態メッセージ（「AIの出力をコピーして Ctrl+Shift+V」）や
                コマンドバーの「解析」ボタン（ShellWindow.axaml）と食い違わないようにする。
            -->
            <TextBlock TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource CaptionFontSize}"
                       Text="このあとAIに貼り付けて変更を依頼し、AIの回答をコピーしてツールバーの「解析」を押してください。" />
        </StackPanel>

        <!--
            画面4（最終画面）: 「使い方を学ぶ」／「チュートリアルを終了」の2択。
            利用者からの指摘（「接ぎ木が体験できないので、ソフトの中核を体験できない」）への
            対応。従来はここが「完了」ボタン1つだけの単純な終了画面だったが、Graftの中核である
            「接ぎ木」（AIが提案した変更を安全にファイルへ適用する）を実際の画面上で1回
            体験できる画面上チュートリアル（ShellWindow.Tutorial.cs参照）への入口をここに置く。
            スキップ（下段のSkipButton）やEsc（OnTunnelKeyDown）は、この画面を経由せず
            そのままガイドを終了する（＝チュートリアルも開始しない）仕様のため、
            このStackPanel自体には次へ/スキップの意味は持たせない。
        -->
        <StackPanel x:Name="Screen4" Grid.Row="0" VerticalAlignment="Center" IsVisible="False">
            <TextBlock Text="準備ができました" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"
                       HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,20"
                       Text="Graftの中核である「接ぎ木」——AIが提案した変更を安全にファイルへ適用する一連の流れ——を、実際の画面上で1回体験してみませんか？サンプルだけを使うので、あなたのプロジェクトには一切触れません。" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="使い方を学ぶ" Click="OnStartTutorialClicked" Margin="0,0,8,0" IsDefault="True"
                        AutomationProperties.Name="使い方を学ぶ（画面上のチュートリアルを開始する）"
                        views:HelpTip.Standard="実際の画面上でコントロールを指しながら、サンプルを使って接ぎ木の一連の流れ（解析→差分確認→適用→履歴→復元）を体験します。"
                        views:HelpTip.Detailed="解析→差分確認→適用→履歴確認→復元までを、実際のGraftの画面上で1つずつコントロールを指しながら体験できるチュートリアルを開始します。使うのは一時フォルダに生成したサンプルのみで、あなたのプロジェクトには一切触れません。いつでもEscキーか吹き出しの「終了」ボタンで中断でき、中断してもGraftの状態が壊れることはありません。あとから「？」メニューやコマンドパレットの「使い方を学ぶ」でも再実行できます。" />
                <Button Content="チュートリアルを終了" Click="OnFinishOnboardingClicked"
                        AutomationProperties.Name="チュートリアルを開始せずいつものGraftの画面へ進む"
                        views:HelpTip.Standard="画面上のチュートリアルは開始せず、いつものGraftの画面へ進みます。あとから「？」メニューでいつでも開始できます。" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <TextBlock x:Name="StepIndicatorText" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource CaptionFontSize}" />
            <Button x:Name="BackButton" Grid.Column="2" Content="戻る" Click="OnBackClicked" Margin="0,0,8,0"
                    IsEnabled="False" AutomationProperties.Name="前の画面に戻る"
                    views:HelpTip.Standard="1つ前の画面に戻ります。" />
            <!--
                最終画面（Screen4）では、下段のNext/Skipの代わりに画面内の2択ボタンで完結させる
                （UpdateStepUiでIsVisible=Falseにする）。「スキップ」はガイド自体の終了であり、
                当然チュートリアル（学ぶ画面・画面上の体験）も開始しない。
            -->
            <Button x:Name="SkipButton" Grid.Column="3" Content="スキップ" Click="OnSkipClicked" Margin="0,0,8,0"
                    AutomationProperties.Name="ガイドをスキップ"
                    views:HelpTip.Standard="初回起動ガイドをここで終了します（画面上のチュートリアルも開始しません）。プロジェクトの登録はあとから設定画面でいつでも行えます。"
                    views:HelpTip.Detailed="この初回起動ガイドをここで終了し、いつものGraftの画面に進みます。画面上のチュートリアルも開始しません。まだプロジェクト（作業対象のフォルダ）を登録していなくても大丈夫です。あとから設定画面や画面左のプロジェクト一覧から、いつでもフォルダを追加登録できます。チュートリアルは「？」メニューからいつでも開始できます。" />
            <Button x:Name="NextButton" Grid.Column="4" Content="次へ" Click="OnNextClicked" IsDefault="True"
                    AutomationProperties.Name="次の画面へ"
                    views:HelpTip.Standard="次の画面へ進みます。" />
        </Grid>
    </Grid>
</Window>
