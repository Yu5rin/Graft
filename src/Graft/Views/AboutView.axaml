<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Graft.Views"
             x:Class="Graft.Views.AboutView"
             AutomationProperties.Name="バージョン情報">
    <!--
        8.15章のバージョン情報。ロゴは Themes/Logo.axaml の {DynamicResource LogoImage} を使い、
        ラスタ画像は使用しない。v2.0のWPF版からの移植（19章 L3）。
        Expander の Expanded イベントは Avalonia に無いため、IsExpanded の変化を
        コードビハインドで購読してライセンス全文を読み込む。見た目は共通テーマ
        （Themes/Controls.Layout.axaml）の Expander が担う。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Image Source="{DynamicResource LogoImage}" Width="56" Height="56"
                       AutomationProperties.Name="Graftロゴ" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Graft" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="BuildDateText" Foreground="{DynamicResource TextSecondary}"
                               FontSize="{DynamicResource CaptionFontSize}" />
                    <TextBlock x:Name="AuthorText" Foreground="{DynamicResource TextSecondary}"
                               AutomationProperties.Name="製作者" />
                    <TextBlock x:Name="CopyrightText" Foreground="{DynamicResource TextSecondary}"
                               FontSize="{DynamicResource CaptionFontSize}"
                               AutomationProperties.Name="著作権表示" />
                </StackPanel>
            </StackPanel>

            <!--
                利用者からの要望（元は「一般」タブ）: 更新まわりのUI一式をこのタブへ移設した。
                「バージョン番号の隣にあるのが自然」という理由で、上のバージョン表示
                （VersionText）のすぐ下に置く。通信条件（起動時1日1回まで・このボタンのみ）・
                ダウンロード〜自己置き換え〜再起動の実処理はSettingsViewModel.Update.cs参照。
                「現在のバージョン」表示は上のVersionText（「バージョン x.y.z」）と内容が重複する
                ため、移設時に削った（移設元のGeneralSettingsView.axamlにはCurrentVersionTextを
                表示する行があったが、二重表示になるので統合した）。

                利用者からの要望（v1.0.11）: 「チェック先URL」のラベルと入力欄が同じ行の左右に
                離れて置かれ、対応関係が分かりにくかった。設定画面の他タブが使う横並びの
                「fieldRow」（Themes/Settings.axaml、ラベル列の幅を280に固定して複数行を
                揃えるための書式）はこの1項目しか無いこのタブには不要なので使わず、ラベル→
                入力欄→ボタンの縦並びへ変更した。TextBoxは幅を明示せず既定のHorizontalAlignment=
                Stretchのまま（親のStackPanelはMaxWidth="640"で頭打ちになるため、パネルの幅を
                超えてはみ出さない）。
            -->
            <TextBlock Text="更新" FontSize="{DynamicResource PaneHeadingFontSize}"
                       FontWeight="{DynamicResource PaneHeadingFontWeight}" Margin="0,0,0,8" />
            <!--
                機能追加（v1.0.11・「起動時に更新チェックされているか分からない」への対応）:
                起動時1日1回の絞り込みや通信の成否は画面から見えず「確認したのか・スキップ
                されたのか・そもそも動いていないのか」を利用者が区別できなかった。実際に
                通信して確認した直近の日時を常時表示することで、「確認したのに何も起きない」を
                「確認した結果、最新でした」と分かる形にする。詳細な結果（最新／新版あり／
                失敗）はlogs/<日付>.logへ記録する（SettingsViewModel.Update.cs参照）。
            -->
            <TextBlock Text="{Binding UpdateLastCheckedText}" Classes="fieldHint" Margin="0,0,0,10"
                       AutomationProperties.Name="更新の最終確認日時" />
            <CheckBox Classes="settingRow" Content="起動時に更新を確認する" IsChecked="{Binding UpdateCheckOnStartup}"
                      AutomationProperties.Name="起動時に更新を確認する"
                      local:HelpTip.Standard="起動のたびに（ただし前回の確認から24時間以上経っていれば）GitHubへ新しいバージョンが無いか確認します。既定はオンです。"
                      local:HelpTip.Detailed="オンにすると（既定）、Graftを起動するたびに、前回の確認から24時間以上経っていることを条件として、GitHub（下の「チェック先URL」）へ新しいバージョンが無いか問い合わせます。見つかった場合はダイアログで知らせ、同意した場合のみダウンロードが始まります（無断でダウンロードされることはありません）。オフにしても、下の「今すぐ更新を確認」はいつでも使えます。確認・ダウンロードのとき以外、Graftは外部と通信しません。" />
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="チェック先URL" Margin="0,0,0,4" />
                <TextBox Text="{Binding UpdateCheckUrl, UpdateSourceTrigger=LostFocus}"
                         local:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="更新のチェック先URL"
                         local:HelpTip.Standard="更新の確認先（GitHub Releases API）です。どこへ通信しているかをここで確認・変更できます。"
                         local:HelpTip.Detailed="更新の確認で問い合わせるGitHub Releases APIのURLです。既定はGraft本体のリポジトリ（https://api.github.com/repos/Yu5rin/Graft/releases/latest）で、通常は変更する必要はありません。「どこへ通信するのか」をコードに隠さず、ここで確認・変更できるようにしています。HTTPS以外のURLへは通信しません。" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="今すぐ更新を確認" Command="{Binding CheckForUpdateNowCommand}"
                        AutomationProperties.Name="今すぐ更新を確認"
                        local:HelpTip.Standard="今すぐGitHubへ問い合わせて、新しいバージョンが無いか確認します。"
                        local:HelpTip.Detailed="「起動時に更新を確認する」がオフでも、押した瞬間に必ずGitHubへ問い合わせます（24時間の間隔は無視されます）。新しいバージョンが見つかった場合はダイアログで案内し、同意した場合のみダウンロードへ進みます。" />
                <Button Content="中断" Command="{Binding CancelUpdateDownloadCommand}" Margin="8,0,0,0"
                        IsVisible="{Binding IsUpdateDownloading}"
                        AutomationProperties.Name="更新のダウンロードを中断"
                        local:HelpTip.Standard="ダウンロード中の更新ファイルの取得を中断します。" />
            </StackPanel>
            <ProgressBar Value="{Binding UpdateProgressPercent}" Minimum="0" Maximum="100" Height="4" Margin="0,8,0,0"
                         IsVisible="{Binding IsUpdateDownloading}"
                         AutomationProperties.Name="更新のダウンロード進捗" />
            <TextBlock Text="{Binding UpdateStatusMessage}" Classes="fieldHint" TextWrapping="Wrap" Margin="0,8,0,16"
                       IsVisible="{Binding UpdateStatusMessage, Converter={x:Static local:Converters.NotNull}}"
                       AutomationProperties.Name="更新の状況" />

            <!--
                機能2（ログの参照手段）: 不具合報告のやり取りを楽にするための2つの導線。
                「ログフォルダを開く」はIFileManagerLauncherを再利用してlogs/フォルダを開くだけ、
                「最新のログを表示」は直近のログファイルの末尾をLogViewerWindowで表示する。
                実処理はSettingsViewModel.DataDirectory.cs（DataContextはTabItem経由で継承する
                SettingsViewModel）にまとめている。
            -->
            <TextBlock Text="ログ" FontSize="{DynamicResource PaneHeadingFontSize}"
                       FontWeight="{DynamicResource PaneHeadingFontWeight}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="ログフォルダを開く" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,0"
                        AutomationProperties.Name="ログフォルダを開く"
                        local:HelpTip.Standard="ログファイル（logs/）が入っているフォルダをファイルマネージャで開きます。"
                        local:HelpTip.Detailed="Graftのログファイル一式が保存されているフォルダ（logs/）を、エクスプローラ（Windows）やファイルマネージャ（Linux）で開きます。不具合を報告する際に、該当日のログファイルを添付したいときに使ってください。" />
                <Button Content="最新のログを表示" Command="{Binding ShowLatestLogCommand}"
                        AutomationProperties.Name="最新のログを表示"
                        local:HelpTip.Standard="直近のログファイルの末尾を、この場で確認できる画面を開きます。全文コピーもできます。"
                        local:HelpTip.Detailed="最も新しいログファイルの末尾（直近200行程度）を専用の画面で表示します。ログは1行ごとに1件のJSON形式のままで、見やすく整形はしません。表示した内容は画面内の「コピー」ボタンでクリップボードへコピーでき、そのまま不具合報告に貼り付けられます。" />
            </StackPanel>

            <!--
                機能1（オープンソースライセンス表記）: Avalonia・AvaloniaEdit・DiffPlex等の依存関係は
                MIT/Apache-2.0/BSD等の条件でライセンス文の同梱・表示を義務付けている。項目数が多く
                このタブへ全文をすべて並べると長くなりすぎるため、一覧＋全文は専用ウィンドウ
                （OpenSourceLicensesWindow）へ切り出し、ここには導線のボタンのみを置く
                （調査方法・確認できたことの詳細はOpenSourceLicensesWindow.axaml.csのコメント参照）。
            -->
            <TextBlock Text="使用ライブラリのライセンス表記" FontSize="{DynamicResource PaneHeadingFontSize}"
                       FontWeight="{DynamicResource PaneHeadingFontWeight}" Margin="0,0,0,8" />
            <Button Content="オープンソースライセンスを表示" Click="OnShowLicensesClicked"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="オープンソースライセンスを表示"
                    local:HelpTip.Standard="Graftが使用しているオープンソースライブラリの一覧と、各ライセンス全文を表示します。"
                    local:HelpTip.Detailed="Avalonia・AvaloniaEdit・DiffPlexなど、Graftが実行時に使用しているオープンソースの依存ライブラリを一覧表示し、それぞれのライセンス全文をこの場で確認できます。ビルド時のみ使用され配布物に含まれないツールは一覧に含みません。" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
