<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Graft.Views"
             x:Class="Graft.Views.QuickOpenOverlay"
             Focusable="False"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             Margin="0,16,0,0"
             Width="520"
             ZIndex="100"
             IsVisible="{Binding IsOpen, FallbackValue=False}"
             AutomationProperties.Name="クイックオープン">
    <!--
        クイックオープン（Ctrl+P、ファイル名あいまい検索）オーバーレイ。エディタ領域の上部中央に
        浮かせて配置する（ShellWindow.axamlのEditorAreaGrid内、EditorHostと同じセルに重ねる）。
        あいまい一致・スコアリングはFuzzyMatcher（Features、WPF非依存）が担い、ここでは
        入力・候補一覧の表示とキー操作の橋渡しのみを行う。開閉・上下キー・Enter・Escは
        ShellWindow.Keyboard.csがQuickOpenViewModelを直接操作する
        （エディタ内フォーカス時にも効かせるため、既存のHandleUnconditionalShortcut系の作法に合わせる）。
    -->
    <Border Background="{DynamicResource BgElevated}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            Padding="8"
            AutomationProperties.Name="クイックオープン: ファイル名で検索して開く">
        <StackPanel>
            <TextBox x:Name="QueryBox"
                     Text="{Binding Query, Mode=TwoWay}"
                     Watermark="ファイル名を入力..."
                     AutomationProperties.Name="クイックオープンの検索文字列" />

            <TextBlock Text="ファイル一覧を読み込み中..."
                       Margin="4,8,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource CaptionFontSize}"
                       IsVisible="{Binding IsLoading}"
                       AutomationProperties.Name="ファイル一覧を読み込み中" />

            <TextBlock Text="一致するファイルがありません"
                       Margin="4,8,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource CaptionFontSize}"
                       IsVisible="{Binding Results.Count,
                                   Converter={x:Static local:Converters.CountIsZero}}"
                       AutomationProperties.Name="一致するファイルがありません" />

            <ListBox x:Name="ResultsList"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                     Margin="0,6,0,0"
                     MaxHeight="280"
                     Background="Transparent"
                     BorderThickness="0"
                     IsVisible="{Binding Results.Count,
                                 Converter={x:Static local:Converters.CountIsNotZero}}"
                     AutomationProperties.Name="クイックオープンの候補一覧（最大10件表示・スクロール可）">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        <Setter Property="Padding" Value="6,4" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- マウスクリックでも確定（仕様書）。Tappedで選択→確定を同時に行う。 -->
                        <StackPanel Orientation="Horizontal" Tapped="OnResultTapped">
                            <TextBlock Text="{Binding FileName}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="{DynamicResource BodyFontSize}" />
                            <TextBlock Text="{Binding RelativePath}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{DynamicResource CaptionFontSize}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
