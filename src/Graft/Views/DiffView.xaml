<UserControl x:Class="Graft.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Graft.ViewModels"
             xmlns:views="clr-namespace:Graft.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DiffViewModel}"
             PreviewMouseWheel="OnPreviewMouseWheel">
    <!--
        仕様書8.7 プレビューとインライン編集 / 8.13 diffの表示制御 / 8.6 シンタックス
        ハイライト / 8.3 diffの形状的区別 / 8.14 アクセシビリティ を担当する。
        DataContext には DiffViewModel を受け取る（他担当が生成・Loadする）。
    -->
    <UserControl.Resources>
        <!-- InverseBooleanConverter / InverseBooleanToVisibilityConverter は
             Views/ContextCollectWindow.xaml.cs（Graft.Views名前空間）で既に定義済みのため、
             ここでは再定義せず再利用する。 -->
        <views:BoolToStarGridLengthConverter x:Key="BoolToStarWidth" />
        <views:BoolToTextWrappingConverter x:Key="BoolToWrap" />

        <!-- 8.3: 削除行の左端バーは破線。3px幅・3px間隔の矩形タイルで表現する。 -->
        <DrawingBrush x:Key="DiffDelBarDashedBrush" Viewport="0,0,1,6" ViewportUnits="RelativeToBoundingBox" TileMode="Tile">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource DiffDelBar}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4,3" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- 1セル（変更前 or 変更後の片側）の共通描画。行番号2列＋左端3pxバー＋コード本体。 -->
        <DataTemplate x:Key="CellTemplate" DataType="{x:Type vm:DiffCellViewModel}">
            <Grid x:Name="RowBg" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding OldLineText}" Width="40" Padding="4,0,8,0"
                           TextAlignment="Right" Foreground="{DynamicResource TextSecondary}"
                           FontFamily="{DynamicResource CodeFontFamily}"
                           Visibility="{Binding DataContext.ShowLineNumbers, RelativeSource={RelativeSource AncestorType=views:DiffView}, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="1" Text="{Binding NewLineText}" Width="40" Padding="4,0,8,0"
                           TextAlignment="Right" Foreground="{DynamicResource TextSecondary}"
                           FontFamily="{DynamicResource CodeFontFamily}"
                           Visibility="{Binding DataContext.ShowLineNumbers, RelativeSource={RelativeSource AncestorType=views:DiffView}, Converter={StaticResource BoolToVis}}" />

                <Border Grid.Column="2" x:Name="Bar" />

                <views:CodeLineControl Grid.Column="3" Margin="8,0,0,0"
                                        LineText="{Binding Text}" Tokens="{Binding Tokens}"
                                        InlineHighlights="{Binding InlineSpans}" DiffKind="{Binding Kind}"
                                        IsDiffRow="True"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        ShowWhitespace="{Binding DataContext.ShowWhitespace, RelativeSource={RelativeSource AncestorType=views:DiffView}}"
                                        TextWrapping="{Binding DataContext.WordWrap, RelativeSource={RelativeSource AncestorType=views:DiffView}, Converter={StaticResource BoolToWrap}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource DiffAddBg}" />
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource DiffAddBar}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource DiffDelBg}" />
                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource DiffDelBarDashedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- diff本体の1行。省略行はクリックで展開するボタン、それ以外は左右セル。 -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:DiffLineViewModel}">
            <Grid>
                <Button Content="{Binding Left.Text}" Command="{Binding ExpandCommand}"
                        HorizontalContentAlignment="Left" Padding="8,4" Background="{DynamicResource BgHover}"
                        BorderThickness="0" Foreground="{DynamicResource TextSecondary}"
                        AutomationProperties.Name="{Binding RowAutomationName}"
                        Visibility="{Binding IsOmitted, Converter={StaticResource BoolToVis}}" />

                <Grid Visibility="{Binding IsOmitted, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{Binding DataContext.IsSideBySide, RelativeSource={RelativeSource AncestorType=views:DiffView}, Converter={StaticResource BoolToStarWidth}}" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Content="{Binding Left}" ContentTemplate="{StaticResource CellTemplate}" />
                    <ContentPresenter Grid.Column="1" Content="{Binding Right}" ContentTemplate="{StaticResource CellTemplate}"
                                       Visibility="{Binding DataContext.IsSideBySide, RelativeSource={RelativeSource AncestorType=views:DiffView}, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BgSurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{DynamicResource SpacingSmThickness}">
            <RadioButton GroupName="DiffMode" Content="並列" Margin="0,0,8,0" VerticalAlignment="Center"
                         IsChecked="{Binding IsSideBySide}" AutomationProperties.Name="並列表示に切り替え" />
            <RadioButton GroupName="DiffMode" Content="統合" Margin="0,0,16,0" VerticalAlignment="Center"
                         IsChecked="{Binding IsSideBySide, Converter={StaticResource InverseBool}}"
                         AutomationProperties.Name="統合表示に切り替え" />
            <ToggleButton Content="折り返し" Margin="0,0,8,0" IsChecked="{Binding WordWrap}"
                          AutomationProperties.Name="長い行の折り返しを切り替え" />
            <ToggleButton Content="空白を表示" Margin="0,0,8,0" IsChecked="{Binding ShowWhitespace}"
                          AutomationProperties.Name="空白文字の可視化を切り替え" />
            <ToggleButton Content="すべて展開" Margin="0,0,16,0" IsChecked="{Binding IsFullyExpanded}"
                          AutomationProperties.Name="省略範囲をすべて展開" />
            <TextBlock Text="表示行数が多いためシンタックスハイライトを無効化しました"
                       Foreground="{DynamicResource StateWarn}" VerticalAlignment="Center"
                       Visibility="{Binding SyntaxHighlightDisabled, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- 8.7: 段階5（要確認）の強調バナー -->
        <Border Grid.Row="1" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource StateWarn}"
                BorderThickness="0,0,0,1" Padding="{DynamicResource SpacingSmThickness}"
                Visibility="{Binding NeedsConfirmation, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconAlertTriangleGeometry}"
                      Stroke="{DynamicResource StateWarn}" Margin="0,0,8,0" />
                <TextBlock Text="要確認: 類似度に基づく一致です。内容を確認し、適用に含めるかを選んでください。"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <CheckBox Content="この変更を適用に含める" IsChecked="{Binding IsIncluded}"
                          IsEnabled="{Binding CanToggleInclusion}"
                          AutomationProperties.Name="この変更を適用に含める" />
            </StackPanel>
        </Border>

        <!-- diff本体（表示範囲のみレンダリング） -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource RowTemplate}"
                  Background="Transparent" BorderThickness="0"
                  FontFamily="{DynamicResource CodeFontFamily}" FontSize="{Binding CodeFontSize}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.Name="差分表示">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding RowAutomationName}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- 8.7: マッチ失敗ブロックのインライン編集（SEARCH/REPLACEペア単位） -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding InlineEdits}"
                      Visibility="{Binding HasInlineEdits, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:InlineEditViewModel}">
                    <views:InlineEditPanel DataContext="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
