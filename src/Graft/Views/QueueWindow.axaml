<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Graft.Views"
        x:Class="Graft.Views.QueueWindow"
        x:Name="Root"
        Title="パッチキュー"
        Width="480" Height="440"
        MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        Foreground="{DynamicResource TextPrimary}"
        AutomationProperties.Name="パッチキュー">
    <!--
        仕様書4.10: 複数回に分けて受け取ったパッチを1つのリビジョンとして結合できるよう、
        キュー内のブロックを確認・個別削除・全削除・結合適用できるようにする。

        v2.0のWPF版からの差分: RelativeSource AncestorType による祖先参照は ElementName（#Root）へ。
        IsCancel は無いため、Escでの終了はコードビハインドで扱う（v2.0のWPF版も同様の購読あり）。
    -->
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   Text="キュー内のブロック"
                   Margin="0,0,0,8"
                   FontSize="{DynamicResource PaneHeadingFontSize}"
                   FontWeight="{DynamicResource PaneHeadingFontWeight}"
                   Foreground="{DynamicResource TextSecondary}" />

        <Grid Grid.Row="1">
            <ListBox x:Name="QueueListBox"
                     ItemsSource="{Binding Items}"
                     Background="{DynamicResource BgSurface}"
                     AutomationProperties.Name="キュー内のブロック一覧">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding PathText}"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DescriptionText}"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AddedAtText}"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="削除"
                                    VerticalAlignment="Top"
                                    Command="{Binding DataContext.RemoveCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="このブロックだけをキューから取り除きます。他のブロックには影響しません。"
                                    AutomationProperties.Name="このブロックをキューから削除" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <views:EmptyStateView State="{Binding IsEmpty,
                                          Converter={x:Static views:Converters.IsEmptyToEmptyState}}"
                                  IconGeometry="{DynamicResource IconCopyGeometry}"
                                  Message="キューは空です。パッチが途中で切れて受信されると自動的に追加されます" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="すべて削除"
                    Command="{Binding ClearCommand}"
                    Margin="0,0,8,0"
                    ToolTip.Tip="キューに溜まっているブロックをすべて削除します（確認あり）。元に戻せないので注意してください。"
                    AutomationProperties.Name="キューをすべて削除" />
            <Button Content="結合して適用へ進む"
                    Command="{Binding MergeCommand}"
                    Margin="0,0,8,0"
                    ToolTip.Tip="キュー内のブロックを1つの変更としてまとめ、通常の解析結果と同じようにプレビュー・適用へ進みます。"
                    AutomationProperties.Name="キューを結合して解析結果へ渡す" />
            <Button Content="閉じる"
                    Click="OnCloseClicked"
                    ToolTip.Tip="このウィンドウを閉じます（Esc）。"
                    AutomationProperties.Name="閉じる" />
        </StackPanel>
    </Grid>
</Window>
