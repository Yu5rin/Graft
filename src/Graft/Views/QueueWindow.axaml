<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Graft.Views"
        x:Class="Graft.Views.QueueWindow"
        x:Name="Root"
        Title="パッチキュー"
        Width="480" Height="440"
        MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        Foreground="{DynamicResource TextPrimary}"
        AutomationProperties.Name="パッチキュー">
    <!--
        仕様書4.10: 複数回に分けて受け取ったパッチを1つのリビジョンとして結合できるよう、
        キュー内のブロックを確認・個別削除・全削除・結合適用できるようにする。

        v2.0のWPF版からの差分: RelativeSource AncestorType による祖先参照は ElementName（#Root）へ。
        IsCancel は無いため、Escでの終了はコードビハインドで扱う（v2.0のWPF版も同様の購読あり）。
    -->
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   Text="キュー内のブロック"
                   Margin="0,0,0,8"
                   FontSize="{DynamicResource PaneHeadingFontSize}"
                   FontWeight="{DynamicResource PaneHeadingFontWeight}"
                   Foreground="{DynamicResource TextSecondary}" />

        <Grid Grid.Row="1">
            <ListBox x:Name="QueueListBox"
                     ItemsSource="{Binding Items}"
                     Background="{DynamicResource BgSurface}"
                     AutomationProperties.Name="キュー内のブロック一覧"
                     views:HelpTip.Standard="「キューへ追加」で溜めておいた変更の一覧です。まだファイルには反映されていません。"
                     views:HelpTip.Detailed="コマンドバーの「キューへ追加」で順番待ちに溜めておいた変更の一覧です。AIの回答が複数回に分けて送られてきたときに使う仕組みで、ここに並んでいる間はまだファイルへ反映されていません。不要な項目は各行の「削除」で個別に取り除け、すべて揃ったら下の「結合して適用へ進む」でまとめて確認・適用できます。">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding PathText}"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DescriptionText}"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AddedAtText}"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="削除"
                                    VerticalAlignment="Top"
                                    Command="{Binding DataContext.RemoveCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    views:HelpTip.Standard="このブロックだけをキューから取り除きます。他のブロックには影響しません。"
                                    views:HelpTip.Detailed="この1件だけを順番待ちの列（キュー）から取り除きます。同じキュー内の他のブロックはそのまま残るので、不要になったものだけを選んで削除できます。"
                                    AutomationProperties.Name="このブロックをキューから削除" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <views:EmptyStateView State="{Binding IsEmpty,
                                          Converter={x:Static views:Converters.IsEmptyToEmptyState}}"
                                  IconGeometry="{DynamicResource IconCopyGeometry}"
                                  Message="キューは空です。パッチが途中で切れて受信されると自動的に追加されます" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="すべて削除"
                    Command="{Binding ClearCommand}"
                    Margin="0,0,8,0"
                    views:HelpTip.Standard="キューに溜まっているブロックをすべて削除します（確認あり）。元に戻せないので注意してください。"
                    views:HelpTip.Detailed="今キューに溜まっているブロックを、すべてまとめて削除します。押すと確認ダイアログが出るので、そこで承認すると実行されます。一度削除すると元に戻せないため、必要なブロックが残っていないか確認してから押してください。"
                    AutomationProperties.Name="キューをすべて削除" />
            <Button Content="結合して適用へ進む"
                    Command="{Binding MergeCommand}"
                    Margin="0,0,8,0"
                    views:HelpTip.Standard="キュー内のブロックを1つの変更としてまとめ、通常の解析結果と同じようにプレビュー・適用へ進みます。"
                    views:HelpTip.Detailed="複数回に分けてキューへ追加しておいたブロックを1つの変更としてまとめ、コマンドバーの「解析」を実行したときと同じ画面（接ぎ木パネル）へ渡します。そこでいつも通り内容を確認し、「適用」を押すとまとめてファイルへ書き込まれます。"
                    AutomationProperties.Name="キューを結合して解析結果へ渡す" />
            <Button Content="閉じる"
                    Click="OnCloseClicked"
                    views:HelpTip.Standard="このウィンドウを閉じます（Esc）。"
                    views:HelpTip.Detailed="このキュー画面を閉じます。キュー自体の中身は消えず、次に「キュー」ボタンを押したときにまた表示されます。キーボードのEscキーでも閉じられます。"
                    AutomationProperties.Name="閉じる" />
        </StackPanel>
    </Grid>
</Window>
