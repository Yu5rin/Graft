<Window x:Class="Graft.Views.ContextCollectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Graft.ViewModels"
        xmlns:local="clr-namespace:Graft.Views"
        Title="コンテキスト収集"
        Width="760" Height="640" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        AutomationProperties.Name="コンテキスト収集">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:NullToVisibilityConverter x:Key="NullToVis" />
        <local:IndentToMarginConverter x:Key="IndentToMargin" />
        <local:IssueToDisplayTextConverter x:Key="IssueToText" />
        <local:FileCheckEnabledConverter x:Key="FileCheckEnabled" />

        <!-- ComboBox: Controls.xaml に定義が無いため、この画面用に最小限のテンプレートを持つ。 -->
        <Style x:Key="GraftComboBoxToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{DynamicResource BgSurface}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1">
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" />
                                <Path Grid.Column="1" Data="M0,0 L8,0 L4,6 Z"
                                      Fill="{DynamicResource TextSecondary}"
                                      VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Style="{StaticResource GraftComboBoxToggleStyle}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding SelectionBoxItem}" />
                            <Border x:Name="FocusRing"
                                    BorderBrush="{DynamicResource Accent}"
                                    BorderThickness="{DynamicResource FocusRingBorderThickness}"
                                    IsHitTestVisible="False" Opacity="0" />
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="None">
                                <Border Background="{DynamicResource BgElevated}"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 8.8: アクセント色の細い不確定プログレスバー。 -->
        <Style x:Key="GraftBusyBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="2" />
            <Setter Property="IsIndeterminate" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0" Style="{StaticResource GraftBusyBarStyle}"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

        <StackPanel Grid.Row="1" Margin="16,12,16,8">
            <TextBlock Text="コンテキスト収集" FontSize="{DynamicResource PaneHeadingFontSize}"
                       FontWeight="{DynamicResource PaneHeadingFontWeight}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="収集モード" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedValue="{Binding SelectedMode}"
                          SelectedValuePath="Mode" DisplayMemberPath="Label" MaxWidth="220" HorizontalAlignment="Left"
                          AutomationProperties.Name="収集モード" TabIndex="0" />
                <TextBlock Grid.Column="2" Text="対象リビジョン" VerticalAlignment="Center" Margin="16,0,8,0"
                           Visibility="{Binding ShowRevisionPicker, Converter={StaticResource BoolToVis}}" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}"
                          DisplayMemberPath="DisplayText" MaxWidth="260" HorizontalAlignment="Left"
                          AutomationProperties.Name="差分の基準リビジョン" TabIndex="1"
                          Visibility="{Binding ShowRevisionPicker, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <Border Margin="0,10,0,0" BorderBrush="{DynamicResource StateError}" BorderThickness="1" Padding="8"
                    Visibility="{Binding ErrorIssue, Converter={StaticResource NullToVis}}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource StateError}"
                           Text="{Binding ErrorIssue, Converter={StaticResource IssueToText}}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="ファイル" FontSize="{DynamicResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                <Grid>
                    <ListBox x:Name="FileListBox" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                             AutomationProperties.Name="ファイル一覧" TabIndex="2"
                             Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Space" Command="{Binding ToggleSelectedCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ContextFileNodeViewModel}">
                                <StackPanel Orientation="Horizontal"
                                            Margin="{Binding IndentLevel, Converter={StaticResource IndentToMargin}}"
                                            AutomationProperties.Name="{Binding AutomationLabel}">
                                    <Path Data="{StaticResource IconFolderGeometry}" Style="{StaticResource IconPathStyle}"
                                          Width="14" Height="14" Margin="0,0,4,0"
                                          Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
                                    <Path Data="{StaticResource IconAlertTriangleGeometry}" Style="{StaticResource IconPathStyle}"
                                          Width="14" Height="14" Margin="0,0,4,0" Stroke="{DynamicResource StateWarn}"
                                          ToolTip="{Binding ExcludeReason}"
                                          Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVis}}" />
                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}"
                                              AutomationProperties.Name="{Binding AutomationLabel}"
                                              Visibility="{Binding IsDirectory, Converter={StaticResource InverseBoolToVis}}">
                                        <CheckBox.IsEnabled>
                                            <MultiBinding Converter="{StaticResource FileCheckEnabled}">
                                                <Binding Path="IsExcluded" />
                                                <Binding Path="DataContext.ShowFileTree"
                                                         RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </CheckBox.IsEnabled>
                                    </CheckBox>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconFolderGeometry}" Style="{StaticResource IconPathStyle}"
                              Width="32" Height="32" Opacity="0.4" HorizontalAlignment="Center" />
                        <TextBlock Text="対象ファイルがありません" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" />

            <DockPanel Grid.Column="2" Margin="8,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="追加の除外パターン（プロジェクト単位）"
                           FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewExcludePattern, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="追加する除外パターン" TabIndex="3" />
                    <Button Grid.Column="1" Content="追加" Command="{Binding AddExcludeCommand}" Margin="6,0,0,0"
                            AutomationProperties.Name="除外パターンを追加" TabIndex="4" />
                </Grid>
                <ListBox ItemsSource="{Binding ExtraExcludes}" AutomationProperties.Name="プロジェクト単位の除外パターン一覧" TabIndex="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="削除"
                                        Command="{Binding DataContext.RemoveExcludeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExceedsWarnThreshold}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource StateWarn}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding EstimatedTokens, StringFormat=推定トークン数: {0} 件}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="{DynamicResource CaptionFontSize}" />
            </StackPanel>
            <Button Grid.Column="1" Content="プレビュー" Command="{Binding PreviewCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="推定トークン数をプレビュー" TabIndex="6" />
            <Button Grid.Column="2" Content="コピー" Command="{Binding CopyCommand}"
                    AutomationProperties.Name="コンテキストをクリップボードへコピー" TabIndex="7" />
        </Grid>
    </Grid>
</Window>
