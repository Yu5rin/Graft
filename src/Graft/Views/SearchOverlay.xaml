<UserControl x:Class="Graft.Views.SearchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             Margin="0,8,20,0"
             PreviewKeyDown="OnPreviewKeyDown"
             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
             AutomationProperties.Name="検索・置換"
             d:DesignWidth="380">
    <!--
        4.4 検索・置換オーバーレイ。AvalonEdit標準のSearchPanelは使わず自前実装する
        （テーマ・日本語文言を制御できないため）。エディタ領域に浮かせて配置することを
        想定し、本コントロール自身は右上寄せのレイアウトのみを持つ。実際の配置
        （EditorPane側のGridへの重ね置き）は統合担当が行う。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 正規表現・大文字小文字区別・単語単位のトグル。専用アイコンは無いため短い文字で表す。 -->
        <Style x:Key="SearchToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelected}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BgElevated}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            Padding="8">
        <StackPanel>
            <!-- ========== 検索行 ========== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0"
                              IsChecked="{Binding IsReplaceMode, Mode=OneWay}"
                              Command="{Binding ToggleReplaceModeCommand}"
                              Style="{StaticResource SearchToggleButtonStyle}"
                              AutomationProperties.Name="置換欄の表示切り替え">
                    <Path x:Name="ReplaceToggleIcon" Width="12" Height="12">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource IconPathStyle}">
                                <Setter Property="Data" Value="{StaticResource IconChevronRightGeometry}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReplaceMode}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconChevronDownGeometry}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </ToggleButton>

                <TextBox x:Name="FindBox"
                         Grid.Column="1"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnFindBoxKeyDown"
                         AutomationProperties.Name="検索文字列" />

                <ToggleButton Grid.Column="2"
                              IsChecked="{Binding UseRegex, Mode=OneWay}"
                              Command="{Binding ToggleRegexCommand}"
                              Content=".*"
                              Style="{StaticResource SearchToggleButtonStyle}"
                              ToolTip="正規表現を使用"
                              AutomationProperties.Name="正規表現を使用" />
                <ToggleButton Grid.Column="3"
                              IsChecked="{Binding CaseSensitive, Mode=OneWay}"
                              Command="{Binding ToggleCaseCommand}"
                              Content="Aa"
                              Style="{StaticResource SearchToggleButtonStyle}"
                              ToolTip="大文字と小文字を区別"
                              AutomationProperties.Name="大文字と小文字を区別" />
                <ToggleButton Grid.Column="4"
                              IsChecked="{Binding WholeWord, Mode=OneWay}"
                              Command="{Binding ToggleWholeWordCommand}"
                              Content="ab"
                              Style="{StaticResource SearchToggleButtonStyle}"
                              ToolTip="単語単位で検索"
                              AutomationProperties.Name="単語単位で検索" />

                <TextBlock Grid.Column="6"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="6,0"
                           FontSize="{DynamicResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondary}"
                           AutomationProperties.Name="検索結果件数"
                           AutomationProperties.LiveSetting="Polite" />

                <Button Grid.Column="7"
                        Command="{Binding FindPreviousCommand}"
                        Style="{StaticResource SearchIconButtonStyle}"
                        ToolTip="前の一致へ移動"
                        AutomationProperties.Name="前の一致へ移動">
                    <Path Data="{StaticResource IconChevronRightGeometry}"
                          Style="{StaticResource IconPathStyle}" Width="12" Height="12"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="180" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
                <Button Grid.Column="8"
                        Command="{Binding FindNextCommand}"
                        Style="{StaticResource SearchIconButtonStyle}"
                        ToolTip="次の一致へ移動"
                        AutomationProperties.Name="次の一致へ移動">
                    <Path Data="{StaticResource IconChevronRightGeometry}" Style="{StaticResource IconPathStyle}" Width="12" Height="12" />
                </Button>
                <Button Grid.Column="9"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource SearchIconButtonStyle}"
                        ToolTip="検索を閉じる"
                        AutomationProperties.Name="検索を閉じる">
                    <Path Data="{StaticResource IconXGeometry}" Style="{StaticResource IconPathStyle}" Width="12" Height="12" />
                </Button>
            </Grid>

            <!-- ========== 置換行（IsReplaceModeのときのみ表示） ========== -->
            <Grid Margin="0,6,0,0" Visibility="{Binding IsReplaceMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="26" />

                <TextBox x:Name="ReplaceBox"
                         Grid.Column="1"
                         Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnReplaceBoxKeyDown"
                         AutomationProperties.Name="置換文字列" />

                <Button Grid.Column="2"
                        Command="{Binding ReplaceCommand}"
                        Content="置換"
                        Margin="4,0,0,0"
                        AutomationProperties.Name="この一致を置換" />
                <Button Grid.Column="3"
                        Command="{Binding ReplaceAllCommand}"
                        Content="すべて置換"
                        Margin="4,0,0,0"
                        AutomationProperties.Name="すべて置換" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
