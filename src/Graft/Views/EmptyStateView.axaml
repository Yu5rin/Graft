<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Graft.Views"
             x:Class="Graft.Views.EmptyStateView"
             x:Name="Root"
             Focusable="False">
    <!--
        8.8 状態表現: 空・読み込み中・エラーの3状態を1つの再利用可能な部品で表現する。
        一覧・ペイン側は本体のリストと同じGridセルにこのコントロールを重ねて使う想定。
        State=None のときは3つのパネルすべてを隠し、リスト本体をそのまま見せる。

        v2.0のWPF版からの差分: AvaloniaにVisibilityは無いためIsVisible（bool）で制御する。
        ElementNameによるバインドは「#名前」を使う（Binding ..., ElementName=Root と等価）。
    -->
    <Grid>
        <!-- 読み込み中: ペイン上端の細い不確定プログレスバー（8.8）。200ms未満は表示しない。 -->
        <ProgressBar x:Name="LoadingBar"
                     IsIndeterminate="True"
                     Height="2"
                     VerticalAlignment="Top"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource Accent}"
                     IsVisible="False"
                     AutomationProperties.Name="読み込み中" />

        <!-- 空状態: 中央に薄いアイコンと1行の説明、主要アクション1つ（8.8）。 -->
        <StackPanel x:Name="EmptyPanel"
                    IsVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="280">
            <!--
                #68担当からの申し送り（配色コントラスト点検）対応: このOpacityは
                Stroke=TextSecondaryへ乗算されるため、#68で色トークン自体を直したあとも
                実効コントラストが1.9〜3.0程度にしか届いていなかった（アイコンは
                「情報を持たない装飾」ではなく空状態の意味を視覚的に示す要素のため、
                本文と同程度の可読性が要る）。アイコンを薄く見せる意図は保ったまま、
                0.45→0.65へ引き上げて9テーマ全体で3:1以上になるようにした
                （#68側のテーマ修正コメントに合わせた目安値）。
            -->
            <views:IconGlyph Data="{Binding IconGeometry, ElementName=Root}"
                             Width="32" Height="32"
                             Opacity="0.65"
                             Stroke="{DynamicResource TextSecondary}"
                             HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Message, ElementName=Root}"
                       Margin="0,12,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource BodyFontSize}" />
            <Button x:Name="ActionButton"
                    Content="{Binding ActionText, ElementName=Root}"
                    AutomationProperties.Name="{Binding ActionText, ElementName=Root}"
                    Command="{Binding ActionCommand, ElementName=Root}"
                    views:HelpTip.Standard="{Binding ActionTooltip, ElementName=Root}"
                    views:HelpTip.Detailed="{Binding ActionTooltipDetailed, ElementName=Root}"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    IsVisible="False" />

            <!-- 副次アクション（例: 4.1「ファイルから解析」）。主要アクションの下に控えめに置く。 -->
            <Button x:Name="SecondaryActionButton"
                    Content="{Binding SecondaryActionText, ElementName=Root}"
                    AutomationProperties.Name="{Binding SecondaryActionText, ElementName=Root}"
                    Command="{Binding SecondaryActionCommand, ElementName=Root}"
                    views:HelpTip.Standard="{Binding SecondaryActionTooltip, ElementName=Root}"
                    views:HelpTip.Detailed="{Binding SecondaryActionTooltipDetailed, ElementName=Root}"
                    Background="Transparent"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    IsVisible="False" />
        </StackPanel>

        <!--
            エラー状態: 赤い帯ではなく、アイコン＋エラーコード＋対処方法のインライン表示（8.8）。
            色だけに依存しないよう x-circle アイコン（形状）とテキストを併用する（8.14）。
        -->
        <StackPanel x:Name="ErrorPanel"
                    IsVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="360">
            <views:IconGlyph Data="{DynamicResource IconXCircleGeometry}"
                             Width="28" Height="28"
                             Stroke="{DynamicResource StateError}"
                             HorizontalAlignment="Center" />
            <TextBlock x:Name="ErrorSummaryText"
                       Margin="0,12,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="{DynamicResource BodyFontSize}" />
            <TextBlock x:Name="ErrorRemedyText"
                       Margin="0,4,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource CaptionFontSize}" />
        </StackPanel>
    </Grid>
</UserControl>
