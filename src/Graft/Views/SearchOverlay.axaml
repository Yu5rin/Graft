<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Graft.Views"
             x:Class="Graft.Views.SearchOverlay"
             Focusable="False"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             Margin="0,8,20,0"
             IsVisible="{Binding IsOpen, FallbackValue=False}"
             AutomationProperties.Name="検索・置換">
    <!--
        4.4 検索・置換オーバーレイ。AvaloniaEdit標準のSearchPanelは使わず自前実装する
        （テーマ・日本語文言を制御できないため）。エディタ領域に浮かせて配置する。

        v2.0のWPF版からの差分:
        - Visibility は IsVisible（bool）へ。DataContextが未設定のうちは
          FallbackValue=False で隠しておく（Attach前に一瞬表示されるのを防ぐ）。
        - トグルボタンのControlTemplateは差し替えず、疑似クラスのStyleで配色を与える。
    -->
    <UserControl.Styles>
        <!-- 正規表現・大文字小文字区別・単語単位のトグル。専用アイコンは無いため短い文字で表す。 -->
        <Style Selector="ToggleButton.searchToggle">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.searchToggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="ToggleButton.searchToggle:checked">
            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="Button.searchIcon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource BgElevated}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            Padding="8">
        <StackPanel>
            <!-- ========== 検索行 ========== -->
            <Grid ColumnDefinitions="Auto,180,Auto,Auto,Auto,Auto,70,Auto,Auto,Auto">

                <ToggleButton Grid.Column="0" Classes="searchToggle"
                              IsChecked="{Binding IsReplaceMode, Mode=OneWay}"
                              Command="{Binding ToggleReplaceModeCommand}"
                              AutomationProperties.Name="置換欄の表示切り替え"
                              views:HelpTip.Standard="下に置換用の入力欄を出します（このファイル内だけの置換）。"
                              views:HelpTip.Detailed="クリックすると下に置換文字列の入力欄が現れ、開いているこのファイルの中だけで文字列を置き換えられるようになります。複数ファイルをまとめて置換したい場合は、サイドバーの「検索」（虫眼鏡アイコン、Ctrl+Shift+F）を使ってください。">
                    <Panel>
                        <views:IconGlyph Width="12" Height="12"
                                         Data="{DynamicResource IconChevronRightGeometry}"
                                         IsVisible="{Binding !IsReplaceMode}" />
                        <views:IconGlyph Width="12" Height="12"
                                         Data="{DynamicResource IconChevronDownGeometry}"
                                         IsVisible="{Binding IsReplaceMode}" />
                    </Panel>
                </ToggleButton>

                <TextBox x:Name="FindBox"
                         Grid.Column="1"
                         Text="{Binding Query}"
                         KeyDown="OnFindBoxKeyDown"
                         AutomationProperties.Name="検索文字列"
                         views:HelpTip.Standard="開いているこのファイルの中だけを検索する文字列です。Enterで次の一致へ移動します。"
                         views:HelpTip.Detailed="今エディタで開いているファイルの中だけを検索します（Ctrl+Fでこの欄にフォーカスします）。入力すると一致箇所が数えられ、Enterキーまたは右側の矢印アイコンで次・前の一致へ移動できます。プロジェクト全体を横断して検索したい場合は、サイドバーの「検索」（虫眼鏡アイコン、Ctrl+Shift+F）を使ってください。" />

                <ToggleButton Grid.Column="2" Classes="searchToggle"
                              IsChecked="{Binding UseRegex, Mode=OneWay}"
                              Command="{Binding ToggleRegexCommand}"
                              Content=".*"
                              views:HelpTip.Standard="正規表現を使用"
                              views:HelpTip.Detailed="検索文字列を正規表現（パターンで文字列を指定する記法）として解釈します。オンにすると「\d+」で数字の連続を探す、といった柔軟な検索ができます。使い方が分からない場合はオフのままで構いません（入力した文字列そのままを検索します）。"
                              AutomationProperties.Name="正規表現を使用" />
                <ToggleButton Grid.Column="3" Classes="searchToggle"
                              IsChecked="{Binding CaseSensitive, Mode=OneWay}"
                              Command="{Binding ToggleCaseCommand}"
                              Content="Aa"
                              views:HelpTip.Standard="大文字と小文字を区別"
                              views:HelpTip.Detailed="オンにすると、検索文字列の大文字・小文字を区別して探します（例: 「Name」と「name」を別の文字列として扱う）。オフのとき（既定）は大文字・小文字を区別せずに探します。"
                              AutomationProperties.Name="大文字と小文字を区別" />
                <ToggleButton Grid.Column="4" Classes="searchToggle"
                              IsChecked="{Binding WholeWord, Mode=OneWay}"
                              Command="{Binding ToggleWholeWordCommand}"
                              Content="ab"
                              views:HelpTip.Standard="単語単位で検索"
                              views:HelpTip.Detailed="オンにすると、検索文字列が単語として独立している箇所だけを探します（例: 「cat」で検索したとき「category」の一部には一致しません）。他の単語の一部を誤ってヒットさせたくないときに使います。"
                              AutomationProperties.Name="単語単位で検索" />

                <TextBlock Grid.Column="6"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="6,0"
                           FontSize="{DynamicResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondary}"
                           AutomationProperties.Name="検索結果件数"
                           AutomationProperties.LiveSetting="Polite" />

                <Button Grid.Column="7" Classes="searchIcon"
                        Command="{Binding FindPreviousCommand}"
                        views:HelpTip.Standard="前の一致へ移動"
                        views:HelpTip.Detailed="今見ている一致箇所から、1つ前の一致箇所へカーソルを移動します。Shift+Enterでも同じ操作ができます。"
                        AutomationProperties.Name="前の一致へ移動">
                    <views:IconGlyph Data="{DynamicResource IconChevronRightGeometry}"
                                     Width="12" Height="12"
                                     RenderTransformOrigin="50%,50%">
                        <views:IconGlyph.RenderTransform>
                            <RotateTransform Angle="180" />
                        </views:IconGlyph.RenderTransform>
                    </views:IconGlyph>
                </Button>
                <Button Grid.Column="8" Classes="searchIcon"
                        Command="{Binding FindNextCommand}"
                        views:HelpTip.Standard="次の一致へ移動"
                        views:HelpTip.Detailed="今見ている一致箇所から、次の一致箇所へカーソルを移動します。検索欄でEnterキーを押しても同じ操作ができます。"
                        AutomationProperties.Name="次の一致へ移動">
                    <views:IconGlyph Data="{DynamicResource IconChevronRightGeometry}" Width="12" Height="12" />
                </Button>
                <Button Grid.Column="9" Classes="searchIcon"
                        Command="{Binding CloseCommand}"
                        views:HelpTip.Standard="検索を閉じる"
                        views:HelpTip.Detailed="このファイル内検索バーを閉じ、エディタでの編集に戻ります。キーボードのEscキーでも閉じられます。"
                        AutomationProperties.Name="検索を閉じる">
                    <views:IconGlyph Data="{DynamicResource IconXGeometry}" Width="12" Height="12" />
                </Button>
            </Grid>

            <!-- ========== 置換行（IsReplaceModeのときのみ表示） ========== -->
            <Grid Margin="0,6,0,0" IsVisible="{Binding IsReplaceMode}"
                  ColumnDefinitions="Auto,180,Auto,Auto">

                <Border Grid.Column="0" Width="26" />

                <TextBox x:Name="ReplaceBox"
                         Grid.Column="1"
                         Text="{Binding ReplaceText}"
                         KeyDown="OnReplaceBoxKeyDown"
                         AutomationProperties.Name="置換文字列"
                         views:HelpTip.Standard="上の検索文字列を、この文字列に置き換えます。「置換」または「すべて置換」を押すまでファイルは変わりません。"
                         views:HelpTip.Detailed="上で検索した文字列を、この文字列に置き換えます。入力しただけではまだ何も変わらず、右の「置換」（今カーソルがある1件だけ）または「すべて置換」（このファイル内の全ての一致）を押した時点で書き換わります。書き込み後は通常のCtrl+Zで元に戻せます。" />

                <Button Grid.Column="2"
                        Command="{Binding ReplaceCommand}"
                        Content="置換"
                        Margin="4,0,0,0"
                        AutomationProperties.Name="この一致を置換"
                        views:HelpTip.Standard="今カーソルがある1件の一致だけを置換文字列に置き換えます。"
                        views:HelpTip.Detailed="現在選択中の1つの一致箇所だけを、上の置換文字列に置き換えます。置き換えたあとは自動的に次の一致箇所へ移動するので、1件ずつ確認しながら進めたいときに使います。" />
                <Button Grid.Column="3"
                        Command="{Binding ReplaceAllCommand}"
                        Content="すべて置換"
                        Margin="4,0,0,0"
                        AutomationProperties.Name="すべて置換"
                        views:HelpTip.Standard="このファイル内の一致箇所すべてを、置換文字列に一括で置き換えます。"
                        views:HelpTip.Detailed="今開いているファイルの中で検索条件に一致する箇所を、すべて一括で置換文字列に置き換えます。確認ダイアログなしで即座に書き換わるため、意図した検索条件になっているかをよく確認してから押してください。書き込み後はCtrl+Zで元に戻せます。" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
