<!--
    設定画面の各タブ（SettingsPanels配下のUserControl）が共通で使うスタイルとコンバータ。

    各タブはSettingsWindow.xamlとは別にコンパイルされるUserControlであり、StaticResourceは
    そのUserControl自身のInitializeComponent実行時点（＝まだSettingsWindowの論理ツリーに
    接続される前）に解決される。そのためSettingsWindow.xamlのWindow.Resourcesで定義した
    スタイルをタブ側からStaticResourceで参照すると、実行時に
    'System.Windows.StaticResourceExtension' の値の指定時に例外がスローされる。
    この辞書を各タブとSettingsWindow自身の両方からMergedDictionariesで取り込むことで解決する。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:Graft.Views">


    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Width" Value="200" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FieldRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource PaneHeadingFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource PaneHeadingFontWeight}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

</ResourceDictionary>
