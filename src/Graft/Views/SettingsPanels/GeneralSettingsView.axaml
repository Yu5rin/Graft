<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Graft.Views"
             x:Class="Graft.Views.SettingsPanels.GeneralSettingsView"
             AutomationProperties.Name="一般設定">
    <UserControl.Styles>
        <StyleInclude Source="avares://Graft/Views/SettingsPanels/SettingsPanelStyles.axaml" />
    </UserControl.Styles>
    <!--
        「一般」タブ: 表示（テーマ・フォント・文字の大きさ）／起動と常駐／キー の3つだけ。
        旧「一般」には適用・履歴・Git・コマンド・保存先・書き出しまで同居して約2000pxの縦長に
        なっていたため、適用と履歴に関わる項目は ApplySettingsView へ、ログレベルと設定の
        書き出し／読み込みは RawJsonSettingsView（詳細）へ、コマンドの制限時間は
        HookSettingsView へ移した（settings.jsonのキー・値・既定値は変えていない）。
    -->
    <!--
        書式（見出し → 項目[ラベル・1行の説明・入力]）は SettingsPanelStyles.axaml のクラス
        （settingItem/settingLabel/settingHint と narrow/medium/wide の幅3種）を全タブで共有する。
        入力欄の確定の仕方（ComboBox/CheckBoxは即時、TextBoxはフォーカスを外した時かEnter）は
        従来から変えていない（「100」を「50」に打ち替える途中の「10」が保存されてしまうのを防ぐため。
        ViewModelの保存の仕組みには触れていない）。
        ScrollViewer自身にPaddingを持たせず内側のStackPanelのMarginへ置くのは、AvaloniaのScrollViewerが
        PaddingをExtentの外側に適用して末尾要素が見切れる（実機で確認済み）ため。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,8,16,16">
            <TextBlock Text="表示" Classes="sectionHeading first" />
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="テーマ" Classes="settingLabel" />
                    <TextBlock Text="画面全体の配色です。「システム追従」はOSの設定に合わせます。" Classes="settingHint" />
                </StackPanel>
                <ComboBox Grid.Column="1" Classes="medium" ItemsSource="{Binding ThemeOptions}" SelectedValueBinding="{Binding Value}"
                          ItemTemplate="{StaticResource LabelItemTemplate}" SelectedValue="{Binding SelectedTheme}"
                          AutomationProperties.Name="テーマ"
                          views:HelpTip.Minimal="{Binding SelectedTheme, StringFormat='テーマ: {0}'}"
                          views:HelpTip.Standard="画面全体の配色を選びます。既定は「システム追従」です。"
                          views:HelpTip.Detailed="Graftの画面全体の配色を選びます。既定ライト・既定ダークに加え、セピア・GitHub風・Solarized Light/Dark・Nord・Dracula・Nightの計9種のプリセットから選べます。プリセットを選ぶとその配色に固定され、「システム追従」（既定）を選ぶとOSの設定（Windowsの「色」設定など）に応じて既定ライト/既定ダークが自動的に切り替わります（9つのプリセットへは追従しません）。見た目だけの設定で、ファイルの内容には一切影響しません。選んだ瞬間にその場で切り替わります。" />
            </Grid>
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="操作の説明" Classes="settingLabel" />
                    <TextBlock Text="ボタンなどにカーソルを合わせたときに出る説明の詳しさです。" Classes="settingHint" />
                </StackPanel>
                <ComboBox Grid.Column="1" Classes="medium" ItemsSource="{Binding TooltipDetailOptions}" SelectedValueBinding="{Binding Value}"
                          ItemTemplate="{StaticResource LabelItemTemplate}" SelectedValue="{Binding SelectedTooltipDetail}"
                          AutomationProperties.Name="操作の説明"
                          views:HelpTip.Minimal="{Binding SelectedTooltipDetail, StringFormat='操作の説明: {0}'}"
                          views:HelpTip.Standard="ボタンなどにカーソルを合わせたときに出る説明の詳しさを選びます。既定は「標準の説明」です。"
                          views:HelpTip.Detailed="画面上のボタンやチェックボックスにマウスを乗せたときに出る、この吹き出し説明の詳しさを選びます。「表示しない」は吹き出しを一切出さず、「最低限」は今その項目に入っている値だけを一言で示し、「標準の説明」（既定）は1文の短い説明、「くわしい説明」は初めて使う人向けに噛み砕いた長い説明を出します。ここで選んだ瞬間、開いている画面全体の説明がその場で切り替わります（アプリの再起動は不要）。" />
            </Grid>
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="画面のフォント" Classes="settingLabel" />
                    <TextBlock Text="メニュー・ボタン・一覧など、画面の文字に使います。" Classes="settingHint" />
                </StackPanel>
                <ComboBox Grid.Column="1" Classes="wide" IsVisible="{Binding HasFontFamilyOptions}"
                          ItemsSource="{Binding FontFamilyOptions}" SelectedValueBinding="{Binding Value}"
                          ItemTemplate="{StaticResource FontChoiceItemTemplate}"
                          SelectedValue="{Binding SelectedFontFamily}"
                          AutomationProperties.Name="UIフォント"
                          views:HelpTip.Minimal="{Binding SelectedFontFamily, StringFormat='UIフォント: {0}'}"
                          views:HelpTip.Standard="メニュー・ボタン・一覧など、画面全体のUIの文字に使うフォントを選びます。既定は「(既定)」（アプリの既定フォント）です。"
                          views:HelpTip.Detailed="メニュー・ボタン・タブの一覧・設定画面など、画面全体のUIの文字に使うフォントを、OSにインストール済みのフォントから選びます。「(既定)」を選ぶとアプリの既定フォント（プラットフォームごとのフォールバック列）に戻ります。選んだ瞬間にその場で画面へ反映されます。取扱説明書やMarkdownプレビューの地の文（見出し・段落・箇条書きなど）には、この欄ではなく下の「本文フォント」が使われます。コード表示に使うフォントは別枠の「等幅フォント」で選びます。" />
                <TextBox Grid.Column="1" Classes="wide" IsVisible="{Binding !HasFontFamilyOptions}"
                         Text="{Binding SelectedFontFamily, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="UIフォント（手入力）"
                         views:HelpTip.Minimal="{Binding SelectedFontFamily, StringFormat='UIフォント: {0}'}"
                         views:HelpTip.Standard="このOS環境ではインストール済みフォントの一覧を取得できなかったため、フォント名を直接入力する形になっています。空欄なら既定のフォントを使います。"
                         views:HelpTip.Detailed="OSにインストール済みのフォントを列挙できなかった環境向けのフォールバックです（本来は一覧から選ぶ形ですが、列挙に失敗した場合だけこの入力欄に切り替わります）。入力したフォント名が実際にはインストールされていない場合、アプリの既定フォントで表示されます。空欄にすると既定のフォントに戻ります。" />
            </Grid>
            <TextBlock Text="プレビュー: あア亜 Aa Bb Cc 0123" Classes="fieldHint" Margin="0,-4,0,10" FontSize="{DynamicResource PreviewSampleFontSize}"
                       Foreground="{DynamicResource TextPrimary}"
                       FontFamily="{Binding SelectedFontFamily, Converter={x:Static views:Converters.FontFamilyOrDefault}}"
                       AutomationProperties.Name="UIフォントのプレビュー" />
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="本文フォント" Classes="settingLabel" />
                    <TextBlock Text="取扱説明書や Markdown プレビューの文章に使います。" Classes="settingHint" />
                </StackPanel>
                <ComboBox Grid.Column="1" Classes="wide" IsVisible="{Binding HasFontFamilyOptions}"
                          ItemsSource="{Binding FontFamilyOptions}" SelectedValueBinding="{Binding Value}"
                          ItemTemplate="{StaticResource FontChoiceItemTemplate}"
                          SelectedValue="{Binding SelectedBodyTextFontFamily}"
                          AutomationProperties.Name="本文フォント"
                          views:HelpTip.Minimal="{Binding SelectedBodyTextFontFamily, StringFormat='本文フォント: {0}'}"
                          views:HelpTip.Standard="取扱説明書とMarkdownプレビューの地の文に使うフォントを選びます。既定は「(既定)」（UIフォントと同じ既定フォント）です。"
                          views:HelpTip.Detailed="取扱説明書とMarkdownプレビューの地の文（見出し・段落・箇条書き・表など）に使うフォントを、OSにインストール済みのフォントから選びます。「(既定)」を選ぶとアプリの既定フォント（上の「UIフォント」と同じフォールバック列）に戻ります。選んだ瞬間にその場で画面へ反映されます。コードブロック・インラインコードはこの欄の影響を受けず、常に「等幅フォント」の設定に従います。すでに「UIフォント」に好みのフォントを設定している場合、その設定は引き続きメニュー・ボタン・一覧などUI全体に効きますが、取扱説明書やMarkdownプレビューの地の文には効かなくなるため、両方に同じフォントを使いたいときはこちらにも同じものを選んでください。" />
                <TextBox Grid.Column="1" Classes="wide" IsVisible="{Binding !HasFontFamilyOptions}"
                         Text="{Binding SelectedBodyTextFontFamily, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="本文フォント（手入力）"
                         views:HelpTip.Minimal="{Binding SelectedBodyTextFontFamily, StringFormat='本文フォント: {0}'}"
                         views:HelpTip.Standard="このOS環境ではインストール済みフォントの一覧を取得できなかったため、フォント名を直接入力する形になっています。空欄なら既定のフォントを使います。"
                         views:HelpTip.Detailed="OSにインストール済みのフォントを列挙できなかった環境向けのフォールバックです（本来は一覧から選ぶ形ですが、列挙に失敗した場合だけこの入力欄に切り替わります）。入力したフォント名が実際にはインストールされていない場合、アプリの既定フォントで表示されます。空欄にすると既定のフォントに戻ります。" />
            </Grid>
            <TextBlock Text="プレビュー: あア亜 Aa Bb Cc 0123" Classes="fieldHint" Margin="0,-4,0,10" FontSize="{DynamicResource PreviewSampleFontSize}"
                       Foreground="{DynamicResource TextPrimary}"
                       FontFamily="{Binding SelectedBodyTextFontFamily, Converter={x:Static views:Converters.FontFamilyOrDefault}}"
                       AutomationProperties.Name="本文フォントのプレビュー" />
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="コード用のフォント（等幅）" Classes="settingLabel" />
                    <TextBlock Text="エディタや差分など、コードの表示に使います。" Classes="settingHint" />
                </StackPanel>
                <ComboBox Grid.Column="1" Classes="wide" IsVisible="{Binding HasMonospaceFontFamilyOptions}"
                          ItemsSource="{Binding MonospaceFontFamilyOptions}" SelectedValueBinding="{Binding Value}"
                          ItemTemplate="{StaticResource FontChoiceItemTemplate}"
                          SelectedValue="{Binding SelectedMonospaceFontFamily}"
                          AutomationProperties.Name="等幅フォント"
                          views:HelpTip.Minimal="{Binding SelectedMonospaceFontFamily, StringFormat='等幅フォント: {0}'}"
                          views:HelpTip.Standard="コードエディタやコードブロックの表示に使う等幅フォントを選びます。既定は「(既定)」（アプリの既定フォント）です。"
                          views:HelpTip.Detailed="コードエディタ（中央のエディタ領域）や、Markdownプレビュー・diff表示・JSON編集タブなど「コード扱い」の文字に使うフォントを、OSにインストール済みの等幅フォントから選びます。等幅かどうかはフォント自身が持つメタデータ、またはそれが無い場合は「i」と「W」の描画幅の比較で判定しています。「(既定)」を選ぶとアプリの既定の等幅フォントに戻ります。選んだ瞬間にエディタ側の表示もその場で切り替わります。上の「本文フォント」とは別枠の設定です。" />
                <TextBox Grid.Column="1" Classes="wide" IsVisible="{Binding !HasMonospaceFontFamilyOptions}"
                         Text="{Binding SelectedMonospaceFontFamily, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="等幅フォント（手入力）"
                         views:HelpTip.Minimal="{Binding SelectedMonospaceFontFamily, StringFormat='等幅フォント: {0}'}"
                         views:HelpTip.Standard="このOS環境ではインストール済みフォントの一覧を取得できなかったため、フォント名を直接入力する形になっています。空欄なら既定のフォントを使います。"
                         views:HelpTip.Detailed="OSにインストール済みのフォントを列挙できなかった環境向けのフォールバックです（本来は一覧から選ぶ形ですが、列挙に失敗した場合だけこの入力欄に切り替わります）。入力したフォント名が実際にはインストールされていない場合、アプリの既定フォントで表示されます。空欄にすると既定のフォントに戻ります。" />
            </Grid>
            <TextBlock Text="プレビュー: あア亜 Aa Bb Cc 0123" Classes="fieldHint" Margin="0,-4,0,8" FontSize="{DynamicResource PreviewSampleFontSize}"
                       Foreground="{DynamicResource TextPrimary}"
                       FontFamily="{Binding SelectedMonospaceFontFamily, Converter={x:Static views:Converters.FontFamilyOrDefault}}"
                       AutomationProperties.Name="等幅フォントのプレビュー" />
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="エディタの文字の大きさ" Classes="settingLabel" />
                    <TextBlock Text="コードの文字の大きさです。エディタ上で Ctrl+マウスホイールでも変えられます。" Classes="settingHint" />
                </StackPanel>
                <TextBox Grid.Column="1" Classes="narrow" Text="{Binding EditorFontSizeText, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="エディタのフォントサイズ"
                         views:HelpTip.Minimal="{Binding EditorFontSizeText, StringFormat='フォントサイズ: {0}'}"
                         views:HelpTip.Standard="コード表示の文字の大きさです。既定は13です。エディタ上でCtrl+マウスホイールでも変更できます。"
                         views:HelpTip.Detailed="中央のエディタ領域に表示するコードの文字サイズ（pt）です。既定は13です。エディタの上にカーソルを置いてCtrlキーを押しながらマウスホイールを回しても同じように変更でき、そちらで変えた値もここへ反映されます。表示だけの設定でファイルの内容には影響しません。" />
            </Grid>
            <TextBlock Text="起動と常駐" Classes="sectionHeading" />
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="ウィンドウを閉じたとき" Classes="settingLabel" />
                    <TextBlock Text="×で閉じたときに、アプリを終了するか、タスクトレイに残すかを選びます。" Classes="settingHint" />
                </StackPanel>
                <ComboBox Grid.Column="1" Classes="medium" ItemsSource="{Binding CloseBehaviorOptions}" SelectedValueBinding="{Binding Value}"
                          ItemTemplate="{StaticResource LabelItemTemplate}" SelectedValue="{Binding CloseBehavior}"
                          AutomationProperties.Name="ウィンドウを閉じたときの動作"
                          views:HelpTip.Minimal="{Binding CloseBehavior, StringFormat='ウィンドウを閉じたときの動作: {0}'}"
                          views:HelpTip.Standard="×ボタンでウィンドウを閉じたときの動作を選びます。「終了する」ならアプリごと終了し、「タスクトレイに常駐する」ならウィンドウを隠すだけで動作を続けます。"
                          views:HelpTip.Detailed="ウィンドウ右上の×ボタンを押したときの挙動を選びます。「終了する」（既定）を選ぶと、×を押した時点でGraftのプロセスごと終了します。「タスクトレイに常駐する」を選ぶと、×を押してもプロセスは終了せずウィンドウが隠れるだけになり、タスクトレイのアイコンの「開く」で再表示、「終了」で完全に終了できます。クリップボード監視やホットキー貼り付けをすぐ使えるよう、常に起動しておきたいときに使います。お使いの環境がタスクトレイに対応していない場合は、この選択肢自体が表示されません（×で閉じると常に終了します）。" />
            </Grid>
            <TextBlock Text="このデスクトップ環境ではタスクトレイに対応していないため、常駐は選べません。×で閉じると終了します。"
                       Classes="fieldHint" IsVisible="{Binding !IsTraySupported}"
                       TextWrapping="Wrap" />
            <CheckBox Classes="settingRow hinted" Content="最小化でタスクトレイへ格納する" IsChecked="{Binding MinimizeToTray}"
                      IsEnabled="{Binding IsTraySupported}"
                      AutomationProperties.Name="最小化でタスクトレイへ格納する"
                      views:HelpTip.Standard="オンにすると、ウィンドウを最小化した瞬間にタスクトレイへ格納されます。既定はオフで、通常のWindowsアプリと同じく最小化してもタスクバーには残ります。"
                      views:HelpTip.Detailed="オフ（既定）のときは、Windowsの通常の慣習どおり最小化してもタスクバーにアイコンが残り、タスクバーから元に戻せます。オンにすると、最小化した瞬間にウィンドウがタスクバーからも消え、タスクトレイのアイコン（左クリックまたは「開く」）からのみ復帰できるようになります。クリップボード監視やホットキー貼り付けをすぐ使えるよう常駐させつつ、タスクバーを占有したくない場合に使います。お使いの環境がタスクトレイに対応していない場合は、オンにしても実際には通常の最小化のままになります（この場合はチェックボックス自体が無効化されます）。" />
            <TextBlock Text="ウィンドウを最小化すると、タスクバーではなくタスクトレイにしまいます。" Classes="settingHint indented" />
            <TextBlock Text="このデスクトップ環境ではタスクトレイに対応していないため、最小化は常に通常の最小化になります。"
                       Classes="fieldHint" IsVisible="{Binding !IsTraySupported}"
                       TextWrapping="Wrap" />
            <CheckBox Classes="settingRow hinted" Content="PC起動時に自動で起動する" IsChecked="{Binding LaunchAtStartup}"
                      IsEnabled="{Binding IsAutoStartSupported}"
                      AutomationProperties.Name="PC起動時に自動で起動する"
                      views:HelpTip.Standard="オンにすると、PCの起動時にGraftが自動的に立ち上がるようになります。"
                      views:HelpTip.Detailed="オンにすると、次回以降PCを起動したときにGraftが自動的に立ち上がるようになります。レジストリは使わず、OS標準のスタートアップフォルダ（Windows）やXDG autostart（Linux）に登録する方式です。オフに戻すと登録は解除されます。登録・解除に失敗した場合は、その場でダイアログに理由が表示されます。" />
            <TextBlock Text="パソコンを起動したときに、Graft も自動で起動します。" Classes="settingHint indented" />
            <TextBlock Text="{Binding AutoStartUnsupportedReason}" Classes="fieldHint"
                       IsVisible="{Binding !IsAutoStartSupported}" TextWrapping="Wrap" />
            <TextBlock Text="キー" Classes="sectionHeading" />
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="グローバルホットキー" Classes="settingLabel" />
                    <TextBlock Text="他のアプリを使っているときでも、クリップボードの内容を Graft に取り込んで解析するキーです。" Classes="settingHint" />
                </StackPanel>
                <TextBox Grid.Column="1" Classes="medium" Text="{Binding Hotkey, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="グローバルホットキー"
                         views:HelpTip.Minimal="{Binding Hotkey, StringFormat='グローバルホットキー: {0}'}"
                         views:HelpTip.Standard="Graftがバックグラウンドにあっても、クリップボードの内容を貼り付けて解析するショートカットキーです。既定はCtrl+Alt+Vです。"
                         views:HelpTip.Detailed="他のアプリを操作していても、このキーを押すだけでクリップボードの内容をGraftへ渡して解析できるショートカットキーです（コマンドバーの「貼り付けて解析」ボタンと同じ動作）。既定は「Ctrl+Alt+V」です。「Ctrl+Shift+K」のように「+」区切りで入力し、フォーカスを外すかEnterで確定します。他のアプリと衝突する組み合わせを入力すると、Graft側では反応しないことがあります。" />
            </Grid>
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="依頼文コピーのホットキー" Classes="settingLabel" />
                    <TextBlock Text="AIへの依頼文をコピーするキーです。空欄にするとOS全体には登録しません。" Classes="settingHint" />
                </StackPanel>
                <TextBox Grid.Column="1" Classes="medium" Text="{Binding PromptHotkey, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         Watermark="空欄ならGraftの画面内だけ"
                         AutomationProperties.Name="依頼文コピーのホットキー"
                         views:HelpTip.Minimal="{Binding PromptHotkey, StringFormat='依頼文コピーのホットキー: {0}'}"
                         views:HelpTip.Standard="AIへの依頼文をコピーするOS全体のショートカットキーです。既定はCtrl+Shift+Cです。空欄にするとOS全体には登録せず、Graftの画面内だけで効きます。"
                         views:HelpTip.Detailed="他のアプリを操作していても、このキーを押すだけでAIへの依頼文（依頼文のテンプレート）をコピーできるショートカットキーです。既定は「Ctrl+Shift+C」ですが、ブラウザの開発者ツールなど他のアプリと衝突する場合は、別の組み合わせに変えるか、空欄にしてください。空欄にするとOS全体のキーとしては登録されず、Graftのウィンドウを操作しているときだけ同じ操作がCtrl+Shift+Cで効きます。「Ctrl+Alt+C」のように「+」区切りで入力し、フォーカスを外すかEnterで確定します。" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
