<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Graft.Views"
             x:Class="Graft.Views.SettingsPanels.DiffSettingsView"
             AutomationProperties.Name="差分の表示設定">
    <UserControl.Styles>
        <StyleInclude Source="avares://Graft/Views/SettingsPanels/SettingsPanelStyles.axaml" />
    </UserControl.Styles>
    <!--
        「差分の表示」タブ: 適用前のプレビューなどに出る差分の見え方だけ。旧「表示・コンテキスト」
        には差分・AIに渡す内容・新規ファイル・クリップボード監視が同居していたため、それぞれ
        ContextSettingsView／ApplySettingsView／ClipboardSettingsView へ分けた。
        エディタ自身の表示設定は EditorSettingsView（差分と同じ「折り返し」「空白」があるため、
        混同しないよう別タブにしている）。
    -->
    <!--
        書式（見出し → 項目[ラベル・1行の説明・入力]）は SettingsPanelStyles.axaml のクラス
        （settingItem/settingLabel/settingHint と narrow/medium/wide の幅3種）を全タブで共有する。
        入力欄の確定の仕方（ComboBox/CheckBoxは即時、TextBoxはフォーカスを外した時かEnter）は
        従来から変えていない（「100」を「50」に打ち替える途中の「10」が保存されてしまうのを防ぐため。
        ViewModelの保存の仕組みには触れていない）。
        ScrollViewer自身にPaddingを持たせず内側のStackPanelのMarginへ置くのは、AvaloniaのScrollViewerが
        PaddingをExtentの外側に適用して末尾要素が見切れる（実機で確認済み）ため。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,8,16,16">
            <TextBlock Text="並べ方と見え方" Classes="sectionHeading first" />
            <CheckBox Classes="settingRow hinted" Content="差分を左右に並べて表示する" IsChecked="{Binding SideBySide}"
                      AutomationProperties.Name="差分表示を左右並列にする"
                      views:HelpTip.Standard="変更前と変更後を左右に並べて表示します。オフにすると上下の統合表示になります。既定はオンです。"
                      views:HelpTip.Detailed="差分表示の既定の見せ方を選びます。オン（既定）では変更前のコードを左、変更後のコードを右に並べて表示し、対応する行が横に揃います。オフでは削除された行と追加された行を1つの流れの中に上下に並べて表示する統合表示になります。差分表示のヘッダーにある「並列」「統合」ボタンで、開いている画面ごとに一時的に切り替えることもでき、その選択はここへも自動的に反映されます。" />
            <TextBlock Text="変更前と変更後を左右に並べて表示します。オフにすると、上下に1列で表示（統合表示）します。" Classes="settingHint indented" />
            <CheckBox Classes="settingRow hinted" Content="長い行を折り返す" IsChecked="{Binding WordWrap}"
                      AutomationProperties.Name="長い行を折り返す"
                      views:HelpTip.Standard="差分表示で、1行が画面幅を超えるとき折り返して表示します。既定はオフです。"
                      views:HelpTip.Detailed="適用前の確認などの差分表示で、長い1行を横スクロールではなく折り返して表示するかどうかです。既定はオフです（エディタ側の折り返しは「エディタ」タブで別途設定します）。" />
            <TextBlock Text="1行が長いとき、横にスクロールせず折り返して表示します。" Classes="settingHint indented" />
            <CheckBox Classes="settingRow hinted" Content="空白文字を見えるようにする" IsChecked="{Binding ShowWhitespace}"
                      AutomationProperties.Name="空白文字を可視化する"
                      views:HelpTip.Standard="差分表示で、タブや行末の空白を記号で見えるようにします。既定はオフです。"
                      views:HelpTip.Detailed="適用前の確認などの差分表示で、タブ文字や行末の余分な空白を記号として可視化するかどうかです。既定はオフです（エディタ側の可視化は「エディタ」タブで別途設定します）。空白だけの変更差分に気付きやすくなります。" />
            <TextBlock Text="タブや行末の空白を、記号で見えるようにします。" Classes="settingHint indented" />
            <CheckBox Classes="settingRow hinted" Content="行番号を表示する" IsChecked="{Binding ShowLineNumbers}"
                      AutomationProperties.Name="行番号を表示する"
                      views:HelpTip.Standard="diff（差分）表示に行番号を表示します。既定はオンです。"
                      views:HelpTip.Detailed="適用前の確認などのdiff（差分）表示に行番号を表示するかどうかです（エディタ側の行番号は「エディタ」タブで別途設定します）。既定はオンです。" />
            <TextBlock Text="差分に行番号を表示します。" Classes="settingHint indented" />
            <CheckBox Classes="settingRow hinted" Content="コードを色分けする（シンタックスハイライト）" IsChecked="{Binding SyntaxEnabled}"
                      AutomationProperties.Name="シンタックスハイライトを有効にする"
                      views:HelpTip.Standard="コードの文法要素（キーワード・文字列など）を色分け表示します。既定はオンです。"
                      views:HelpTip.Detailed="オンにすると（既定）、エディタやdiff（差分）表示でコードのキーワード・文字列・コメントなどを言語ごとの文法に応じて色分けし、読みやすくします。オフにすると全て単色のプレーンテキストとして表示されます。表示だけの設定でファイルの内容には影響しません。" />
            <TextBlock Text="キーワードや文字列を色分けして、読みやすくします。" Classes="settingHint indented" />
            <TextBlock Text="表示する範囲" Classes="sectionHeading" />
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="変更箇所の前後に表示する行数" Classes="settingLabel" />
                    <TextBlock Text="変更のない行を、前後に何行ぶん見せるかです。増やすと前後の流れが分かりやすくなります。" Classes="settingHint" />
                </StackPanel>
                <TextBox Grid.Column="1" Classes="narrow" Text="{Binding ContextLinesText, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="前後のコンテキスト行数"
                         views:HelpTip.Minimal="{Binding ContextLinesText, StringFormat='前後のコンテキスト行数: {0}'}"
                         views:HelpTip.Standard="差分表示で、変更が無い行を変更箇所の前後に何行分表示するかです。既定は3行です。"
                         views:HelpTip.Detailed="適用前の確認などの差分表示で、実際に変更された行の前後に、変更の無い行（文脈を確認するための周辺コード）を何行分あわせて表示するかです。既定は3行です。増やすと変更箇所の前後の文脈を確認しやすくなりますが、表示が縦に長くなります。" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
