<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Graft.Views"
             x:Class="Graft.Views.SettingsPanels.SafetySettingsView"
             AutomationProperties.Name="適用の制限設定">
    <UserControl.Styles>
        <StyleInclude Source="avares://Graft/Views/SettingsPanels/SettingsPanelStyles.axaml" />
    </UserControl.Styles>
    <!--
        「適用の制限」タブ（旧: 適用の制限）。適用を止める条件（拡張子・大きさ・ファイル数）と、
        当てはめ方の判定（旧「マッチング」タブの3項目。一致率は「止める・確認する」条件と
        同じ性質のため合流させた）。旧「マッチング」タブ用のMatchingSettingsViewは廃止した。
    -->
    <!--
        書式（見出し → 項目[ラベル・1行の説明・入力]）は SettingsPanelStyles.axaml のクラス
        （settingItem/settingLabel/settingHint と narrow/medium/wide の幅3種）を全タブで共有する。
        入力欄の確定の仕方（ComboBox/CheckBoxは即時、TextBoxはフォーカスを外した時かEnter）は
        従来から変えていない（「100」を「50」に打ち替える途中の「10」が保存されてしまうのを防ぐため。
        ViewModelの保存の仕組みには触れていない）。
        ScrollViewer自身にPaddingを持たせず内側のStackPanelのMarginへ置くのは、AvaloniaのScrollViewerが
        PaddingをExtentの外側に適用して末尾要素が見切れる（実機で確認済み）ため。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,8,16,16">
            <TextBlock Text="適用を止める条件" Classes="sectionHeading first" />
            <TextBlock Text="意図しない大量の書き換えや、対象外のファイルへの適用を防ぎます。ゆるめると、AIの誤った回答による被害が広がりやすくなります。" Classes="settingHint" Margin="0,0,0,12" />
            <StackPanel Classes="settingItem">
                <TextBlock Text="許可する拡張子（カンマ区切り）" Classes="settingLabel" />
                <TextBlock Text="ここに無い拡張子のファイルへの変更は、適用が止まります。" Classes="settingHint" />
                <TextBox Text="{Binding AllowedExtensionsText, UpdateSourceTrigger=LostFocus}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,6,0,0"
                         AutomationProperties.Name="許可する拡張子"
                         views:HelpTip.Minimal="{Binding AllowedExtensionsText, StringFormat='許可する拡張子: {0}'}"
                         views:HelpTip.Standard="適用を許可するファイルの拡張子の一覧です（カンマ区切り）。ここに無い拡張子への変更はブロックされます。"
                         views:HelpTip.Detailed="パッチの適用先として許可する拡張子を、カンマ区切りで列挙します（例: .py, .js, .cs）。AIの回答にこの一覧に無い拡張子のファイルへの変更が含まれていた場合、その変更は安全のためブロックされ、書き込まれません。既定では主要なプログラミング言語や設定ファイルの拡張子（.py, .js, .ts, .cs, .json, .md など）が登録されています。見慣れない拡張子のファイルを扱う必要が出てきたら、ここへ追加してください。空にするとどの拡張子も許可されなくなり、実質的に適用ができなくなります。" />
            </StackPanel>
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="1ファイルの上限サイズ（MB）" Classes="settingLabel" />
                    <TextBlock Text="これより大きいファイルへの適用は止まります。" Classes="settingHint" />
                </StackPanel>
                <TextBox Grid.Column="1" Classes="narrow" Text="{Binding MaxFileSizeMBText, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="1ファイルの上限サイズ"
                         views:HelpTip.Minimal="{Binding MaxFileSizeMBText, StringFormat='1ファイルの上限サイズ（MB）: {0}'}"
                         views:HelpTip.Standard="1つのファイルに書き込める最大サイズ（MB）です。既定は10MBで、これを超えるファイルへの適用はブロックされます。"
                         views:HelpTip.Detailed="パッチを書き込む対象の1ファイルあたりの上限サイズです。既定は10MBで、これを超える大きさのファイルへの変更はブロックされ、書き込まれません。巨大なファイル（画像を埋め込んだデータファイルなど）を誤って全文書き換えてしまうような事故を防ぐための歯止めです。大きな生成ファイルなどを正当に扱う必要がある場合のみ、値を増やしてください。" />
            </Grid>
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="1回の適用で書き換えるファイル数の上限" Classes="settingLabel" />
                    <TextBlock Text="これを超える変更が含まれる回答は、適用が止まります。" Classes="settingHint" />
                </StackPanel>
                <TextBox Grid.Column="1" Classes="narrow" Text="{Binding MaxFilesPerRevisionText, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="1回の適用の上限ファイル数"
                         views:HelpTip.Minimal="{Binding MaxFilesPerRevisionText, StringFormat='1回の適用の上限ファイル数: {0}'}"
                         views:HelpTip.Standard="1回の「適用」で同時に書き換えられるファイル数の上限です。既定は200件で、これを超える場合は適用がブロックされます。"
                         views:HelpTip.Detailed="1回の「適用」操作（履歴の1件）で同時に書き換えられるファイルの最大数です。既定は200件です。これを超える数のファイルを一度に変更しようとした場合、意図しない大規模な書き換え（AIの回答の解釈違いなどによる暴走）の可能性があるとみなし、適用そのものがブロックされます。本当に大規模な一括変更が必要な場合のみ、値を増やしてください。" />
            </Grid>
            <TextBlock Text="当てはめ方の判定" Classes="sectionHeading" />
            <TextBlock Text="AIが出した変更を、実際のコードのどこへ当てはめるかの判定です。通常は既定値のままで問題ありません。" Classes="settingHint" Margin="0,0,0,12" />
            <CheckBox Classes="settingRow hinted" Content="似ている箇所への当てはめを許可する"
                      IsChecked="{Binding AllowSimilarityMatch}" AutomationProperties.Name="類似度マッチを許可する"
                      views:HelpTip.Standard="完全一致しないコードも「似ている」判定で当てはめることを許可します。既定はオンです。"
                      views:HelpTip.Detailed="Graftは変更前のコードを何段階かの方法（完全一致→徐々に緩い一致）で探しますが、そのうち最後の手段である「似ているコードを探す」段階を使ってよいかどうかです。オンにすると（既定）、完全には一致しなくても上の閾値を満たせば適用できる可能性が広がります。オフにすると、この最後の段階を使わなくなり、完全一致に近いものしか適用されなくなるため、より慎重な運用になります（適用に失敗する頻度は増えます）。" />
            <TextBlock Text="完全には一致しない箇所も、似ていれば当てはめます。オフにすると、完全に一致した箇所にだけ当てはめます。" Classes="settingHint indented" />
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="一致率のしきい値（0〜1）" Classes="settingLabel" />
                    <TextBlock Text="「似ている」とみなす基準です。1に近いほど厳しく、完全一致に近いものだけ当てはめます。" Classes="settingHint" />
                </StackPanel>
                <TextBox Grid.Column="1" Classes="narrow" Text="{Binding SimilarityThresholdText, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="類似度マッチの閾値"
                         views:HelpTip.Minimal="{Binding SimilarityThresholdText, StringFormat='類似度マッチの閾値: {0}'}"
                         views:HelpTip.Standard="コードが完全一致しなくても「似ている」と判定して当てはめる基準の厳しさです。既定は0.85で、1に近いほど厳しくなります。"
                         views:HelpTip.Detailed="AIが示した変更前のコードが、実際のファイルの内容と一字一句までは一致しない場合に、「どれくらい似ていれば同じ箇所とみなすか」を0〜1の数値で決めます。既定は0.85です。1に近づけるほど厳しくなり、似ているだけの別の箇所を誤って書き換えるリスクは減りますが、少しの差でも一致とみなされず適用に失敗しやすくなります。0に近づけるほど適用は通りやすくなりますが、意図しない箇所に当たるリスクがわずかに増えます。迷ったら既定のままにしてください。" />
            </Grid>
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="範囲が広すぎるときの警告（行）" Classes="settingLabel" />
                    <TextBlock Text="AIが示した変更の範囲がこの行数を超えると、適用前に警告します。" Classes="settingHint" />
                </StackPanel>
                <TextBox Grid.Column="1" Classes="narrow" Text="{Binding RangeWarningLinesText, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="アンカー範囲の警告閾値"
                         views:HelpTip.Minimal="{Binding RangeWarningLinesText, StringFormat='アンカー範囲の警告閾値（行）: {0}'}"
                         views:HelpTip.Standard="AIが「〇〇行目から△△行目まで」のように範囲指定で変更を示したとき、その範囲が広すぎる場合に警告する行数の目安です。既定は300行です。"
                         views:HelpTip.Detailed="AIの回答が変更前コードの全文を書かず、開始・終了位置（アンカー）の範囲指定だけで変更箇所を示すことがあります。その指定範囲がここで指定した行数を超えて広い場合、意図しない範囲を書き換えてしまう可能性があるとして警告を表示します。既定は300行です。警告が出ても適用自体は可能ですが、内容をよく確認してから進めることをおすすめします。" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
