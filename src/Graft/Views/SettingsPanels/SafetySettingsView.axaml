<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Graft.Views"
             x:Class="Graft.Views.SettingsPanels.SafetySettingsView"
             AutomationProperties.Name="安全機構設定">
    <!--
        14章「safety」区分（13章 安全機構）。
        即時反映方式（14章）の確定タイミングの理屈はGeneralSettingsView参照。ただし
        「許可する拡張子」欄はAcceptsReturn=Trueの複数行入力のため、Enterは改行そのものの
        入力手段として使わせる必要があり、あえてCommitOnEnterを付けない
        （フォーカスを外したときのみ確定する）。
    -->
    <!--
        AvaloniaのScrollViewerはPaddingをScrollContentPresenterの外側へ適用するため、
        Padding指定だとスクロール範囲（Extent）に下端の余白が含まれず末尾要素が
        下端で見切れる（実機で確認済みの不具合。GeneralSettingsView参照）。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,8,16,16">
            <TextBlock Text="安全機構" Classes="sectionHeading first" />
            <TextBlock Text="意図しない大量の書き換えや、対象外のファイルへの適用を防ぐための歯止めです。ゆるめると、AIの誤った回答による被害の範囲が広がりやすくなります。"
                       Classes="fieldHint" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="許可する拡張子（カンマ区切り）" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource CaptionFontSize}" />
            <TextBox Text="{Binding AllowedExtensionsText, UpdateSourceTrigger=LostFocus}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,10"
                     AutomationProperties.Name="許可する拡張子"
                     views:HelpTip.Minimal="{Binding AllowedExtensionsText, StringFormat='許可する拡張子: {0}'}"
                     views:HelpTip.Standard="適用を許可するファイルの拡張子の一覧です（カンマ区切り）。ここに無い拡張子への変更はブロックされます。"
                     views:HelpTip.Detailed="パッチの適用先として許可する拡張子を、カンマ区切りで列挙します（例: .py, .js, .cs）。AIの回答にこの一覧に無い拡張子のファイルへの変更が含まれていた場合、その変更は安全のためブロックされ、書き込まれません。既定では主要なプログラミング言語や設定ファイルの拡張子（.py, .js, .ts, .cs, .json, .md など）が登録されています。見慣れない拡張子のファイルを扱う必要が出てきたら、ここへ追加してください。空にするとどの拡張子も許可されなくなり、実質的に適用ができなくなります。" />
            <StackPanel Classes="fieldRow">
                <TextBlock Text="1ファイルの上限サイズ（MB）" Classes="fieldLabel" />
                <TextBox Text="{Binding MaxFileSizeMBText, UpdateSourceTrigger=LostFocus}" Width="120"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="1ファイルの上限サイズ"
                         views:HelpTip.Minimal="{Binding MaxFileSizeMBText, StringFormat='1ファイルの上限サイズ（MB）: {0}'}"
                         views:HelpTip.Standard="1つのファイルに書き込める最大サイズ（MB）です。既定は10MBで、これを超えるファイルへの適用はブロックされます。"
                         views:HelpTip.Detailed="パッチを書き込む対象の1ファイルあたりの上限サイズです。既定は10MBで、これを超える大きさのファイルへの変更はブロックされ、書き込まれません。巨大なファイル（画像を埋め込んだデータファイルなど）を誤って全文書き換えてしまうような事故を防ぐための歯止めです。大きな生成ファイルなどを正当に扱う必要がある場合のみ、値を増やしてください。" />
            </StackPanel>
            <StackPanel Classes="fieldRow">
                <TextBlock Text="1リビジョンの上限ファイル数" Classes="fieldLabel" />
                <TextBox Text="{Binding MaxFilesPerRevisionText, UpdateSourceTrigger=LostFocus}" Width="120"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="1リビジョンの上限ファイル数"
                         views:HelpTip.Minimal="{Binding MaxFilesPerRevisionText, StringFormat='1リビジョンの上限ファイル数: {0}'}"
                         views:HelpTip.Standard="1回の「適用」で同時に書き換えられるファイル数の上限です。既定は200件で、これを超える場合は適用がブロックされます。"
                         views:HelpTip.Detailed="1回の「適用」操作（1つのリビジョン）で同時に書き換えられるファイルの最大数です。既定は200件です。これを超える数のファイルを一度に変更しようとした場合、意図しない大規模な書き換え（AIの回答の解釈違いなどによる暴走）の可能性があるとみなし、適用そのものがブロックされます。本当に大規模な一括変更が必要な場合のみ、値を増やしてください。" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
