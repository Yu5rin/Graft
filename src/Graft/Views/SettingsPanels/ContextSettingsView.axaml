<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Graft.Views"
             x:Class="Graft.Views.SettingsPanels.ContextSettingsView"
             AutomationProperties.Name="AIに渡す内容の設定">
    <UserControl.Styles>
        <StyleInclude Source="avares://Graft/Views/SettingsPanels/SettingsPanelStyles.axaml" />
    </UserControl.Styles>
    <!--
        「AIに渡す内容」タブ（旧: コンテキスト収集）。「ファイルを選ぶ」画面で集めてAIへ渡す内容の
        対象・除外・大きさの目安。旧「表示・コンテキスト」タブの該当4項目をそのまま移した。
        トークン概算比率は依頼文のテンプレートの推定トークン数にも使われる共通の式のため、
        説明にそのことを書いている。
    -->
    <!--
        書式（見出し → 項目[ラベル・1行の説明・入力]）は SettingsPanelStyles.axaml のクラス
        （settingItem/settingLabel/settingHint と narrow/medium/wide の幅3種）を全タブで共有する。
        入力欄の確定の仕方（ComboBox/CheckBoxは即時、TextBoxはフォーカスを外した時かEnter）は
        従来から変えていない（「100」を「50」に打ち替える途中の「10」が保存されてしまうのを防ぐため。
        ViewModelの保存の仕組みには触れていない）。
        ScrollViewer自身にPaddingを持たせず内側のStackPanelのMarginへ置くのは、AvaloniaのScrollViewerが
        PaddingをExtentの外側に適用して末尾要素が見切れる（実機で確認済み）ため。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,8,16,16">
            <TextBlock Text="対象と除外" Classes="sectionHeading first" />
            <CheckBox Classes="settingRow hinted" Content=".gitignoreを尊重する" IsChecked="{Binding RespectGitignore}"
                      AutomationProperties.Name="gitignoreを尊重する"
                      views:HelpTip.Standard="AIに渡す内容を集めるとき、.gitignoreに書かれたファイルを一覧から除外します。既定はオンです。"
                      views:HelpTip.Detailed="コマンドバーの「ファイルを選ぶ」から開く画面で、プロジェクト内のファイル一覧を作るときに.gitignoreの指定を尊重するかどうかです。オンにすると（既定）、node_modulesやビルド成果物などGit管理対象外のファイルが一覧から自動的に除外され、AIへ渡す内容を絞り込みやすくなります。オフにすると、.gitignoreに関わらず全ファイルが一覧に出ます。" />
            <TextBlock Text=".gitignore に書かれたファイルを、AIに渡す候補から外します。" Classes="settingHint indented" />
            <CheckBox Classes="settingRow hinted" Content="依頼文のコピーに、選んだファイルも付ける" IsChecked="{Binding AppendFilesToPrompt}"
                      AutomationProperties.Name="依頼文のコピーに選んだファイルも付ける"
                      views:HelpTip.Standard="依頼文をコピーするとき、依頼文の後ろに「ファイルを選ぶ」画面で選んだファイルの内容も付けます。既定はオフです。"
                      views:HelpTip.Detailed="コマンドバーの「依頼文をコピー」・Ctrl+Shift+Cでテンプレートをコピーするとき、依頼文の後ろに「ファイルを選ぶ」画面で選んだファイルの内容も続けてコピーします。依頼文とファイルを1回のコピー・1回の貼り付けでAIへ渡せます。テンプレートが本文に変数 {{files}} を含んでいる場合は、そこへファイルが入るため二重には付きません。既定はオフ（従来どおり依頼文だけ）です。テンプレートの本文自体は書き換わりません。「依頼文」のドロップダウンにある同名のチェックと同じ設定です。" />
            <TextBlock Text="依頼文をコピーするとき、「ファイルを選ぶ」画面で選んだファイルの内容も続けて付けます。" Classes="settingHint indented" />
            <TextBlock Text="大きさの目安" Classes="sectionHeading" />
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="トークン数の概算比率（文字数 ÷ この値）" Classes="settingLabel" />
                    <TextBlock Text="トークンは、AIが文章を数える単位です。この式で概算し、依頼文のテンプレートの数字にも使います。" Classes="settingHint" />
                </StackPanel>
                <TextBox Grid.Column="1" Classes="narrow" Text="{Binding TokenRatioText, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="トークン概算比率"
                         views:HelpTip.Minimal="{Binding TokenRatioText, StringFormat='トークン概算比率: {0}'}"
                         views:HelpTip.Standard="コピーする文字数からAIのトークン数をおおまかに見積もる際の割り算の値です。既定は2.5（文字数÷2.5）です。"
                         views:HelpTip.Detailed="「ファイルを選ぶ」画面や統計タブで表示する「推定トークン数」は、実際にAIへ送って数えるわけではなく、「コピーする文字数 ÷ この値」という簡易な計算で見積もっています。既定は2.5です。目安の値であり、実際にAIが消費するトークン数と厳密には一致しません。通常は変更する必要はありません。" />
            </Grid>
            <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingText">
                    <TextBlock Text="大きすぎると知らせる量（トークン）" Classes="settingLabel" />
                    <TextBlock Text="AIに渡す内容がこの量（概算）を超えると、大きすぎるかもしれないと知らせます。" Classes="settingHint" />
                </StackPanel>
                <TextBox Grid.Column="1" Classes="narrow" Text="{Binding TokenWarnThresholdText, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxCommitBehavior.CommitOnEnter="True"
                         AutomationProperties.Name="トークン数の警告閾値"
                         views:HelpTip.Minimal="{Binding TokenWarnThresholdText, StringFormat='トークン数の警告閾値: {0}'}"
                         views:HelpTip.Standard="AIに渡す内容としてコピー・保存する内容の推定トークン数がこれを超えると、大きいかもしれないという助言を表示します。既定は50000です。"
                         views:HelpTip.Detailed="「ファイルを選ぶ」画面でファイルを選んでコピー・保存しようとしたとき、上の比率で見積もった推定トークン数がこの値を超える場合に「AIへ一度に渡すには大きいかもしれません」という助言を表示します。既定は50000です。AIへ渡すと回答が途中で切れてしまうことがある、といった事態に気付きやすくするための目安であり、この値を超えてもコピー・保存の内容が削られることはありません（あくまで目安の表示だけで、常に全文がコピー・保存されます）。" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
