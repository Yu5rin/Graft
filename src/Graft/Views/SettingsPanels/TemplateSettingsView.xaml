<UserControl x:Class="Graft.Views.SettingsPanels.TemplateSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Graft.ViewModels"
             AutomationProperties.Name="プロンプトテンプレート設定">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        4.8章 AI向けプロンプトテンプレート管理。テンプレートの追加・編集・削除、名前の右への
        推定トークン数表示、プロジェクトごとの既定紐づけ、初回用/継続用トグルでのコピーを行う。
        このUserControl自身のDataContextは（TabItem経由で）SettingsViewModelを継承するため、
        ルート要素で {Binding Templates}（PromptTemplateViewModel）へ明示的に設定し直す。
        保存・削除ボタンはWindow祖先のDataContext（SettingsViewModel）を辿って
        Templates.SaveEditCommand 等を参照する。スタイルは親SettingsWindow.xamlのものを継承する。
    -->
    <Grid DataContext="{Binding Templates}" Margin="16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="プレビュー対象プロジェクト" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Projects}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedProject}" AutomationProperties.Name="プレビュー対象プロジェクト" />
            <CheckBox Content="継続用（短縮版）でコピーする" IsChecked="{Binding IsContinuationMode}"
                      Margin="24,0,0,0" VerticalAlignment="Center"
                      AutomationProperties.Name="継続用の短縮版でコピーする" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                     AutomationProperties.Name="テンプレート一覧">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TemplateEntry}">
                        <Grid AutomationProperties.Name="{Binding Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       Text="{Binding EstimatedTokens, StringFormat=約{0}トークン}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" />

            <Grid Grid.Column="2" DataContext="{Binding SelectedTemplate}" Margin="8,0,0,0"
                  Visibility="{Binding Converter={StaticResource NullToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsBuiltIn}" Margin="0,0,0,8"
                         AutomationProperties.Name="テンプレート名" />
                <TextBox Grid.Row="1" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsBuiltIn}" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource CodeFontSize}"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="テンプレート本文" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="保存" Command="{Binding DataContext.Templates.SaveEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBool}}"
                            Margin="0,0,8,0" AutomationProperties.Name="テンプレートを保存" />
                    <Button Content="削除" Command="{Binding DataContext.Templates.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBool}}"
                            Margin="0,0,8,0" AutomationProperties.Name="テンプレートを削除" />
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="テンプレートを追加" Command="{Binding AddCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="テンプレートを追加" />
            <Button Content="コピー" Command="{Binding CopyCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="テンプレートをコピー" />
            <Button Content="プロジェクトの既定に設定" Command="{Binding SetAsProjectDefaultCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="プロジェクトの既定テンプレートに設定" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
