<UserControl x:Class="Graft.Views.SettingsTabs.DiffSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="表示・コンテキスト設定">
    <!--
        14章「syntax」「diff」「context」「encoding」「clipboardWatch」区分をまとめる
        （8.6シンタックス・8.13 diff表示制御・10章コンテキスト収集の各設定）。
        スタイルは親SettingsWindow.xamlのものを継承する。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
        <StackPanel>
            <TextBlock Text="シンタックスハイライト" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
            <CheckBox Content="シンタックスハイライトを有効にする" IsChecked="{Binding SyntaxEnabled}" Margin="0,0,0,10"
                      AutomationProperties.Name="シンタックスハイライトを有効にする" />
            <CheckBox Content="行番号を表示する" IsChecked="{Binding ShowLineNumbers}" Margin="0,0,0,10"
                      AutomationProperties.Name="行番号を表示する" />

            <TextBlock Text="diff表示" Style="{StaticResource SectionHeading}" />
            <StackPanel Style="{StaticResource FieldRow}">
                <TextBlock Text="前後のコンテキスト行数" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ContextLinesText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         AutomationProperties.Name="前後のコンテキスト行数" />
            </StackPanel>
            <CheckBox Content="長い行を折り返す" IsChecked="{Binding WordWrap}" Margin="0,0,0,10"
                      AutomationProperties.Name="長い行を折り返す" />
            <CheckBox Content="空白文字を可視化する" IsChecked="{Binding ShowWhitespace}" Margin="0,0,0,10"
                      AutomationProperties.Name="空白文字を可視化する" />

            <TextBlock Text="コンテキスト収集" Style="{StaticResource SectionHeading}" />
            <CheckBox Content=".gitignoreを尊重する" IsChecked="{Binding RespectGitignore}" Margin="0,0,0,10"
                      AutomationProperties.Name="gitignoreを尊重する" />
            <StackPanel Style="{StaticResource FieldRow}">
                <TextBlock Text="トークン概算比率（文字数÷この値）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding TokenRatioText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         AutomationProperties.Name="トークン概算比率" />
            </StackPanel>
            <StackPanel Style="{StaticResource FieldRow}">
                <TextBlock Text="トークン数の警告閾値" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding TokenWarnThresholdText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         AutomationProperties.Name="トークン数の警告閾値" />
            </StackPanel>

            <TextBlock Text="新規ファイル" Style="{StaticResource SectionHeading}" />
            <StackPanel Style="{StaticResource FieldRow}">
                <TextBlock Text="エンコーディング" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding NewFileEncoding, UpdateSourceTrigger=PropertyChanged}" Width="160"
                         AutomationProperties.Name="新規ファイルのエンコーディング" />
            </StackPanel>
            <CheckBox Content="BOMを付与する" IsChecked="{Binding NewFileBom}" Margin="0,0,0,10"
                      AutomationProperties.Name="新規ファイルにBOMを付与する" />

            <TextBlock Text="クリップボード監視" Style="{StaticResource SectionHeading}" />
            <CheckBox Content="クリップボード監視を有効にする" IsChecked="{Binding ClipboardWatchEnabled}" Margin="0,0,0,10"
                      AutomationProperties.Name="クリップボード監視を有効にする" />
            <StackPanel Style="{StaticResource FieldRow}">
                <TextBlock Text="反応時の挙動" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding ClipboardActionOptions}" SelectedValuePath="Value"
                          DisplayMemberPath="Label" SelectedValue="{Binding SelectedClipboardAction}"
                          AutomationProperties.Name="クリップボード監視反応時の挙動" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
