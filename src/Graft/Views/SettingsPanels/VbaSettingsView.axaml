<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Graft.Views"
             x:Class="Graft.Views.SettingsPanels.VbaSettingsView"
             AutomationProperties.Name="VBA連携設定">
    <UserControl.Styles>
        <StyleInclude Source="avares://Graft/Views/SettingsPanels/SettingsPanelStyles.axaml" />
    </UserControl.Styles>
    <!--
        「VBA 連携」タブ（仕様書_VBA連携 8章）。Excel の VBA コードを Graft で直接編集する機能の設定。
        プロジェクトごとの「適用後に Excel へ自動反映する」「反映後にブックを保存する」は、ここではなく
        プロジェクト一覧の右クリックメニューにある（プロジェクトごとの値のため。ProjectOverrides の編集画面は無い）。

        Windows 以外では、パネル全体を「この環境では使えない機能です」（E706 の実際の文言）に置き換え、
        入力欄は一切出さない（VbaSettingsContent を非表示にする）。タブそのものを隠さないのは、
        「無いのか、使えないのか」を利用者が迷わないようにするため。
        書式は他のタブと同じ（SettingsPanelStyles.axaml）。ScrollViewer 自身に Padding を持たせず、
        内側の StackPanel の Margin に置くのも他のタブと同じ理由（末尾の見切れの回避）。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,8,16,16">
            <!-- 使えない環境: 案内だけ。 -->
            <StackPanel x:Name="VbaUnsupportedPanel" IsVisible="{Binding IsVbaUnsupported}" Spacing="6">
                <TextBlock Text="VBA 連携" Classes="sectionHeading first" />
                <TextBlock x:Name="VbaUnsupportedMessage" Text="{Binding VbaUnsupportedText}" TextWrapping="Wrap"
                           AutomationProperties.Name="VBA連携はこの環境では使えない機能です" />
                <TextBlock Text="Excel VBA の直接編集は、Windows 版の Graft でのみ使えます。" Classes="settingHint" />
            </StackPanel>

            <!-- 使える環境: 設定項目。 -->
            <StackPanel x:Name="VbaSettingsContent" IsVisible="{Binding IsVbaSupported}">
                <TextBlock Text="VBA 連携" Classes="sectionHeading first" />
                <CheckBox Classes="settingRow hinted" Content="Excel VBA 連携を有効にする"
                          IsChecked="{Binding VbaEnabled}"
                          AutomationProperties.Name="Excel VBA 連携を有効にする"
                          views:HelpTip.Standard="Excel VBA の直接編集の機能全体のオン・オフです。既定はオンです。オフにすると、Excel には一切接続しません。"
                          views:HelpTip.Detailed="オフにすると、Excel VBA 連携のボタン・メニュー・自動の取り込み・自動の反映をすべて止め、Excel(COM)を一切呼びません。すでに追加してある VBA プロジェクトは、ミラーのフォルダを普通のファイルプロジェクトとして編集・適用できますが、Excel とは同期されません（プロジェクト一覧には「VBA 連携オフ」と出ます）。オンに戻すと、溜まった未反映の変更を「Excel へ反映」で送れます。" />
                <TextBlock Text="オフにすると、VBA プロジェクトも普通のファイルとして扱い、Excel とは同期しません。" Classes="settingHint indented" />

                <TextBlock Text="Excel からの取り込み" Classes="sectionHeading" />
                <CheckBox Classes="settingRow hinted" Content="AI に渡すファイルを集める前に、Excel の最新を取り込む"
                          IsChecked="{Binding VbaPullOnContextOpen}"
                          IsEnabled="{Binding VbaEnabled}"
                          AutomationProperties.Name="コンテキスト収集の前に Excel の最新を取り込む"
                          views:HelpTip.Standard="「ファイルを選ぶ」画面を開くとき・依頼文をコピーするときに、先に Excel 側の変更をミラーへ取り込みます。既定はオンです。"
                          views:HelpTip.Detailed="Excel で直接編集したコードが、古いまま AI に渡されるのを防ぎます。オンにすると、コンテキスト収集の走査の前に、Excel 側だけが変わったモジュールを取り込みます（「選んだファイルも付ける」の依頼文コピーやホットキーでも同じです）。Excel に接続できないときや、Excel 側とファイル側の両方が変わっていて取り込みを中止したときは、集めること自体は止めず、ミラーの現在の内容で続けて警告を出します。" />
                <TextBlock Text="Excel で直接編集した内容が、古いまま AI に渡らないようにします。" Classes="settingHint indented" />
                <CheckBox Classes="settingRow hinted" Content="解析の前に、対象モジュールの Excel の最新を自動で取り込む"
                          IsChecked="{Binding VbaPullBeforeDryRun}"
                          IsEnabled="{Binding VbaEnabled}"
                          AutomationProperties.Name="解析の前に対象モジュールを自動で取り込む"
                          views:HelpTip.Standard="AI の回答を解析する直前に、対象のモジュールの Excel 側の変更を取り込みます。既定はオンです。オフのときは、取り込むかどうかを確認します。"
                          views:HelpTip.Detailed="オンにすると、貼り付けた回答の対象になっているモジュールに限って、Excel 側だけが変わっていれば自動で取り込んでから解析します（AI が最新でない本文を前提にしている可能性があるため）。オフにすると、同じ内容を「取り込む／取り込まずに続ける／中止」の確認で行います。Excel 側とファイル側の両方が変わっている衝突は、どちらの設定でも衝突ダイアログで選びます。" />
                <TextBlock Text="オフにすると、取り込むかどうかをその都度確認します。" Classes="settingHint indented" />

                <TextBlock Text="Excel の応答待ち" Classes="sectionHeading" />
                <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="settingText">
                        <TextBlock Text="再試行の上限（ミリ秒、1000〜30000）" Classes="settingLabel" />
                        <TextBlock Text="Excel がセル編集中やダイアログ表示中で断ってきたときに、再試行を続ける時間です。超えると「Excel が応答しません」になります。" Classes="settingHint" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="narrow" Text="{Binding VbaComTimeoutMsText, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding VbaEnabled}"
                             views:TextBoxCommitBehavior.CommitOnEnter="True"
                             AutomationProperties.Name="Excel の再試行の上限（ミリ秒）"
                             views:HelpTip.Minimal="{Binding VbaComTimeoutMsText, StringFormat='再試行の上限（ミリ秒）: {0}'}"
                             views:HelpTip.Standard="Excel が呼び出しを断ったときに再試行する時間の上限です。既定は5000ミリ秒（5秒）です。"
                             views:HelpTip.Detailed="セルを編集している最中やダイアログが開いている間、Excel は外からの呼び出しを断ります。Graft は200ミリ秒おきに再試行し、この時間を過ぎても通らなければ、Excel が応答しないものとして中止します。既定は5000ミリ秒です。範囲は1000〜30000です。" />
                </Grid>
                <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="settingText">
                        <TextBlock Text="呼び出し全体の時間切れ（ミリ秒、5000〜120000）" Classes="settingLabel" />
                        <TextBlock Text="マクロの実行中などで Excel が戻ってこないときに、待つのをやめる時間です。再試行の上限以上にしてください。" Classes="settingHint" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="narrow" Text="{Binding VbaCallTimeoutMsText, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding VbaEnabled}"
                             views:TextBoxCommitBehavior.CommitOnEnter="True"
                             AutomationProperties.Name="Excel の呼び出し全体の時間切れ（ミリ秒）"
                             views:HelpTip.Minimal="{Binding VbaCallTimeoutMsText, StringFormat='呼び出し全体の時間切れ（ミリ秒）: {0}'}"
                             views:HelpTip.Standard="Excel への1回の呼び出しが戻らないときに、待つのをやめる時間です。既定は30000ミリ秒（30秒）です。"
                             views:HelpTip.Detailed="マクロの実行中・中断中・VBE のダイアログ表示中などは、Excel が断りもせず戻ってこないことがあります。この時間を過ぎたら待つのをやめて「Excel が応答しません」とし、Graft 自身は固まらずに操作を続けられるようにします。既定は30000ミリ秒です。範囲は5000〜120000で、再試行の上限以上にする必要があります（下回ると既定値に戻ります）。" />
                </Grid>

                <TextBlock Text="ブックの情報" Classes="sectionHeading" />
                <CheckBox Classes="settingRow hinted" Content="AI に渡すとき、ブックの情報（シート・テーブル・名前・参照設定・選んだシートの値）も取る"
                          IsChecked="{Binding VbaCollectWorkbookInfo}"
                          IsEnabled="{Binding VbaEnabled}"
                          AutomationProperties.Name="ブックの情報を取る"
                          views:HelpTip.Standard="「ファイルを選ぶ」画面を開くとき・依頼文をコピーするときに、Excel からブックの構造（シート名・テーブル・名前付き範囲・参照設定）と、シートごとに選んだ値を読んで、AI に渡す内容へ加えます。既定はオンです。"
                          views:HelpTip.Detailed="AI は、どんなシートや表があるブックかを知らないと、存在しないシート名や列を前提にした VBA を書いてしまいます。オンにすると、依頼文の作成のたびに Excel からブックの構造を読み、「# ブックの情報」として渡します（読み取りだけで、ブックは変更しません）。どこまで渡すかは、「ファイルを選ぶ」画面の「ブックの情報」の行で、プロジェクトごとに「内容も出す／構成だけ／出さない」から選べます。シートの値（見出し＋N 行・全部・範囲を指定）は、この設定とは別に、その行の下のシートごとの見せ方で明示的に選んだシートだけが渡ります（既定は全シート「構成だけ」で、値は渡りません）。オフにすると、Excel には一切問い合わせません。" />
                <TextBlock Text="Excel に繋がらないときも、依頼文の作成は止まりません（警告を出して続けます）。取得した内容はメモリにだけ置き、ファイルには保存しません。" Classes="settingHint indented" />
                <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="settingText">
                        <TextBlock Text="「見出し＋N 行」の N の既定（1〜20）" Classes="settingLabel" />
                        <TextBlock Text="シートの見せ方で「見出し＋N 行」を選んだときの、最初の行数です（シートごとに変えられます）。以前の「値の見本」をオンにしていたプロジェクトは、全シートこの行数の「見出し＋N 行」として引き継ぎます。" Classes="settingHint" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="narrow" Text="{Binding VbaWorkbookInfoSampleRowsText, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding VbaEnabled}"
                             views:TextBoxCommitBehavior.CommitOnEnter="True"
                             AutomationProperties.Name="見出し＋N 行の N の既定"
                             views:HelpTip.Minimal="{Binding VbaWorkbookInfoSampleRowsText, StringFormat='見出し＋N 行の N の既定: {0}'}"
                             views:HelpTip.Standard="シートの見せ方で「見出し＋N 行」を選んだときの N の最初の値です。既定は5行です。"
                             views:HelpTip.Detailed="「ブックの情報」の下で、シートの見せ方を「見出し＋N 行」にしたときの N の最初の値です（その後はシートごとに 0〜100 で変えられます）。以前の「値の見本」をオンにしていたプロジェクトは、全シートこの行数の「見出し＋N 行」として引き継ぎます。既定は5行、範囲は1〜20です（範囲外は既定値に戻ります）。" />
                </Grid>
                <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="settingText">
                        <TextBlock Text="見出し＋N 行の最大列数（5〜100）" Classes="settingLabel" />
                        <TextBlock Text="右側の列は、この数で切ります（切った列数は「…（他 N 列）」と伝えます）。" Classes="settingHint" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="narrow" Text="{Binding VbaWorkbookInfoMaxColumnsText, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding VbaEnabled}"
                             views:TextBoxCommitBehavior.CommitOnEnter="True"
                             AutomationProperties.Name="見出し＋N 行の最大列数"
                             views:HelpTip.Minimal="{Binding VbaWorkbookInfoMaxColumnsText, StringFormat='最大列数: {0}'}"
                             views:HelpTip.Standard="シートの見せ方「見出し＋N 行」で、左から何列まで読むかです。既定は30列です。"
                             views:HelpTip.Detailed="横に非常に長い表で、依頼文が大きくなりすぎないようにする上限です。超えた右側は読まず、「…（他 N 列）」と伝えます。既定は30列、範囲は5〜100です（範囲外は既定値に戻ります）。" />
                </Grid>
                <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="settingText">
                        <TextBlock Text="1 セルの最大文字数（10〜500）" Classes="settingLabel" />
                        <TextBlock Text="渡す値のセルの文字が長いとき、この数で「…」をつけて切ります。" Classes="settingHint" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="narrow" Text="{Binding VbaWorkbookInfoMaxCellCharsText, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding VbaEnabled}"
                             views:TextBoxCommitBehavior.CommitOnEnter="True"
                             AutomationProperties.Name="1セルの最大文字数"
                             views:HelpTip.Minimal="{Binding VbaWorkbookInfoMaxCellCharsText, StringFormat='1セルの最大文字数: {0}'}"
                             views:HelpTip.Standard="渡す値の1セルの文字数の上限です。既定は60文字です。"
                             views:HelpTip.Detailed="長い文章が入ったセルで依頼文が膨らまないようにする上限です。超えた分は「…」をつけて切ります（改行は空白1つにまとめます）。既定は60文字、範囲は10〜500です（範囲外は既定値に戻ります）。" />
                </Grid>
                <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="settingText">
                        <TextBlock Text="ブックの情報の最大文字数（2000〜100000）" Classes="settingLabel" />
                        <TextBlock Text="超えたら、シートの値・参照設定の順に省いて収めます。" Classes="settingHint" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="narrow" Text="{Binding VbaWorkbookInfoMaxCharsText, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding VbaEnabled}"
                             views:TextBoxCommitBehavior.CommitOnEnter="True"
                             AutomationProperties.Name="ブックの情報の最大文字数"
                             views:HelpTip.Minimal="{Binding VbaWorkbookInfoMaxCharsText, StringFormat='ブックの情報の最大文字数: {0}'}"
                             views:HelpTip.Standard="依頼文に入れるブックの情報全体の文字数の上限です。既定は20000文字です。"
                             views:HelpTip.Detailed="シートや名前が多いブックで、依頼文が大きくなりすぎないようにする上限です。超えるときは、シートの値（末尾のシートから。入る行数までは残します）、参照設定、名前付き範囲、テーブルの列名、テーブル、シートの順に（構成ほど後まで残して）省き、末尾に「（長いため一部を省略しました）」と添えます。既定は20000文字、範囲は2000〜100000です（範囲外は既定値に戻ります）。" />
                </Grid>
                <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="settingText">
                        <TextBlock Text="「全部」「範囲を指定」の最大行数（10〜5000）" Classes="settingLabel" />
                        <TextBlock Text="シートの見せ方が「全部」「範囲を指定」のとき、1 シートから読む行数の上限です。超えた分は切り、依頼文にその旨を書きます。" Classes="settingHint" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="narrow" Text="{Binding VbaWorkbookInfoAllMaxRowsText, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding VbaEnabled}"
                             views:TextBoxCommitBehavior.CommitOnEnter="True"
                             AutomationProperties.Name="全部・範囲を指定の最大行数"
                             views:HelpTip.Minimal="{Binding VbaWorkbookInfoAllMaxRowsText, StringFormat='全部・範囲を指定の最大行数: {0}'}"
                             views:HelpTip.Standard="見せ方「全部」「範囲を指定」で 1 シートから読む行数の上限です。既定は500行です。"
                             views:HelpTip.Detailed="上限を超えるシートは、先頭からこの行数だけを読み、「何行・何列のうち何行・何列を出したか」と、続きを読むには「範囲を指定」を使うことを依頼文に書きます。ブックの情報全体の最大文字数（上の設定）も別に効きます。既定は500行、範囲は10〜5000です（範囲外は既定値に戻ります）。" />
                </Grid>
                <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="settingText">
                        <TextBlock Text="「全部」「範囲を指定」の最大列数（5〜200）" Classes="settingLabel" />
                        <TextBlock Text="同じく、1 シートから読む列数の上限です。" Classes="settingHint" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="narrow" Text="{Binding VbaWorkbookInfoAllMaxColumnsText, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding VbaEnabled}"
                             views:TextBoxCommitBehavior.CommitOnEnter="True"
                             AutomationProperties.Name="全部・範囲を指定の最大列数"
                             views:HelpTip.Minimal="{Binding VbaWorkbookInfoAllMaxColumnsText, StringFormat='全部・範囲を指定の最大列数: {0}'}"
                             views:HelpTip.Standard="見せ方「全部」「範囲を指定」で 1 シートから読む列数の上限です。既定は50列です。"
                             views:HelpTip.Detailed="横に長い表で、依頼文が大きくなりすぎないようにする上限です。超えた右側は読まず、切ったことを依頼文に書きます。既定は50列、範囲は5〜200です（範囲外は既定値に戻ります）。" />
                </Grid>

                <TextBlock Text="Excel 側の控え" Classes="sectionHeading" />
                <TextBlock Text="「Excel へ反映」で Excel 側が上書きされる直前の本文を、毎回控えとして残します。プロジェクトの右クリック「Excel 側の控えを見る…」で、一覧・差分の確認と、ミラーへの取り込み（戻す）ができます。控えは履歴には記録されません。"
                           Classes="settingHint indented" TextWrapping="Wrap" />
                <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="settingText">
                        <TextBlock Text="控えの世代数（1〜200）" Classes="settingLabel" />
                        <TextBlock Text="1 つのモジュールについて残す、反映前の自動控えと戻す前のミラーの控えの数です。" Classes="settingHint" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="narrow" Text="{Binding VbaRescueMaxGenerationsText, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding VbaEnabled}"
                             views:TextBoxCommitBehavior.CommitOnEnter="True"
                             AutomationProperties.Name="控えの世代数"
                             views:HelpTip.Minimal="{Binding VbaRescueMaxGenerationsText, StringFormat='控えの世代数: {0}'}"
                             views:HelpTip.Standard="1 つのモジュールについて残す自動控えの数です。既定は20世代です。"
                             views:HelpTip.Detailed="反映のたびに、上書きされる前の Excel 側の本文を残します（前回と同じ内容なら増やしません）。この数を超えた古いものから自動で消します。衝突で「Graft 側で上書き」を選んだ直前などの控えは、利用者の VBE での編集を救う最後の控えなので、自動では消しません。既定は20、範囲は1〜200です（範囲外は既定値に戻ります）。" />
                </Grid>
                <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="settingText">
                        <TextBlock Text="控え全体の容量（MB。5〜1000）" Classes="settingLabel" />
                        <TextBlock Text="超えたら、自動控えを古い順に消します。" Classes="settingHint" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="narrow" Text="{Binding VbaRescueMaxTotalMBText, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding VbaEnabled}"
                             views:TextBoxCommitBehavior.CommitOnEnter="True"
                             AutomationProperties.Name="控え全体の容量"
                             views:HelpTip.Minimal="{Binding VbaRescueMaxTotalMBText, StringFormat='控え全体の容量: {0} MB'}"
                             views:HelpTip.Standard="1 つのプロジェクトの控え全体の容量の上限です。既定は50MBです。"
                             views:HelpTip.Detailed="プロジェクトごとの控えのフォルダ全体の大きさの上限です。超えたら、自動控えを古い順に消します（各モジュールの最新の自動控えは残します）。従来の控え（衝突の上書き前など）は自動では消しませんが、容量には数えます。既定は50、範囲は5〜1000です（範囲外は既定値に戻ります）。" />
                </Grid>

                <TextBlock Text="プロジェクトごとの設定" Classes="sectionHeading" />
                <TextBlock Text="「適用後に Excel へ自動反映する」と「反映後にブックを保存する」は、プロジェクト一覧で VBA プロジェクトを右クリックして切り替えます。ブックの情報の出し方と値の見本は、「ファイルを選ぶ」画面の「ブックの情報」の行で切り替えます。"
                           Classes="settingHint" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
