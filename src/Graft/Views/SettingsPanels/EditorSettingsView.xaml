<UserControl x:Class="Graft.Views.SettingsPanels.EditorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="エディタ設定">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsPanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        15章 editorセクション（12項目）・4章 コードエディタの設定タブ。
        FieldLabel/FieldRow/SectionHeadingは共通のSettingsPanelResources.xamlを参照する
        （UserControlはSettingsWindow.Resourcesを実行時に遡って参照できないため）。
        DataContextはTabItem経由でSettingsViewModelを継承する。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
        <StackPanel>
            <TextBlock Text="表示" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
            <StackPanel Style="{StaticResource FieldRow}">
                <TextBlock Text="フォントサイズ" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding EditorFontSizeText, UpdateSourceTrigger=PropertyChanged}" Width="80"
                         AutomationProperties.Name="エディタのフォントサイズ" />
            </StackPanel>
            <CheckBox Content="長い行を折り返す" IsChecked="{Binding EditorWordWrap}" Margin="0,0,0,10"
                      AutomationProperties.Name="長い行を折り返す" />
            <CheckBox Content="タブ・行末空白を可視化する" IsChecked="{Binding EditorShowWhitespace}" Margin="0,0,0,10"
                      AutomationProperties.Name="タブ・行末空白を可視化する" />
            <CheckBox Content="行番号を表示する" IsChecked="{Binding EditorShowLineNumbers}" Margin="0,0,0,10"
                      AutomationProperties.Name="行番号を表示する" />
            <CheckBox Content="現在行をハイライトする" IsChecked="{Binding EditorHighlightCurrentLine}" Margin="0,0,0,10"
                      AutomationProperties.Name="現在行をハイライトする" />
            <CheckBox Content="行番号ガターにGitの変更状態を表示する" IsChecked="{Binding EditorGitGutter}" Margin="0,0,0,10"
                      AutomationProperties.Name="行番号ガターにGitの変更状態を表示する" />

            <TextBlock Text="インデント" Style="{StaticResource SectionHeading}" />
            <StackPanel Style="{StaticResource FieldRow}">
                <TextBlock Text="タブ幅（検出不能時の既定値）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding EditorTabSizeText, UpdateSourceTrigger=PropertyChanged}" Width="80"
                         AutomationProperties.Name="タブ幅" />
            </StackPanel>
            <CheckBox Content="タブの代わりにスペースを挿入する（検出不能時の既定値）" IsChecked="{Binding EditorInsertSpaces}"
                      Margin="0,0,0,10" AutomationProperties.Name="タブの代わりにスペースを挿入する" />
            <CheckBox Content="ファイルを開いた時点で優勢なインデントを自動検出する" IsChecked="{Binding EditorDetectIndent}"
                      Margin="0,0,0,10" AutomationProperties.Name="ファイルのインデントを自動検出する" />

            <TextBlock Text="編集支援" Style="{StaticResource SectionHeading}" />
            <CheckBox Content="括弧の自動閉じと対応括弧の強調を行う" IsChecked="{Binding EditorAutoClosingBrackets}"
                      Margin="0,0,0,10" AutomationProperties.Name="括弧の自動閉じと対応括弧の強調を行う" />
            <CheckBox Content="コードの折りたたみを有効にする" IsChecked="{Binding EditorFolding}" Margin="0,0,0,10"
                      AutomationProperties.Name="コードの折りたたみを有効にする" />
            <CheckBox Content="単語ベースの簡易補完を有効にする" IsChecked="{Binding EditorCompletion}" Margin="0,0,0,10"
                      AutomationProperties.Name="単語ベースの簡易補完を有効にする" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
