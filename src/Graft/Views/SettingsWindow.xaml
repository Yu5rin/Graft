<Window x:Class="Graft.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Graft.Views"
        xmlns:settings="clr-namespace:Graft.Views.SettingsPanels"
        Title="設定"
        Width="880" Height="680" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        AutomationProperties.Name="設定">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:InverseBooleanConverter x:Key="InverseBool" />
        <local:NullToVisibilityConverter x:Key="NullToVis" />
        <local:IssueToDisplayTextConverter x:Key="IssueToText" />
        <local:CollectionCountToVisibilityConverter x:Key="CountToVis" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource PaneHeadingFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource PaneHeadingFontWeight}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding SelectionBoxItem}" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <Grid Margin="8,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" />
                                                <Path Grid.Column="1" Data="M0,0 L8,0 L4,6 Z"
                                                      Fill="{DynamicResource TextSecondary}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Accent}"
                                    BorderThickness="{DynamicResource FocusRingBorderThickness}"
                                    IsHitTestVisible="False" Opacity="0" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="None">
                                <Border Background="{DynamicResource BgElevated}"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GraftBusyBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="2" />
            <Setter Property="IsIndeterminate" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="4" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSelected}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bg" Background="{DynamicResource BgSurface}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Accent}"
                                    BorderThickness="{DynamicResource FocusRingBorderThickness}"
                                    IsHitTestVisible="False" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelected}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0" Style="{StaticResource GraftBusyBarStyle}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <ItemsControl Grid.Row="1" Margin="16,10,16,0" ItemsSource="{Binding ValidationIssues}"
                      Visibility="{Binding ValidationIssues, Converter={StaticResource CountToVis}}"
                      AutomationProperties.Name="設定の検証結果">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource StateWarn}" BorderThickness="1" Padding="8" Margin="0,0,0,4">
                        <TextBlock Foreground="{DynamicResource StateWarn}" TextWrapping="Wrap"
                                   Text="{Binding Converter={StaticResource IssueToText}}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl Grid.Row="2" Margin="16,12,16,12" TabStripPlacement="Left">

            <TabItem Header="一般" AutomationProperties.Name="一般設定タブ">
                <settings:GeneralSettingsView />
            </TabItem>

            <TabItem Header="マッチング" AutomationProperties.Name="マッチング設定タブ">
                <settings:MatchingSettingsView />
            </TabItem>

            <TabItem Header="安全機構" AutomationProperties.Name="安全機構設定タブ">
                <settings:SafetySettingsView />
            </TabItem>

            <TabItem Header="表示・コンテキスト" AutomationProperties.Name="表示・コンテキスト設定タブ">
                <settings:DiffSettingsView />
            </TabItem>

            <TabItem Header="プロンプトテンプレート" AutomationProperties.Name="プロンプトテンプレート設定タブ">
                <settings:TemplateSettingsView />
            </TabItem>

            <TabItem Header="トークン統計" AutomationProperties.Name="トークン統計タブ">
                <Grid DataContext="{Binding TokenStats}" Margin="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" Style="{StaticResource GraftBusyBarStyle}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="プロジェクト" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Projects}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProject}" AutomationProperties.Name="集計対象プロジェクト" />
                        <TextBlock Text="集計単位" Style="{StaticResource FieldLabel}" Margin="24,0,0,0" />
                        <ComboBox ItemsSource="{Binding Granularities}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Granularity}"
                                  AutomationProperties.Name="集計単位" />
                        <Button Content="更新" Command="{Binding RefreshCommand}" Margin="24,0,0,0"
                                AutomationProperties.Name="トークン統計を更新" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ListView ItemsSource="{Binding Buckets}" AutomationProperties.Name="期間別トークン統計"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="期間" DisplayMemberBinding="{Binding Label}" Width="160" />
                                    <GridViewColumn Header="推定トークン数" DisplayMemberBinding="{Binding Tokens}" Width="140" />
                                    <GridViewColumn Header="削減できた推定トークン数" DisplayMemberBinding="{Binding SavedTokens}" Width="180" />
                                    <GridViewColumn Header="リビジョン数" DisplayMemberBinding="{Binding Revisions}" Width="120" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource IconHistoryGeometry}" Style="{StaticResource IconPathStyle}"
                                  Width="32" Height="32" Opacity="0.4" HorizontalAlignment="Center" />
                            <TextBlock Text="このプロジェクトのリビジョンがまだありません" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource StateError}" BorderThickness="1" Padding="8"
                                VerticalAlignment="Top" Margin="0,0,0,0"
                                Visibility="{Binding ErrorIssue, Converter={StaticResource NullToVis}}">
                            <TextBlock Foreground="{DynamicResource StateError}" TextWrapping="Wrap"
                                       Text="{Binding ErrorIssue, Converter={StaticResource IssueToText}}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalTokens, StringFormat=推定トークン数 合計: {0}}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding TotalSavedTokens, StringFormat=削減できた推定トークン数 合計: {0}}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding TotalRevisions, StringFormat=リビジョン数 合計: {0}}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="JSON編集" AutomationProperties.Name="設定JSON直接編集タブ">
                <settings:RawJsonSettingsView />
            </TabItem>

            <TabItem Header="バージョン情報" AutomationProperties.Name="バージョン情報タブ">
                <local:AboutView />
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" />
            <Button Grid.Column="1" Content="保存" Command="{Binding SaveCommand}" Margin="0,0,8,0" IsDefault="True"
                    AutomationProperties.Name="設定を保存" />
            <Button Grid.Column="2" Content="閉じる" Click="OnCloseClicked"
                    AutomationProperties.Name="設定を閉じる" />
        </Grid>
    </Grid>
</Window>
