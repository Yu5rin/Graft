<Window x:Class="Graft.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Graft.ViewModels"
        xmlns:local="clr-namespace:Graft.Views"
        Title="設定"
        Width="880" Height="680" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        AutomationProperties.Name="設定">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:InverseBooleanConverter x:Key="InverseBool" />
        <local:NullToVisibilityConverter x:Key="NullToVis" />
        <local:IssueToDisplayTextConverter x:Key="IssueToText" />
        <local:CollectionCountToVisibilityConverter x:Key="CountToVis" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource PaneHeadingFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource PaneHeadingFontWeight}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding SelectionBoxItem}" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <Grid Margin="8,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" />
                                                <Path Grid.Column="1" Data="M0,0 L8,0 L4,6 Z"
                                                      Fill="{DynamicResource TextSecondary}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Accent}"
                                    BorderThickness="{DynamicResource FocusRingBorderThickness}"
                                    IsHitTestVisible="False" Opacity="0" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="None">
                                <Border Background="{DynamicResource BgElevated}"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GraftBusyBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="2" />
            <Setter Property="IsIndeterminate" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="4" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSelected}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bg" Background="{DynamicResource BgSurface}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource Accent}"
                                    BorderThickness="{DynamicResource FocusRingBorderThickness}"
                                    IsHitTestVisible="False" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelected}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0" Style="{StaticResource GraftBusyBarStyle}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <ItemsControl Grid.Row="1" Margin="16,10,16,0" ItemsSource="{Binding ValidationIssues}"
                      Visibility="{Binding ValidationIssues, Converter={StaticResource CountToVis}}"
                      AutomationProperties.Name="設定の検証結果">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource StateWarn}" BorderThickness="1" Padding="8" Margin="0,0,0,4">
                        <TextBlock Foreground="{DynamicResource StateWarn}" TextWrapping="Wrap"
                                   Text="{Binding Converter={StaticResource IssueToText}}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl Grid.Row="2" Margin="16,12,16,12" TabStripPlacement="Left">

            <TabItem Header="一般" AutomationProperties.Name="一般設定タブ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
                    <StackPanel>
                        <TextBlock Text="一般" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="テーマ" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Value"
                                      DisplayMemberPath="Label" SelectedValue="{Binding SelectedTheme}"
                                      AutomationProperties.Name="テーマ" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="適用モード" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ApplyModeOptions}" SelectedValuePath="Value"
                                      DisplayMemberPath="Label" SelectedValue="{Binding SelectedApplyMode}"
                                      AutomationProperties.Name="適用モード" />
                        </StackPanel>
                        <CheckBox Content="適用前にプレビューを表示する" IsChecked="{Binding ShowPreview}"
                                  Margin="0,0,0,10" AutomationProperties.Name="適用前にプレビューを表示する" />
                        <CheckBox Content="パッチメタデータのsummaryを必須にする" IsChecked="{Binding RequireSummary}"
                                  Margin="0,0,0,10" AutomationProperties.Name="パッチメタデータのsummaryを必須にする" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="グローバルホットキー" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" Width="220"
                                     AutomationProperties.Name="グローバルホットキー" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="ログレベル" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding LogLevelOptions}" SelectedValuePath="Value"
                                      DisplayMemberPath="Label" SelectedValue="{Binding SelectedLogLevel}"
                                      AutomationProperties.Name="ログレベル" />
                        </StackPanel>

                        <TextBlock Text="エクスポート／インポート" Style="{StaticResource SectionHeading}" />
                        <CheckBox Content="設定のみを対象にする（プロジェクト定義を除外）" IsChecked="{Binding ExportSettingsOnly}"
                                  Margin="0,0,0,10" AutomationProperties.Name="設定のみを対象にする" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="エクスポート" Command="{Binding ExportCommand}" Margin="0,0,8,0"
                                    AutomationProperties.Name="設定をエクスポート" />
                            <Button Content="インポート" Command="{Binding ImportCommand}"
                                    AutomationProperties.Name="設定をインポート" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="マッチング・安全" AutomationProperties.Name="マッチング・安全設定タブ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
                    <StackPanel>
                        <TextBlock Text="マッチングエンジン" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="類似度マッチの閾値（0〜1）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SimilarityThresholdText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                     AutomationProperties.Name="類似度マッチの閾値" />
                        </StackPanel>
                        <CheckBox Content="類似度マッチ（段階5）を許可する" IsChecked="{Binding AllowSimilarityMatch}"
                                  Margin="0,0,0,10" AutomationProperties.Name="類似度マッチを許可する" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="アンカー範囲の警告閾値（行）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RangeWarningLinesText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                     AutomationProperties.Name="アンカー範囲の警告閾値" />
                        </StackPanel>

                        <TextBlock Text="安全機構" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="許可する拡張子（カンマ区切り）" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"
                                   FontSize="{DynamicResource CaptionFontSize}" />
                        <TextBox Text="{Binding AllowedExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,10"
                                 AutomationProperties.Name="許可する拡張子" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="1ファイルの上限サイズ（MB）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxFileSizeMBText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                     AutomationProperties.Name="1ファイルの上限サイズ" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="1リビジョンの上限ファイル数" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxFilesPerRevisionText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                     AutomationProperties.Name="1リビジョンの上限ファイル数" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="バックアップ・Git" AutomationProperties.Name="バックアップ・Git設定タブ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
                    <StackPanel>
                        <TextBlock Text="バックアップ・世代管理" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="最大保持リビジョン数（0で無制限）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxRevisionsText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                     AutomationProperties.Name="最大保持リビジョン数" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="バックアップ合計上限（MB、0で無制限）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxTotalMBText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                     AutomationProperties.Name="バックアップ合計上限" />
                        </StackPanel>
                        <CheckBox Content="世代整理でごみ箱を使用する" IsChecked="{Binding UseRecycleBin}" Margin="0,0,0,10"
                                  AutomationProperties.Name="世代整理でごみ箱を使用する" />

                        <TextBlock Text="Git連携" Style="{StaticResource SectionHeading}" />
                        <CheckBox Content="適用後に自動コミットする" IsChecked="{Binding AutoCommit}" Margin="0,0,0,10"
                                  AutomationProperties.Name="適用後に自動コミットする" />

                        <TextBlock Text="適用後フック" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="フックのタイムアウト（秒）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding HooksTimeoutSecText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                     AutomationProperties.Name="フックのタイムアウト秒数" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="表示・コンテキスト" AutomationProperties.Name="表示・コンテキスト設定タブ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
                    <StackPanel>
                        <TextBlock Text="シンタックスハイライト" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                        <CheckBox Content="シンタックスハイライトを有効にする" IsChecked="{Binding SyntaxEnabled}" Margin="0,0,0,10"
                                  AutomationProperties.Name="シンタックスハイライトを有効にする" />
                        <CheckBox Content="行番号を表示する" IsChecked="{Binding ShowLineNumbers}" Margin="0,0,0,10"
                                  AutomationProperties.Name="行番号を表示する" />

                        <TextBlock Text="diff表示" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="前後のコンテキスト行数" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ContextLinesText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                     AutomationProperties.Name="前後のコンテキスト行数" />
                        </StackPanel>
                        <CheckBox Content="長い行を折り返す" IsChecked="{Binding WordWrap}" Margin="0,0,0,10"
                                  AutomationProperties.Name="長い行を折り返す" />
                        <CheckBox Content="空白文字を可視化する" IsChecked="{Binding ShowWhitespace}" Margin="0,0,0,10"
                                  AutomationProperties.Name="空白文字を可視化する" />

                        <TextBlock Text="コンテキスト収集" Style="{StaticResource SectionHeading}" />
                        <CheckBox Content=".gitignoreを尊重する" IsChecked="{Binding RespectGitignore}" Margin="0,0,0,10"
                                  AutomationProperties.Name="gitignoreを尊重する" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="トークン概算比率（文字数÷この値）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TokenRatioText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                     AutomationProperties.Name="トークン概算比率" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="トークン数の警告閾値" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TokenWarnThresholdText, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                     AutomationProperties.Name="トークン数の警告閾値" />
                        </StackPanel>

                        <TextBlock Text="新規ファイル" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="エンコーディング" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NewFileEncoding, UpdateSourceTrigger=PropertyChanged}" Width="160"
                                     AutomationProperties.Name="新規ファイルのエンコーディング" />
                        </StackPanel>
                        <CheckBox Content="BOMを付与する" IsChecked="{Binding NewFileBom}" Margin="0,0,0,10"
                                  AutomationProperties.Name="新規ファイルにBOMを付与する" />

                        <TextBlock Text="クリップボード監視" Style="{StaticResource SectionHeading}" />
                        <CheckBox Content="クリップボード監視を有効にする" IsChecked="{Binding ClipboardWatchEnabled}" Margin="0,0,0,10"
                                  AutomationProperties.Name="クリップボード監視を有効にする" />
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="反応時の挙動" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ClipboardActionOptions}" SelectedValuePath="Value"
                                      DisplayMemberPath="Label" SelectedValue="{Binding SelectedClipboardAction}"
                                      AutomationProperties.Name="クリップボード監視反応時の挙動" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="プロンプトテンプレート" AutomationProperties.Name="プロンプトテンプレート設定タブ">
                <Grid DataContext="{Binding Templates}" Margin="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="プレビュー対象プロジェクト" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Projects}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProject}" AutomationProperties.Name="プレビュー対象プロジェクト" />
                        <CheckBox Content="継続用（短縮版）でコピーする" IsChecked="{Binding IsContinuationMode}"
                                  Margin="24,0,0,0" VerticalAlignment="Center"
                                  AutomationProperties.Name="継続用の短縮版でコピーする" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                                 AutomationProperties.Name="テンプレート一覧">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TemplateEntry}">
                                    <Grid AutomationProperties.Name="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="{DynamicResource CaptionFontSize}"
                                                   Text="{Binding EstimatedTokens, StringFormat=約{0}トークン}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" />

                        <Grid Grid.Column="2" DataContext="{Binding SelectedTemplate}" Margin="8,0,0,0"
                              Visibility="{Binding Converter={StaticResource NullToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsBuiltIn}" Margin="0,0,0,8"
                                     AutomationProperties.Name="テンプレート名" />
                            <TextBox Grid.Row="1" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsBuiltIn}" AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource CodeFontSize}"
                                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="テンプレート本文" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="保存" Command="{Binding DataContext.Templates.SaveEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBool}}"
                                        Margin="0,0,8,0" AutomationProperties.Name="テンプレートを保存" />
                                <Button Content="削除" Command="{Binding DataContext.Templates.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBool}}"
                                        Margin="0,0,8,0" AutomationProperties.Name="テンプレートを削除" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="テンプレートを追加" Command="{Binding AddCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="テンプレートを追加" />
                        <Button Content="コピー" Command="{Binding CopyCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="テンプレートをコピー" />
                        <Button Content="プロジェクトの既定に設定" Command="{Binding SetAsProjectDefaultCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="プロジェクトの既定テンプレートに設定" />
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="トークン統計" AutomationProperties.Name="トークン統計タブ">
                <Grid DataContext="{Binding TokenStats}" Margin="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" Style="{StaticResource GraftBusyBarStyle}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="プロジェクト" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Projects}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProject}" AutomationProperties.Name="集計対象プロジェクト" />
                        <TextBlock Text="集計単位" Style="{StaticResource FieldLabel}" Margin="24,0,0,0" />
                        <ComboBox ItemsSource="{Binding Granularities}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Granularity}"
                                  AutomationProperties.Name="集計単位" />
                        <Button Content="更新" Command="{Binding RefreshCommand}" Margin="24,0,0,0"
                                AutomationProperties.Name="トークン統計を更新" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ListView ItemsSource="{Binding Buckets}" AutomationProperties.Name="期間別トークン統計"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="期間" DisplayMemberBinding="{Binding Label}" Width="160" />
                                    <GridViewColumn Header="推定トークン数" DisplayMemberBinding="{Binding Tokens}" Width="140" />
                                    <GridViewColumn Header="削減できた推定トークン数" DisplayMemberBinding="{Binding SavedTokens}" Width="180" />
                                    <GridViewColumn Header="リビジョン数" DisplayMemberBinding="{Binding Revisions}" Width="120" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource IconHistoryGeometry}" Style="{StaticResource IconPathStyle}"
                                  Width="32" Height="32" Opacity="0.4" HorizontalAlignment="Center" />
                            <TextBlock Text="このプロジェクトのリビジョンがまだありません" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource StateError}" BorderThickness="1" Padding="8"
                                VerticalAlignment="Top" Margin="0,0,0,0"
                                Visibility="{Binding ErrorIssue, Converter={StaticResource NullToVis}}">
                            <TextBlock Foreground="{DynamicResource StateError}" TextWrapping="Wrap"
                                       Text="{Binding ErrorIssue, Converter={StaticResource IssueToText}}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalTokens, StringFormat=推定トークン数 合計: {0}}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding TotalSavedTokens, StringFormat=削減できた推定トークン数 合計: {0}}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding TotalRevisions, StringFormat=リビジョン数 合計: {0}}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="JSON編集" AutomationProperties.Name="設定JSON直接編集タブ">
                <Grid Margin="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="settings.json を直接編集できます。保存時に検証し、不正な値は既定値へフォールバックします。"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                    <TextBox Grid.Row="1" Text="{Binding JsonText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource CodeFontSize}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="settings.jsonの内容" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="検証して保存" Command="{Binding SaveJsonCommand}"
                                AutomationProperties.Name="JSONを検証して保存" />
                        <TextBlock Text="{Binding JsonParseError}" Foreground="{DynamicResource StateError}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding JsonParseError, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="バージョン情報" AutomationProperties.Name="バージョン情報タブ">
                <local:AboutView />
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" />
            <Button Grid.Column="1" Content="保存" Command="{Binding SaveCommand}" Margin="0,0,8,0" IsDefault="True"
                    AutomationProperties.Name="設定を保存" />
            <Button Grid.Column="2" Content="閉じる" Click="OnCloseClicked" IsCancel="True"
                    AutomationProperties.Name="設定を閉じる" />
        </Grid>
    </Grid>
</Window>
