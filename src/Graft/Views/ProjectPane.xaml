<UserControl x:Class="Graft.Views.ProjectPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Graft.Views"
             mc:Ignorable="d"
             Background="{DynamicResource BgSurface}"
             d:DesignHeight="260" d:DesignWidth="240">
    <UserControl.Resources>
        <local:ProjectPaneStateConverter x:Key="StateConverter" />
        <local:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 見出し（12px SemiBold）とプロジェクト追加ボタン -->
        <Grid Grid.Row="0" Margin="12,10,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="プロジェクト"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource PaneHeadingFontSize}"
                       FontWeight="{DynamicResource PaneHeadingFontWeight}"
                       Foreground="{DynamicResource TextSecondary}" />
            <Button Grid.Column="1"
                    Command="{Binding AddProjectCommand}"
                    Padding="4"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip="プロジェクトを追加"
                    AutomationProperties.Name="プロジェクトを追加（フォルダ選択）">
                <Path Data="{StaticResource IconFolderGeometry}" Style="{StaticResource IconPathStyle}" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListBox x:Name="ProjectListBox"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     AllowDrop="True"
                     DragEnter="OnDragEnter"
                     Drop="OnDrop"
                     Background="{x:Null}"
                     AutomationProperties.Name="プロジェクト一覧">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 数字キーショートカットのバッジ（上位9件のみ、仕様書3.2） -->
                            <Border Grid.Column="0"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="{DynamicResource BgHover}"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding ShortcutText, Converter={StaticResource EmptyToVisibility}}">
                                <TextBlock Text="{Binding ShortcutText}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="{DynamicResource BodyFontSize}" Text="{Binding Name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <!-- 3.2: 未接続プロジェクトはグレー表示（色のみに依存しないよう、
                                                     一覧の下段テキストと読み上げ内容にも「未接続」を明示する） -->
                                                <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TagsText}"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Visibility="{Binding TagsText, Converter={StaticResource EmptyToVisibility}}" />
                                <TextBlock Text="未接続"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource StateWarn}"
                                           Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <local:EmptyStateView State="{Binding State, Converter={StaticResource StateConverter}}"
                                   IconGeometry="{StaticResource IconLayersGeometry}"
                                   Message="プロジェクトがありません。フォルダをドラッグ＆ドロップ、または追加ボタンで登録してください"
                                   ActionText="フォルダを追加"
                                   ActionCommand="{Binding AddProjectCommand}"
                                   Issue="{Binding Error}" />
        </Grid>
    </Grid>
</UserControl>
