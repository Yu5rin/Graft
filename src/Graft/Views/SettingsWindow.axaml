<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Graft.Views"
        xmlns:settings="clr-namespace:Graft.Views.SettingsPanels"
        x:Class="Graft.Views.SettingsWindow"
        Title="設定"
        Width="940" Height="720" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        AutomationProperties.Name="設定">
    <!--
        14章 設定画面。v2.0のWPF版からの差分:
        - 各タブ共通の書式（fieldLabel/fieldRow/sectionHeading）は Themes/Settings.axaml の
          クラスとしてApp.Stylesへ入れているため、v2.0のWPF版が必要としていた専用の
          リソース辞書（SettingsPanelResources.xaml）を両側からマージする回避策は不要になった。
        - TabControl/TabItem/ListBoxItem の書式は共通テーマ側が持つため重複定義しない。
        - トークン統計の表は ListView + GridView がAvaloniaに無いため、
          DataGrid を使わず ListBox ＋ 桁を揃えたテンプレートで表現する
          （別パッケージ Avalonia.Controls.DataGrid を増やさないため。附録A.2 依存最小化）。
        - Visibility は IsVisible（bool）へ。

        タブの再編（settings.json のキー・値・既定値は変えず、画面の構成と文言だけを変えた）:
        旧「一般」に適用・履歴・Git・保存先・書き出しまでが同居して約2000pxの縦長になり、タブ名も
        内部の言葉（安全機構・JSON編集・適用後フック）だったため、利用者の作業の単位で組み替えた。
        左の縦並びの一覧（TabStripPlacement=Left）は従来のまま使う。12本でも、窓の高さ720pxに
        収まることを実機（Xvfb）で確認している。
        旧タブ → 新タブ:
          一般              → 一般（表示・起動と常駐・キー）／適用と履歴／詳細（ログレベル・書き出し）／
                              適用後に実行するコマンド（制限時間）
          エディタ          → エディタ（文字の大きさだけ「一般」の表示へ）
          マッチング        → 適用の制限
          安全機構          → 適用の制限
          表示・コンテキスト → 差分の表示／AIに渡す内容／適用と履歴（新規ファイル）／クリップボード監視
          プロンプトテンプレート → 依頼文のテンプレート
          適用後フック      → 適用後に実行するコマンド
          トークン統計      → 統計
          JSON編集          → 詳細（settings.json）
          バージョン情報    → 更新とバージョン情報
    -->
    <Window.Styles>
        <!-- 各タブ共通の「項目」の書式（見出し → ラベル・説明・入力）。統計タブも同じ型で組む。 -->
        <StyleInclude Source="avares://Graft/Views/SettingsPanels/SettingsPanelStyles.axaml" />
        <!-- トークン統計の表。見出し行と各行で同じ桁幅を使う。 -->
        <Style Selector="TextBlock.statCell">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.statHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="2,Auto,*,Auto">

        <!-- 8.8: アクセント色の細い不確定プログレスバー。 -->
        <ProgressBar Grid.Row="0" Height="2" IsIndeterminate="True"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Accent}"
                     IsVisible="{Binding IsBusy}" />

        <ItemsControl Grid.Row="1" Margin="16,10,16,0" ItemsSource="{Binding ValidationIssues}"
                      IsVisible="{Binding ValidationIssues, Converter={x:Static local:Converters.HasItems}}"
                      AutomationProperties.Name="設定の検証結果">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource StateWarn}" BorderThickness="1" Padding="8" Margin="0,0,0,4">
                        <TextBlock Foreground="{DynamicResource StateWarn}" TextWrapping="Wrap"
                                   Text="{Binding Converter={x:Static local:Converters.IssueToText}}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
            細かいユーザビリティ改善5（ダイアログのキー操作総点検）: 即時反映方式のため単一の
            「OK」に相当する既定ボタンは持たない（下部の「既定に戻す」は破壊的操作のため
            意図的にIsDefaultを与えていない。上のコメント参照）。開いた直後の初期フォーカスは、
            最初に操作するであろうカテゴリタブへ当てる（SettingsWindow.axaml.cs参照）。
        -->
        <TabControl x:Name="CategoryTabControl" Grid.Row="2" Margin="16,12,16,12" TabStripPlacement="Left"
                    Background="Transparent" BorderThickness="0">

            <TabItem x:Name="GeneralTabItem" Header="一般" AutomationProperties.Name="一般設定タブ"
                     local:HelpTip.Standard="テーマ・フォント・文字の大きさ、起動と常駐、キーなど、アプリ全体の基本設定です。"
                     local:HelpTip.Detailed="見た目（テーマ・フォント・エディタの文字の大きさ）、ウィンドウを閉じたときや起動時の動き、ホットキーをまとめています。迷ったらまずここを確認してください。">
                <settings:GeneralSettingsView />
            </TabItem>
            <TabItem Header="適用と履歴" AutomationProperties.Name="適用と履歴設定タブ"
                     local:HelpTip.Standard="パッチを適用するときの動き、履歴とバックアップの残し方、新規ファイルの書き方、Git、データの保存場所です。"
                     local:HelpTip.Detailed="適用モード・適用前のプレビュー・要約の入力、履歴とバックアップをどれだけ残すか、新しく作るファイルの文字コードと改行、適用後の自動コミット、設定や履歴を置く場所を設定します。">
                <settings:ApplySettingsView />
            </TabItem>
            <TabItem Header="適用の制限" AutomationProperties.Name="適用の制限設定タブ"
                     local:HelpTip.Standard="適用を止める条件（拡張子・大きさ・ファイル数）と、変更を当てはめるときの判定の厳しさを決めます。"
                     local:HelpTip.Detailed="意図しない大量の書き換えや対象外のファイルへの適用を防ぐための上限値（許可する拡張子、1ファイルの上限サイズ、1回に書き換えられるファイル数）と、AIが示した変更を実際のコードに当てはめるときの一致率などを設定します。ゆるめるとAIの誤った回答による被害の範囲が広がりやすくなるため、変更する際は内容をよく理解した上で行ってください。">
                <settings:SafetySettingsView />
            </TabItem>
            <TabItem Header="差分の表示" AutomationProperties.Name="差分の表示設定タブ"
                     local:HelpTip.Standard="適用前のプレビューなどに出る差分の見え方（左右に並べる・折り返し・空白・前後の行数）です。"
                     local:HelpTip.Detailed="変更前と変更後を左右に並べるか上下に統合するか、長い行の折り返し、空白の可視化、行番号、コードの色分け、変更箇所の前後に何行見せるかを設定します。">
                <settings:DiffSettingsView />
            </TabItem>
            <TabItem Header="エディタ" AutomationProperties.Name="エディタ設定タブ"
                     local:HelpTip.Standard="中央のコード編集領域の見た目・インデント・入力の補助の設定です。"
                     local:HelpTip.Detailed="ファイルを開いたときの中央のエディタ領域について、折り返しや行番号などの表示、タブ幅などのインデント、括弧の自動閉じや折りたたみなどの入力の補助を調整します。文字の大きさは「一般」タブにあります。">
                <settings:EditorSettingsView />
            </TabItem>
            <TabItem Header="AIに渡す内容" AutomationProperties.Name="AIに渡す内容の設定タブ"
                     local:HelpTip.Standard="「ファイル」画面でAIへ渡す内容を集めるときの、対象・除外・大きさの目安の設定です。"
                     local:HelpTip.Detailed=".gitignoreを尊重するか、依頼文のコピーに選んだファイルも付けるか、渡す量（トークン数）をどう概算してどこから「大きすぎる」と知らせるかを設定します。">
                <settings:ContextSettingsView />
            </TabItem>
            <TabItem Header="クリップボード監視" AutomationProperties.Name="クリップボード監視設定タブ"
                     local:HelpTip.Standard="AIの回答らしき内容がコピーされたことを自動で見つける機能の設定です。"
                     local:HelpTip.Detailed="監視を使うかどうかと、見つけたときの知らせ方・自動で解析するか・ウィンドウを前面に出すかを設定します。既定はオフです。">
                <settings:ClipboardSettingsView />
            </TabItem>
            <TabItem Header="依頼文のテンプレート" AutomationProperties.Name="依頼文のテンプレート設定タブ"
                     local:HelpTip.Standard="AIへの依頼文のひな形を追加・編集します。コマンドバーの「依頼文」ボタンで使われます。"
                     local:HelpTip.Detailed="コマンドバーの「依頼文」ボタンでコピーされる、AIへの依頼文のひな形を管理します。Graftが読み取れる形式で回答するよう指示する文面で、プロジェクトごとに既定のテンプレートを分けることもできます。">
                <settings:TemplateSettingsView />
            </TabItem>
            <TabItem Header="適用後に実行するコマンド" AutomationProperties.Name="適用後に実行するコマンド設定タブ"
                     local:HelpTip.Standard="パッチの適用が成功した直後に、リンターなどのコマンドを自動で実行する設定です。"
                     local:HelpTip.Detailed="適用が成功するたびに自動実行したいコマンド（リンター・フォーマッタなど）を、プロジェクトごとに登録します。コマンドは実際にファイルを書き換えられるため、内容をよく確認してから登録してください。">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <settings:HookSettingsView />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="統計" AutomationProperties.Name="統計タブ"
                     local:HelpTip.Standard="これまでAIとのやり取りで使ったおおよそのトークン数（AIが文章を数える単位）を、期間ごとに確認できます。"
                     local:HelpTip.Detailed="AIに渡した内容やパッチ適用でやり取りした内容から見積もった、AIのトークン消費量の推移を確認できます。実際にAIへ送って数えた値ではなく、文字数からの概算です（見積もり方法は「AIに渡す内容」タブの「トークン数の概算比率」）。AIの利用量を把握したいときの目安として使ってください。">
                <!--
                    項目1: 元は「プロジェクト」ラベル→ComboBox→「集計単位」ラベルの並びをStackPanel
                    (Orientation="Horizontal")で並べていたため、既定サイズ880x680・fieldLabelの
                    MinWidth=280（Themes/Settings.axaml）と相まって右端に達し、「集計単位」の
                    ComboBoxと「更新」ボタンが画面外に出て操作できなかった（1340pxまで広げると
                    現れることを実機Xvfbで確認済み）。HookSettingsView.axaml:19に倣いWrapPanelにして
                    幅が足りないときは2段目へ折り返す形にする。ラベルとComboBoxは
                    ペアで1つのStackPanelにまとめ、折り返してもラベルとComboBoxが離ればなれに
                    ならないようにする。あわせてタブ全体をScrollViewerで包み、折り返しで縦に
                    伸びても・狭いMinHeightでも「更新」ボタンまで確実に辿り着けるようにする
                    （他の設定タブは包んであるのに、この2つだけ包んでいなかった）。
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid DataContext="{Binding TokenStats}" Margin="16,8" RowDefinitions="2,Auto,Auto,Auto,Auto">

                    <ProgressBar Grid.Row="0" Height="2" IsIndeterminate="True"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Accent}"
                                 IsVisible="{Binding IsBusy}" />

                    <!--
                        他のタブと同じ「見出し → 項目（ラベル・説明・入力）」の型に揃えた。以前はラベルを
                        fieldLabel（最小幅280px）で横に並べたため、幅が足りないと「集計単位」と「更新」が
                        2段目へ折り返していた。縦積みにして、折り返しに頼らないようにしている。
                    -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="トークンの使用量（概算）" Classes="sectionHeading first" />
                        <TextBlock Text="プロジェクトごとに、これまでの適用で使ったおおよそのトークン数（AIが文章を数える単位）を期間別に表示します。"
                                   Classes="settingHint" Margin="0,0,0,12" />
                        <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                            <StackPanel Classes="settingText">
                                <TextBlock Text="プロジェクト" Classes="settingLabel" />
                                <TextBlock Text="集計するプロジェクトです。" Classes="settingHint" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="medium" ItemsSource="{Binding Projects}"
                                      ItemTemplate="{StaticResource NameItemTemplate}"
                                      SelectedItem="{Binding SelectedProject}"
                                      AutomationProperties.Name="集計対象プロジェクト"
                                      local:HelpTip.Standard="集計するプロジェクトを選びます。"
                                      local:HelpTip.Detailed="下の表・合計に表示する集計対象のプロジェクトを選びます。プロジェクトごとに履歴が別々に記録されているため、複数プロジェクトの合計は表示されません。" />
                        </Grid>
                        <Grid Classes="settingItem" ColumnDefinitions="*,Auto">
                            <StackPanel Classes="settingText">
                                <TextBlock Text="集計単位" Classes="settingLabel" />
                                <TextBlock Text="表を、日ごと・週ごと・月ごとのどれで区切るかです。" Classes="settingHint" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="medium" ItemsSource="{Binding Granularities}"
                                      ItemTemplate="{StaticResource LabelItemTemplate}"
                                      SelectedValueBinding="{Binding Value}" SelectedValue="{Binding Granularity}"
                                      AutomationProperties.Name="集計単位"
                                      local:HelpTip.Standard="下の表を日ごと・週ごと・月ごとのどれで区切って表示するかです。"
                                      local:HelpTip.Detailed="下の表の「期間」列を、日単位・週単位・月単位のどの粒度でまとめるかを選びます。選び直すと表がその場で更新されます。" />
                        </Grid>
                        <Button Content="更新" Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="統計を更新"
                                local:HelpTip.Standard="履歴から最新の集計を読み直します。"
                                local:HelpTip.Detailed="このプロジェクトの履歴を読み直し、下の表と合計を最新の内容に更新します。この画面を開いたあとに別の操作でパッチを適用した場合など、表示が古いと感じたら押してください。" />
                    </StackPanel>

                    <!-- 表の見出し行。桁幅は各行のテンプレートと合わせる。 -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                            Background="{DynamicResource BgSurface}"
                            IsVisible="{Binding !IsEmpty}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="statHeader" Text="期間" Width="160" />
                            <TextBlock Classes="statHeader" Text="推定トークン数" Width="140" />
                            <TextBlock Classes="statHeader" Text="削減できた推定トークン数" Width="180" />
                            <TextBlock Classes="statHeader" Text="履歴の件数" Width="120" />
                        </StackPanel>
                    </Border>

                    <!--
                        項目1の付随修正: このタブ自体をScrollViewerで包んだため、下のリストは
                        RowDefinitionsの"*"（残り全部）ではなく、必要な高さぶんだけを要求する
                        "Auto"扱いになる（ScrollViewer配下では星指定は高さ無限大の中で評価され、
                        実質Autoと同じに振る舞う）。空状態のアイコン＋文言が窮屈にならないよう
                        MinHeightで最低限の高さを確保する。
                    -->
                    <Grid Grid.Row="3" MinHeight="160">
                        <ListBox ItemsSource="{Binding Buckets}" AutomationProperties.Name="期間別トークン統計"
                                 Background="{DynamicResource BgSurface}" BorderThickness="0"
                                 IsVisible="{Binding !IsEmpty}"
                                 local:HelpTip.Standard="選んだ期間ごとの、推定トークン数・削減できた推定トークン数・履歴の件数の一覧です。"
                                 local:HelpTip.Detailed="上で選んだプロジェクト・集計単位に応じて、期間ごとの推定トークン数を一覧表示します。「削減できた推定トークン数」は、AIに渡す内容から無駄なファイルを外せた分などの目安です。実際にAIへ送って数えた正確な値ではなく、文字数からの概算であることに注意してください。">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="statCell" Text="{Binding Label}" Width="160" />
                                        <TextBlock Classes="statCell" Text="{Binding Tokens}" Width="140" />
                                        <TextBlock Classes="statCell" Text="{Binding SavedTokens}" Width="180" />
                                        <TextBlock Classes="statCell" Text="{Binding Revisions}" Width="120" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 項目7: ここも手書きのアイコン＋文言（Opacity 0.4）だった空状態を
                             共通EmptyStateViewへ寄せる。 -->
                        <local:EmptyStateView AutomationProperties.Name="期間別トークン統計（0件）"
                                              IconGeometry="{DynamicResource IconHistoryGeometry}"
                                              Message="このプロジェクトの履歴がまだありません"
                                              State="{Binding IsEmpty, Converter={x:Static local:Converters.IsEmptyToEmptyState}}" />
                        <Border BorderBrush="{DynamicResource StateError}" BorderThickness="1" Padding="8"
                                VerticalAlignment="Top"
                                IsVisible="{Binding ErrorIssue, Converter={x:Static local:Converters.NotNull}}">
                            <TextBlock Foreground="{DynamicResource StateError}" TextWrapping="Wrap"
                                       Text="{Binding ErrorIssue, Converter={x:Static local:Converters.IssueToText}}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalTokens, StringFormat=推定トークン数 合計: {0}}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding TotalSavedTokens, StringFormat=削減できた推定トークン数 合計: {0}}"
                                   Margin="0,0,16,0" />
                        <TextBlock Text="{Binding TotalRevisions, StringFormat=履歴の件数 合計: {0}}" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="詳細（settings.json）" AutomationProperties.Name="詳細設定タブ"
                     local:HelpTip.Standard="ログレベルと設定の書き出し／読み込み、そして設定ファイル（settings.json）の直接編集です。普段は触らなくて構いません。"
                     local:HelpTip.Detailed="ログファイルの詳しさ、設定一式を別のPCへ持っていくための書き出し／読み込み、他のタブに無い細かい設定を調整するためのsettings.jsonの直接編集をまとめています。通常はここを使わなくても他のタブだけで設定できます。">
                <settings:RawJsonSettingsView />
            </TabItem>

            <TabItem Header="更新とバージョン情報" AutomationProperties.Name="更新とバージョン情報タブ"
                     local:HelpTip.Standard="Graftのバージョン番号の確認と、新しいバージョンの確認・更新ができます。"
                     local:HelpTip.Detailed="現在使っているGraftのバージョン番号、起動時の更新確認と自動更新の設定、ログの確認、使用ライブラリのライセンス表記をまとめています。不具合を報告する際にバージョンを聞かれたら、ここで確認してください。">
                <local:AboutView />
            </TabItem>
        </TabControl>

        <!--
            即時反映方式への移行で「保存」ボタンは撤去した（変更は変更した瞬間・またはTextBoxの
            フォーカスを外した瞬間に自動で保存される。SettingsViewModelのクラスドキュメント参照）。
            代わりに「触りすぎて分からなくなった」ときの逃げ道として「既定に戻す」を同じ位置へ
            置く。破壊的操作なのでIsDefault（Enterキーでの実行）は与えない。
        -->
        <Grid Grid.Row="3" Margin="16,0,16,16" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" />
            <Button Grid.Column="1" Content="既定に戻す" Command="{Binding ResetToDefaultsCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="設定を既定値に戻す"
                    local:HelpTip.Standard="この画面の設定をすべて既定値に戻します。確認のうえ実行され、実行後は元に戻せません。プロジェクトの登録や履歴は消えません。"
                    local:HelpTip.Detailed="設定は変更した瞬間に自動で保存され「保存しない」を選べないため、いろいろ触って分からなくなったときの逃げ道としてこのボタンを用意しています。押すと確認のダイアログが出て、OKするとテーマ・エディタ・適用の制限など、この設定画面（settings.json）の内容だけがすべて既定値に戻ります。登録済みのプロジェクト一覧、適用後に実行するコマンド、依頼文のテンプレート、これまでの適用履歴（バックアップ）は対象外で消えません。設定を戻した後にもう一度カスタマイズし直したい場合は、事前に「詳細（settings.json）」タブの「設定を書き出す」で今の内容を書き出しておくと安心です。" />
            <Button Grid.Column="2" Content="閉じる" Click="OnCloseClicked"
                    AutomationProperties.Name="設定を閉じる"
                    local:HelpTip.Standard="この設定画面を閉じます。ここまでの変更はすでに自動で保存済みです。"
                    local:HelpTip.Detailed="設定画面を閉じます。この画面の変更は操作した瞬間ごとに自動で保存されているため、閉じる前に別途保存する必要はありません。" />
        </Grid>
    </Grid>
</Window>
