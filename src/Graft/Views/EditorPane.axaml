<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:local="clr-namespace:Graft.Views"
             x:Class="Graft.Views.EditorPane"
             x:Name="Root"
             Background="{DynamicResource BgBase}">
    <!--
        エディタ領域（4章）。単一のAvaloniaEdit TextEditor を複数タブで使い回す。
        Themes/Editor.axaml は App.axaml のMergedDictionariesでアプリ全体へ読み込まれている。

        v2.0のWPF版からの差分:
        - Visibility は IsVisible（bool）へ。件数からの切り替えはコンバータで行う。
        - タブ見出しのDataTemplate.Triggers（プレビューのイタリック化・未保存ドット・
          ホバー時の閉じるボタン）は条件付きクラスとStyleセレクタで表現する。
          ホバー判定は :pointerover 疑似クラスをタブ項目側で受け、子要素へ波及させる。
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.tabTitle.preview">
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <!-- 未保存を示す点は、ホバー中は閉じるボタンと入れ替える（v2.0のWPF版と同じ挙動）。 -->
        <Style Selector="ListBoxItem:pointerover TextBlock.modifiedDot">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.tabClose">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ========== タブ見出し（4.3） ========== -->
        <ListBox x:Name="TabStrip"
                 Grid.Row="0"
                 Theme="{StaticResource EditorTabStripTheme}"
                 ItemContainerTheme="{StaticResource EditorTabItemTheme}"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                 IsVisible="{Binding Tabs.Count, Converter={x:Static local:Converters.CountIsNotZero}}"
                 AutomationProperties.Name="開いているファイルのタブ一覧">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- タブ見出しの右クリックメニュー。Command先はEditorPaneViewModel（Rootの
                         DataContext）、CommandParameterはこの項目自身（タブ）。ContextMenuは
                         配置対象（Border）の論理ツリーを共有するため、ElementName=Rootでの
                         参照はExplorerView.axamlのContextMenuと同様に機能する。 -->
                    <Border Background="Transparent">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="閉じる"
                                          Command="{Binding CloseCommand}"
                                          AutomationProperties.Name="このタブを閉じる" />
                                <MenuItem Header="他のタブを閉じる"
                                          Command="{Binding DataContext.CloseOtherTabsCommand, ElementName=Root}"
                                          CommandParameter="{Binding}"
                                          AutomationProperties.Name="他のタブをすべて閉じる" />
                                <MenuItem Header="すべてのタブを閉じる"
                                          Command="{Binding DataContext.CloseAllTabsCommand, ElementName=Root}"
                                          AutomationProperties.Name="開いているタブをすべて閉じる" />
                                <Separator />
                                <MenuItem Header="フルパスをコピー"
                                          Command="{Binding DataContext.CopyFullPathCommand, ElementName=Root}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding IsDocument}"
                                          AutomationProperties.Name="このタブのフルパスをコピー" />
                                <MenuItem Header="ファイルマネージャで表示"
                                          Command="{Binding DataContext.RevealInFileManagerCommand, ElementName=Root}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding IsDocument}"
                                          AutomationProperties.Name="このタブをファイルマネージャで表示" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="tabTitle"
                                       Classes.preview="{Binding IsPreview}"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="{DynamicResource BodyFontSize}" />
                            <TextBlock Classes="modifiedDot"
                                       Text="●"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="8"
                                       Foreground="{DynamicResource TextSecondary}"
                                       IsVisible="{Binding IsModified}"
                                       AutomationProperties.Name="未保存の変更があります" />
                            <Button Classes="tabClose"
                                    Command="{Binding CloseCommand}"
                                    Theme="{StaticResource EditorTabCloseButtonTheme}"
                                    Margin="6,0,0,0"
                                    IsVisible="False"
                                    local:HelpTip.Standard="このタブを閉じます。未保存の変更があれば保存するか確認します（Ctrl+W）。"
                                    local:HelpTip.Detailed="このファイルをエディタから閉じます。保存していない変更が残っている場合は、閉じる前に「保存する／保存しない／キャンセル」を確認するダイアログが出ます。ファイル自体（ディスク上のファイル）は削除されません。ショートカットはCtrl+Wです。"
                                    AutomationProperties.Name="タブを閉じる" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ========== エディタ本体 ========== -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">

            <!-- 4.6: 外部変更検知（E702）の非モーダル通知バー。 -->
            <Border x:Name="ConflictBar"
                    Grid.Row="0"
                    Background="{DynamicResource BgElevated}"
                    BorderBrush="{DynamicResource StateWarn}"
                    BorderThickness="0,0,0,2"
                    Padding="12,8"
                    IsVisible="{Binding ActiveTab.HasExternalConflict, FallbackValue=False}"
                    AutomationProperties.Name="ディスク上の変更通知">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               Text="ディスク上で変更されています。未保存の編集と競合しています。"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="再読込"
                            Command="{Binding ActiveTab.ReloadDiscardingChangesCommand}"
                            Margin="8,0,0,0"
                            local:HelpTip.Standard="未保存の編集を破棄し、ディスク上の最新の内容を読み込み直します。"
                            local:HelpTip.Detailed="このファイルが、Graftの外（他のエディタやAIによる適用など）で書き換えられたことを検知しました。「再読込」を押すと、今エディタに残っている未保存の編集内容は失われ、ディスク上の最新の内容に置き換わります。自分の編集より、外部での変更を優先したいときに使います。"
                            AutomationProperties.Name="編集を破棄してディスクの内容を再読込" />
                    <Button Grid.Column="2"
                            Content="無視"
                            Command="{Binding ActiveTab.DismissExternalConflictCommand}"
                            Margin="8,0,0,0"
                            local:HelpTip.Standard="この通知を閉じ、現在編集中の内容をそのまま保持します（ディスク上の変更は無視されます）。"
                            local:HelpTip.Detailed="この通知バーを閉じます。エディタ上の未保存の編集内容はそのまま残り、ディスク側の変更は取り込みません。このあと保存すると、ディスク上の変更を上書きすることになります。自分の編集を優先したいときに使います。"
                            AutomationProperties.Name="この通知を無視して編集を続ける" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- 課題3: WordWrapはここでバインドせずEditorPane.axaml.csのApplyWordWrapOptionで
                     一括管理する（極端に長い行を含むファイルでは利用者の設定に関わらず無効化するため。
                     ShowSpaces/ShowTabs/HighlightCurrentLine等と同じ方針）。 -->
                <ae:TextEditor x:Name="Editor"
                               FontSize="{Binding FontSize}"
                               ShowLineNumbers="{Binding ShowLineNumbers}"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               AutomationProperties.Name="コードエディタ">
                    <!--
                        本文の右クリックメニュー。標準操作（切り取り/コピー/貼り付け）はAvaloniaEditの
                        TextEditor自身のメソッドを呼ぶだけに留める（EditorPane.SelectionPrompt.cs）。
                        「選択範囲の修正依頼プロンプトをコピー」は選択が無いとき（差分タブ表示中は
                        Editor自体が非表示になるため右クリックできない）は無効化する。
                    -->
                    <ae:TextEditor.ContextMenu>
                        <ContextMenu Opening="OnEditorContextMenuOpening">
                            <MenuItem Header="切り取り"
                                      Click="OnCutClicked"
                                      AutomationProperties.Name="選択範囲を切り取り" />
                            <MenuItem Header="コピー"
                                      Click="OnCopyClicked"
                                      AutomationProperties.Name="選択範囲をコピー" />
                            <MenuItem Header="貼り付け"
                                      Click="OnPasteClicked"
                                      AutomationProperties.Name="クリップボードの内容を貼り付け" />
                            <Separator />
                            <MenuItem x:Name="CopyFixRequestPromptMenuItem"
                                      Header="選択範囲の修正依頼プロンプトをコピー"
                                      Click="OnCopyFixRequestPromptClicked"
                                      AutomationProperties.Name="選択範囲の修正依頼プロンプトをコピー" />
                        </ContextMenu>
                    </ae:TextEditor.ContextMenu>
                </ae:TextEditor>

                <!-- 9.2/4.8: diffはエディタ領域の専用タブとして開く。 -->
                <local:DiffView x:Name="DiffHost"
                                IsVisible="False"
                                AutomationProperties.Name="差分表示タブ" />

                <TextBlock Text="開いているファイルはありません"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="{DynamicResource BodyFontSize}"
                           IsVisible="{Binding Tabs.Count, Converter={x:Static local:Converters.CountIsZero}}"
                           IsHitTestVisible="False" />

                <!-- 4.4: 検索・置換オーバーレイ。右上に重ねて配置し、タブ切替のたびにAttach(Editor)する。 -->
                <local:SearchOverlay x:Name="Search" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
