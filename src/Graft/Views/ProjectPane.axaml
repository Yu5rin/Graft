<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Graft.Views"
             x:Class="Graft.Views.ProjectPane"
             Background="{DynamicResource BgSurface}">
    <!--
        左ペイン上段「プロジェクト一覧」（仕様書3.2・8.2）。
        v2.0のWPF版からの差分:
        - Visibility は IsVisible（bool）へ。空文字判定・真偽値はコンバータで解決する。
        - DataTrigger は Avalonia の条件付きクラス（Classes.xxx="{Binding ...}"）へ。
        - ItemContainerStyle は ListBox.Styles のセレクタ（ListBoxItem）へ。
        - ToolTip は添付プロパティ ToolTip.Tip へ。
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.projectName">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.projectName.pinned">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 3.2: 未接続プロジェクトはグレー表示（色のみに依存しないよう、
             下段テキストと読み上げ内容にも「未接続」を明示する） -->
        <Style Selector="TextBlock.projectName.disconnected">
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- 見出し（12px SemiBold）とプロジェクト追加ボタン -->
        <Grid Grid.Row="0" Margin="12,10,8,4" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="プロジェクト"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource PaneHeadingFontSize}"
                       FontWeight="{DynamicResource PaneHeadingFontWeight}"
                       Foreground="{DynamicResource TextSecondary}" />
            <Button Grid.Column="1"
                    Command="{Binding AddProjectCommand}"
                    Padding="4"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip.Tip="プロジェクトを追加"
                    AutomationProperties.Name="プロジェクトを追加（フォルダ選択）">
                <local:IconGlyph Data="{DynamicResource IconFolderGeometry}" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListBox x:Name="ProjectListBox"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     Background="Transparent"
                     AutomationProperties.Name="プロジェクト一覧">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3" ColumnDefinitions="20,*">

                            <!-- 数字キーショートカットのバッジ（上位9件のみ、仕様書3.2） -->
                            <Border Grid.Column="0"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="{DynamicResource BgHover}"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding ShortcutText,
                                                Converter={x:Static local:Converters.NotEmptyString}}">
                                <TextBlock Text="{Binding ShortcutText}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="projectName"
                                           Classes.pinned="{Binding IsPinned}"
                                           Classes.disconnected="{Binding IsDisconnected}"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           Text="{Binding Name}" />
                                <TextBlock Text="{Binding TagsText}"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding TagsText,
                                                       Converter={x:Static local:Converters.NotEmptyString}}" />
                                <TextBlock Text="未接続"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource StateWarn}"
                                           IsVisible="{Binding IsDisconnected}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <local:EmptyStateView State="{Binding State,
                                          Converter={x:Static local:Converters.ProjectPaneStateToEmptyState}}"
                                  IconGeometry="{DynamicResource IconLayersGeometry}"
                                  Message="プロジェクトがありません。フォルダをドラッグ＆ドロップ、または追加ボタンで登録してください"
                                  ActionText="フォルダを追加"
                                  ActionCommand="{Binding AddProjectCommand}"
                                  ActionTooltip="プロジェクトとして管理するフォルダをダイアログで選び、一覧に登録します。ドラッグ＆ドロップでも追加できます。"
                                  Issue="{Binding Error}" />
        </Grid>
    </Grid>
</UserControl>
