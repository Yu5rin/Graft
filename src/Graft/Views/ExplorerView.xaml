<UserControl x:Class="Graft.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Graft.Views"
             xmlns:vm="clr-namespace:Graft.ViewModels"
             mc:Ignorable="d"
             Background="{DynamicResource BgSurface}"
             d:DesignHeight="480" d:DesignWidth="260">
    <!--
        4.2 エクスプローラ: プロジェクトルート配下をフォルダ優先・名前順のツリーで表示する。
        遅延読み込み（FileNodeViewModel.IsExpanded初回trueでExpandRequested）・除外規則の
        グレー表示／トグル・FileSystemWatcherによる自動更新はExplorerViewModel側の責務。
        本Viewはツリーの描画・選択橋渡し（TreeView.SelectedItemは読み取り専用）・
        右クリックメニュー・キー操作（F2/Delete/Enter）のみを担う。
    -->
    <UserControl.Resources>
        <local:ExplorerStateConverter x:Key="StateConverter" />
        <local:ExcludedNodeVisibilityConverter x:Key="ExcludedVisibility" />

        <Style x:Key="TreeIconStyle" TargetType="Path" BasedOn="{StaticResource IconPathStyle}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource TextDisabled}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ContextMenu/MenuItem/Separatorは共通スタイルが無いため、ここでテーマトークンに
             追従する最小限のスタイルを定義する（ContextCollectWindow.xamlのComboBox等と同方針）。 -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,4" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右クリックメニュー: PlacementTarget.Tag にExplorerViewModel、
             PlacementTarget.DataContext に右クリックされたノードを保持させて参照する
             （ContextMenuは別ビジュアルツリーのためRelativeSource AncestorTypeで
             UserControlまで遡れない。ブリーフ記載のWPF既知の落とし穴と同種の問題）。 -->
        <ContextMenu x:Key="NodeContextMenu">
            <MenuItem Header="開く"
                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      AutomationProperties.Name="開く" />
            <Separator />
            <MenuItem Header="新規ファイル..."
                      Command="{Binding PlacementTarget.Tag.NewFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      AutomationProperties.Name="新規ファイルを作成" />
            <MenuItem Header="新規フォルダ..."
                      Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      AutomationProperties.Name="新規フォルダを作成" />
            <Separator />
            <MenuItem Header="名前の変更 (F2)"
                      Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      AutomationProperties.Name="名前を変更" />
            <MenuItem Header="削除 (Delete)"
                      Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      AutomationProperties.Name="ごみ箱へ削除" />
            <Separator />
            <MenuItem Header="パスをコピー"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      AutomationProperties.Name="パスをコピー" />
            <MenuItem Header="エクスプローラで表示"
                      Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      AutomationProperties.Name="OSのエクスプローラで表示" />
        </ContextMenu>

        <!-- ツリー項目本体のControlTemplate: 既定OSスタイルの三角ではなく
             Themes/Icons.xamlのchevronアイコンで開閉を表す（9.1 SVGベクターのみ）。 -->
        <Style x:Key="FileTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ExplorerView}}, Path=DataContext}" />
            <Setter Property="ContextMenu" Value="{StaticResource NodeContextMenu}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
            <Setter Property="Visibility">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource ExcludedVisibility}">
                        <Binding Path="IsExcluded" />
                        <Binding Path="DataContext.ShowExcludedFiles" RelativeSource="{RelativeSource AncestorType={x:Type local:ExplorerView}}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bg" Background="Transparent">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Visibility="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"
                                                  Background="Transparent" BorderThickness="0"
                                                  Width="16" Height="16" Focusable="False"
                                                  AutomationProperties.Name="展開切り替え">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Path x:Name="Arrow" Width="9" Height="9" Stretch="Uniform"
                                                      Data="{StaticResource IconChevronRightGeometry}"
                                                      Style="{StaticResource IconPathStyle}" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="Data" Value="{StaticResource IconChevronDownGeometry}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 9.2: 読み込み中はアクセント色の細い不確定プログレスバーを上端に。 -->
        <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="2" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource Accent}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     AutomationProperties.Name="ツリーを読み込み中" />

        <!-- 見出しと操作ボタン -->
        <Grid Grid.Row="1" Margin="12,10,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="エクスプローラ" VerticalAlignment="Center"
                       FontSize="{DynamicResource PaneHeadingFontSize}"
                       FontWeight="{DynamicResource PaneHeadingFontWeight}"
                       Foreground="{DynamicResource TextSecondary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding NewFileCommand}" Padding="4" Background="Transparent" BorderThickness="0"
                        ToolTip="新規ファイル" AutomationProperties.Name="新規ファイルを作成">
                    <Path Data="{StaticResource IconFileGeometry}" Style="{StaticResource IconPathStyle}" />
                </Button>
                <Button Command="{Binding NewFolderCommand}" Padding="4" Background="Transparent" BorderThickness="0"
                        ToolTip="新規フォルダ" AutomationProperties.Name="新規フォルダを作成">
                    <Path Data="{StaticResource IconFolderGeometry}" Style="{StaticResource IconPathStyle}" />
                </Button>
                <Button Command="{Binding RefreshCommand}" Padding="4" Background="Transparent" BorderThickness="0"
                        ToolTip="更新" AutomationProperties.Name="ツリーを更新">
                    <Path Data="{StaticResource IconRotateCcwGeometry}" Style="{StaticResource IconPathStyle}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 除外ファイルの表示トグル -->
        <CheckBox Grid.Row="2" Content="除外ファイルを表示" Margin="12,0,8,6"
                  IsChecked="{Binding ShowExcludedFiles, Mode=TwoWay}"
                  AutomationProperties.Name="除外ファイルを表示する" />

        <Grid Grid.Row="3">
            <TreeView x:Name="FileTreeView"
                      ItemsSource="{Binding RootNodes}"
                      Background="{x:Null}" BorderThickness="0"
                      SelectedItemChanged="OnSelectedItemChanged"
                      AutomationProperties.Name="ファイルツリー">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource FileTreeItemStyle}" />
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FileNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="2,2">
                            <Path Data="{StaticResource IconFolderGeometry}" Style="{StaticResource TreeIconStyle}"
                                  Visibility="{Binding ShowFolderIcon, Converter={StaticResource BoolToVis}}" />
                            <Path Data="{StaticResource IconFileCodeGeometry}" Style="{StaticResource TreeIconStyle}"
                                  Visibility="{Binding ShowCodeIcon, Converter={StaticResource BoolToVis}}" />
                            <Path Data="{StaticResource IconFileGeometry}" Style="{StaticResource TreeIconStyle}"
                                  Visibility="{Binding ShowPlainFileIcon, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.InputBindings>
                    <KeyBinding Key="F2" Command="{Binding RenameCommand}" CommandParameter="{Binding SelectedNode}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedNode}" />
                    <KeyBinding Key="Return" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedNode}" />
                </TreeView.InputBindings>
            </TreeView>

            <local:EmptyStateView AutomationProperties.Name="エクスプローラビュー"
                                   IconGeometry="{StaticResource IconFolderGeometry}"
                                   Message="プロジェクトを選択してください"
                                   State="{Binding HasProject, Converter={StaticResource StateConverter}}" />
        </Grid>
    </Grid>
</UserControl>
