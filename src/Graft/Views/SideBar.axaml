<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Graft.ViewModels"
             xmlns:views="clr-namespace:Graft.Views"
             x:Class="Graft.Views.SideBar"
             Focusable="False">
    <!--
        9.2 サイドバー（48px固定）。プロジェクト／エクスプローラ／履歴／検索の4ビューを
        アイコンで切り替える。並び順は「プロジェクトを登録→ファイルを見る→履歴を確認→
        必要なら検索する」というワークフロー順。既定表示はプロジェクトビュー
        （ShellViewModel）なので、起動直後は一番上のアイコンが選択状態になる。
        同じアイコンの再クリックでサイドビューを折りたたむ
        （ShellViewModel.SelectSideView）。DataContextはShellWindowから継承する。

        v2.0のWPF版からの差分: AvaloniaにMultiDataTriggerが無いため、「表示中かつ折りたたみ
        でない」という選択状態の判定はShellViewModel側（IsExplorerActive等）へ移し、
        Avaloniaの条件付きクラス（Classes.active="{Binding ...}"）で見た目を切り替える。
    -->
    <UserControl.Styles>
        <Style Selector="Button.sideBarIcon">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.sideBarIcon.active /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource BgSurface}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="0,0,1,0"
            AutomationProperties.Name="サイドバー">
        <StackPanel Orientation="Vertical" Margin="0,8">

            <Button Classes="sideBarIcon"
                    Classes.active="{Binding IsProjectActive}"
                    Command="{Binding SelectSideViewCommand}"
                    CommandParameter="{x:Static vm:SideViewKind.Project}"
                    views:HelpTip.Standard="プロジェクト一覧。登録したフォルダを切り替えます。"
                    views:HelpTip.Detailed="Graftで開いているプロジェクト（登録済みのフォルダ）の一覧を表示します。複数のプロジェクトを登録している場合、ここでクリックすると作業対象を切り替えられます。同じアイコンをもう一度押すと、このサイドビューを閉じて元の広さに戻せます。"
                    AutomationProperties.Name="プロジェクトビューを切り替え">
                <views:IconGlyph Data="{DynamicResource IconLayersGeometry}" />
            </Button>

            <Button Classes="sideBarIcon"
                    Classes.active="{Binding IsExplorerActive}"
                    Command="{Binding SelectSideViewCommand}"
                    CommandParameter="{x:Static vm:SideViewKind.Explorer}"
                    views:HelpTip.Standard="ファイル一覧。プロジェクト内のファイルを開いて編集します。"
                    views:HelpTip.Detailed="今選んでいるプロジェクトのフォルダ・ファイルをツリー表示します。ファイルをクリックすると右側のエディタで開いて、直接手で編集することもできます。AIに頼らず自分で細かく直したいときや、AIが適用した結果を見比べたいときに使います。"
                    AutomationProperties.Name="エクスプローラビューを切り替え">
                <views:IconGlyph Data="{DynamicResource IconFolderGeometry}" />
            </Button>

            <Button Classes="sideBarIcon"
                    Classes.active="{Binding IsHistoryActive}"
                    Command="{Binding SelectSideViewCommand}"
                    CommandParameter="{x:Static vm:SideViewKind.History}"
                    views:HelpTip.Standard="適用の履歴。過去の変更を確認して元に戻せます。"
                    views:HelpTip.Detailed="これまでに「適用」した変更が、新しい順に一覧表示されます。それぞれの変更内容を確認できるほか、選んでその時点の状態へ復元（元に戻す）することもできます。適用した結果に問題があったときの、やり直し手段です。"
                    AutomationProperties.Name="履歴ビューを切り替え">
                <views:IconGlyph Data="{DynamicResource IconHistoryGeometry}" />
            </Button>

            <Button Classes="sideBarIcon"
                    Classes.active="{Binding IsSearchActive}"
                    Command="{Binding SelectSideViewCommand}"
                    CommandParameter="{x:Static vm:SideViewKind.Search}"
                    views:HelpTip.Standard="横断検索。プロジェクト全体の文字列を検索・置換します。"
                    views:HelpTip.Detailed="今のプロジェクト内のすべてのファイルを対象に、文字列を検索します。見つかった箇所をまとめて別の文字列へ置き換えることもできます。特定のファイル名が分からず、どのファイルに何が書いてあるかを横断的に探したいときに使います。"
                    AutomationProperties.Name="検索ビューを切り替え">
                <views:IconGlyph Data="{DynamicResource IconSearchGeometry}" />
            </Button>

        </StackPanel>
    </Border>
</UserControl>
