<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Graft.Views.ShortcutsWindow"
        Title="キーボードショートカット"
        Width="640" Height="680"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        AutomationProperties.Name="キーボードショートカット一覧">
    <!--
        利用者からの指摘対応: 20個以上のキーボードショートカット（ShellWindow.Keyboard.cs）が
        定義されているのに、それを知る手段が「プロンプト」ボタンのツールチップ1箇所しか
        無かった。ここに機能分類ごとにまとめて一覧表示する。

        静的な内容のみ（アプリの状態に依存する項目が無い）ため、専用のViewModelは持たず
        Window直下に直接書く（AboutView.axamlの「バージョン情報」と同じ考え方）。
        開く手段はShellWindow.axamlの「?」ボタンとCtrl+/の2通り（ShellWindow.Keyboard.cs）。
        Escapeで閉じる（QueueWindow・ContextCollectWindowと同じコードビハインドの仕組み）。

        ここに載せているのはShellWindow.Keyboard.csが実際にフォーカス位置に関わらず処理する
        キーのみ。クイックオープン表示中の上下キー・Enter・Escapeのような「開いた後の内部操作」は
        自明な標準操作のため一覧からは省く（検索オーバーレイの内部操作も同様）。
    -->
    <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="16,16,16,8">
            <TextBlock Text="キーボードショートカット"
                       FontSize="{DynamicResource PaneHeadingFontSize}"
                       FontWeight="{DynamicResource PaneHeadingFontWeight}" />
            <TextBlock Text="機能ごとに分類しています。Escapeでこのウィンドウを閉じます。"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource CaptionFontSize}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="16,0,16,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ============== 接ぎ木の操作 ============== -->
                <TextBlock Classes="categoryHeading" Text="接ぎ木の操作" />
                <Border Classes="shortcutGroup">
                    <StackPanel>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Shift+V" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="クリップボードのAIの回答を読み取って解析します。接ぎ木の入口です。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Enter" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="解析した変更を実際のファイルへ適用します。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Alt+Z" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="直前に適用したリビジョンを元に戻します。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+J" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="接ぎ木パネル（下部）を開閉します。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Shift+C" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="AIへの依頼文（プロンプトテンプレート）をコピーします。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Alt+1〜9" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="登録したプロジェクトを番号で切り替えます。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Space" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="（ブロック一覧にフォーカス中）選択したブロックの適用チェックを切り替えます。" />
                        </Grid>
                        <Grid Classes="shortcutRow last" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Escape" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="解析中のパッチを破棄し、ブロック一覧を空にします。" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============== ファイル・エディタ ============== -->
                <TextBlock Classes="categoryHeading" Text="ファイル・エディタ" />
                <Border Classes="shortcutGroup">
                    <StackPanel>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+P" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="ファイル名であいまい検索して開きます（クイックオープン）。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+S" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="現在のタブを保存します。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Shift+S" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="開いているタブをすべて保存します。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+W" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="現在のタブを閉じます（未保存なら保存確認あり）。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Tab" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="直近使用した順にタブを切り替えます。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+G" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="指定した行番号へ移動します。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+/" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="（ファイル編集中）現在行のコメントを切り替えます。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Alt+↑ / Alt+↓" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="現在行を上/下の行と入れ替えます。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Shift+Alt+↓" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="現在行を複製して直下に挿入します。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Shift+K" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="現在行を削除します。" />
                        </Grid>
                        <Grid Classes="shortcutRow last" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Space" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="単語補完の候補を表示します。" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============== 検索 ============== -->
                <TextBlock Classes="categoryHeading" Text="検索" />
                <Border Classes="shortcutGroup">
                    <StackPanel>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+F" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="開いているファイル内を検索します。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+H" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="開いているファイル内を置換します。" />
                        </Grid>
                        <Grid Classes="shortcutRow last" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Shift+F" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="プロジェクト全体を横断検索します。" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============== 表示の切り替え ============== -->
                <TextBlock Classes="categoryHeading" Text="表示の切り替え" />
                <Border Classes="shortcutGroup">
                    <StackPanel>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Shift+E" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="サイドビューをエクスプローラ（ファイル一覧）へ切り替えます。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+Shift+H" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="履歴ビューを開きます。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+," /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="設定を開きます。" />
                        </Grid>
                        <Grid Classes="shortcutRow" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="F6" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="サイドビュー→エディタ→ブロック一覧→適用ボタンの順にフォーカスを巡回します。" />
                        </Grid>
                        <Grid Classes="shortcutRow last" ColumnDefinitions="150,*">
                            <Border Classes="keyBadge" Grid.Column="0"><TextBlock Classes="keyText" Text="Ctrl+/" /></Border>
                            <TextBlock Grid.Column="1" Classes="descText" Text="（ファイル編集中を除く）このショートカット一覧を開きます。" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16">
            <Button Content="閉じる" Click="OnCloseClicked" AutomationProperties.Name="閉じる" />
        </StackPanel>
    </Grid>

    <Window.Styles>
        <Style Selector="TextBlock.categoryHeading">
            <Setter Property="FontSize" Value="{DynamicResource PaneHeadingFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource PaneHeadingFontWeight}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <Style Selector="Border.shortcutGroup">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.shortcutRow">
            <Setter Property="Margin" Value="12,7,12,0" />
        </Style>
        <!-- 各グループ内の最後の行だけ下側にも余白を持たせ、グループの境界線と詰まりすぎないようにする。 -->
        <Style Selector="Grid.shortcutRow.last">
            <Setter Property="Margin" Value="12,7,12,7" />
        </Style>
        <Style Selector="Border.keyBadge">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBlock.keyText">
            <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        </Style>
        <Style Selector="TextBlock.descText">
            <Setter Property="Margin" Value="8,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Styles>
</Window>
