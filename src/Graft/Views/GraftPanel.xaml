<UserControl x:Class="Graft.Views.GraftPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Graft.Views"
             xmlns:vm="clr-namespace:Graft.ViewModels"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance vm:ShellViewModel}"
             d:DesignHeight="260" d:DesignWidth="760">
    <!--
        9.2 接ぎ木パネル（下部）。旧MainWindowの中央ブロック一覧・右ペインdiffを移設した。
        通常時は折りたたまれ、パッチ解析時に自動展開する（ShellViewModel.IsGraftPanelOpen）。
        Root（このUserControl自体）のDataContextはShellWindowから継承したまま（ShellViewModel）
        にしておき、ヘッダー・本体の内側だけGraft（MainViewModel）へ差し替える。開閉状態と
        トグルコマンドはShellViewModel側のため、ElementName=Rootで参照する。
    -->
    <UserControl.Resources>
        <views:CenterPaneStateConverter x:Key="CenterStateConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource BgSurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダー: 開閉トグル・タイトル・状態サマリ・プレビュー/適用・失敗再依頼 -->
        <Border Grid.Row="0" DataContext="{Binding Graft}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding DataContext.ToggleGraftPanelCommand, ElementName=Root}"
                        Background="Transparent" BorderThickness="0" Padding="4"
                        AutomationProperties.Name="接ぎ木パネルの開閉">
                    <Path x:Name="ToggleIcon" Width="14" Height="14" Data="{StaticResource IconChevronRightGeometry}">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource IconPathStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsGraftPanelOpen, ElementName=Root}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconChevronDownGeometry}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,12,0">
                    <Path Style="{StaticResource IconPathStyle}" Width="14" Height="14"
                          Data="{StaticResource IconPanelBottomGeometry}"
                          Stroke="{DynamicResource TextSecondary}" Margin="0,0,4,0" />
                    <TextBlock Text="接ぎ木" VerticalAlignment="Center"
                               FontSize="{DynamicResource PaneHeadingFontSize}"
                               FontWeight="{DynamicResource PaneHeadingFontWeight}"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding StatusSummaryText}" VerticalAlignment="Center"
                           FontSize="{DynamicResource StatusBarFontSize}"
                           Foreground="{DynamicResource TextSecondary}" />

                <!-- 11章 失敗時リカバリ支援: 失敗ブロックがある場合のみ有効になる。 -->
                <Button Grid.Column="3" Content="失敗を再依頼" Margin="4,0"
                        Command="{Binding CopyRecoveryPromptCommand}"
                        AutomationProperties.Name="失敗ブロックの再依頼プロンプトをコピー" />

                <Button Grid.Column="4" Margin="4,0" Command="{Binding PreviewCommand}"
                        AutomationProperties.Name="プレビューを再実行">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconEyeGeometry}" Style="{StaticResource IconPathStyle}"
                              Width="14" Height="14" Margin="0,0,4,0" />
                        <TextBlock Text="プレビュー" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" Command="{Binding ApplyCommand}" AutomationProperties.Name="適用を実行">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlayGeometry}" Style="{StaticResource IconPathStyle}"
                              Width="14" Height="14" Margin="0,0,4,0" />
                        <TextBlock Text="適用" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 本体: ブロック一覧 + diff（展開時のみ表示） -->
        <Grid Grid.Row="1" DataContext="{Binding Graft}"
              Visibility="{Binding DataContext.IsGraftPanelOpen, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BlockListColumn" Width="320" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- 左: ブロック一覧（1行目パス・2行目変更説明、状態アイコン、チェックボックス） -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Margin="8,6"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="ブロック一覧を検索" />

                <Grid Grid.Row="1">
                    <ListBox x:Name="BlockListBox"
                             ItemsSource="{Binding Blocks}"
                             SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                             Background="{x:Null}"
                             AutomationProperties.Name="ブロック一覧">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,4,0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanToggle}"
                                              AutomationProperties.Name="適用可否を切り替え" />

                                    <Path x:Name="StatusIcon" Grid.Column="1" Style="{StaticResource IconPathStyle}"
                                          Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,6,0" />

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding PathText}" FontSize="{DynamicResource BodyFontSize}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DescriptionText}"
                                                   FontSize="{DynamicResource CaptionFontSize}"
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                        <!-- 8.8: エラーは赤い帯ではなく該当行のインライン表示。エラーコード＋対処方法併記。 -->
                                        <TextBlock Text="{Binding IssueText}" FontSize="{DynamicResource CaptionFontSize}"
                                                   Foreground="{DynamicResource StateError}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasIssue, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding AddedRemovedText}" VerticalAlignment="Top"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </Grid>

                                <!-- 8.5: 状態は色と形状の両方で区別する（check / alert-triangle / x-circle）。 -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Ok">
                                        <Setter TargetName="StatusIcon" Property="Data" Value="{StaticResource IconCheckGeometry}" />
                                        <Setter TargetName="StatusIcon" Property="Stroke" Value="{DynamicResource StateOk}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Warn">
                                        <Setter TargetName="StatusIcon" Property="Data" Value="{StaticResource IconAlertTriangleGeometry}" />
                                        <Setter TargetName="StatusIcon" Property="Stroke" Value="{DynamicResource StateWarn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                        <Setter TargetName="StatusIcon" Property="Data" Value="{StaticResource IconXCircleGeometry}" />
                                        <Setter TargetName="StatusIcon" Property="Stroke" Value="{DynamicResource StateError}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <views:EmptyStateView State="{Binding State, Converter={StaticResource CenterStateConverter}}"
                                           IconGeometry="{StaticResource IconCopyGeometry}"
                                           Message="AIの出力をコピーして Ctrl+Shift+V"
                                           ActionText="解析"
                                           ActionCommand="{Binding PasteAndParseCommand}"
                                           Issue="{Binding CenterError}" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderSubtle}"
                          AutomationProperties.Name="ブロック一覧とdiffの境界" />

            <!-- 右: diff（DiffView/DiffViewModelは他担当実装。diffのエディタタブ化はE4） -->
            <Border Grid.Column="2" x:Name="DiffPaneHost" Focusable="True"
                    AutomationProperties.Name="差分表示ペイン">
                <views:DiffView DataContext="{Binding Diff}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
