<UserControl x:Class="Graft.Views.InlineEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Graft.ViewModels"
             xmlns:views="clr-namespace:Graft.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InlineEditViewModel}">
    <!--
        仕様書8.7: マッチ失敗ブロックのSEARCH部インライン編集。
        右ペインに実ファイル内容、左に入力中のSEARCH部を並べ、DataContext
        （InlineEditViewModel）が入力から200ms後に再マッチ判定を行った結果を
        ResultSummary/IsMatchSuccessfulへ反映する。編集内容はDiffViewModel経由で
        呼び出し側（ブロック一覧・適用側）がBuildEditedPair()を通じて取得する想定。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
            Background="{DynamicResource BgElevated}" Padding="{DynamicResource SpacingMd}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <!-- ヘッダー -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconXCircleGeometry}"
                      Stroke="{DynamicResource StateError}" Margin="0,0,8,0" />
                <TextBlock Text="マッチ失敗: SEARCH部を編集して再判定できます" FontWeight="{DynamicResource PaneHeadingFontWeight}" />
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0" />
            </StackPanel>

            <!-- 再判定結果 -->
            <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,4" Background="{DynamicResource BgSurface}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconCheckGeometry}"
                          Stroke="{DynamicResource StateOk}" Margin="0,0,8,0"
                          Visibility="{Binding IsMatchSuccessful, Converter={StaticResource BoolToVis}}" />
                    <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconXCircleGeometry}"
                          Stroke="{DynamicResource StateError}" Margin="0,0,8,0"
                          Visibility="{Binding IsMatchSuccessful, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Text="{Binding ResultSummary}" VerticalAlignment="Center"
                               AutomationProperties.Name="再判定結果" />
                </StackPanel>
            </Border>

            <!-- 左: SEARCH部の編集 / 右: 実ファイル内容 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="SEARCH部（編集可）" Margin="0,0,0,4"
                               FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource CodeFontSize}"
                             AutomationProperties.Name="SEARCH部の編集" />
                </DockPanel>

                <Border Grid.Column="1" Background="{DynamicResource BorderSubtle}" />

                <DockPanel Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="実際のファイル内容" Margin="0,0,0,4"
                               FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextSecondary}" />
                    <ListBox ItemsSource="{Binding FileLines}" Background="{DynamicResource BgSurface}"
                             BorderThickness="0" FontFamily="{DynamicResource CodeFontFamily}"
                             FontSize="{DynamicResource CodeFontSize}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="実際のファイル内容">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FileLineViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LineNumberText}" TextAlignment="Right"
                                               Padding="0,0,8,0" Foreground="{DynamicResource TextSecondary}" />
                                    <views:CodeLineControl Grid.Column="1" LineText="{Binding Text}"
                                                            Tokens="{Binding Tokens}" IsDiffRow="False" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
