<UserControl x:Class="Graft.Views.EditorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:local="clr-namespace:Graft.Views"
             mc:Ignorable="d"
             Background="{DynamicResource BgBase}"
             PreviewKeyDown="OnPreviewKeyDown"
             d:DesignHeight="480" d:DesignWidth="800">

    <!--
        Themes/Editor.xamlはApp.xamlのMergedDictionariesで既にアプリ全体へ読み込まれている
        （Application.Resourcesは既知の落とし穴2＝UserControlから親Windowの個別リソースを
        参照できない問題の対象外のため、ここで二重にマージする必要はない）。
        ここではEditorPane固有のコンバータのみを持つ。
    -->
    <UserControl.Resources>
        <local:EmptyCollectionToVisibilityConverter x:Key="EmptyToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========== タブ見出し（4.3） ========== -->
        <ListBox x:Name="TabStrip"
                 Grid.Row="0"
                 Style="{StaticResource EditorTabStripStyle}"
                 ItemContainerStyle="{StaticResource EditorTabItemStyle}"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                 PreviewMouseDown="OnTabStripPreviewMouseDown"
                 Visibility="{Binding Tabs.Count, Converter={StaticResource EmptyToVisibility}}"
                 AutomationProperties.Name="開いているファイルのタブ一覧">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="ItemRoot" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TitleText"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="{DynamicResource BodyFontSize}" />
                            <TextBlock x:Name="ModifiedDot"
                                       Text="●"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="8"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Visibility="Collapsed"
                                       AutomationProperties.Name="未保存の変更があります" />
                            <Button x:Name="CloseButton"
                                    Command="{Binding CloseCommand}"
                                    Style="{StaticResource EditorTabCloseButtonStyle}"
                                    Margin="6,0,0,0"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="タブを閉じる" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPreview}" Value="True">
                            <Setter TargetName="TitleText" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsModified}" Value="True">
                            <Setter TargetName="ModifiedDot" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger SourceName="ItemRoot" Property="IsMouseOver" Value="True">
                            <Setter TargetName="ModifiedDot" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ========== エディタ本体 ========== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 4.6: 外部変更検知（E702）の非モーダル通知バー。ActiveTab.HasExternalConflictが
                 立つと表示する。エクスプローラ側がEditorPaneViewModel.NotifyExternalChangeAsyncを
                 呼ぶことで発火する（配線は統合担当）。 -->
            <Border x:Name="ConflictBar"
                    Grid.Row="0"
                    Background="{DynamicResource BgElevated}"
                    BorderBrush="{DynamicResource StateWarn}"
                    BorderThickness="0,0,0,2"
                    Padding="12,8"
                    Visibility="{Binding ActiveTab.HasExternalConflict, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="ディスク上の変更通知">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="ディスク上で変更されています。未保存の編集と競合しています。"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="再読込"
                            Command="{Binding ActiveTab.ReloadDiscardingChangesCommand}"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="編集を破棄してディスクの内容を再読込" />
                    <Button Grid.Column="2"
                            Content="無視"
                            Command="{Binding ActiveTab.DismissExternalConflictCommand}"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="この通知を無視して編集を続ける" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ae:TextEditor x:Name="Editor"
                               FontSize="{Binding FontSize}"
                               ShowLineNumbers="{Binding ShowLineNumbers}"
                               WordWrap="{Binding WordWrap}"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               PreviewMouseWheel="OnEditorPreviewMouseWheel"
                               AutomationProperties.Name="コードエディタ" />

                <TextBlock Text="開いているファイルはありません"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="{DynamicResource BodyFontSize}"
                           Visibility="{Binding Tabs.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}"
                           IsHitTestVisible="False" />

                <!-- 4.4: 検索・置換オーバーレイ。右上に重ねて配置し、タブ切替のたびにAttach(Editor)する
                     （EditorPane.xaml.cs側）。開閉・Escでの終了はSearchOverlay自身が持つ。 -->
                <local:SearchOverlay x:Name="Search" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
