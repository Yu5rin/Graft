<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Graft.Views"
             x:Class="Graft.Views.GraftPanel"
             x:Name="Root">
    <!--
        9.2 接ぎ木パネル（下部）。diffはエディタ領域の専用タブへ移設したため、本パネルは
        ブロック一覧・適用サマリ・操作ボタンに絞る。通常時は折りたたまれ、パッチ解析時に
        自動展開する（ShellViewModel.IsGraftPanelOpen）。
        Root（このUserControl自体）のDataContextはShellWindowから継承したまま
        （ShellViewModel）にしておき、ヘッダー・本体の内側だけGraft（MainViewModel）へ
        差し替える。開閉状態とトグルコマンドはShellViewModel側のためElementName=Rootで参照する。

        v2.0のWPF版からの差分:
        - Visibility は IsVisible（bool）へ。
        - 状態アイコンのDataTrigger（check / alert-triangle / x-circle）は、3つのPathを
          重ねてViewModel側の真偽値（IsOk/IsWarn/IsError）で出し分ける形にした。
    -->
    <Grid Background="{DynamicResource BgSurface}" RowDefinitions="Auto,*">

        <!-- ヘッダー: 開閉トグル・タイトル・対象の要約・修正を依頼/破棄/キューへ追加/再チェック/適用 -->
        <Border Grid.Row="0" DataContext="{Binding Graft}"
                MinHeight="{DynamicResource PaneHeaderHeight}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid Margin="8,0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">

                <Button Grid.Column="0"
                        Command="{Binding DataContext.ToggleGraftPanelCommand, ElementName=Root}"
                        Classes="subtle" BorderThickness="0" Padding="4"
                        views:HelpTip.Standard="接ぎ木パネルを開閉します。パッチを解析すると自動的に開きます（Ctrl+J）。"
                        views:HelpTip.Detailed="下部の接ぎ木パネル（AIの回答から抽出した変更ブロックの一覧）を開閉します。「貼り付けて解析」ボタンでAIの回答を読み取ると自動的に開くため、通常は自分で開く必要はありません。作業スペースを広く使いたいときにこのボタンで折りたたんでください。ショートカットはCtrl+Jです。"
                        AutomationProperties.Name="接ぎ木パネルの開閉">
                    <Panel>
                        <views:IconGlyph Width="14" Height="14"
                                         Data="{DynamicResource IconChevronRightGeometry}"
                                         IsVisible="{Binding !DataContext.IsGraftPanelOpen, ElementName=Root}" />
                        <views:IconGlyph Width="14" Height="14"
                                         Data="{DynamicResource IconChevronDownGeometry}"
                                         IsVisible="{Binding DataContext.IsGraftPanelOpen, ElementName=Root}" />
                    </Panel>
                </Button>

                <!--
                    利用者からの改善要望: 接ぎ木パネルをコードの下だけでなく右にも配置できるように
                    したい（3列）。切替方法はこのヘッダーボタン1個に決めている。
                    利用者からの指摘: トグルボタンのアイコンは「今どうなっているか」ではなく
                    「押すとどうなるか（次の状態）」を示すのが一般的な作法。そのため下配置のときは
                    押すと移る先＝panel-right、右配置のときはpanel-bottomを表示する
                    （ジオメトリ自体は変更せず、表示条件のIsGraftPanelPlacementRightを入れ替えただけ）。
                    実際のGrid行・列の付け替えはShellWindow.axaml.csが担い、このパネル自体は
                    常に1インスタンスのまま位置だけが変わる。
                -->
                <Button Grid.Column="1"
                        Command="{Binding DataContext.ToggleGraftPanelPlacementCommand, ElementName=Root}"
                        Classes="subtle" BorderThickness="0" Padding="4"
                        views:HelpTip.Standard="押すと接ぎ木パネルをコードの下と右の間で切り替えます。"
                        views:HelpTip.Detailed="接ぎ木パネルの配置を、コードの下（既定）とコードの右の間で切り替えます。右に切り替えるとサイドバー・エディタ・接ぎ木パネルの3列になり、コードとパッチのブロック一覧を横に並べて同時に見比べられます。境界をドラッグして幅・高さを調整でき、調整した寸法と配置は次回起動時にも記憶されます。"
                        AutomationProperties.Name="接ぎ木パネルの配置切り替え（下／右）">
                    <Panel>
                        <!-- 下配置中は「押すと右へ移る」ことを示すpanel-rightアイコンを出す。 -->
                        <views:IconGlyph Width="14" Height="14"
                                         Data="{DynamicResource IconPanelRightGeometry}"
                                         IsVisible="{Binding !DataContext.IsGraftPanelPlacementRight, ElementName=Root}" />
                        <!-- 右配置中は「押すと下へ移る」ことを示すpanel-bottomアイコンを出す。 -->
                        <views:IconGlyph Width="14" Height="14"
                                         Data="{DynamicResource IconPanelBottomGeometry}"
                                         IsVisible="{Binding DataContext.IsGraftPanelPlacementRight, ElementName=Root}" />
                    </Panel>
                </Button>

                <TextBlock Grid.Column="2" Text="接ぎ木" VerticalAlignment="Center" Margin="4,0,12,0"
                           FontSize="{DynamicResource PaneHeadingFontSize}"
                           FontWeight="{DynamicResource PaneHeadingFontWeight}"
                           Foreground="{DynamicResource TextSecondary}" />

                <!--
                    件数の要約（8.2「2件適用可 / 1件要確認」）はステータスバーの担当。
                    この見出しはすぐ上に接しているため、同じ文字列をここにも出すと
                    同じ内容が数十px違いで二重に見える。対象ファイル名を出す。
                -->
                <TextBlock Grid.Column="3" Text="{Binding TargetSummaryText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource StatusBarFontSize}"
                           Foreground="{DynamicResource TextSecondary}" />

                <!--
                    見出しの操作ボタンは、左から「修正を依頼 → 破棄 → キューへ追加 → 再チェック → 適用」。
                    解析結果に対する操作を、慎重な（取り返しやすい）ものから順に並べ、いちばん右の
                    「適用」だけを主ボタン（primary）にしている。以前は「適用」と「キューへ追加」が
                    上のツールバーにあり、「適用」だけは見出しにも重複してあった。利用者の選択
                    （「作業の流れで並べ直す」）で、解析結果に対する操作はすべてこの見出しに集めた。
                    押せないときのツールチップの理由（views:HelpTip.DisabledReason）は移した先でも保つ。
                -->
                <!-- 11章 失敗時の修正依頼: 失敗ブロックがある場合のみ有効になる。 -->
                <Button Grid.Column="4" Content="修正を依頼" Margin="4,0"
                        Command="{Binding CopyRecoveryPromptCommand}"
                        views:HelpTip.DisabledReason="{Binding RecoveryDisabledReason}"
                        views:HelpTip.Standard="適用できなかったブロックについて、現在のファイルの内容を添えた修正依頼文をクリップボードへコピーします。AIへ再度質問するときに使います。失敗したブロックがあるときだけ有効になります。"
                        views:HelpTip.Detailed="一覧の中に赤い×印（適用できなかったブロック）があるときに使います。押すと、失敗した理由と対象ファイルの今の中身を含んだ修正依頼文がクリップボードへコピーされます。それをAIとの会話に貼り付けて再度質問すれば、状況を説明し直す手間なく修正案をもらえます。失敗したブロックが無いときはこのボタンは押せません。"
                        AutomationProperties.Name="失敗ブロックの修正依頼文をコピー" />

                <!--
                    修正3: 「破棄」ボタン。DiscardCommand自体は既存実装済みだったが、Escキー以外の
                    露出が接ぎ木パネルのどこにも無く「実装はあるのに見えない」状態だった（13件目）。
                    解析結果が無いときは無効化する（DiscardCommandのCanExecute参照）。
                -->
                <Button Classes="danger" Grid.Column="5" Margin="4,0" Command="{Binding DiscardCommand}"
                        views:HelpTip.DisabledReason="{Binding NeedAnalysisReason}"
                        views:HelpTip.Standard="解析した内容を捨てます。ファイルは変更されません。"
                        views:HelpTip.Detailed="接ぎ木パネルに表示されている解析結果（ブロック一覧・差分）を捨てて、パネルを空の状態に戻します。ここまでの操作はまだファイルへは一切書き込んでいないため、ファイルの内容には何も影響しません。押し間違えても、捨てた直後の数秒は画面下の「元に戻す」で戻せます。解析結果が無いときはこのボタンは押せません。"
                        AutomationProperties.Name="解析結果を破棄">
                    <StackPanel Orientation="Horizontal">
                        <views:IconGlyph Data="{DynamicResource IconXGeometry}"
                                         Width="14" Height="14" Margin="0,0,4,0" />
                        <TextBlock Text="破棄" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 4.10: 分割パッチの受け取り。解析した変更をすぐ適用せず、キューへ溜める。 -->
                <Button Grid.Column="6" Content="キューへ追加" Margin="4,0"
                        Command="{Binding AddCurrentPatchToQueueCommand}"
                        views:HelpTip.DisabledReason="{Binding NeedAnalysisReason}"
                        views:HelpTip.Standard="解析した変更をすぐ適用せず、順番待ち（キュー）に溜めます。AIが変更を数回に分けて出してきたときに使います。"
                        views:HelpTip.Detailed="AIの回答が長く、修正が何回かに分けて送られてくることがあります。そのたびに「貼り付けて解析」で読み取った内容を、このボタンで順番待ちの列（キュー）に追加できます。追加してもファイルはまだ変わりません。すべての回答を解析し終えたら、上のバーの「キュー」ボタンで一覧を開き、まとめて適用してください。"
                        AutomationProperties.Name="現在の解析結果をパッチキューへ追加" />

                <!-- 「再チェック」: 解析済みの変更が今のファイルに適用できるかを、書き込まずに調べ直す
                     （以前の名前は「プレビュー」。適用前の確認画面・Markdownの表示も「プレビュー」と
                     呼んでいて、3つの意味が混ざっていたため、これだけ改名した）。 -->
                <Button Grid.Column="7" Margin="4,0" Command="{Binding PreviewCommand}"
                        views:HelpTip.DisabledReason="{Binding NeedAnalysisReason}"
                        views:HelpTip.Standard="解析した変更が今のファイルに適用できるかを、書き込まずにもう一度調べ、各ブロックの結果と差分を最新にします。対象ファイルを編集した後に使います。"
                        views:HelpTip.Detailed="解析済みの変更が、今のファイルの中身に対して問題なく適用できるかどうかを、実際には書き込まずに調べ直します。エディタで対象ファイルを直接編集したあとにこのボタンを押すと、各ブロックの状態（適用可能・要確認・失敗）と差分表示が最新の内容に更新されます。"
                        AutomationProperties.Name="適用できるかを再チェック">
                    <StackPanel Orientation="Horizontal">
                        <views:IconGlyph Data="{DynamicResource IconEyeGeometry}"
                                         Width="14" Height="14" Margin="0,0,4,0" />
                        <TextBlock Text="再チェック" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F6ペイン巡回の最後の停留先（GraftPanel.axaml.cs: DiffHost）。 -->
                <Button Classes="primary" x:Name="ApplyButtonElement" Grid.Column="8" Margin="4,0,0,0"
                        Command="{Binding ApplyCommand}"
                        views:HelpTip.DisabledReason="{Binding ApplyDisabledReason}"
                        views:HelpTip.Standard="チェックの付いた変更を実際のファイルへ書き込みます。書き込む前に自動でバックアップを取るので、履歴からいつでも取り消せます（Ctrl+Enter）。"
                        views:HelpTip.Detailed="一覧に並んでいる、チェックが入ったブロックを実際のファイルへ書き込みます。ボタンの括弧内の数字は、いま書き込まれる件数です。書き込む前には自動でバックアップが作られるため、結果が気に入らなければサイドバーの「履歴」からいつでも取り消せます。ショートカットはCtrl+Enterです。"
                        AutomationProperties.Name="適用を実行">
                    <StackPanel Orientation="Horizontal">
                        <views:IconGlyph Data="{DynamicResource IconPlayGeometry}"
                                         Width="14" Height="14" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ApplyButtonText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 本体: ブロック一覧（展開時のみ表示）。 -->
        <Grid Grid.Row="1" DataContext="{Binding Graft}"
              IsVisible="{Binding DataContext.IsGraftPanelOpen, ElementName=Root}"
              RowDefinitions="Auto,Auto,*">

            <!--
                適用済みのパッチ（E302）の通知。再投入したパッチは、要約入力・適用確認の窓を通り抜けた後に
                適用エンジンの再判定で止められていた。プレビューの時点（解析直後）でここに1つだけ出す。
                全ブロックを赤い失敗にしない（「修正を依頼」を押せるようにしない）ため、ブロック一覧とは
                別の帯として置く。「適用」ボタンはこの間は押せない（MainViewModel.AlreadyApplied.cs）。
            -->
            <Border Grid.Row="0" Background="{DynamicResource BgElevated}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="8,6"
                    IsVisible="{Binding HasAlreadyAppliedNotice}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:IconGlyph Width="16" Height="16" VerticalAlignment="Center"
                                     Data="{DynamicResource IconAlertTriangleGeometry}"
                                     Stroke="{DynamicResource StateWarn}" />
                    <TextBlock Text="{Binding AlreadyAppliedNoticeText}" VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource TextPrimary}"
                               AutomationProperties.Name="{Binding AlreadyAppliedNoticeText}" />
                </StackPanel>
            </Border>

            <!-- 項目8: パネルヘッダー直下に用途が書かれていない空欄が1本あった（実機Xvfbで
                 確認済み）。他の検索欄と同じくWatermarkで用途を示す。 -->
            <TextBox Grid.Row="1" Margin="8,6"
                     Text="{Binding FilterText}"
                     Watermark="パス・変更説明で絞り込み"
                     views:EscapeClearBehavior.Enabled="True"
                     AutomationProperties.Name="ブロック一覧を検索" />

            <Grid Grid.Row="2">
                <!-- ブロック一覧（1行目パス・2行目変更説明、状態アイコン、チェックボックス）。
                     選択すると差分がエディタ領域のタブへ開く（ShellViewModel側の配線）。 -->
                <ListBox x:Name="BlockListBox"
                         ItemsSource="{Binding BlocksDisplay}"
                         SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                         Background="Transparent"
                         AutomationProperties.Name="ブロック一覧">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--
                                B: ブロック行の右クリックメニュー。Background="Transparent"は
                                余白部分での右クリックも拾うため（EditorPane.axamlのタブ見出しと
                                同じ作法）。Command先はShellViewModel（views:GraftPanelのRoot＝
                                DataContext）またはMainViewModel（Root.DataContext.Graft）、
                                CommandParameterはこの項目自身（ブロック）。
                            -->
                            <Grid Margin="0,4" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="対象ファイルを開く"
                                                  Command="{Binding DataContext.OpenBlockInEditorCommand, ElementName=Root}"
                                                  CommandParameter="{Binding}"
                                                  views:HelpTip.Standard="このブロックが変更する対象ファイルを、変更箇所の行へジャンプしてエディタで開きます。"
                                                  AutomationProperties.Name="対象ファイルを開く" />
                                        <MenuItem Header="このブロックの差分をコピー"
                                                  Command="{Binding DataContext.CopyBlockDiffCommand, ElementName=Root}"
                                                  CommandParameter="{Binding}"
                                                  views:HelpTip.Standard="このブロックの変更内容を、unified diff形式でクリップボードへコピーします。AIへ「この変更のここを直して」と貼り戻せる形です。"
                                                  AutomationProperties.Name="このブロックの差分をコピー" />
                                        <MenuItem Header="修正依頼文をコピー"
                                                  Command="{Binding DataContext.CopyBlockRecoveryPromptCommand, ElementName=Root}"
                                                  CommandParameter="{Binding}"
                                                  IsEnabled="{Binding IsError}"
                                                  views:HelpTip.Standard="このブロックが失敗した理由と、AIが出したSEARCH部、現在のファイルの中身を含む修正依頼文を、このブロックの分だけクリップボードへコピーします。失敗したブロックのときだけ使えます。"
                                                  AutomationProperties.Name="修正依頼文をコピー" />
                                        <Separator />
                                        <MenuItem Header="{Binding ToggleLabel}"
                                                  Command="{Binding DataContext.ToggleBlockCheckCommand, ElementName=Root}"
                                                  CommandParameter="{Binding}"
                                                  views:HelpTip.Standard="このブロックを適用対象に含めるかどうかを切り替えます。失敗したブロックには使えません。"
                                                  AutomationProperties.Name="{Binding ToggleLabel}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,4,0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding CanToggle}"
                                          AutomationProperties.Name="適用可否を切り替え" />

                                <!-- 8.5: 状態は色と形状の両方で区別する（check / alert-triangle / x-circle）。 -->
                                <Panel Grid.Column="1" VerticalAlignment="Top" Margin="0,2,6,0">
                                    <views:IconGlyph Width="16" Height="16"
                                                     Data="{DynamicResource IconCheckGeometry}"
                                                     Stroke="{DynamicResource StateOk}"
                                                     IsVisible="{Binding IsOk}" />
                                    <views:IconGlyph Width="16" Height="16"
                                                     Data="{DynamicResource IconAlertTriangleGeometry}"
                                                     Stroke="{DynamicResource StateWarn}"
                                                     IsVisible="{Binding IsWarn}" />
                                    <views:IconGlyph Width="16" Height="16"
                                                     Data="{DynamicResource IconXCircleGeometry}"
                                                     Stroke="{DynamicResource StateError}"
                                                     IsVisible="{Binding IsError}" />
                                </Panel>

                                <!-- 項目3の同種の問題: このパネルはApplyPreviewWindowより横幅に余裕があり
                                     実害は小さいが、長い日本語パスでは末尾のファイル名が省略され得るため、
                                     完全なパスをToolTipで確認できるようにしておく（実測: 幅広なので通常は
                                     省略されないが、パネルを狭めた場合の保険）。 -->
                                <StackPanel Grid.Column="2" ToolTip.Tip="{Binding PathText}">
                                    <TextBlock Text="{Binding PathText}" FontSize="{DynamicResource BodyFontSize}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DescriptionText}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    <!--
                                        8.8: エラーは赤い帯ではなく該当行のインライン表示。エラーコード＋対処方法併記。
                                        不具合1対応: 1ブロックに複数件の問題が付くことがある（PathGuard.Inspectが
                                        サイズ超過E203と排他ロックE204を同時に返す場合など）。以前は1本のTextBlock
                                        へ改行文字で連結していたが、複数件を確実に縦へ並べて全部読めるようにする
                                        ため、IssueLines（BlockItemViewModel、上限＋「ほかN件」で件数も抑える）を
                                        ItemsControlで1件ずつ独立したTextBlockとして描画する。ItemsPanelは既定でも
                                        StackPanelだが、意図を明示するためここでも明記する。
                                    -->
                                    <ItemsControl ItemsSource="{Binding IssueLines}" IsVisible="{Binding HasIssue}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="{DynamicResource CaptionFontSize}"
                                                           Foreground="{DynamicResource StateError}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding AddedRemovedText}" VerticalAlignment="Top"
                                           Margin="4,0"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondary}" />

                                <!-- 4.8: ブロック一覧からのジャンプ。マッチ位置をエディタで開く。 -->
                                <Button Grid.Column="4" VerticalAlignment="Top" Padding="2"
                                        Classes="subtle" BorderThickness="0"
                                        Command="{Binding DataContext.OpenBlockInEditorCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        views:HelpTip.Standard="このブロックが変更する対象ファイルを、変更箇所の行へジャンプしてエディタで開きます。"
                                        views:HelpTip.Detailed="このブロックが変更しようとしているファイルをエディタで開き、変更対象の行まで自動でスクロールします。適用する前に、実際のコードの前後の文脈を見ながら内容を確認したいときに使います。"
                                        AutomationProperties.Name="エディタで開く">
                                    <views:IconGlyph Width="14" Height="14"
                                                     Data="{DynamicResource IconFileCodeGeometry}"
                                                     Stroke="{DynamicResource TextSecondary}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <views:EmptyStateView State="{Binding State,
                                              Converter={x:Static views:Converters.CenterPaneStateToEmptyState}}"
                                      IconGeometry="{DynamicResource IconCopyGeometry}"
                                      Message="AIの出力をコピーして Ctrl+Shift+V"
                                      ActionText="貼り付けて解析"
                                      ActionCommand="{Binding PasteAndParseCommand}"
                                      ActionTooltip="コピーしたAIの回答を読み取り、変更内容を抽出します。ここが接ぎ木の入口です（Ctrl+Shift+V）。"
                                      ActionTooltipDetailed="ChatGPTやClaudeなどのAIに修正を頼んで返ってきた回答を、まるごとコピーしてからこのボタンを押します。Graftが回答の中からコード変更の部分だけを探し出し、この一覧に表示します。この時点ではまだファイルは書き換わりません。ショートカットはCtrl+Shift+Vです。"
                                      SecondaryActionText="ファイルから解析"
                                      SecondaryActionCommand="{Binding ParseFromFileCommand}"
                                      SecondaryActionTooltip="AIの出力をクリップボードではなく、保存済みのファイル（.md/.txt/.diff/.patch）から読み込んで解析します。"
                                      SecondaryActionTooltipDetailed="AIとのやり取りをクリップボードにコピーする代わりに、あらかじめファイルへ保存してある場合に使います。.md/.txt/.diff/.patchのいずれかの形式で保存したファイルを選ぶと、その中身を「貼り付けて解析」ボタンを押したときと同じように読み取ります。長いやり取りを一旦保存してから読み込みたいときに便利です。"
                                      Issue="{Binding CenterError}"
                                      IssueActionText="{Binding RequestedFilesActionText}"
                                      IssueActionCommand="{Binding AddRequestedFilesToContextCommand}"
                                      IssueActionTooltip="AIが「このファイルも見せて」と求めたファイルを、「ファイルを選ぶ」画面で「内容も出す」に設定します。そのあと窓の「コピー」でAIへ渡せます。" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
