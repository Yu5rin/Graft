<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Graft.Views"
             x:Class="Graft.Views.GraftPanel"
             x:Name="Root">
    <!--
        9.2 接ぎ木パネル（下部）。diffはエディタ領域の専用タブへ移設したため、本パネルは
        ブロック一覧・適用サマリ・操作ボタンに絞る。通常時は折りたたまれ、パッチ解析時に
        自動展開する（ShellViewModel.IsGraftPanelOpen）。
        Root（このUserControl自体）のDataContextはShellWindowから継承したまま
        （ShellViewModel）にしておき、ヘッダー・本体の内側だけGraft（MainViewModel）へ
        差し替える。開閉状態とトグルコマンドはShellViewModel側のためElementName=Rootで参照する。

        v2.0のWPF版からの差分:
        - Visibility は IsVisible（bool）へ。
        - 状態アイコンのDataTrigger（check / alert-triangle / x-circle）は、3つのPathを
          重ねてViewModel側の真偽値（IsOk/IsWarn/IsError）で出し分ける形にした。
    -->
    <Grid Background="{DynamicResource BgSurface}" RowDefinitions="32,*">

        <!-- ヘッダー: 開閉トグル・タイトル・状態サマリ・プレビュー/適用・失敗再依頼 -->
        <Border Grid.Row="0" DataContext="{Binding Graft}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid Margin="8,0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">

                <Button Grid.Column="0"
                        Command="{Binding DataContext.ToggleGraftPanelCommand, ElementName=Root}"
                        Background="Transparent" BorderThickness="0" Padding="4"
                        views:HelpTip.Standard="接ぎ木パネルを開閉します。パッチを解析すると自動的に開きます（Ctrl+J）。"
                        views:HelpTip.Detailed="下部の接ぎ木パネル（AIの回答から抽出した変更ブロックの一覧）を開閉します。「解析」ボタンでAIの回答を読み取ると自動的に開くため、通常は自分で開く必要はありません。作業スペースを広く使いたいときにこのボタンで折りたたんでください。ショートカットはCtrl+Jです。"
                        AutomationProperties.Name="接ぎ木パネルの開閉">
                    <Panel>
                        <views:IconGlyph Width="14" Height="14"
                                         Data="{DynamicResource IconChevronRightGeometry}"
                                         IsVisible="{Binding !DataContext.IsGraftPanelOpen, ElementName=Root}" />
                        <views:IconGlyph Width="14" Height="14"
                                         Data="{DynamicResource IconChevronDownGeometry}"
                                         IsVisible="{Binding DataContext.IsGraftPanelOpen, ElementName=Root}" />
                    </Panel>
                </Button>

                <!--
                    利用者からの改善要望: 接ぎ木パネルをコードの下だけでなく右にも配置できるように
                    したい（3列）。切替方法はこのヘッダーボタン1個に決めている。アイコンは現在の
                    配置を表し（下配置ならpanel-bottom、右配置ならpanel-right）、押すともう一方へ
                    切り替わる。実際のGrid行・列の付け替えはShellWindow.axaml.csが担い、このパネル
                    自体は常に1インスタンスのまま位置だけが変わる。
                -->
                <Button Grid.Column="1"
                        Command="{Binding DataContext.ToggleGraftPanelPlacementCommand, ElementName=Root}"
                        Background="Transparent" BorderThickness="0" Padding="4"
                        views:HelpTip.Standard="接ぎ木パネルをコードの下と右のどちらに表示するか切り替えます。"
                        views:HelpTip.Detailed="接ぎ木パネルの配置を、コードの下（既定）とコードの右の間で切り替えます。右に切り替えるとサイドバー・エディタ・接ぎ木パネルの3列になり、コードとパッチのブロック一覧を横に並べて同時に見比べられます。境界をドラッグして幅・高さを調整でき、調整した寸法と配置は次回起動時にも記憶されます。"
                        AutomationProperties.Name="接ぎ木パネルの配置切り替え（下／右）">
                    <Panel>
                        <views:IconGlyph Width="14" Height="14"
                                         Data="{DynamicResource IconPanelBottomGeometry}"
                                         IsVisible="{Binding !DataContext.IsGraftPanelPlacementRight, ElementName=Root}" />
                        <views:IconGlyph Width="14" Height="14"
                                         Data="{DynamicResource IconPanelRightGeometry}"
                                         IsVisible="{Binding DataContext.IsGraftPanelPlacementRight, ElementName=Root}" />
                    </Panel>
                </Button>

                <TextBlock Grid.Column="2" Text="接ぎ木" VerticalAlignment="Center" Margin="4,0,12,0"
                           FontSize="{DynamicResource PaneHeadingFontSize}"
                           FontWeight="{DynamicResource PaneHeadingFontWeight}"
                           Foreground="{DynamicResource TextSecondary}" />

                <!--
                    件数の要約（8.2「2件適用可 / 1件要確認」）はステータスバーの担当。
                    この見出しはすぐ上に接しているため、同じ文字列をここにも出すと
                    同じ内容が数十px違いで二重に見える。対象ファイル名を出す。
                -->
                <TextBlock Grid.Column="3" Text="{Binding TargetSummaryText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource StatusBarFontSize}"
                           Foreground="{DynamicResource TextSecondary}" />

                <!-- 11章 失敗時リカバリ支援: 失敗ブロックがある場合のみ有効になる。 -->
                <Button Grid.Column="4" Content="失敗を再依頼" Margin="4,0"
                        Command="{Binding CopyRecoveryPromptCommand}"
                        views:HelpTip.Standard="適用できなかったブロックについて、現在のファイルの内容を添えた修正依頼文をクリップボードへコピーします。AIへ再度質問するときに使います。失敗したブロックがあるときだけ有効になります。"
                        views:HelpTip.Detailed="一覧の中に赤い×印（適用できなかったブロック）があるときに使います。押すと、失敗した理由と対象ファイルの今の中身を含んだ修正依頼文がクリップボードへコピーされます。それをAIとの会話に貼り付けて再度質問すれば、状況を説明し直す手間なく修正案をもらえます。失敗したブロックが無いときはこのボタンは押せません。"
                        AutomationProperties.Name="失敗ブロックの再依頼プロンプトをコピー" />

                <!--
                    修正3: 「破棄」ボタン。DiscardCommand自体は既存実装済みだったが、Escキー以外の
                    露出が接ぎ木パネルのどこにも無く「実装はあるのに見えない」状態だった（13件目）。
                    プレビュー・適用と並べ、解析結果が無いときは無効化する（DiscardCommandの
                    CanExecute参照）。
                -->
                <Button Grid.Column="5" Margin="4,0" Command="{Binding DiscardCommand}"
                        views:HelpTip.Standard="解析した内容を取り消します。ファイルは変更されません。"
                        views:HelpTip.Detailed="接ぎ木パネルに表示されている解析結果（ブロック一覧・プレビュー）を取り消し、パネルを空の状態に戻します。ここまでの操作はまだファイルへは一切書き込んでいないため、ファイルの内容には何も影響しません。Escキーでも同じ操作ができます。解析結果が無いときはこのボタンは押せません。"
                        AutomationProperties.Name="解析結果を破棄">
                    <StackPanel Orientation="Horizontal">
                        <views:IconGlyph Data="{DynamicResource IconXGeometry}"
                                         Width="14" Height="14" Margin="0,0,4,0" />
                        <TextBlock Text="破棄" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="6" Margin="4,0" Command="{Binding PreviewCommand}"
                        views:HelpTip.Standard="解析した変更をもう一度ドライラン（試し適用）し、各ブロックの適用可否と差分を最新の状態に更新します。対象ファイルを編集した後に使います。"
                        views:HelpTip.Detailed="解析済みの変更が、今のファイルの中身に対して問題なく適用できるかどうかを、実際には書き込まずに試します（ドライラン）。エディタで対象ファイルを直接編集したあとにこのボタンを押すと、各ブロックの状態（適用可能・要確認・失敗）と差分表示が最新の内容に更新されます。"
                        AutomationProperties.Name="プレビューを再実行">
                    <StackPanel Orientation="Horizontal">
                        <views:IconGlyph Data="{DynamicResource IconEyeGeometry}"
                                         Width="14" Height="14" Margin="0,0,4,0" />
                        <TextBlock Text="プレビュー" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F6ペイン巡回の最後の停留先（GraftPanel.axaml.cs: DiffHost）。 -->
                <Button x:Name="ApplyButtonElement" Grid.Column="7" Command="{Binding ApplyCommand}"
                        views:HelpTip.Standard="解析した変更を実際のファイルへ書き込みます。書き込む前に自動でバックアップを取るので、履歴からいつでも元に戻せます（Ctrl+Enter）。"
                        views:HelpTip.Detailed="一覧に並んでいる、チェックが入ったブロックを実際のファイルへ書き込みます。書き込む前には自動でバックアップが作られるため、結果が気に入らなければサイドバーの「履歴」からいつでも元に戻せます。ショートカットはCtrl+Enterです。"
                        AutomationProperties.Name="適用を実行">
                    <StackPanel Orientation="Horizontal">
                        <views:IconGlyph Data="{DynamicResource IconPlayGeometry}"
                                         Width="14" Height="14" Margin="0,0,4,0" />
                        <TextBlock Text="適用" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 本体: ブロック一覧（展開時のみ表示）。 -->
        <Grid Grid.Row="1" DataContext="{Binding Graft}"
              IsVisible="{Binding DataContext.IsGraftPanelOpen, ElementName=Root}"
              RowDefinitions="Auto,*">

            <TextBox Grid.Row="0" Margin="8,6"
                     Text="{Binding FilterText}"
                     AutomationProperties.Name="ブロック一覧を検索" />

            <Grid Grid.Row="1">
                <!-- ブロック一覧（1行目パス・2行目変更説明、状態アイコン、チェックボックス）。
                     選択すると差分がエディタ領域のタブへ開く（ShellViewModel側の配線）。 -->
                <ListBox x:Name="BlockListBox"
                         ItemsSource="{Binding Blocks}"
                         SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                         Background="Transparent"
                         AutomationProperties.Name="ブロック一覧">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                                <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,4,0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding CanToggle}"
                                          AutomationProperties.Name="適用可否を切り替え" />

                                <!-- 8.5: 状態は色と形状の両方で区別する（check / alert-triangle / x-circle）。 -->
                                <Panel Grid.Column="1" VerticalAlignment="Top" Margin="0,2,6,0">
                                    <views:IconGlyph Width="16" Height="16"
                                                     Data="{DynamicResource IconCheckGeometry}"
                                                     Stroke="{DynamicResource StateOk}"
                                                     IsVisible="{Binding IsOk}" />
                                    <views:IconGlyph Width="16" Height="16"
                                                     Data="{DynamicResource IconAlertTriangleGeometry}"
                                                     Stroke="{DynamicResource StateWarn}"
                                                     IsVisible="{Binding IsWarn}" />
                                    <views:IconGlyph Width="16" Height="16"
                                                     Data="{DynamicResource IconXCircleGeometry}"
                                                     Stroke="{DynamicResource StateError}"
                                                     IsVisible="{Binding IsError}" />
                                </Panel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding PathText}" FontSize="{DynamicResource BodyFontSize}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DescriptionText}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    <!--
                                        8.8: エラーは赤い帯ではなく該当行のインライン表示。エラーコード＋対処方法併記。
                                        不具合1対応: 1ブロックに複数件の問題が付くことがある（PathGuard.Inspectが
                                        サイズ超過E203と排他ロックE204を同時に返す場合など）。以前は1本のTextBlock
                                        へ改行文字で連結していたが、複数件を確実に縦へ並べて全部読めるようにする
                                        ため、IssueLines（BlockItemViewModel、上限＋「ほかN件」で件数も抑える）を
                                        ItemsControlで1件ずつ独立したTextBlockとして描画する。ItemsPanelは既定でも
                                        StackPanelだが、意図を明示するためここでも明記する。
                                    -->
                                    <ItemsControl ItemsSource="{Binding IssueLines}" IsVisible="{Binding HasIssue}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="{DynamicResource CaptionFontSize}"
                                                           Foreground="{DynamicResource StateError}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding AddedRemovedText}" VerticalAlignment="Top"
                                           Margin="4,0"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondary}" />

                                <!-- 4.8: ブロック一覧からのジャンプ。マッチ位置をエディタで開く。 -->
                                <Button Grid.Column="4" VerticalAlignment="Top" Padding="2"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.OpenBlockInEditorCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        views:HelpTip.Standard="このブロックが変更する対象ファイルを、変更箇所の行へジャンプしてエディタで開きます。"
                                        views:HelpTip.Detailed="このブロックが変更しようとしているファイルをエディタで開き、変更対象の行まで自動でスクロールします。適用する前に、実際のコードの前後の文脈を見ながら内容を確認したいときに使います。"
                                        AutomationProperties.Name="エディタで開く">
                                    <views:IconGlyph Width="14" Height="14"
                                                     Data="{DynamicResource IconFileCodeGeometry}"
                                                     Stroke="{DynamicResource TextSecondary}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <views:EmptyStateView State="{Binding State,
                                              Converter={x:Static views:Converters.CenterPaneStateToEmptyState}}"
                                      IconGeometry="{DynamicResource IconCopyGeometry}"
                                      Message="AIの出力をコピーして Ctrl+Shift+V"
                                      ActionText="解析"
                                      ActionCommand="{Binding PasteAndParseCommand}"
                                      ActionTooltip="コピーしたAIの回答を読み取り、変更内容を抽出します。ここが接ぎ木の入口です（Ctrl+Shift+V）。"
                                      ActionTooltipDetailed="ChatGPTやClaudeなどのAIに修正を頼んで返ってきた回答を、まるごとコピーしてからこのボタンを押します。Graftが回答の中からコード変更の部分だけを探し出し、この一覧に表示します。この時点ではまだファイルは書き換わりません。ショートカットはCtrl+Shift+Vです。"
                                      SecondaryActionText="ファイルから解析"
                                      SecondaryActionCommand="{Binding ParseFromFileCommand}"
                                      SecondaryActionTooltip="AIの出力をクリップボードではなく、保存済みのファイル（.md/.txt/.diff/.patch）から読み込んで解析します。"
                                      SecondaryActionTooltipDetailed="AIとのやり取りをクリップボードにコピーする代わりに、あらかじめファイルへ保存してある場合に使います。.md/.txt/.diff/.patchのいずれかの形式で保存したファイルを選ぶと、その中身を「解析」ボタンを押したときと同じように読み取ります。長いやり取りを一旦保存してから読み込みたいときに便利です。"
                                      Issue="{Binding CenterError}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
