<Window x:Class="Graft.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:Graft.Views"
        mc:Ignorable="d"
        Title="Graft"
        MinWidth="{DynamicResource MinWindowWidth}"
        MinHeight="{DynamicResource MinWindowHeight}"
        Background="{DynamicResource BgBase}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        Foreground="{DynamicResource TextPrimary}"
        d:DesignWidth="1280" d:DesignHeight="800">
    <!--
        9.2 レイアウト（全面改訂）: 上からコマンドバー(40px)／本体／ステータスバー(24px)。
        本体は左からサイドバー(48px固定)／サイドビュー(幅可変・記憶)／エディタ領域＋
        接ぎ木パネル(下部、高さ可変・記憶)。GridSplitterで幅・高さを調整できる。
        実際の幅・高さの計算・記憶（サイドビュー幅・接ぎ木パネル高さ）はShellWindow.xaml.csが
        担う。キーボード操作（9.5・附録A）はShellWindow.Keyboard.csに分割する
        （1ファイル400行上限のため。詳細はShellWindow.Keyboard.cs参照）。
        AutomationProperties.Nameはすべての操作可能要素に日本語で設定する（9.3・8.14）。
    -->
    <Window.Resources>
        <views:SideViewVisibilityConverter x:Key="SideViewVisibility" />
        <views:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource CommandBarRowHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ============== コマンドバー（40px、メニュー・ツールバーなし） ============== -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          MinWidth="180"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Graft.ProjectPane.Items}"
                          SelectedItem="{Binding Graft.ProjectPane.SelectedItem, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          AutomationProperties.Name="プロジェクトを選択" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 10章: プロジェクトのフォルダ構成・ファイル内容を確認するコンテキスト収集画面。 -->
                    <Button Content="ファイル"
                            Command="{Binding Graft.OpenContextCollectCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="プロジェクトのファイル一覧とコンテキスト収集を開く" />
                    <Button Content="解析"
                            Command="{Binding Graft.PasteAndParseCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="クリップボードのパッチを解析" />
                    <!-- 4.10: 分割パッチの受け取り。キューへ追加／キュー一覧を開く。 -->
                    <Button Content="キューへ追加"
                            Command="{Binding Graft.AddCurrentPatchToQueueCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="現在の解析結果をパッチキューへ追加" />
                    <Button Content="{Binding Graft.Queue.Items.Count, StringFormat=キュー（{0}）}"
                            Command="{Binding Graft.OpenQueueCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="パッチキューを開く" />
                    <Button Content="適用"
                            Command="{Binding Graft.ApplyCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="適用を実行" />
                    <!-- 4.8.4 コピー操作: テンプレート選択ドロップダウン。Ctrl+Shift+Cでも同じ操作が行える。 -->
                    <Button x:Name="PromptButton"
                            Content="プロンプト"
                            Command="{Binding Graft.OpenPromptDropdownCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="プロンプトテンプレートを選んでコピー" />
                    <!-- 9.2: サイドバーの履歴ビューを開く動作にする（v1.5の右ペインフォーカスから変更）。 -->
                    <Button Content="履歴"
                            Command="{Binding Graft.ShowHistoryCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="履歴ビューを開く" />
                    <Button Content="設定"
                            Command="{Binding Graft.OpenSettingsCommand}"
                            Margin="4,0"
                            AutomationProperties.Name="設定を開く" />
                </StackPanel>

                <!-- 4.8.4: テンプレート選択ドロップダウン。名称の右に展開後の推定トークン数を表示する。 -->
                <Popup x:Name="PromptPopup"
                       Grid.Column="2"
                       PlacementTarget="{Binding ElementName=PromptButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       IsOpen="{Binding Graft.PromptCopy.IsOpen, Mode=TwoWay}"
                       AutomationProperties.Name="プロンプトテンプレートの選択">
                    <Border Background="{DynamicResource BgElevated}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            Padding="12"
                            MinWidth="280" MaxWidth="360">
                        <StackPanel DataContext="{Binding Graft.PromptCopy}">
                            <TextBlock Text="プロンプトテンプレート"
                                       FontSize="{DynamicResource PaneHeadingFontSize}"
                                       FontWeight="{DynamicResource PaneHeadingFontWeight}"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <ListBox ItemsSource="{Binding Templates}"
                                     SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                     MaxHeight="220"
                                     Margin="0,8,0,0"
                                     AutomationProperties.Name="テンプレート一覧（推定トークン数付き）">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding StatusMessage}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVisibility}}" />
                            <Button Content="コピー"
                                    Command="{Binding CopyCommand}"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0"
                                    AutomationProperties.Name="選択したテンプレートをコピー" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- ============== 本体: サイドバー／サイドビュー／エディタ＋接ぎ木パネル ============== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition x:Name="SideViewColumn" Width="260" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <views:SideBar Grid.Column="0" />

            <!-- サイドビュー: エクスプローラ／プロジェクト／履歴／検索。
                 検索はフェーズE3の担当のため、E2では空状態を置く。 -->
            <Grid Grid.Column="1">
                <Border Visibility="{Binding SelectedSideView, Converter={StaticResource SideViewVisibility}, ConverterParameter=Explorer}">
                    <views:ExplorerView x:Name="ExplorerViewControl" DataContext="{Binding Explorer}" />
                </Border>
                <Border Visibility="{Binding SelectedSideView, Converter={StaticResource SideViewVisibility}, ConverterParameter=Project}">
                    <views:ProjectPane x:Name="ProjectPaneControl" DataContext="{Binding Graft.ProjectPane}" />
                </Border>
                <Border Visibility="{Binding SelectedSideView, Converter={StaticResource SideViewVisibility}, ConverterParameter=History}">
                    <views:HistoryPane x:Name="HistoryPaneControl" DataContext="{Binding Graft.History}" />
                </Border>
                <Border Visibility="{Binding SelectedSideView, Converter={StaticResource SideViewVisibility}, ConverterParameter=Search}">
                    <views:SearchView DataContext="{Binding Search}" />
                </Border>
            </Grid>

            <GridSplitter x:Name="SideViewSplitter"
                          Grid.Column="2"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderSubtle}"
                          AutomationProperties.Name="サイドビューとエディタの境界" />

            <!-- エディタ領域 ＋ 接ぎ木パネル（下部、高さ可変） -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="GraftSplitterRow" Height="Auto" />
                    <RowDefinition x:Name="GraftPanelRow" Height="32" />
                </Grid.RowDefinitions>

                <!-- Views.EditorPane / EditorPaneViewModel は他担当実装（Editor/担当）。 -->
                <Border Grid.Row="0"
                        x:Name="EditorHost"
                        Focusable="True"
                        Background="{DynamicResource BgSurface}"
                        AutomationProperties.Name="エディタ領域">
                    <views:EditorPane DataContext="{Binding Editor}" />
                </Border>

                <GridSplitter x:Name="GraftSplitter"
                              Grid.Row="1"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource BorderSubtle}"
                              AutomationProperties.Name="エディタと接ぎ木パネルの境界" />

                <views:GraftPanel Grid.Row="2" x:Name="GraftPanelControl" />
            </Grid>
        </Grid>

        <!-- ============== ステータスバー（24px） ============== -->
        <views:StatusBarView Grid.Row="2" />
    </Grid>
</Window>
