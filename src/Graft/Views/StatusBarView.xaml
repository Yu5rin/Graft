<UserControl x:Class="Graft.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Graft.ViewModels"
             mc:Ignorable="d"
             Focusable="False"
             d:DataContext="{d:DesignInstance vm:ShellViewModel}"
             d:DesignHeight="24" d:DesignWidth="1280">
    <!--
        9.2/9.9 ステータスバー（24px）。行:列・選択文字数・エンコーディング・改行コード・言語は
        ShellViewModel.Editor（他担当実装のEditorPaneViewModel）、接ぎ木状態・シンタックス
        無効化通知はShellViewModel.Graft（既存MainViewModel）を参照する。
        DataContextはShellWindowから継承する（上書きしない）。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Background="{DynamicResource BgSurface}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="0,1,0,0"
            AutomationProperties.Name="ステータスバー">
        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左: エディタの状態（行:列・エンコーディング・改行コード・言語） -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Editor.CaretText}" FontSize="{DynamicResource StatusBarFontSize}" />
                <TextBlock Text="{Binding Editor.EncodingText}" Margin="12,0,0,0"
                           FontSize="{DynamicResource StatusBarFontSize}" />
                <TextBlock Text="{Binding Editor.NewLineText}" Margin="12,0,0,0"
                           FontSize="{DynamicResource StatusBarFontSize}" />
                <TextBlock Text="{Binding Editor.LanguageText}" Margin="12,0,0,0"
                           FontSize="{DynamicResource StatusBarFontSize}" />
                <!-- 8.6: シンタックスハイライトが性能基準を満たさず無効化された場合の通知（接ぎ木パネルのdiff側）。 -->
                <TextBlock Text="シンタックスハイライトを無効化しました" Margin="12,0,0,0"
                           Foreground="{DynamicResource StateWarn}"
                           FontSize="{DynamicResource StatusBarFontSize}"
                           Visibility="{Binding Graft.Diff.SyntaxHighlightDisabled, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- 右: 接ぎ木状態（8.2「2件適用可 / 1件要確認」） -->
            <TextBlock Grid.Column="1" Text="{Binding Graft.StatusSummaryText}"
                       VerticalAlignment="Center" FontSize="{DynamicResource StatusBarFontSize}" />
        </Grid>
    </Border>
</UserControl>
