<UserControl x:Class="Graft.Views.HistoryPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Graft.Views"
             mc:Ignorable="d"
             Background="{DynamicResource BgSurface}"
             d:DesignHeight="320" d:DesignWidth="240">
    <UserControl.Resources>
        <local:HistoryPaneStateConverter x:Key="StateConverter" />
        <local:DateTimeOffsetConverter x:Key="DateConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 見出しと復元ボタン -->
        <Grid Grid.Row="0" Margin="12,10,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="履歴"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource PaneHeadingFontSize}"
                       FontWeight="{DynamicResource PaneHeadingFontWeight}"
                       Foreground="{DynamicResource TextSecondary}" />
            <Button Grid.Column="1"
                    Command="{Binding RestoreCommand}"
                    Padding="4"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip="選択したリビジョン直前の状態へ復元"
                    AutomationProperties.Name="選択したリビジョンへ復元">
                <Path Data="{StaticResource IconRotateCcwGeometry}" Style="{StaticResource IconPathStyle}" />
            </Button>
        </Grid>

        <!-- 全文検索（Ctrl+F） -->
        <Grid Grid.Row="1" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0"
                  Data="{StaticResource IconSearchGeometry}"
                  Style="{StaticResource IconPathStyle}"
                  Width="14" Height="14"
                  Margin="4,0,4,0"
                  Stroke="{DynamicResource TextSecondary}" />
            <TextBox x:Name="KeywordBox"
                     Grid.Column="1"
                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="リビジョンの要約を検索" />
        </Grid>

        <!-- type絞り込み・日付範囲 -->
        <Grid Grid.Row="2" Margin="8,0,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="TypeCombo"
                      Grid.Column="0"
                      ItemsSource="{Binding AvailableTypes}"
                      SelectedItem="{Binding TypeFilter, Mode=TwoWay}"
                      AutomationProperties.Name="種別で絞り込み" />
            <Button Grid.Column="1"
                    Content="×"
                    Click="OnClearTypeFilter"
                    Padding="6,2"
                    Margin="4,0,0,0"
                    ToolTip="種別絞り込みを解除"
                    AutomationProperties.Name="種別絞り込みを解除" />
            <DatePicker Grid.Column="2"
                        SelectedDate="{Binding DateFrom, Converter={StaticResource DateConverter}, Mode=TwoWay}"
                        Width="96"
                        Margin="4,0,0,0"
                        AutomationProperties.Name="開始日" />
            <DatePicker Grid.Column="3"
                        SelectedDate="{Binding DateTo, Converter={StaticResource DateConverter}, Mode=TwoWay}"
                        Width="96"
                        Margin="4,0,0,0"
                        AutomationProperties.Name="終了日" />
        </Grid>

        <Grid Grid.Row="3">
            <ListBox x:Name="RevisionListBox"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     Background="{x:Null}"
                     AutomationProperties.Name="リビジョン履歴一覧">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding RevisionLabel}"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource BodyFontSize}" />
                                <Border Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Padding="4,0"
                                        Background="{DynamicResource BgHover}">
                                    <TextBlock Text="{Binding TypeText}" FontSize="{DynamicResource CaptionFontSize}" />
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding AppliedAtText}"
                                           HorizontalAlignment="Right"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Grid>
                            <TextBlock Text="{Binding SummaryText}"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StatsText}"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <!-- 13.1: 復元不可のリビジョンはその旨を示す（色のみに依存しない文言表示） -->
                            <TextBlock Text="{Binding RestorabilityText}"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       Foreground="{DynamicResource StateWarn}"
                                       Visibility="{Binding CanRestore, Converter={StaticResource InverseBoolToVisibility}}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <local:EmptyStateView State="{Binding State, Converter={StaticResource StateConverter}}"
                                   IconGeometry="{StaticResource IconHistoryGeometry}"
                                   Message="このプロジェクトにはまだ適用履歴がありません"
                                   Issue="{Binding Error}" />
        </Grid>
    </Grid>
</UserControl>
