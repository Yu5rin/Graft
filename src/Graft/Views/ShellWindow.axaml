<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Graft.Views"
        x:Class="Graft.Views.ShellWindow"
        x:Name="RootWindow"
        Title="Graft"
        Width="1280" Height="800"
        MinWidth="{DynamicResource MinWindowWidth}"
        MinHeight="{DynamicResource MinWindowHeight}"
        Background="{DynamicResource BgBase}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        Foreground="{DynamicResource TextPrimary}">
    <!--
        9.2 レイアウト: 上からコマンドバー(40px)／本体／ステータスバー(24px)。
        本体は左からサイドバー(48px固定)／サイドビュー(幅可変・記憶)／エディタ領域＋
        接ぎ木パネル。接ぎ木パネルはコードの下（既定、高さ可変・記憶）とコードの右
        （3列、幅可変・記憶）のどちらかに配置でき、切替は接ぎ木パネルのヘッダーボタンで行う
        （利用者からの改善要望）。GridSplitterで幅・高さを調整できる。
        実際の幅・高さ・配置の計算・記憶はShellWindow.axaml.csが担う。キーボード操作（9.5・附録A）は
        ShellWindow.Keyboard.csに分割する（1ファイル400行上限のため）。
        AutomationProperties.Nameはすべての操作可能要素に日本語で設定する（9.3・8.14）。

        v2.0のWPF版からの差分:
        - Visibility は IsVisible（bool）へ。サイドビューの出し分けはコンバータで行う。
        - Popup は Avalonia でも同名だが、配置は PlacementTarget＋Placement="Bottom" と
          IsLightDismissEnabled（WPFのStaysOpen=Falseに相当）で指定する。
        - ComboBox の DisplayMemberPath は ItemTemplate（共通テンプレート）へ。
          DisplayMemberBinding ではなく ItemTemplate を使うのは、閉じた状態の幅を
          「一番長い項目＋矢印」に合わせる共通テーマの仕組みが ItemTemplate を見るため。
        - GridSplitter の ResizeDirection/ResizeBehavior は無く、置いた向き（幅か高さか）で
          自動的に決まる。
    -->
    <Window.Styles>
        <!--
            コマンドバーの分割ボタン（本体＋▼）。標準のボタンを2つ隣り合わせ、間の角だけ丸めない。
            Fluent標準のSplitButtonを使わないのは、アプリ全体のボタンの見た目（Controls.axamlの
            ControlTheme・Controls.Buttons.axamlの種類）と食い違うため。角丸は標準ボタンと同じ
            RadiusSm（3）に合わせている。
        -->
        <Style Selector="Button.split-main">
            <Setter Property="CornerRadius" Value="3,0,0,3" />
        </Style>
        <Style Selector="Button.split-arrow">
            <Setter Property="CornerRadius" Value="0,3,3,0" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <!-- 「AIに渡す」「AIから受け取る」の小さなグループ名。ボタンより目立たせない。 -->
        <Style Selector="TextBlock.toolbar-group-label">
            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
    </Window.Styles>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource CommandBarRowHeight}" />
            <RowDefinition Height="*" />
            <!-- 項目13: 直値24pxをStatusBarRowHeightトークン参照へ直した
                 （CommandBarRowHeightと同じ作法。トークン側もこの24に合わせて修正済み）。 -->
            <RowDefinition Height="{DynamicResource StatusBarRowHeight}" />
        </Grid.RowDefinitions>

        <!-- ============== コマンドバー（40px、作業の流れで並べる） ============== -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <!--
                並びは「作業の流れ」: プロジェクトを選ぶ → AIに渡す（ファイルを選ぶ・依頼文をコピー）
                → AIから受け取る（貼り付けて解析・キュー）。以前は「ファイル 解析 キューへ追加 キュー 適用
                プロンプト 履歴」と、作業の順でも意味のまとまりでもない並びで、「適用」だけが上の
                ツールバーと下の接ぎ木パネルの両方にあった。利用者の選択（「作業の流れで並べ直す」）に従い、
                次のように整理した。
                  - 「適用」「キューへ追加」は、解析結果に対する操作なので接ぎ木パネルの見出しへ移した
                    （GraftPanel.axaml）。ツールバーには、解析結果が無くても押せる入口だけを残す。
                  - 「AIに渡す」「AIから受け取る」の2グループに小さな見出しを付ける。見出しは
                    説明のための飾りなので、幅が足りないときは見出しを先に隠し、ボタンは残す
                    （Converters.WideEnoughForToolbarLabels。しきい値は実機の画面写真で、
                    最小幅960pxでもボタンが欠けない境目を測って決めた）。
                  - 「履歴」「設定」「？」は作業の流れの外にある補助なので、右端にまとめる。
                    履歴は適用を取り消す入口でもあるが、サイドバーの履歴アイコンと
                    Ctrl+Shift+Hからも開けるため、右端に寄せても取り消しが遠くならない。
                  - 「依頼文をコピー」「貼り付けて解析」は、本体が最もよく使う操作、▼が
                    それ以外の入口という分割ボタン。以前は「プロンプト」を押してテンプレートを
                    選んでコピー、の3クリックだったが、本体を押すだけで既定の依頼文がコピーできる。

                列構成はAuto,Auto,*,Auto（プロジェクト選択／作業の流れ／余白／右端グループ）。
                ボタン列（列1）を包むScrollViewerのMaxWidthは、ウィンドウ幅からプロジェクト選択と
                右端グループの各ボタンの実測幅を引いて求める（Converters.ToolbarButtonsMaxWidth）。
                GridのAuto列にScrollViewerを置くだけでは、最小幅まで縮めたときに内容が画面外へ
                あふれる（不具合5、実機で確認済み）ため、この計算は残している。
            -->
            <Grid x:Name="CommandBarGrid" Margin="12,0" ColumnDefinitions="Auto,Auto,*,Auto">

                <!-- 利用者からの要望: クリックしてフォーカスを当てなくても、マウスカーソルを
                     乗せてホイールを回すだけでプロジェクトを切り替えられるようにする。
                     ComboBox既定のホイール処理（無し）を上書きする実装はShellWindow.
                     ProjectComboBox.cs（トンネリング段階でPointerWheelChangedを拾う）参照。 -->
                <ComboBox x:Name="ProjectComboBox"
                          Grid.Column="0"
                          MinWidth="180"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Graft.ProjectPane.Items}"
                          SelectedItem="{Binding Graft.ProjectPane.SelectedItem, Mode=TwoWay}"
                          ItemTemplate="{StaticResource NameItemTemplate}"
                          AutomationProperties.Name="プロジェクトを選択" />

                <ScrollViewer x:Name="ToolbarButtonsScroll"
                              Grid.Column="1"
                              Margin="12,0,0,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <ScrollViewer.MaxWidth>
                        <MultiBinding Converter="{x:Static views:Converters.ToolbarButtonsMaxWidth}">
                            <Binding ElementName="RootWindow" Path="ClientSize.Width" />
                            <Binding ElementName="ProjectComboBox" Path="Bounds.Width" />
                            <Binding ElementName="HistoryButton" Path="Bounds.Width" />
                            <Binding ElementName="SettingsButton" Path="Bounds.Width" />
                            <Binding ElementName="ShortcutsButton" Path="Bounds.Width" />
                        </MultiBinding>
                    </ScrollViewer.MaxWidth>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">

                        <!-- ===== AIに渡す ===== -->
                        <Border Width="1" Height="18" Margin="4,0,8,0"
                                Background="{DynamicResource BorderSubtle}" />
                        <TextBlock x:Name="HandoffGroupLabel" Classes="toolbar-group-label"
                                   Text="AIに渡す"
                                   IsVisible="{Binding #RootWindow.ClientSize.Width,
                                               Converter={x:Static views:Converters.WideEnoughForToolbarLabels}}" />

                        <!-- 10章: プロジェクトのどのファイルをAIに渡すかを選ぶ画面（コンテキスト収集）。
                             ツールチップの表示レベルは views:HelpTip.Standard / Detailed の2種類の文言で、
                             実際のToolTip.Tipへの反映はHelpTipクラスが設定に応じて一括で行う。 -->
                        <Button x:Name="ContextButton" Content="ファイルを選ぶ"
                                Command="{Binding Graft.OpenContextCollectCommand}"
                                views:HelpTip.DisabledReason="{Binding Graft.NeedProjectReason}"
                                views:HelpTip.Standard="AIに渡すファイルを選びます。選んだファイルの内容は、依頼文と一緒にコピーできます。"
                                views:HelpTip.Detailed="AIに質問する前に、プロジェクト内のどのファイルを読んでもらうかを選ぶ画面を開きます。左側でファイルにチェックを入れると、その中身をまとめてコピーする準備ができます。コピーした内容をChatGPTやClaudeなどのAIとの会話に貼り付けてから、直してほしい内容を伝えてください。ここではまだファイルは変更されません。"
                                AutomationProperties.Name="AIに渡すファイルを選ぶ" />

                        <!-- 4.8.4 コピー操作。本体は既定の依頼文を即コピー（Ctrl+Shift+C）、▼はテンプレートの一覧。 -->
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <Button x:Name="PromptButton" Classes="split-main" Content="依頼文をコピー"
                                    Command="{Binding Graft.CopyPromptCommand}"
                                    views:HelpTip.DisabledReason="{Binding Graft.NeedProjectReason}"
                                    views:HelpTip.Standard="AIへの依頼文をコピーします。Graftが読み取れる形式で回答するよう指示する文面です（Ctrl+Shift+C）。右の▼でテンプレートを選べます。"
                                    views:HelpTip.Detailed="AIに「Graftが読み取れる決まった形式で回答してください」と伝えるための文章（依頼文）を、クリップボードへコピーします。コピーした文章をAIとの会話に貼り付けてから、続けて直してほしい内容を書いてください。こうしておくと、AIの回答をあとで「貼り付けて解析」で正しく読み取れるようになります。ショートカットキーはCtrl+Shift+Cです。右の▼を押すと、依頼文のテンプレートを選べます。"
                                    AutomationProperties.Name="既定の依頼文をコピー" />
                            <Button x:Name="PromptTemplateButton" Classes="split-arrow"
                                    Command="{Binding Graft.OpenPromptDropdownCommand}"
                                    views:HelpTip.DisabledReason="{Binding Graft.NeedProjectReason}"
                                    views:HelpTip.Standard="依頼文のテンプレートを選んでコピーします。"
                                    AutomationProperties.Name="依頼文のテンプレートを選んでコピー">
                                <views:IconGlyph Width="10" Height="10" Data="{DynamicResource IconChevronDownGeometry}" />
                            </Button>
                        </StackPanel>

                        <!-- ===== AIから受け取る ===== -->
                        <Border Width="1" Height="18" Margin="8,0"
                                Background="{DynamicResource BorderSubtle}" />
                        <TextBlock x:Name="ReceiveGroupLabel" Classes="toolbar-group-label"
                                   Text="AIから受け取る"
                                   IsVisible="{Binding #RootWindow.ClientSize.Width,
                                               Converter={x:Static views:Converters.WideEnoughForToolbarLabels}}" />

                        <!-- 本体はクリップボードの解析（Ctrl+Shift+V。ここが接ぎ木の入口）、▼はそれ以外の入口。 -->
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <Button x:Name="ParseButton" Classes="split-main" Content="貼り付けて解析"
                                    Command="{Binding Graft.PasteAndParseCommand}"
                                    views:HelpTip.Standard="コピーしたAIの回答を読み取り、変更内容を取り出します（Ctrl+Shift+V）。ここが接ぎ木の入口です。"
                                    views:HelpTip.Detailed="ChatGPTやClaudeなどのAIに修正を頼んで返ってきた回答を、まるごとコピーしてからこのボタンを押します。Graftが回答の中からコード変更の部分だけを探し出し、下の接ぎ木パネルに一覧表示します。この時点ではまだファイルは書き換わりません。内容を確認して「適用」を押すまで、あなたのコードは安全なままです。ショートカットキーはCtrl+Shift+Vです。"
                                    AutomationProperties.Name="クリップボードの回答を解析" />
                            <Button x:Name="ParseMenuButton" Classes="split-arrow"
                                    views:HelpTip.Standard="ファイルから解析するなど、そのほかの受け取り方を選びます。"
                                    AutomationProperties.Name="そのほかの解析方法を選ぶ">
                                <views:IconGlyph Width="10" Height="10" Data="{DynamicResource IconChevronDownGeometry}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="クリップボードから解析"
                                                  InputGesture="Ctrl+Shift+V"
                                                  Command="{Binding Graft.PasteAndParseCommand}"
                                                  AutomationProperties.Name="クリップボードから解析" />
                                        <MenuItem Header="ファイルから解析…"
                                                  Command="{Binding Graft.ParseFromFileCommand}"
                                                  AutomationProperties.Name="ファイルから解析" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <!-- 4.10: 分割パッチの受け取り。キュー一覧を開く（キューへの追加は接ぎ木パネルの見出し）。 -->
                        <Button x:Name="QueueButton"
                                Content="{Binding Graft.Queue.Items.Count, StringFormat=キュー ({0})}"
                                Command="{Binding Graft.OpenQueueCommand}"
                                views:HelpTip.Standard="順番待ちにしてある変更の一覧を開きます。括弧内は現在の待ち件数です。まとめて適用できます。"
                                views:HelpTip.Detailed="接ぎ木パネルの「キューへ追加」で溜めておいた変更の一覧を開きます。ボタンの括弧内の数字は、今たまっている件数です。開いた画面で内容を確認し、不要なものを取り除いてから、まとめて適用できます。"
                                AutomationProperties.Name="パッチキューを開く" />
                    </StackPanel>
                </ScrollViewer>

                <!--
                    右端固定グループ（履歴・設定・？）。作業の流れの外にある補助機能をまとめる。
                    x:Name="CommandBarRightGroup"は回帰テスト（右端グループにあることの確認）が
                    拠り所にする。アイコンのみのボタンは、ツールチップと読み上げの名前で
                    何のボタンかが分かるようにしてある。
                -->
                <StackPanel x:Name="CommandBarRightGroup"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">

                    <Button x:Name="HistoryButton"
                            Content="履歴"
                            Command="{Binding Graft.ShowHistoryCommand}"
                            Classes="subtle"
                            views:HelpTip.Standard="これまでに適用した変更の一覧を開きます。選んで取り消すことができます（Ctrl+Shift+H）。"
                            views:HelpTip.Detailed="これまでに「適用」したすべての変更が、時系列の一覧として記録されています。過去のどれかを選ぶと、その時点の内容を確認したり、適用を取り消したりできます。誤った変更を適用してしまったときのやり直し手段です。ショートカットキーはCtrl+Shift+Hです。"
                            AutomationProperties.Name="履歴ビューを開く" />

                    <Button x:Name="SettingsButton"
                            Command="{Binding Graft.OpenSettingsCommand}"
                            VerticalAlignment="Center"
                            Padding="6"
                            Classes="subtle" BorderThickness="0"
                            views:HelpTip.Standard="テーマ・エディタ・安全機構などの設定を開きます（Ctrl+,）。"
                            views:HelpTip.Detailed="Graft全体の動作を調整する設定画面を開きます。見た目の色（テーマ）、この説明文の詳しさ、エディタの表示、バックアップの保持数など、多くの項目をここでまとめて変更できます。変更は入力した瞬間に自動で保存されるため、保存ボタンを押す必要はありません。ショートカットキーはCtrl+,です。"
                            AutomationProperties.Name="設定を開く">
                        <views:IconGlyph Width="16" Height="16" Data="{DynamicResource IconSettingsGeometry}" />
                    </Button>

                    <!-- ヘルプメニュー。標準のMenuFlyoutなので、Enter・Space・矢印キー・Escで操作できる。 -->
                    <Button x:Name="ShortcutsButton"
                            VerticalAlignment="Center"
                            Padding="6"
                            Classes="subtle" BorderThickness="0"
                            views:HelpTip.Standard="取扱説明書（F1）・キーボードショートカット一覧（Ctrl+/）などを開くメニューを表示します。"
                            views:HelpTip.Detailed="Graftの使い方をまとめた取扱説明書と、キーボードショートカットの一覧を開くためのメニューを表示します。取扱説明書はキーボードでF1を、ショートカット一覧はCtrl+/を押しても、このボタンを経由せず直接開けます。"
                            AutomationProperties.Name="ヘルプメニューを開く">
                        <views:IconGlyph Width="16" Height="16" Data="{DynamicResource IconHelpCircleGeometry}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="取扱説明書" InputGesture="F1"
                                          Command="{Binding OpenManualCommand}"
                                          AutomationProperties.Name="取扱説明書を開く" />
                                <MenuItem Header="キーボードショートカット一覧" InputGesture="Ctrl+OemQuestion"
                                          Command="{Binding OpenShortcutsCommand}"
                                          AutomationProperties.Name="キーボードショートカット一覧を開く" />
                                <!-- 画面上のチュートリアル（コーチマーク）。初回起動ガイドの最終画面から
                                     開始する体験を、あとからいつでも再実行できる入口。 -->
                                <MenuItem Header="使い方を学ぶ"
                                          Command="{Binding StartTutorialCommand}"
                                          AutomationProperties.Name="使い方を学ぶ（画面上のチュートリアルを開始）" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- 4.8.4: テンプレート選択ドロップダウン。名称の右に展開後の推定トークン数を表示する。
                     「依頼文をコピー」の直下に出す（▼ボタンはコマンドでIsOpenを立てるだけ）。 -->
                <Popup x:Name="PromptPopup"
                       PlacementTarget="{Binding #PromptButton}"
                       Placement="Bottom"
                       IsLightDismissEnabled="True"
                       IsOpen="{Binding Graft.PromptCopy.IsOpen, Mode=TwoWay}">
                    <Border Background="{DynamicResource BgElevated}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            Padding="12"
                            MinWidth="280" MaxWidth="420"
                            AutomationProperties.Name="依頼文テンプレートの選択">
                        <StackPanel DataContext="{Binding Graft.PromptCopy}">
                            <TextBlock Text="依頼文テンプレート"
                                       FontSize="{DynamicResource PaneHeadingFontSize}"
                                       FontWeight="{DynamicResource PaneHeadingFontWeight}"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <!--
                                実機で確認された指摘3: 項目をダブルクリックしても何も起きず、
                                「コピー」ボタンまでたどり着くのに必ず3クリックかかっていた
                                （項目選択→コピー押下の2クリックでは済まず、開く操作を含めると3）。
                                ダブルタップとEnterで「選んで即コピーして閉じる」を追加する
                                （コードビハインドはShellWindow.axaml.csのOnPromptTemplate系参照）。
                                「コピー」ボタン自体は変更しない（マウスで1件ずつ選んで内容を
                                確認してからコピーしたい場合の経路として残す）。
                            -->
                            <ListBox x:Name="PromptTemplateListBox"
                                     ItemsSource="{Binding Templates}"
                                     SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                     MaxHeight="220"
                                     Margin="0,8,0,0"
                                     AutomationProperties.Name="テンプレート一覧（推定トークン数付き）">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding StatusMessage}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       IsVisible="{Binding StatusMessage,
                                                   Converter={x:Static views:Converters.NotEmptyString}}" />
                            <!--
                                依頼の観点（チップ）。選んだ観点は依頼文の「# 対象ファイル」の直前に入る
                                （何も選ばなければ従来と同じ依頼文）。選択はコンテキスト収集の窓と共有する
                                （PromptCopyViewModel.Context.Focus。仕様書_ブックの情報と依頼の観点 6.2）。
                            -->
                            <views:PromptFocusPanel DataContext="{Binding Context.Focus}" Margin="0,10,0,0" />
                            <!--
                                値の見本（ブックの情報）をオンにしている間は、依頼文に各シートの先頭数行の値が入ることを
                                常に1行出す（仕様書_ブックの情報と依頼の観点 5.2）。オフのときは出ない。
                            -->
                            <TextBlock Text="{Binding Context.WorkbookInfo.SampleNoticeText}"
                                       IsVisible="{Binding Context.WorkbookInfo.IsSampleNoticeVisible}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource StateWarn}"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       AutomationProperties.Name="値の見本の注意" />
                            <!--
                                指示文と選んだファイルを1回のコピーで渡すための選択肢。テンプレートの本文は
                                書き換えず、コピーのたびに「指示文の後ろにファイルを付けるか」だけを選ぶ。
                                既定はオフ（従来どおり指示文だけ）。設定にも保存される
                                （PromptCopyViewModel.AppendSelectedFiles参照）。
                            -->
                            <CheckBox Content="選んだファイルも付ける"
                                      IsChecked="{Binding AppendSelectedFiles, Mode=TwoWay}"
                                      Margin="0,8,0,0"
                                      AutomationProperties.Name="選んだファイルも付ける"
                                      views:HelpTip.Standard="依頼文の後ろに、「ファイルを選ぶ」画面で選んだファイルの内容も付けてコピーします。依頼文とファイルを1回の貼り付けでAIへ渡せます。"
                                      views:HelpTip.Detailed="オンにすると、テンプレートをコピーするとき、依頼文の後ろに「ファイルを選ぶ」画面で選んだファイルの内容も続けてコピーします。依頼文とファイルを別々に2回コピーして貼る手間が要りません。テンプレートの本文に変数 {{files}} がある場合はそこへファイルが入るため、二重には付きません。既定はオフ（従来どおり依頼文だけ）で、切り替えは保存され次回も効きます。" />
                            <Button Content="コピー"
                                    Command="{Binding CopyCommand}"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0"
                                    AutomationProperties.Name="選択したテンプレートをコピー" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- ============== 本体: サイドバー／サイドビュー／エディタ＋接ぎ木パネル ============== -->
        <Grid Grid.Row="1" x:Name="BodyGrid">
            <!--
                要望1（実機からの改善要望）: サイドビュー列（列1）の MinWidth は
                ここでは 0 のまま置く。折りたたみ機能（ViewModel.IsSideViewCollapsed）は
                この列の幅を GridLength(0) へ直接書き換えることで実現しており、MinWidthを
                ここで正の値にしてしまうと折りたたみ時にその値へ切り上げられてしまい
                「折りたたむと0にならない」という別の不具合になる。そのため実際の
                ドラッグ下限（ペインを潰しきれないようにする最小幅）は、展開中だけ
                ShellWindow.axaml.cs（ApplySideViewState）が動的に付け外しする
                （折りたたみ機能と喧嘩しないための対応）。
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="260" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <views:SideBar Grid.Column="0" />

            <!--
                サイドビュー: エクスプローラ／プロジェクト／履歴／検索。
                表示の出し分けは外側のBorderに置く。同じ要素で DataContext を差し替えると
                IsVisible のバインドもその新しいDataContext（Explorer等）に対して解決されてしまい、
                SelectedSideView が見つからず全ビューが重なって表示されるため。
            -->
            <Grid Grid.Column="1">
                <Border IsVisible="{Binding SelectedSideView,
                                    Converter={x:Static views:Converters.SideViewIs},
                                    ConverterParameter=Explorer}">
                    <views:ExplorerView x:Name="ExplorerViewControl" DataContext="{Binding Explorer}" />
                </Border>
                <Border IsVisible="{Binding SelectedSideView,
                                    Converter={x:Static views:Converters.SideViewIs},
                                    ConverterParameter=Project}">
                    <views:ProjectPane x:Name="ProjectPaneControl" DataContext="{Binding Graft.ProjectPane}" />
                </Border>
                <Border IsVisible="{Binding SelectedSideView,
                                    Converter={x:Static views:Converters.SideViewIs},
                                    ConverterParameter=History}">
                    <views:HistoryPane x:Name="HistoryPaneControl" DataContext="{Binding Graft.History}" />
                </Border>
                <Border IsVisible="{Binding SelectedSideView,
                                    Converter={x:Static views:Converters.SideViewIs},
                                    ConverterParameter=Search}">
                    <views:SearchView x:Name="SearchViewControl" DataContext="{Binding Search}" />
                </Border>
            </Grid>

            <!--
                要望1: 掴みやすさのため幅は6px（実機で4pxは掴みにくかったため6pxへ）とし、
                カーソルを左右リサイズ形状にして「ここはドラッグできる」と分かるようにする。
                GridSplitterはThumb派生のTemplatedControlのため、ControlTheme側に
                ControlTemplate（Border 1枚）を与えないと何も描画されずヒットテストの
                対象にもならない＝ドラッグが一切効かないという不具合があった
                （Controls.Layout.axamlのGridSplitterテーマ参照。実機・headlessテスト
                双方でPointerPressedすら発火しないことを確認して特定した）。
            -->
            <GridSplitter x:Name="SideViewSplitter"
                          Grid.Column="2"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWestEast"
                          Background="{DynamicResource BorderSubtle}"
                          AutomationProperties.Name="サイドビューとエディタの境界" />

            <!--
                エディタ領域 ＋ 接ぎ木パネル。配置（下／右）はGraftPanel.axamlのヘッダーボタンで
                切り替えられる（利用者からの改善要望）。行・列の定義はコードビハインドから寸法を
                書き換えるため、Gridに名前を付けてRowDefinitions[1]/[2]・ColumnDefinitions[1]/[2]を
                位置で参照する（AvaloniaのXAMLコンパイラはRow/ColumnDefinitionのx:Nameに対して
                フィールドを生成しないため、v2.0のWPF版のように定義自体へ名前は付けられない）。

                下配置（既定）: 行方向を使う。[0]エディタ／[1]水平スプリッタ／[2]接ぎ木パネル。
                列は[0]（*）のみを使い、[1][2]は幅0へたたんでおく。
                右配置: 列方向を使う。[0]エディタ／[1]垂直スプリッタ／[2]接ぎ木パネル。
                行は[0]（*、MinHeight=120）がGrid全体の高さを占め、[1][2]は高さ0へたたんでおく。
                接ぎ木パネル（views:GraftPanel）自体は常に1つのインスタンスのままで、
                ShellWindow.axaml.cs（ApplyGraftPanelState）がGrid.SetRow/Grid.SetColumnで
                位置だけを付け替える（2枚のレイアウトを複製して片方を隠す方式は取らない）。
            -->
            <Grid Grid.Column="3" x:Name="EditorAreaGrid">
                <!-- エディタ行（[0]）のMinHeightは常時固定で構わない（折りたたみ対象ではないため）。
                     接ぎ木パネル行（[2]）のMinHeightは列1と同じ理由で折りたたみ（ヘッダーのみ32px）と
                     喧嘩するため、ShellWindow.axaml.cs（ApplyGraftPanelState）が動的に付け外す。 -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <!-- 列側は右配置のときだけ使う。既定（下配置）は[1][2]とも幅0にたたみ、
                     エディタ列（[0]）だけがGridの全幅を占める。エディタ列のMinWidthは、
                     右配置で接ぎ木パネル側を広げ過ぎてもエディタが潰れきらないための下限
                     （BodyGrid列3のMinWidth=320と同じ考え方）。 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        x:Name="EditorHost"
                        Focusable="True"
                        Background="{DynamicResource BgSurface}"
                        AutomationProperties.Name="エディタ領域">
                    <views:EditorPane DataContext="{Binding Editor}" />
                </Border>

                <!-- クイックオープン（Ctrl+P）。エディタ領域の上部中央に浮かせて重ねる
                     （配置に関わらずエディタの真上にだけ重なればよいため、常にGrid.Column=0）。 -->
                <views:QuickOpenOverlay Grid.Row="0" Grid.Column="0"
                                        x:Name="QuickOpenOverlayControl"
                                        DataContext="{Binding QuickOpen}" />

                <!-- コマンドパレット（Ctrl+Shift+P、機能改善）。クイックオープンと同じ配置。
                     ShellViewModelが2つのオーバーレイを同時に開かないよう調停する
                     （ShellViewModel.CommandPalette.cs参照）ため、ここでは単純に重ねるだけでよい。 -->
                <views:CommandPaletteOverlay Grid.Row="0" Grid.Column="0"
                                             x:Name="CommandPaletteOverlayControl"
                                             DataContext="{Binding CommandPalette}" />

                <!-- 下配置用（水平スプリッタ）。右配置中はShellWindow.axaml.csがIsVisible=Falseにする。 -->
                <GridSplitter x:Name="GraftSplitter"
                              Grid.Row="1" Grid.Column="0"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Cursor="SizeNorthSouth"
                              Background="{DynamicResource BorderSubtle}"
                              AutomationProperties.Name="エディタと接ぎ木パネルの境界" />

                <!-- 右配置用（垂直スプリッタ）。下配置中はShellWindow.axaml.csがIsVisible=Falseにする。
                     GridSplitterのControlTheme（Controls.Layout.axaml）はテンプレートを持つため、
                     下配置のGraftSplitterと同じくドラッグが効く。 -->
                <GridSplitter x:Name="GraftSplitterRight"
                              Grid.Row="0" Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Cursor="SizeWestEast"
                              Background="{DynamicResource BorderSubtle}"
                              IsVisible="False"
                              AutomationProperties.Name="エディタと接ぎ木パネルの境界（右配置）" />

                <views:GraftPanel x:Name="GraftPanelControl" Grid.Row="2" Grid.Column="0" />
            </Grid>
        </Grid>

        <!-- ============== ステータスバー（24px） ============== -->
        <views:StatusBarView Grid.Row="2" />

        <!--
            点検指摘A-2: プロジェクト切り替え中の待機表示。
            ShellViewModel.IsProjectSwitchBusy は従来 ShellWindow.ProjectComboBox.cs の
            ホイール操作ガード（切り替え中の入力を捨てる）にしか使われておらず、どの
            .axaml にもバインドされていなかった。切り替え1件は Editor.CloseAllAsync
            （未保存の確認ダイアログを含みうる）・Explorer.SetProjectAsync（ツリーの
            作り直しとファイル監視の張り直し）を伴い、SMB越しのプロジェクトでは数秒
            かかる。その間まったくの無表示だと、利用者は「効かなかった」と思って
            ComboBoxを連打する。

            見せ方は他のペイン（ExplorerView・ContextCollectWindow）と揃えて、
            アクセント色の高さ2pxの不確定プログレスバーにする。本体行（Grid.Row=1）の
            上端へ重ねることで、コマンドバーのすぐ下＝視線が最後に置かれていた
            ComboBoxの真下に出る。TutorialOverlayより前に置いているのは、
            コーチマーク表示中はそちらを最前面にしたいため（Avaloniaは子の描画順=Z順）。
        -->
        <ProgressBar x:Name="ProjectSwitchProgressBar"
                     Grid.Row="1" VerticalAlignment="Top"
                     Height="2" IsIndeterminate="True"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Accent}"
                     IsVisible="{Binding IsProjectSwitchBusy}"
                     AutomationProperties.Name="プロジェクトを切り替え中" />

        <!--
            画面上のチュートリアル（コーチマーク）のオーバーレイ。コマンドバー・本体・
            ステータスバーの3行すべてに重なるよう、この最上位Gridの最後の子として
            Grid.RowSpan="3"で配置する（Avaloniaは子の描画順=Z順のため、最後に置くことで
            必ず最前面に来る）。既定は非表示（TutorialOverlay.axaml側でIsVisible="False"）。
            実際の開始・進行の制御はShellWindow.Tutorial.cs、対象コントロールを明るく見せる
            仕組み・吹き出しの位置計算はTutorialOverlay.axaml.csが担う。
        -->
        <views:TutorialOverlay x:Name="TutorialOverlayControl" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</Window>
