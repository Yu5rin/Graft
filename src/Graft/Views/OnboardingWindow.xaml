<Window x:Class="Graft.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Graftへようこそ"
        Width="560" Height="420" MinWidth="560" MinHeight="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        AutomationProperties.Name="初回起動ガイド">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 画面1: 導入 -->
        <StackPanel x:Name="Screen1" Grid.Row="0" VerticalAlignment="Center">
            <Image Source="{DynamicResource LogoImage}" Width="72" Height="72" HorizontalAlignment="Center"
                   AutomationProperties.Name="Graftロゴ" />
            <TextBlock Text="Graftへようこそ" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,8" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                       Text="GraftはAIが提案したコードの変更を、安全にファイルへ適用するためのツールです。&#10;最初にプロジェクトを登録し、AI向けのプロンプトをコピーする方法を確認しましょう。" />
        </StackPanel>

        <!-- 画面2: プロジェクト登録 -->
        <StackPanel x:Name="Screen2" Grid.Row="0" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="プロジェクトを登録" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"
                       Text="変更を適用したいプロジェクトのフォルダを登録します。あとから設定画面でいつでも追加・変更できます。" />
            <Button Content="フォルダを選択して登録" Click="OnRegisterProjectClicked" HorizontalAlignment="Left"
                    AutomationProperties.Name="フォルダを選択してプロジェクトを登録" />
            <TextBlock x:Name="ProjectResultText" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <!-- 画面3: プロンプトテンプレートのコピー -->
        <StackPanel x:Name="Screen3" Grid.Row="0" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="プロンプトをコピー" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       Text="AIに出力形式を守らせるための指示文をクリップボードへコピーできます。会話の最初にAIへ貼り付けてください。" />
            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Background="{DynamicResource BgSurface}">
                <TextBox x:Name="TemplatePreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="120" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                         FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource CodeFontSize}"
                         AutomationProperties.Name="初回用プロンプトのプレビュー" />
            </Border>
            <Button Content="クリップボードにコピー" Click="OnCopyTemplateClicked" Margin="0,12,0,0" HorizontalAlignment="Left"
                    AutomationProperties.Name="プロンプトをクリップボードにコピー" />
            <TextBlock x:Name="CopyResultText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StepIndicatorText" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource CaptionFontSize}" />
            <Button x:Name="BackButton" Grid.Column="2" Content="戻る" Click="OnBackClicked" Margin="0,0,8,0"
                    IsEnabled="False" AutomationProperties.Name="前の画面に戻る" />
            <Button x:Name="SkipButton" Grid.Column="3" Content="スキップ" Click="OnSkipClicked" Margin="0,0,8,0"
                    AutomationProperties.Name="ガイドをスキップ" />
            <Button x:Name="NextButton" Grid.Column="4" Content="次へ" Click="OnNextClicked" IsDefault="True"
                    AutomationProperties.Name="次の画面へ" />
        </Grid>
    </Grid>
</Window>
