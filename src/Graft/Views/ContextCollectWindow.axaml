<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Graft.ViewModels"
        xmlns:local="clr-namespace:Graft.Views"
        x:Class="Graft.Views.ContextCollectWindow"
        x:Name="Root"
        Title="コンテキスト収集"
        Width="760" Height="640" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        AutomationProperties.Name="コンテキスト収集">
    <!--
        10章 コンテキスト収集。v2.0のWPF版からの差分:
        - Visibility は IsVisible（bool）へ。
        - TabControl/TabItem の書式は共通テーマ（Themes/Controls.Layout.axaml）が持つため、
          v2.0のWPF版がこの画面内に抱えていた重複定義は不要になった。
        - RelativeSource AncestorType=Window は ElementName（#Root）へ。
        - 仮想化はListBoxの既定の挙動のため VirtualizingPanel の添付プロパティは不要。
    -->
    <Grid RowDefinitions="2,Auto,*,Auto">

        <!-- 8.8: アクセント色の細い不確定プログレスバー。 -->
        <ProgressBar Grid.Row="0" Height="2" IsIndeterminate="True"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Accent}"
                     IsVisible="{Binding IsScanning}" />

        <StackPanel Grid.Row="1" Margin="16,12,16,8">
            <TextBlock Text="コンテキスト収集" FontSize="{DynamicResource PaneHeadingFontSize}"
                       FontWeight="{DynamicResource PaneHeadingFontWeight}" />
            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto,*">
                <TextBlock Grid.Column="0" Text="収集モード" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedValue="{Binding SelectedMode}"
                          SelectedValueBinding="{Binding Mode}"
                          ItemTemplate="{StaticResource LabelItemTemplate}"
                          MaxWidth="220" HorizontalAlignment="Left"
                          AutomationProperties.Name="収集モード" TabIndex="0"
                          local:HelpTip.Standard="AIへ渡す内容の集め方を選びます。「ツリーのみ」はファイル構成だけ、「選択ファイル」は中身も含める、「差分のみ」は前回からの変更点だけです。"
                          local:HelpTip.Detailed="下のファイル一覧・出力プレビューに何を含めるかを選びます。「ツリーのみ」はフォルダ構成だけを伝え中身は含めません。「選択ファイル」は左のファイル一覧でチェックした内容も含めます（通常はこれを使います）。「ツリー＋選択」はフォルダ構成全体を見せつつ、選んだファイルだけ中身も含めます。「差分のみ」は右側で選ぶ過去のリビジョンから今までの変更点だけを抜き出します（大きなプロジェクトで変更箇所だけをAIに伝えたいときに使います）。" />
                <TextBlock Grid.Column="2" Text="対象リビジョン" VerticalAlignment="Center" Margin="16,0,8,0"
                           IsVisible="{Binding ShowRevisionPicker}" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}"
                          ItemTemplate="{StaticResource DisplayTextItemTemplate}"
                          MaxWidth="260" HorizontalAlignment="Left"
                          AutomationProperties.Name="差分の基準リビジョン" TabIndex="1"
                          IsVisible="{Binding ShowRevisionPicker}"
                          local:HelpTip.Standard="「差分のみ」モードで、どの時点から今までの変更を集めるかを選びます。"
                          local:HelpTip.Detailed="収集モードが「差分のみ」のとき、履歴（バックアップ）の中からどのリビジョンを基準にするかを選びます。ここで選んだ時点から現在までに変更されたファイルの差分だけが、AIへ渡す内容に含まれます。" />
            </Grid>

            <Border Margin="0,10,0,0" BorderBrush="{DynamicResource StateError}" BorderThickness="1" Padding="8"
                    IsVisible="{Binding ErrorIssue, Converter={x:Static local:Converters.NotNull}}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource StateError}"
                           Text="{Binding ErrorIssue, Converter={x:Static local:Converters.IssueToText}}" />
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2" Margin="16,0,16,8" Background="Transparent" BorderThickness="0">
            <TabItem Header="ファイル選択" AutomationProperties.Name="ファイル選択タブ">
                <Grid Margin="0,8,0,0" ColumnDefinitions="2*,Auto,1*">

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="ファイル" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"
                                   local:HelpTip.Standard="行のアイコンをクリック（またはSpaceキー）すると「内容も出す→構成だけ→出さない」の3状態を切り替えられます。フォルダなら配下へまとめて適用されます。"
                                   local:HelpTip.Detailed="ファイル名の左のアイコンをクリックする、またはその行を選んでSpaceキーを押すと、「内容も出す」（チェックのアイコン。出力にファイル構成も中身も含める）「構成だけ」（ファイルのアイコン。ファイル構成には載るが中身は出力しない。lib/やnode_modules/のような、存在は知らせたいが中身は不要なフォルダを一括で切り替えるのに使う）「出さない」（×のアイコン。ファイル構成にも出力にも一切含めない）の3状態を順に切り替えられます。フォルダのアイコンをクリックすると、配下のファイル・サブフォルダすべてへ同じ状態がまとめて適用されます。配下の状態が一致していないフォルダは「混在」を示す重なったアイコンで表示され、この状態でクリックすると配下すべてが「内容も出す」に揃います。既定では全ファイルが「内容も出す」です。" />
                        <Grid>
                            <ListBox x:Name="FileListBox" ItemsSource="{Binding Files}"
                                     SelectedItem="{Binding SelectedFile}"
                                     AutomationProperties.Name="ファイル一覧" TabIndex="2"
                                     IsVisible="{Binding !IsEmpty}"
                                     local:HelpTip.Standard="プロジェクト内のファイル構成です。各行のアイコンをクリックすると「内容も出す／構成だけ／出さない」を切り替えられます。"
                                     local:HelpTip.Detailed="プロジェクトのフォルダ構成を一覧表示しています。各行のアイコンをクリック（またはSpaceキー）すると、そのファイル・フォルダの扱いを「内容も出す／構成だけ／出さない」の3状態で切り替えられます（詳細は上の見出しのツールチップ参照）。ここではまだ何もコピー・保存されておらず、選び終えたら下の「プレビュー」「コピー」「ファイルへ保存」のいずれかで実際の出力を作成します。">
                                <ListBox.KeyBindings>
                                    <KeyBinding Gesture="Space" Command="{Binding CycleSelectedStateCommand}" />
                                </ListBox.KeyBindings>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ContextFileNodeViewModel">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="{Binding IndentLevel,
                                                             Converter={x:Static local:Converters.IndentToMargin}}"
                                                    AutomationProperties.Name="{Binding AutomationLabel}">
                                            <local:IconGlyph Data="{DynamicResource IconFolderGeometry}"
                                                             Width="14" Height="14" Margin="0,0,4,0"
                                                             IsVisible="{Binding IsDirectory}" />
                                            <local:IconGlyph Data="{DynamicResource IconAlertTriangleGeometry}"
                                                             Width="14" Height="14" Margin="0,0,4,0"
                                                             Stroke="{DynamicResource StateWarn}"
                                                             ToolTip.Tip="{Binding ExcludeReason}"
                                                             IsVisible="{Binding IsExcluded}" />
                                            <!--
                                                課題2: 3状態選択。素のCheckBox.IsThreeStateは「未選択／選択／中間」の
                                                3値しか表せず、ここで必要な「内容も出す／構成だけ／出さない」という
                                                3つの実値と、フォルダ集計専用の「混在」という第4の表示状態を両立できない
                                                （中間＝構成だけと誤読される）。そのため、クリックで3状態を巡回する
                                                Buttonに、状態ごとに異なるアイコン・色を割り当てる方式にした
                                                （一目で見分けられることを優先）。
                                            -->
                                            <Button Classes="stateToggle" IsVisible="{Binding !IsExcluded}"
                                                    Command="{Binding DataContext.CycleStateCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding StateLabel}"
                                                    AutomationProperties.Name="{Binding AutomationLabel}">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{x:Static local:Converters.FileCheckEnabled}">
                                                        <Binding Path="IsExcluded" />
                                                        <Binding Path="DataContext.ShowFileTree" ElementName="Root" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                                <local:IconGlyph Width="14" Height="14"
                                                                 Classes.stateFull="{Binding IsFull}"
                                                                 Classes.stateStructureOnly="{Binding IsStructureOnly}"
                                                                 Classes.stateHidden="{Binding IsHidden}"
                                                                 Classes.stateMixed="{Binding IsMixed}" />
                                            </Button>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsVisible="{Binding IsEmpty}">
                                <local:IconGlyph Data="{DynamicResource IconFolderGeometry}"
                                                 Width="32" Height="32" Opacity="0.4" HorizontalAlignment="Center" />
                                <TextBlock Text="対象ファイルがありません" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" />

                    <DockPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="追加の除外パターン（プロジェクト単位）"
                                   FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,0,0,4" />
                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding NewExcludePattern}"
                                     AutomationProperties.Name="追加する除外パターン" TabIndex="3"
                                     local:HelpTip.Standard="AIへ渡す内容から除外したいファイル・フォルダのパターンを入力します（例: *.log、node_modules/）。"
                                     local:HelpTip.Detailed="ここに入力したパターンに一致するファイル・フォルダを、このプロジェクトでは常にファイル一覧・出力から除外できます（例: *.log で全てのログファイル、node_modules/ でそのフォルダ全体）。.gitignoreと似た書き方です。入力したら右の「追加」ボタンで確定します。" />
                            <Button Grid.Column="1" Content="追加" Command="{Binding AddExcludeCommand}" Margin="6,0,0,0"
                                    local:HelpTip.Standard="入力した除外パターンをこのプロジェクト専用の除外リストへ追加します。次回以降のファイル一覧・収集結果から外れます。"
                                    local:HelpTip.Detailed="左のテキストボックスに入力したパターン（例: *.log や node_modules/）を、このプロジェクト専用の除外リストへ追加します。追加すると、左側のファイル一覧やAIへ渡す内容から、パターンに一致するファイルが除かれるようになります。AIに読ませたくない大きなファイルや秘密情報を含むファイルを外すのに使います。"
                                    AutomationProperties.Name="除外パターンを追加" TabIndex="4" />
                        </Grid>
                        <ListBox ItemsSource="{Binding ExtraExcludes}"
                                 AutomationProperties.Name="プロジェクト単位の除外パターン一覧" TabIndex="5"
                                 local:HelpTip.Standard="このプロジェクトに登録済みの除外パターンの一覧です。各行の「削除」で取り除けます。"
                                 local:HelpTip.Detailed="上で追加した除外パターンの一覧です。このプロジェクトを開いている間はずっと有効で、ファイル一覧・出力プレビューに反映されます。不要になったパターンは各行の「削除」ボタンで取り除けます。">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="削除"
                                                Command="{Binding DataContext.RemoveExcludeCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                local:HelpTip.Standard="この除外パターンをプロジェクトの除外リストから取り除きます。"
                                                local:HelpTip.Detailed="この1件の除外パターンだけをリストから取り除きます。取り除くと、次にファイル一覧・収集結果を作り直したときに、これまでこのパターンで除かれていたファイルが再び対象に含まれるようになります。"
                                                AutomationProperties.Name="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="プレビュー" AutomationProperties.Name="出力プレビュータブ">
                <Grid Margin="0,8,0,0">
                    <ListBox ItemsSource="{Binding PreviewLines}" Background="Transparent" BorderThickness="0"
                             FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource CodeFontSize}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="出力プレビュー"
                             IsVisible="{Binding PreviewLines, Converter={x:Static local:Converters.HasItems}}"
                             local:HelpTip.Standard="「プレビュー」または「コピー」を押すと、実際にAIへ渡される文章がここに表示されます。"
                             local:HelpTip.Detailed="「ファイル選択」タブで選んだ内容から実際に組み立てられた、AIへ渡す文章そのものです。「コピー」ボタンでクリップボードへコピーされる内容と同じものがここで確認できます。この画面を見ているだけではまだ何も送信・コピーされていません。">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <local:CodeLineControl LineText="{Binding Text}" Tokens="{Binding Tokens}"
                                                       AutomationProperties.Name="{Binding Text}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsVisible="{Binding PreviewLines,
                                            Converter={x:Static local:Converters.IsEmptyCollection}}">
                        <local:IconGlyph Data="{DynamicResource IconEyeGeometry}"
                                         Width="32" Height="32" Opacity="0.4" HorizontalAlignment="Center" />
                        <TextBlock Text="「プレビュー」または「コピー」を押すと出力内容を表示します"
                                   Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="16,0,16,16" ColumnDefinitions="*,Auto,Auto,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Classes="statusMessage"
                           Classes.warn="{Binding ExceedsWarnThreshold}" />
                <TextBlock Text="{Binding EstimatedTokens, StringFormat=推定トークン数: {0} 件}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="{DynamicResource CaptionFontSize}" />
            </StackPanel>
            <Button Grid.Column="1" Content="プレビュー" Command="{Binding PreviewCommand}" Margin="0,0,8,0"
                    local:HelpTip.Standard="選んだファイルからAIへ渡す内容を組み立て、プレビュータブと推定トークン数で確認します。クリップボードへはコピーしません。"
                    local:HelpTip.Detailed="左で選んだファイルの内容をつなぎ合わせ、実際にAIへ渡す文章としてどう組み立てられるかを「プレビュー」タブで確認できます。おおよそのトークン数（AIへの負荷の目安）もここで分かります。この操作ではクリップボードには何もコピーされないため、内容を確認するだけのときに使ってください。"
                    AutomationProperties.Name="推定トークン数をプレビュー" TabIndex="6" />
            <Button Grid.Column="2" Content="コピー" Command="{Binding CopyCommand}" Margin="0,0,8,0"
                    local:HelpTip.Standard="選んだファイルからAIへ渡す内容を組み立て、クリップボードへコピーします。推定トークン数が上限を超えている場合はコピーされず警告のみ表示します。"
                    local:HelpTip.Detailed="左で選んだファイルの内容をつなぎ合わせ、AIへ渡す文章としてクリップボードへコピーします。コピーしたら、そのままChatGPTやClaudeなどのAIとの会話に貼り付けて質問してください。推定トークン数が設定の上限を超えている場合は、コピーされずに警告だけが表示されます（内容が大きすぎるため、除外パターンでファイルを減らすなどの調整が必要です）。"
                    AutomationProperties.Name="コンテキストをクリップボードへコピー" TabIndex="7" />
            <Button Grid.Column="3" Content="ファイルへ保存" Command="{Binding SaveToFileCommand}"
                    local:HelpTip.Standard="選んだファイルからAIへ渡す内容を組み立て、名前を付けてMarkdownファイルへ保存します。"
                    local:HelpTip.Detailed="左で選んだファイルの内容をつなぎ合わせ、Markdown形式のテキストファイルとして好きな場所へ保存します。既定のファイル名はプロジェクト名と保存日時から自動で組み立てます（例: デモ_20260808_1530.md）。保存したファイルはそのままAIチャットへ添付・貼り付けして使えます。推定トークン数が上限を超えている場合でも保存自体は行いますが、内容が大きすぎる可能性があるため見直しを促す表示が出ます。"
                    AutomationProperties.Name="コンテキストをファイルへ保存" TabIndex="8" />
        </Grid>
    </Grid>

    <Window.Styles>
        <Style Selector="TextBlock.statusMessage">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.statusMessage.warn">
            <Setter Property="Foreground" Value="{DynamicResource StateWarn}" />
        </Style>

        <!-- 課題2: 3状態切替ボタンの見た目。透明・枠無しの小さなボタンにアイコンだけを乗せる。 -->
        <Style Selector="Button.stateToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- 内容も出す: チェック（アクセント色）。 -->
        <Style Selector="local|IconGlyph.stateFull">
            <Setter Property="Data" Value="{DynamicResource IconCheckGeometry}" />
            <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        </Style>
        <!-- 構成だけ: ファイルの輪郭のみ（中身が無いことを表す）。 -->
        <Style Selector="local|IconGlyph.stateStructureOnly">
            <Setter Property="Data" Value="{DynamicResource IconFileGeometry}" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
        </Style>
        <!-- 出さない: ×（警告色）。 -->
        <Style Selector="local|IconGlyph.stateHidden">
            <Setter Property="Data" Value="{DynamicResource IconXGeometry}" />
            <Setter Property="Stroke" Value="{DynamicResource StateError}" />
        </Style>
        <!-- 混在（フォルダの集計専用。ユーザーが選べる値ではない）: 重なった層。 -->
        <Style Selector="local|IconGlyph.stateMixed">
            <Setter Property="Data" Value="{DynamicResource IconLayersGeometry}" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
        </Style>
    </Window.Styles>
</Window>
