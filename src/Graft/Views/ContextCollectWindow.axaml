<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Graft.ViewModels"
        xmlns:local="clr-namespace:Graft.Views"
        x:Class="Graft.Views.ContextCollectWindow"
        x:Name="Root"
        Title="コンテキスト収集"
        Width="760" Height="640" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        AutomationProperties.Name="コンテキスト収集">
    <!--
        10章 コンテキスト収集。v2.0のWPF版からの差分:
        - Visibility は IsVisible（bool）へ。
        - TabControl/TabItem の書式は共通テーマ（Themes/Controls.Layout.axaml）が持つため、
          v2.0のWPF版がこの画面内に抱えていた重複定義は不要になった。
        - RelativeSource AncestorType=Window は ElementName（#Root）へ。
        - 仮想化はListBoxの既定の挙動のため VirtualizingPanel の添付プロパティは不要。
    -->
    <Grid RowDefinitions="2,Auto,*,Auto">

        <!-- 8.8: アクセント色の細い不確定プログレスバー。 -->
        <ProgressBar Grid.Row="0" Height="2" IsIndeterminate="True"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Accent}"
                     IsVisible="{Binding IsScanning}" />

        <StackPanel Grid.Row="1" Margin="16,12,16,8">
            <TextBlock Text="コンテキスト収集" FontSize="{DynamicResource PaneHeadingFontSize}"
                       FontWeight="{DynamicResource PaneHeadingFontWeight}" />
            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto,*">
                <TextBlock Grid.Column="0" Text="収集モード" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedValue="{Binding SelectedMode}"
                          SelectedValueBinding="{Binding Mode}"
                          ItemTemplate="{StaticResource LabelItemTemplate}"
                          MaxWidth="220" HorizontalAlignment="Left"
                          AutomationProperties.Name="収集モード" TabIndex="0" />
                <TextBlock Grid.Column="2" Text="対象リビジョン" VerticalAlignment="Center" Margin="16,0,8,0"
                           IsVisible="{Binding ShowRevisionPicker}" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}"
                          ItemTemplate="{StaticResource DisplayTextItemTemplate}"
                          MaxWidth="260" HorizontalAlignment="Left"
                          AutomationProperties.Name="差分の基準リビジョン" TabIndex="1"
                          IsVisible="{Binding ShowRevisionPicker}" />
            </Grid>

            <Border Margin="0,10,0,0" BorderBrush="{DynamicResource StateError}" BorderThickness="1" Padding="8"
                    IsVisible="{Binding ErrorIssue, Converter={x:Static local:Converters.NotNull}}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource StateError}"
                           Text="{Binding ErrorIssue, Converter={x:Static local:Converters.IssueToText}}" />
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2" Margin="16,0,16,8" Background="Transparent" BorderThickness="0">
            <TabItem Header="ファイル選択" AutomationProperties.Name="ファイル選択タブ">
                <Grid Margin="0,8,0,0" ColumnDefinitions="2*,Auto,1*">

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="ファイル" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                        <Grid>
                            <ListBox x:Name="FileListBox" ItemsSource="{Binding Files}"
                                     SelectedItem="{Binding SelectedFile}"
                                     AutomationProperties.Name="ファイル一覧" TabIndex="2"
                                     IsVisible="{Binding !IsEmpty}">
                                <ListBox.KeyBindings>
                                    <KeyBinding Gesture="Space" Command="{Binding ToggleSelectedCommand}" />
                                </ListBox.KeyBindings>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ContextFileNodeViewModel">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="{Binding IndentLevel,
                                                             Converter={x:Static local:Converters.IndentToMargin}}"
                                                    AutomationProperties.Name="{Binding AutomationLabel}">
                                            <local:IconGlyph Data="{DynamicResource IconFolderGeometry}"
                                                             Width="14" Height="14" Margin="0,0,4,0"
                                                             IsVisible="{Binding IsDirectory}" />
                                            <local:IconGlyph Data="{DynamicResource IconAlertTriangleGeometry}"
                                                             Width="14" Height="14" Margin="0,0,4,0"
                                                             Stroke="{DynamicResource StateWarn}"
                                                             ToolTip.Tip="{Binding ExcludeReason}"
                                                             IsVisible="{Binding IsExcluded}" />
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}"
                                                      AutomationProperties.Name="{Binding AutomationLabel}"
                                                      IsVisible="{Binding !IsDirectory}">
                                                <CheckBox.IsEnabled>
                                                    <MultiBinding Converter="{x:Static local:Converters.FileCheckEnabled}">
                                                        <Binding Path="IsExcluded" />
                                                        <Binding Path="DataContext.ShowFileTree" ElementName="Root" />
                                                    </MultiBinding>
                                                </CheckBox.IsEnabled>
                                            </CheckBox>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                       IsVisible="{Binding IsDirectory}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsVisible="{Binding IsEmpty}">
                                <local:IconGlyph Data="{DynamicResource IconFolderGeometry}"
                                                 Width="32" Height="32" Opacity="0.4" HorizontalAlignment="Center" />
                                <TextBlock Text="対象ファイルがありません" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" />

                    <DockPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="追加の除外パターン（プロジェクト単位）"
                                   FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,0,0,4" />
                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding NewExcludePattern}"
                                     AutomationProperties.Name="追加する除外パターン" TabIndex="3" />
                            <Button Grid.Column="1" Content="追加" Command="{Binding AddExcludeCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="除外パターンを追加" TabIndex="4" />
                        </Grid>
                        <ListBox ItemsSource="{Binding ExtraExcludes}"
                                 AutomationProperties.Name="プロジェクト単位の除外パターン一覧" TabIndex="5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="削除"
                                                Command="{Binding DataContext.RemoveExcludeCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="プレビュー" AutomationProperties.Name="出力プレビュータブ">
                <Grid Margin="0,8,0,0">
                    <ListBox ItemsSource="{Binding PreviewLines}" Background="Transparent" BorderThickness="0"
                             FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource CodeFontSize}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="出力プレビュー"
                             IsVisible="{Binding PreviewLines, Converter={x:Static local:Converters.HasItems}}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <local:CodeLineControl LineText="{Binding Text}" Tokens="{Binding Tokens}"
                                                       AutomationProperties.Name="{Binding Text}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsVisible="{Binding PreviewLines,
                                            Converter={x:Static local:Converters.IsEmptyCollection}}">
                        <local:IconGlyph Data="{DynamicResource IconEyeGeometry}"
                                         Width="32" Height="32" Opacity="0.4" HorizontalAlignment="Center" />
                        <TextBlock Text="「プレビュー」または「コピー」を押すと出力内容を表示します"
                                   Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="16,0,16,16" ColumnDefinitions="*,Auto,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Classes="statusMessage"
                           Classes.warn="{Binding ExceedsWarnThreshold}" />
                <TextBlock Text="{Binding EstimatedTokens, StringFormat=推定トークン数: {0} 件}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="{DynamicResource CaptionFontSize}" />
            </StackPanel>
            <Button Grid.Column="1" Content="プレビュー" Command="{Binding PreviewCommand}" Margin="0,0,8,0"
                    AutomationProperties.Name="推定トークン数をプレビュー" TabIndex="6" />
            <Button Grid.Column="2" Content="コピー" Command="{Binding CopyCommand}"
                    AutomationProperties.Name="コンテキストをクリップボードへコピー" TabIndex="7" />
        </Grid>
    </Grid>

    <Window.Styles>
        <Style Selector="TextBlock.statusMessage">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.statusMessage.warn">
            <Setter Property="Foreground" Value="{DynamicResource StateWarn}" />
        </Style>
    </Window.Styles>
</Window>
