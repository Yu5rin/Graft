<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Graft.ViewModels"
        xmlns:local="clr-namespace:Graft.Views"
        x:Class="Graft.Views.ContextCollectWindow"
        x:Name="Root"
        Title="AIに渡すファイルを選ぶ"
        Width="960" Height="700" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        AutomationProperties.Name="AIに渡すファイルを選ぶ">
    <!--
        10章 コンテキスト収集。v2.0のWPF版からの差分:
        - Visibility は IsVisible（bool）へ。
        - TabControl/TabItem の書式は共通テーマ（Themes/Controls.Layout.axaml）が持つため、
          v2.0のWPF版がこの画面内に抱えていた重複定義は不要になった。
        - RelativeSource AncestorType=Window は ElementName（#Root）へ。
        - 仮想化はListBoxの既定の挙動のため VirtualizingPanel の添付プロパティは不要。
    -->
    <!--
        【配置（設計案A「一覧を主役にする」）】
        縦に積むものが多すぎて、伸び縮みするのがファイル一覧だけ、という構造が窮屈さの根だった
        （VBA プロジェクトでシートを 5 枚並べると、ファイル一覧が 0 行になっていた）。次のように組み替えた。
        機能は 1 つも減らしていない。
        ・窓の既定を 760×720 → 960×700 に（最小は 600×520 → 640×560）。ブックの情報をファイル一覧の右に
          並べられる幅にする。高さ 700 は、1366×768 の画面でタスクバーを除いても収まる値。
        ・窓の題名と同じ文言の見出し（「AIに渡すファイルを選ぶ」）は、本文から外した（1 行ぶん）。
        ・依頼の観点は、見出しのかたまりを横へ流して折り返す（PromptFocusPanel）。たたむボタンつき。
        ・追加の除外パターンは、空でも窓の 1/3 を占めていた右の柱をやめ、ファイル一覧の下の折りたたみへ。
        ・ブックの情報（シート一覧・リボンの行を含む）は、広い窓（860px 以上）ではファイル一覧の右、
          狭い窓では「ブックの情報」タブへ。同じ部品の親をコード側（ContextCollectWindow.axaml.cs）が付け替える。
        ・状況の文（トークン数の助言など）は、ボタンの左の狭い列から、ボタンの上の全幅の行へ。
        ・タブの中身の左右の端は、共通テーマの TabControl の「flush」クラスで、上の収集モードや下のボタンと
          同じ 16px に揃える（負の余白で打ち消すことはしない）。
        ・Tab キーの順は画面の上から下・左から右。TabIndex は付けず、XAML の並びをそのまま順序にする
          （一部にだけ付けると、付けていない依頼の観点のチップが最後に回る）。
    -->
    <Grid RowDefinitions="2,Auto,*,Auto,Auto">

        <!-- 8.8: アクセント色の細い不確定プログレスバー。 -->
        <ProgressBar Grid.Row="0" Height="2" IsIndeterminate="True"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Accent}"
                     IsVisible="{Binding IsScanning}" />

        <StackPanel Grid.Row="1" Margin="16,12,16,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                <TextBlock Grid.Column="0" Text="収集モード" VerticalAlignment="Center" Margin="0,0,8,0" />
                <!--
                    細かいユーザビリティ改善5（ダイアログのキー操作総点検）: 開いた直後の
                    初期フォーカスをここへ当てる（ContextCollectWindow.axaml.cs参照）。
                    「プレビュー」「コピー」「ファイルへ保存」の3つはどれも対等な出力先の
                    選択であり、どれか1つを唯一の既定ボタン（Enterで実行）に決め打つと
                    かえって誤操作を招くため、意図的にIsDefaultは与えていない。
                -->
                <ComboBox x:Name="ModeComboBox" Grid.Column="1" ItemsSource="{Binding Modes}" SelectedValue="{Binding SelectedMode}"
                          SelectedValueBinding="{Binding Mode}"
                          ItemTemplate="{StaticResource LabelItemTemplate}"
                          MaxWidth="220" HorizontalAlignment="Left"
                          AutomationProperties.Name="収集モード"
                          local:HelpTip.Standard="AIへ渡す内容の集め方を選びます。「ツリーのみ」はファイル構成だけ、「選択ファイル」は選んだファイルの中身だけ、「ツリー＋選択」は構成全体＋選んだファイルの中身（既定）、「差分のみ」は前回からの変更点だけです。"
                          local:HelpTip.Detailed="下のファイル一覧・出力プレビューに何を含めるかを選びます。「ツリーのみ」はフォルダ構成だけを伝え中身は含めません。「選択ファイル」は下のファイル一覧でチェックしたファイルの中身だけを含め、構成は伝えません。「ツリー＋選択」はフォルダ構成全体を見せつつ、選んだファイルだけ中身も含めます（既定はこちらで、通常はこれを使います）。「差分のみ」は右側で選ぶ過去の履歴から今までの変更点だけを抜き出します（大きなプロジェクトで変更箇所だけをAIに伝えたいときに使います）。" />
                <TextBlock Grid.Column="2" Text="対象履歴" VerticalAlignment="Center" Margin="16,0,8,0"
                           IsVisible="{Binding ShowRevisionPicker}" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}"
                          ItemTemplate="{StaticResource DisplayTextItemTemplate}"
                          MaxWidth="260" HorizontalAlignment="Left"
                          AutomationProperties.Name="差分の基準履歴"
                          IsVisible="{Binding ShowRevisionPicker}"
                          local:HelpTip.Standard="「差分のみ」モードで、どの時点から今までの変更を集めるかを選びます。"
                          local:HelpTip.Detailed="収集モードが「差分のみ」のとき、履歴（バックアップ）の中からどの履歴を基準にするかを選びます。ここで選んだ時点から現在までに変更されたファイルの差分だけが、AIへ渡す内容に含まれます。" />
            </Grid>

            <!--
                依頼の観点（チップ）。依頼文コピーのドロップダウンと同じ部品・同じ選択状態
                （ContextCollectViewModel.Focus）。選んだ観点は、出力の「# 前提」の直後に入る
                （仕様書_ブックの情報と依頼の観点 6.3）。IsCollapsible で、この窓だけ「たたむ」ボタンを出す
                （既定は開いた状態。たたんだ状態は記憶しない）。
            -->
            <local:PromptFocusPanel x:Name="FocusPanel" Margin="0,10,0,0" DataContext="{Binding Focus}" IsCollapsible="True" />

            <Border Margin="0,10,0,0" BorderBrush="{DynamicResource StateError}" BorderThickness="1" Padding="8"
                    IsVisible="{Binding ErrorIssue, Converter={x:Static local:Converters.NotNull}}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource StateError}"
                           Text="{Binding ErrorIssue, Converter={x:Static local:Converters.IssueToText}}" />
            </Border>
        </StackPanel>

        <TabControl x:Name="MainTabs" Grid.Row="2" Classes="flush" Margin="16,0,16,8" Background="Transparent" BorderThickness="0">
            <TabItem Header="ファイル選択" AutomationProperties.Name="ファイル選択タブ">
                <!--
                    列の割り付けは、窓の幅とブックの情報の有無で ContextCollectWindow.axaml.cs の
                    UpdateFileSelectLayout が切り替える。
                      広い窓: ファイル一覧（左）│仕切り│ブックの情報（右）
                      狭い窓: ブックの情報の枠を「ブックの情報」タブへ移す。ここはファイル一覧だけにする。
                      通常のプロジェクト（ブックの情報なし）: ファイル一覧だけ（全幅）。
                -->
                <Grid x:Name="FileSelectGrid" Margin="0,8,0,0" ColumnDefinitions="*">

                    <!--
                        ファイル一覧の側。DockPanel ではなく Grid の行で組む。DockPanel で下に置くもの
                        （除外パターンの折りたたみ）を一覧より先に書くと、Tab キーの順（XAML の並び）が
                        「除外パターン → ファイル一覧」と画面の見た目と逆になるため。
                    -->
                    <Grid x:Name="FilesPane" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                        <!--
                            狭い窓でブックの情報がタブへ移っているあいだだけ出す 1 行。
                            シートの値が渡るあいだは常に注意を出す（仕様書_ブックの情報と依頼の観点 5.3）を、
                            ファイル選択タブを見ているときも守るため。広い窓では、枠が右に見えているので出さない。
                        -->
                        <WrapPanel x:Name="WorkbookSummaryRow" Grid.Row="0" Margin="0,0,0,6" IsVisible="False"
                                   DataContext="{Binding WorkbookInfo}"
                                   AutomationProperties.Name="ブックの情報の要約">
                            <TextBlock Text="ブックの情報:" Margin="0,0,4,0"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding LevelLabel}" Margin="0,0,12,0"
                                       FontSize="{DynamicResource CaptionFontSize}" />
                            <TextBlock Text="{Binding ValueNoticeText}" IsVisible="{Binding IsValueNoticeVisible}" Margin="0,0,12,0"
                                       Foreground="{DynamicResource StateWarn}"
                                       FontSize="{DynamicResource CaptionFontSize}" />
                            <TextBlock Text="（「ブックの情報」タブで変えられます）"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </WrapPanel>
                        <TextBlock Grid.Row="1" Text="ファイル" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"
                                   local:HelpTip.Standard="行のアイコンをクリック（またはSpaceキー）すると「内容も出す→構成だけ→出さない」の3状態を切り替えられます。フォルダなら配下へまとめて適用されます。先頭の「すべて」行を使えば、プロジェクト直下のファイルも含めて全体を一括で切り替えられます。"
                                   local:HelpTip.Detailed="ファイル名の左のアイコンをクリックする、またはその行を選んでSpaceキーを押すと、「内容も出す」（チェックのアイコン。出力にファイル構成も中身も含める）「構成だけ」（ファイルのアイコン。ファイル構成には載るが中身は出力しない。lib/やnode_modules/のような、存在は知らせたいが中身は不要なフォルダを一括で切り替えるのに使う）「出さない」（×のアイコン。ファイル構成にも出力にも一切含めない）の3状態を順に切り替えられます。フォルダのアイコンをクリックすると、配下のファイル・サブフォルダすべてへ同じ状態がまとめて適用されます。配下の状態が一致していないフォルダは「混在」を示す重なったアイコンで表示され、この状態でクリックすると配下すべてが「内容も出す」に揃います。既定では全ファイルが「内容も出す」です。一覧の先頭には「すべて」というプロジェクトルートを表す行があり、これも他のフォルダ行と同じ操作でプロジェクト全体（サブフォルダの中身も含む）を一括切替できます。" />
                        <!--
                            ファイル名の絞り込みと、gitの変更ファイルだけを選ぶ操作。
                            この窓には入力欄がもう1つ（下の「追加の除外パターン」）あり、見た目が
                            同じTextBoxのため取り違えやすい。役割が混ざらないよう、こちらには
                            虫眼鏡アイコン（ExplorerView.axamlの絞り込み欄と同じ）・「ファイル名で
                            絞り込み」のウォーターマーク・「表示を絞るだけで除外ではない」旨の
                            ツールチップを付け、除外パターンの欄の側にも「一覧の表示を絞るのは
                            上の欄」と書いて、両側から区別する。
                        -->
                        <Grid Grid.Row="2" Margin="0,0,0,4" ColumnDefinitions="Auto,*,Auto,Auto">
                            <local:IconGlyph Grid.Column="0"
                                             Data="{DynamicResource IconSearchGeometry}"
                                             Width="14" Height="14" Margin="4,0,4,0"
                                             Stroke="{DynamicResource TextSecondary}" />
                            <TextBox x:Name="FileFilterBox" Grid.Column="1"
                                     Text="{Binding FilterText}"
                                     Watermark="ファイル名で絞り込み（例: view .cs）"
                                     AutomationProperties.Name="ファイル名で一覧を絞り込む"
                                     local:HelpTip.Standard="一覧に出すファイルを、パスに入力した文字を含むものだけへ絞ります（Ctrl+Fでここへ移動、Escで空にします）。表示を絞るだけで、AIへ渡す内容からは除外しません。"
                                     local:HelpTip.Detailed="一覧を、フォルダ名を含むパスに入力した文字を含むファイルだけへ絞ります。大文字小文字は区別せず、「/」と「\」も同じに扱います。空白で区切って複数の語を入れると、すべてを含むファイルだけに絞ります（例: 「api user」）。絞り込み中はフォルダ行を出さず、見えているファイルだけを平らに並べます（フォルダ行を押すと見えていないファイルまで切り替わってしまうため）。各ファイルの「内容も出す／構成だけ／出さない」は絞り込み中も通常どおり切り替えられ、欄を空にすると、切り替えた結果がツリーに反映されて戻ります。ここは見た目を絞るだけで、AIへ渡す内容から外す設定ではありません。外したいときは一覧の下の「追加の除外パターン」を使ってください。Ctrl+Fでこの欄へ移動し、欄に文字があるときのEscで空にできます（欄が空のときのEscは窓を閉じます）。" />
                            <Button Grid.Column="2" Content="×"
                                    Command="{Binding ClearFilterCommand}"
                                    Padding="6,0" Margin="4,0,0,0"
                                    Classes="subtle" BorderThickness="0"
                                    IsVisible="{Binding HasFilterText}"
                                    AutomationProperties.Name="絞り込みを解除"
                                    ToolTip.Tip="絞り込みを解除して、ツリー表示に戻します" />
                            <Button Grid.Column="3" Content="gitの変更ファイルだけ" Margin="8,0,0,0"
                                    Command="{Binding SelectGitChangedCommand}"
                                    local:HelpTip.Standard="{Binding GitSelectToolTip}"
                                    local:HelpTip.Detailed="{Binding GitSelectDetailedToolTip}"
                                    AutomationProperties.Name="gitの変更ファイルだけを内容も出す状態にする" />
                        </Grid>
                        <TextBlock Grid.Row="3" Margin="26,0,0,4"
                                   Text="{Binding FilterSummary}"
                                   FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   IsVisible="{Binding IsFiltering}"
                                   AutomationProperties.Name="絞り込みの一致件数" />
                        <Grid Grid.Row="4">
                            <!--
                                利用者の要望: プロジェクトルート直下のファイルには、既存のフォルダ行の
                                ような「配下をまとめて切り替える親」が存在しなかった（Filesに入るのは
                                ルート直下から始まる実ノードのみで、ルート自身の行が一覧に無いため）。

                                【なぜ「すべて」行を一覧の外に置かず、Filesの先頭へ実ノードと
                                同じ1行として混ぜたか】
                                当初は一覧の外（この見出しとListBoxの間）に専用の行を追加する案で
                                作ったが、それだと行の見た目（Button Classes="stateToggle" +
                                IconGlyphのClasses.stateXxxの束ね方）の定義が2箇所に分かれてしまう。
                                このリポジトリでは過去に、同じ見た目の部品が2つ存在したことが
                                原因の不具合を踏んでいるため、定義を1箇所（下のListBox.ItemTemplate）
                                に保てる「Filesの先頭に混ぜる」ほうを選んだ。こうすれば見た目・
                                クリック挙動が実ノードと構造的に完全に同一であることが保証され、
                                CycleState・ApplyStateRecursiveのようなクリック時の挙動にも
                                一切手を入れる必要が無い（ルートはIsDirectory=trueの通常の
                                ディレクトリ行として扱われ、_childrenByPath[""]（既存のルート
                                キー）を辿って配下すべてへ再帰適用される）。

                                3つのボタン（「すべて出す」「すべて構成だけ」「すべて出さない」）を
                                並べる案も採らない。利用者は既に「行のアイコンをクリックすると
                                3状態を巡回し、フォルダなら配下へまとめて適用される」という操作を
                                覚えている。ルート行を1つ足すだけなら新しい概念も新しい操作も増えず、
                                かつ「いま全体がどの状態か（混在しているか）」が集計アイコンとして
                                一目で分かる副産物も得られる。

                                Filesに混ぜたことでUpdateApproxTokenEstimate・EstimateTreeSectionChars・
                                selectedPaths/hiddenPathsの算出（すべてFilesを走査する実装）への
                                影響が生じるため、そちらはContextCollectViewModel側（EstimateTreeSectionChars・
                                RebuildChildrenMap・RecomputeDirectoryStatesの各コメント）で個別に
                                手当てしている。
                            -->
                            <!--
                                ItemsSourceはFilesではなくDisplayedFiles。絞り込みが無いときはFilesと
                                同じインスタンス、絞り込み中は一致したファイルだけの平らな一覧になる
                                （ContextCollectViewModel.Filter.csのDisplayedFilesのコメント参照）。
                            -->
                            <ListBox x:Name="FileListBox" ItemsSource="{Binding DisplayedFiles}"
                                     SelectedItem="{Binding SelectedFile}"
                                     AutomationProperties.Name="ファイル一覧"
                                     IsVisible="{Binding !IsEmpty}"
                                     local:HelpTip.Standard="プロジェクト内のファイル構成です。各行のアイコンをクリックすると「内容も出す／構成だけ／出さない」を切り替えられます。先頭の「すべて」行はプロジェクト全体をまとめて切り替えます。"
                                     local:HelpTip.Detailed="プロジェクトのフォルダ構成を一覧表示しています。各行のアイコンをクリック（またはSpaceキー）すると、そのファイル・フォルダの扱いを「内容も出す／構成だけ／出さない」の3状態で切り替えられます（詳細は上の見出しのツールチップ参照）。一覧の先頭にある「すべて」行はプロジェクトルートに対応する仮想的な行で、他のフォルダ行とまったく同じ操作（クリック・Spaceキーで巡回、配下へ一括適用、配下が混在していれば重なったアイコンで表示）でプロジェクト全体を一括切替できます。ここではまだ何もコピー・保存されておらず、選び終えたら下の「プレビュー」「コピー」「ファイルへ保存」のいずれかで実際の出力を作成します。">
                                <ListBox.KeyBindings>
                                    <KeyBinding Gesture="Space" Command="{Binding CycleSelectedStateCommand}" />
                                </ListBox.KeyBindings>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ContextFileNodeViewModel">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="{Binding RowIndentLevel,
                                                             Converter={x:Static local:Converters.IndentToMargin}}"
                                                    AutomationProperties.Name="{Binding AutomationLabel}">
                                            <local:IconGlyph Data="{DynamicResource IconFolderGeometry}"
                                                             Width="14" Height="14" Margin="0,0,4,0"
                                                             IsVisible="{Binding IsDirectory}" />
                                            <local:IconGlyph Data="{DynamicResource IconAlertTriangleGeometry}"
                                                             Width="14" Height="14" Margin="0,0,4,0"
                                                             Stroke="{DynamicResource StateWarn}"
                                                             ToolTip.Tip="{Binding ExcludeReason}"
                                                             IsVisible="{Binding IsExcluded}" />
                                            <!--
                                                課題2: 3状態選択。素のCheckBox.IsThreeStateは「未選択／選択／中間」の
                                                3値しか表せず、ここで必要な「内容も出す／構成だけ／出さない」という
                                                3つの実値と、フォルダ集計専用の「混在」という第4の表示状態を両立できない
                                                （中間＝構成だけと誤読される）。そのため、クリックで3状態を巡回する
                                                Buttonに、状態ごとに異なるアイコン・色を割り当てる方式にした
                                                （一目で見分けられることを優先）。
                                            -->
                                            <Button Classes="stateToggle" IsVisible="{Binding !IsExcluded}"
                                                    Command="{Binding DataContext.CycleStateCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding ToggleToolTip}"
                                                    AutomationProperties.Name="{Binding AutomationLabel}">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{x:Static local:Converters.FileCheckEnabled}">
                                                        <Binding Path="IsExcluded" />
                                                        <Binding Path="DataContext.ShowFileTree" ElementName="Root" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                                <local:IconGlyph Width="14" Height="14"
                                                                 Classes.stateFull="{Binding IsFull}"
                                                                 Classes.stateStructureOnly="{Binding IsStructureOnly}"
                                                                 Classes.stateHidden="{Binding IsHidden}"
                                                                 Classes.stateMixed="{Binding IsMixed}" />
                                            </Button>
                                            <!-- 項目5: 長い日本語ファイル名が枠端で省略記号無しに断ち切られ、
                                                 ツールチップも無かった（実機Xvfbで確認済み）。エクスプローラは
                                                 横スクロールで追えるが、この一覧には横スクロールバーが無いため
                                                 実害がより大きい。 -->
                                            <!-- RowText/RowToolTipは、通常は名前、ファイル名の絞り込み中は相対パス
                                                 （ContextFileNodeViewModel.ShowFullPathのコメント参照）。 -->
                                            <TextBlock Text="{Binding RowText}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding RowToolTip}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 項目7: 手書きのアイコン＋文言（Opacity 0.4）だった空状態を、他画面
                                 （ProjectPane/ExplorerView/HistoryPane等）と同じ共通EmptyStateViewへ
                                 寄せる（空状態の作り方が4系統に分かれている問題への対応）。 -->
                            <local:EmptyStateView AutomationProperties.Name="ファイル一覧（0件）"
                                                  IconGeometry="{DynamicResource IconFolderGeometry}"
                                                  Message="対象ファイルがありません"
                                                  State="{Binding IsEmpty, Converter={x:Static local:Converters.IsEmptyToEmptyState}}" />
                        </Grid>

                        <!--
                            追加の除外パターン。空でも窓の 1/3 を占めていた右の柱（中身は「登録されていません」だけ）をやめ、
                            ファイル一覧の下の折りたたみへ。初期状態は常に閉じる（開いた状態は記憶しない）。
                            たたんでいても「何件効いているか」が分かるよう、件数は見出しに常に出す
                            （一覧に出てこないファイルがあるとき、除外が原因だと気づけるように）。
                            読み上げ名にも件数を含める。開くと、入力欄・追加・一覧（最大 140px）・削除が出る。
                            共通テーマの Expander を使う（Enter・Space で開閉。見出しに Tab で届く）。
                        -->
                        <Expander x:Name="ExcludesExpander" Grid.Row="5" Margin="0,8,0,0" Padding="8,4"
                                  AutomationProperties.Name="{Binding ExtraExcludes.Count, StringFormat='追加の除外パターン（プロジェクト単位）{0} 件'}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="追加の除外パターン（プロジェクト単位）"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding ExtraExcludes.Count, StringFormat='{}{0} 件'}"
                                               FontSize="{DynamicResource CaptionFontSize}" />
                                </StackPanel>
                            </Expander.Header>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,8,0,8" ColumnDefinitions="*,Auto">
                                    <!-- 項目8: このパターン入力欄だけWatermarkが無く、用途が書かれていない
                                         空欄になっていた（実機Xvfbで確認済み）。HelpTipの例示と同じ文言にする。 -->
                                    <TextBox Grid.Column="0" Text="{Binding NewExcludePattern}"
                                             Watermark="例: *.log、node_modules/"
                                             AutomationProperties.Name="追加する除外パターン"
                                             local:HelpTip.Standard="AIへ渡す内容から除外したいファイル・フォルダのパターンを入力します（例: *.log、node_modules/）。"
                                             local:HelpTip.Detailed="ここに入力したパターンに一致するファイル・フォルダを、このプロジェクトでは常にファイル一覧・出力から除外できます。（一覧の上にある「ファイル名で絞り込み」は表示を絞るだけの別の欄で、除外は行いません。）（例: *.log で全てのログファイル、node_modules/ でそのフォルダ全体）。.gitignoreと似た書き方です。入力したら右の「追加」ボタンで確定します。" />
                                    <Button Grid.Column="1" Content="追加" Command="{Binding AddExcludeCommand}" Margin="6,0,0,0"
                                            local:HelpTip.Standard="入力した除外パターンをこのプロジェクト専用の除外リストへ追加します。次回以降のファイル一覧・収集結果から外れます。"
                                            local:HelpTip.Detailed="左のテキストボックスに入力したパターン（例: *.log や node_modules/）を、このプロジェクト専用の除外リストへ追加します。追加すると、上のファイル一覧やAIへ渡す内容から、パターンに一致するファイルが除かれるようになります。AIに読ませたくない大きなファイルや秘密情報を含むファイルを外すのに使います。"
                                            AutomationProperties.Name="除外パターンを追加" />
                                </Grid>
                                <!-- 項目7個別: 除外パターン0件のとき何も出ない「空箱」だった（4系統目、
                                     「何も出さない」パターン。実機Xvfbで確認済み）。他と同じEmptyStateViewを
                                     重ねる。ここは登録前が普通の状態（未使用でも問題ない画面）なので
                                     アクションボタンは付けない。一覧の高さは 84〜140px（件数が多くても
                                     ファイル一覧を押しつぶさず、0 件の空状態の表示も収まる）。 -->
                                <Grid MinHeight="84" MaxHeight="140">
                                    <ListBox ItemsSource="{Binding ExtraExcludes}"
                                             AutomationProperties.Name="プロジェクト単位の除外パターン一覧"
                                             local:HelpTip.Standard="このプロジェクトに登録済みの除外パターンの一覧です。各行の「削除」で取り除けます。"
                                             local:HelpTip.Detailed="上で追加した除外パターンの一覧です。このプロジェクトを開いている間はずっと有効で、ファイル一覧・出力プレビューに反映されます。不要になったパターンは各行の「削除」ボタンで取り除けます。">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Content="削除"
                                                            Command="{Binding DataContext.RemoveExcludeCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            local:HelpTip.Standard="この除外パターンをプロジェクトの除外リストから取り除きます。"
                                                            local:HelpTip.Detailed="この1件の除外パターンだけをリストから取り除きます。取り除くと、次にファイル一覧・収集結果を作り直したときに、これまでこのパターンで除かれていたファイルが再び対象に含まれるようになります。"
                                                            AutomationProperties.Name="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <local:EmptyStateView AutomationProperties.Name="除外パターン一覧（0件）"
                                                          IconGeometry="{DynamicResource IconAlertTriangleGeometry}"
                                                          Message="除外パターンは登録されていません"
                                                          State="{Binding ExtraExcludes, Converter={x:Static local:Converters.CollectionToEmptyState}}" />
                                </Grid>
                            </DockPanel>
                        </Expander>
                    </Grid>

                    <!-- 広い窓のときだけ出す、ファイル一覧とブックの情報の仕切り（ドラッグで幅を変えられる）。Tab の順には入れない。 -->
                    <GridSplitter x:Name="WorkbookSplitter" Width="6" HorizontalAlignment="Center" Background="Transparent"
                                  IsTabStop="False" IsVisible="False" />

                    <!--
                        ブックの情報の側（Excel VBA プロジェクトのときだけ表示。仕様書_ブックの情報と依頼の観点 5.3 と 15.5）。
                        「ブックの情報」の枠とリボン（customUI）の枠を 1 つの部品（WorkbookColumn）にまとめ、
                        広い窓ではファイル一覧の右、狭い窓では「ブックの情報」タブへ、コード側が親を付け替える
                        （同じ部品を 2 つ作らない。このリポジトリは、同じ見た目の部品が 2 つあることによる不具合を
                        過去に踏んでいる）。表示するかどうかは、2 つの枠のどちらかが出ているか（コード側が決める）。

                        【高さの扱い（実測で変えた）】 最初は、リボンの枠を下へ固定してシート一覧だけを内側でスクロールさせたが、
                        VBA プロジェクトでシートが 5 枚・リボンの枠が付くと、シート一覧が 2 枚ぶんしか見えなかった
                        （リボンの枠が 180px ほどあり、幅の狭い列では取得状況の文が折り返すため）。そこで、列全体を
                        1 つの ScrollViewer に入れ、2 つの枠を自然な高さで縦に並べる（一覧の中の入れ子のスクロールはしない）。
                        足りないぶんは、この 1 つのスクロールで見る。値が渡る注意は、スクロールで見えなくならないよう、
                        枠の上のほう（取得状況の下）に置く。
                    -->
                    <ScrollViewer x:Name="WorkbookColumn" IsVisible="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="WorkbookColumnContent" Spacing="8">
                            <!--
                                ブックの情報の行（仕様書_ブックの情報と依頼の観点 5.3）。
                                ミラーにはファイルを作らないので、ファイル一覧のノードにはせず、専用の枠として置く
                                （ファイルの選択集計・除外・差分方式の記憶と混ぜない）。3状態のアイコンと操作は、
                                ファイル行と同じ（クリックで 内容も出す → 構成だけ → 出さない と巡る）。
                                シートごとの見せ方で値が渡るシートがあるあいだは、常に注意を出す。
                            -->
                            <Border x:Name="WorkbookInfoRow" Padding="8,6"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4"
                                    IsVisible="{Binding WorkbookInfo.IsVisible}"
                                    AutomationProperties.Name="ブックの情報">
                                <StackPanel Spacing="4" DataContext="{Binding WorkbookInfo}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="stateToggle"
                                                Command="{Binding CycleCommand}"
                                                ToolTip.Tip="{Binding ToggleToolTip}"
                                                AutomationProperties.Name="{Binding AutomationLabel}">
                                            <local:IconGlyph Width="14" Height="14"
                                                             Classes.stateFull="{Binding IsFull}"
                                                             Classes.stateStructureOnly="{Binding IsStructureOnly}"
                                                             Classes.stateHidden="{Binding IsHidden}" />
                                        </Button>
                                        <TextBlock Text="ブックの情報" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   local:HelpTip.Standard="Excel ブックの構造（シート・テーブル・名前付き範囲・参照設定）と、選んだシートの値を、AI に渡す内容へ加えます。アイコンのクリックで「内容も出す→構成だけ→出さない」を切り替えます。"
                                                   local:HelpTip.Detailed="AI は、どんなシートや表があるブックかを知らないと、存在しないシート名や列を前提にした VBA を書いてしまいます。この行は、Excel から読んだブックの構造を「# ブックの情報」として、出力の「# 前提」の直後に加えるかを決めます。「内容も出す」はシート・テーブル・名前付き範囲・参照設定に加えて、下のシートごとの見せ方で選んだ値、「構成だけ」はシート・テーブル・名前付き範囲だけ（値は渡さない）、「出さない」は何も渡さず Excel にも問い合わせません。選んだ状態はプロジェクトごとに記憶されます。ミラーのフォルダにファイルは作りません。" />
                                        <TextBlock Text="{Binding LevelLabel}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="{DynamicResource CaptionFontSize}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               AutomationProperties.Name="ブックの情報の取得状況" />
                                    <!--
                                        値が渡る注意は、スクロールで見えなくならないよう、取得状況のすぐ下（枠の上のほう）に置く。
                                        シートごとの見せ方で値が渡るシートがあるあいだは、常に出す（仕様書_ブックの情報と依頼の観点 5.3）。
                                    -->
                                    <TextBlock Text="{Binding ValueNoticeText}" IsVisible="{Binding IsValueNoticeVisible}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource StateWarn}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               AutomationProperties.Name="シートの値の注意" />
                                    <!--
                                        シートごとの見せ方（v0.4。仕様書_ブックの情報と依頼の観点 5.2）。「内容も出す」のときだけ出す。
                                        既定は全シート「構成だけ」。値が渡る見せ方（見出し＋N 行・全部・範囲を指定）を選ぶと確認が出る。
                                        選んだ見せ方は、シートのコード名に結び付けてプロジェクトごとに記憶される。
                                    -->
                                    <TextBlock Text="シートごとの見せ方（取得すると、ここにシートが並びます）"
                                               IsVisible="{Binding ShowSheetViewsPlaceholder}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{DynamicResource CaptionFontSize}" />
                                    <TextBlock Margin="0,4,0,0" Text="シートごとの見せ方" FontSize="{DynamicResource CaptionFontSize}"
                                               IsVisible="{Binding ShowSheetViews}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               local:HelpTip.Standard="シートごとに、AI へ渡す内容を選びます。既定は「構成だけ」（値は渡しません）。値が渡る見せ方を選ぶときは確認が出ます。"
                                               local:HelpTip.Detailed="「出さない」はそのシートを何も渡さず、「構成だけ」はシート名・コード名・使用範囲・テーブル名と列名だけを渡します。「見出し＋N 行」は見出し行と続く N 行の値、「全部」は使用範囲の値すべて（上限あり）、「範囲を指定」は入力した範囲（例 A1:F30）の値を渡します。選んだ見せ方はシートのコード名に結び付けてプロジェクトごとに記憶するので、表示名を変えても外れません。値は Graft のメモリにだけ置き、ファイルには保存しません。" />
                                    <ItemsControl ItemsSource="{Binding Sheets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VbaSheetViewRowViewModel">
                                                <StackPanel Spacing="2" Margin="0,2,0,4"
                                                            AutomationProperties.Name="{Binding AutomationLabel}">
                                                    <DockPanel LastChildFill="True">
                                                        <ComboBox DockPanel.Dock="Right" Width="140" MinHeight="26"
                                                                  ItemsSource="{Binding ModeOptions}"
                                                                  SelectedItem="{Binding SelectedMode}"
                                                                  IsEnabled="{Binding IsSelectable}"
                                                                  FontSize="{DynamicResource CaptionFontSize}"
                                                                  AutomationProperties.Name="{Binding ModeAutomationName}" />
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding UsedRangeText, StringFormat='使用範囲: {0}'}" />
                                                    </DockPanel>
                                                    <!--
                                                        行数（または範囲）の入力と「数式も含める」を 1 行に並べ、入りきらなければ折り返す
                                                        （1 シートあたり縦に 1 行ぶん減る）。
                                                    -->
                                                    <WrapPanel Margin="16,0,0,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" IsVisible="{Binding ShowRows}">
                                                            <TextBlock Text="見出しに続く行数" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       FontSize="{DynamicResource CaptionFontSize}" />
                                                            <TextBox Width="64" Text="{Binding RowsDraft, UpdateSourceTrigger=PropertyChanged}"
                                                                     local:SheetViewDraftBehavior.CommitDrafts="True"
                                                                     AutomationProperties.Name="{Binding RowsAutomationName}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" IsVisible="{Binding ShowRange}">
                                                            <TextBlock Text="範囲" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       FontSize="{DynamicResource CaptionFontSize}" />
                                                            <TextBox Width="160" Watermark="例 A1:F30" Text="{Binding RangeDraft, UpdateSourceTrigger=PropertyChanged}"
                                                                     local:SheetViewDraftBehavior.CommitDrafts="True"
                                                                     AutomationProperties.Name="{Binding RangeAutomationName}"
                                                                     local:HelpTip.Standard="このシートで AI に渡す範囲を A1 形式で入力します（例 A1:F30、列だけの A:F、行だけの 3:10）。"
                                                                     local:HelpTip.Detailed="シート名は付けません。名前付き範囲は指定できません（A1:F30 のようにセルの範囲で入力してください）。使用範囲の外は読まず、上限（1 シートあたりの行数・列数）を超える分は切ります。入力が正しくないあいだは、そのシートの値は渡しません。" />
                                                        </StackPanel>
                                                        <CheckBox Content="数式も含める" IsVisible="{Binding ShowFormulas}" VerticalAlignment="Center"
                                                                  IsChecked="{Binding IncludeFormulas}"
                                                                  FontSize="{DynamicResource CaptionFontSize}"
                                                                  IsEnabled="{Binding IsSelectable}"
                                                                  AutomationProperties.Name="{Binding FormulasAutomationName}"
                                                                  local:HelpTip.Standard="このシートの値に、セルの数式（=式 → 値）も含めます。既定はオフです。"
                                                                  local:HelpTip.Detailed="数式を含めると、AI は参照先のシート名やセルの構造まで分かりますが、値と同じく中身（他のシートの名前など）が渡ります。" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding RowsError}" IsVisible="{Binding HasRowsError}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource StateError}"
                                                               FontSize="{DynamicResource CaptionFontSize}" />
                                                    <TextBlock Text="{Binding RangeError}" IsVisible="{Binding HasRangeError}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource StateError}"
                                                               FontSize="{DynamicResource CaptionFontSize}"
                                                               AutomationProperties.Name="{Binding RangeErrorAutomationName}" />
                                                    <TextBlock Text="{Binding NoteText}" IsVisible="{Binding HasNote}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource StateWarn}"
                                                               FontSize="{DynamicResource CaptionFontSize}"
                                                               AutomationProperties.Name="{Binding NoteAutomationName}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding LimitsText}" TextWrapping="Wrap"
                                               IsVisible="{Binding ShowSheetViews}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{DynamicResource CaptionFontSize}" />
                                </StackPanel>
                            </Border>
                            <!--
                                リボン（customUI）の行（仕様書_ブックの情報と依頼の観点 15.5）。
                                「ブックの情報」の行と同じ作り・同じ操作（クリックで 内容も出す → 構成だけ → 出さない と巡る）。
                                保存済みのブックのファイルを読むので、最後に保存した内容であることを常に出す。
                            -->
                            <Border x:Name="RibbonRow" Padding="8,6"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4"
                                    IsVisible="{Binding Ribbon.IsVisible}"
                                    AutomationProperties.Name="リボン（customUI）">
                                <StackPanel Spacing="4" DataContext="{Binding Ribbon}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="stateToggle"
                                                Command="{Binding CycleCommand}"
                                                ToolTip.Tip="{Binding ToggleToolTip}"
                                                AutomationProperties.Name="{Binding AutomationLabel}">
                                            <local:IconGlyph Width="14" Height="14"
                                                             Classes.stateFull="{Binding IsFull}"
                                                             Classes.stateStructureOnly="{Binding IsStructureOnly}"
                                                             Classes.stateHidden="{Binding IsHidden}" />
                                        </Button>
                                        <TextBlock Text="リボン（customUI）" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   local:HelpTip.Standard="Excel のリボン（タブ・ボタンなど）を定義する customUI の XML を、AI に渡す内容へ加えます。アイコンのクリックで「内容も出す→構成だけ→出さない」を切り替えます。"
                                                   local:HelpTip.Detailed="リボンを直したい・足したいときに、AI が今のリボンの定義と、呼ばれるマクロの有無を知っていると、ずれた回答を防げます。保存済みのブックのファイルを読み取り専用で読み（Excel が開いていても読めます）、customUI の XML を「# リボン（customUI）」として、「ブックの情報」の直後に加えます。「内容も出す」は構成・コールバックと VBA の照合・XML の全文、「構成だけ」はタブ・グループ・コントロールの id・label・種類とコールバックの一覧だけ、「出さない」は何も渡さずファイルも読みません。読むのは最後に保存した内容で、Excel で編集中の未保存の変更は含まれません。選んだ状態はプロジェクトごとに記憶されます。" />
                                        <TextBlock Text="{Binding LevelLabel}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="{DynamicResource CaptionFontSize}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               AutomationProperties.Name="リボンの取得状況" />
                                    <TextBlock Text="{Binding CallbackText}" IsVisible="{Binding HasCallbackText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               AutomationProperties.Name="リボンのコールバックの照合" />
                                    <TextBlock Text="{Binding MissingText}" IsVisible="{Binding HasMissingText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource StateWarn}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               AutomationProperties.Name="VBA に見つからないコールバック" />
                                    <TextBlock Text="{Binding NoteText}" IsVisible="{Binding ShowNote}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               AutomationProperties.Name="リボンは最後に保存した内容" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!--
                狭い窓（860px 未満）のときだけ出すタブ。中身（WorkbookColumn）は、コード側がファイル選択タブから
                付け替える。ブックの情報がないとき（通常のプロジェクト）・広い窓のときは、タブごと出さない。
            -->
            <TabItem x:Name="WorkbookTab" Header="ブックの情報" IsVisible="False" AutomationProperties.Name="ブックの情報タブ">
                <Panel x:Name="WorkbookTabHost" Margin="0,8,0,0" />
            </TabItem>

            <TabItem Header="プレビュー" AutomationProperties.Name="出力プレビュータブ">
                <Grid Margin="0,8,0,0">
                    <ListBox ItemsSource="{Binding PreviewLines}" Background="Transparent" BorderThickness="0"
                             FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource CodeFontSize}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="出力プレビュー"
                             IsVisible="{Binding PreviewLines, Converter={x:Static local:Converters.HasItems}}"
                             local:HelpTip.Standard="「プレビュー」または「コピー」を押すと、実際にAIへ渡される文章がここに表示されます。"
                             local:HelpTip.Detailed="「ファイル選択」タブで選んだ内容から実際に組み立てられた、AIへ渡す文章そのものです。「コピー」ボタンでクリップボードへコピーされる内容と同じものがここで確認できます。この画面を見ているだけではまだ何も送信・コピーされていません。">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <local:CodeLineControl LineText="{Binding Text}" Tokens="{Binding Tokens}"
                                                       AutomationProperties.Name="{Binding Text}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 項目7: こちらも手書きのアイコン＋文言（Opacity 0.4）だった空状態を
                         共通EmptyStateViewへ寄せる。 -->
                    <local:EmptyStateView AutomationProperties.Name="出力プレビュー（未生成）"
                                          IconGeometry="{DynamicResource IconEyeGeometry}"
                                          Message="「プレビュー」または「コピー」を押すと出力内容を表示します"
                                          State="{Binding PreviewLines, Converter={x:Static local:Converters.CollectionToEmptyState}}" />
                </Grid>
            </TabItem>
        </TabControl>

        <!--
            状況の文（トークン数の助言・gitの結果・要求されたファイルの結果など）。以前はボタンの左の狭い列
            （幅 350px ほどで 4〜5 行に折り返し、約 100〜120px を使っていた）にあったが、ボタンの上の全幅の行へ移す。
            最大 3 行で切り、全文はツールチップで読める。文が無いときは行ごと消える。
            読み上げには、内容が変わったことを伝える（コピー後の結果などが読まれる）。色だけに頼らず文でも伝える点は従来どおり
            （警告色は補助）。数字は、ボタンの行の「推定トークン数」と食い違わない
            （ContextCollectViewModel.SetSizeStatus のコメント参照）。
        -->
        <TextBlock Grid.Row="3" Margin="16,0,16,8" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   MaxLines="3" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static local:Converters.NotEmptyString}}"
                   Classes="statusMessage"
                   Classes.warn="{Binding ExceedsWarnThreshold}"
                   AutomationProperties.Name="状況"
                   AutomationProperties.LiveSetting="Polite" />

        <!--
            実機の画面（監査 H4）: 左の説明文（警告時は5行に折り返す）が行の高さを決めるため、
            既定でStretchのボタンが縦に約105pxまで伸びていた。ボタンは通常の高さ（ControlHeight）の
            まま行の縦中央に置く。下のStyleは、この行のボタン4つにだけ効く。
        -->
        <Grid Grid.Row="4" Margin="16,0,16,16" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <Grid.Styles>
                <Style Selector="Button">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Grid.Styles>
            <!--
                推定トークン数と目安を 1 行に。目安を超えたら数字を警告色にする（色だけに頼らず、上の行の文でも伝える）。
                狭い窓では 2 行に折り返す（WrapPanel）。横一列の StackPanel だと、最小幅でボタンの下へはみ出した。
            -->
            <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="{Binding EstimatedTokens, StringFormat=推定トークン数: 約{0}トークン}"
                           Classes="tokenCount" Margin="0,0,8,0"
                           Classes.warn="{Binding ExceedsWarnThreshold}"
                           FontSize="{DynamicResource CaptionFontSize}" />
                <TextBlock Text="{Binding TokenWarnThreshold, StringFormat=（目安: 約{0}トークン）}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="{DynamicResource CaptionFontSize}" />
            </WrapPanel>
            <Button Grid.Column="1" Content="プレビュー" Command="{Binding PreviewCommand}" Margin="0,0,8,0"
                    local:HelpTip.Standard="選んだファイルからAIへ渡す内容を組み立て、プレビュータブと推定トークン数で確認します。クリップボードへはコピーしません。"
                    local:HelpTip.Detailed="選んだファイルの内容をつなぎ合わせ、実際にAIへ渡す文章としてどう組み立てられるかを「プレビュー」タブで確認できます。おおよそのトークン数（AIへの負荷の目安）もここで分かります。この操作ではクリップボードには何もコピーされないため、内容を確認するだけのときに使ってください。"
                    AutomationProperties.Name="推定トークン数をプレビュー" />
            <Button Classes="primary" Grid.Column="2" Content="コピー" Command="{Binding CopyCommand}" Margin="0,0,8,0"
                    local:HelpTip.Standard="選んだファイルからAIへ渡す内容を組み立て、クリップボードへコピーします。推定トークン数が大きい場合でも必ずコピーしたうえで、目安として大きさを知らせます。"
                    local:HelpTip.Detailed="選んだファイルの内容をつなぎ合わせ、AIへ渡す文章としてクリップボードへコピーします。コピーしたら、そのままChatGPTやClaudeなどのAIとの会話に貼り付けて質問してください。推定トークン数が設定の目安値を超えている場合でも内容は必ずコピーされ、そのうえで「AIへ一度に渡すには大きいかもしれません」という助言がステータスに添えられます（気になる場合は除外パターンでファイルを減らしてください）。"
                    AutomationProperties.Name="コンテキストをクリップボードへコピー" />
            <Button Grid.Column="3" Content="ファイルへ保存" Command="{Binding SaveToFileCommand}"
                    Margin="0,0,8,0"
                    local:HelpTip.Standard="選んだファイルからAIへ渡す内容を組み立て、名前を付けてMarkdownファイルへ保存します。"
                    local:HelpTip.Detailed="選んだファイルの内容をつなぎ合わせ、Markdown形式のテキストファイルとして好きな場所へ保存します。既定のファイル名はプロジェクト名と保存日時から自動で組み立てます（例: デモ_20260808_1530.md）。保存したファイルはそのままAIチャットへ添付・貼り付けして使えます。推定トークン数が設定の目安値を超えている場合でも保存は必ず行われ、そのうえで大きさについての助言が表示されます。"
                    AutomationProperties.Name="コンテキストをファイルへ保存" />
            <!--
                実機で確認された指摘7: 設定・キュー・取扱説明書にはある「閉じる」ボタンが
                このウィンドウにだけ無く、マウスだけの利用者にはタイトルバーの×しか無かった
                （Escapeでは閉じられる。ContextCollectWindow.axaml.cs参照）。他の3つの
                「プレビュー」「コピー」「ファイルへ保存」と対等に並べると押し間違えを誘発する
                （上のコメント参照）ため、Margin区切りを空けてGrid.Column="4"へ独立させる。
            -->
            <Button Grid.Column="4" Content="閉じる" Click="OnCloseClicked"
                    AutomationProperties.Name="ファイルを選ぶ画面を閉じる"
                    local:HelpTip.Standard="このウィンドウを閉じます。"
                    local:HelpTip.Detailed="ファイルを選ぶ画面を閉じます。Escapeキーでも閉じられます。" />
        </Grid>
    </Grid>

    <Window.Styles>
        <Style Selector="TextBlock.statusMessage">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.statusMessage.warn">
            <Setter Property="Foreground" Value="{DynamicResource StateWarn}" />
        </Style>
        <!-- 推定トークン数（ボタンの行）。目安を超えたら警告色（上の状況の文と同じ色）。 -->
        <Style Selector="TextBlock.tokenCount">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.tokenCount.warn">
            <Setter Property="Foreground" Value="{DynamicResource StateWarn}" />
        </Style>

        <!-- 課題2: 3状態切替ボタンの見た目。透明・枠無しの小さなボタンにアイコンだけを乗せる。 -->
        <Style Selector="Button.stateToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- 内容も出す: チェック（アクセント色）。 -->
        <Style Selector="local|IconGlyph.stateFull">
            <Setter Property="Data" Value="{DynamicResource IconCheckGeometry}" />
            <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        </Style>
        <!-- 構成だけ: ファイルの輪郭のみ（中身が無いことを表す）。 -->
        <Style Selector="local|IconGlyph.stateStructureOnly">
            <Setter Property="Data" Value="{DynamicResource IconFileGeometry}" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
        </Style>
        <!-- 出さない: ×（警告色）。 -->
        <Style Selector="local|IconGlyph.stateHidden">
            <Setter Property="Data" Value="{DynamicResource IconXGeometry}" />
            <Setter Property="Stroke" Value="{DynamicResource StateError}" />
        </Style>
        <!-- 混在（フォルダの集計専用。ユーザーが選べる値ではない）: 重なった層。 -->
        <Style Selector="local|IconGlyph.stateMixed">
            <Setter Property="Data" Value="{DynamicResource IconLayersGeometry}" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
        </Style>
    </Window.Styles>
</Window>
