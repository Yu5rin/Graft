<!--
  共通コントロールスタイル（既定の書式のみ・ControlTemplateを差し替えないもの）。
  v2.0のWPF版 Themes/Controls.xaml（TextBlock/ListBox部分）・Controls.Input.xaml（Window部分）の
  移植（附録A・20章L2）。

  Avaloniaでは、ControlTemplateを差し替えない「Setterのみの暗黙スタイル」は
  ControlTheme（x:Key="{x:Type X}"、ResourceDictionaryへ登録）ではなく、
  カスケード適用される <Style Selector="X"> を使う。ControlThemeは型ごとに1つしか
  登録できず、かつTemplateを指定しない場合はFluentThemeの既定テンプレートごと
  失われてしまうため（実測確認済み）、Template を差し替えない項目はこちらに分離する。
  この構文上の理由により、ファイルのルート要素は ResourceDictionary ではなく
  Styles とし、App.axaml から Application.Styles へ StyleInclude で読み込む
  （Icons.axamlと同じ扱い）。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== Window（既定の書式のみ。テンプレートは差し替えない） ========== -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BgBase}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    </Style>

    <!-- ========== TextBlock（既定の書式） ========== -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    </Style>

    <!--
        利用者からの指摘対応（無効なボタンの見た目）: Button/ToggleButton/CheckBox/ComboBoxの
        ControlTheme（Controls.axaml・Controls.Input.axaml）はいずれも:disabledで自分自身の
        Foregroundをtext.disabledへ変えているが、これは「文字列をそのままContentへ渡した
        ボタン」（例: 接ぎ木パネルの「失敗を再依頼」）でしか効いていなかった。「破棄」
        「プレビュー」「適用」のようにContentへ StackPanel＋アイコン＋TextBlock を組んで
        いるボタンは、内側のTextBlockがこのファイル冒頭の暗黙スタイル（Foreground:
        text.primary固定）を持つため、ボタン側のForeground変更を受け取れず無効時も
        文字色が変わらなかった（8.14の指摘の直接原因）。

        AvaloniaのIsEnabled/:disabledは実効的な有効状態（祖先のIsEnabledも考慮した
        IsEffectivelyEnabled）で決まるため、disabledなボタンの内側のTextBlockにも
        :disabled疑似クラスは伝播している。個々のボタンへ直接色を継ぎ足すのではなく、
        ここでTextBlock自身に対する:disabledスタイルを（同じファイル内で後から）
        追加することで、ボタンに限らずあらゆる場所でTextBlockが無効な祖先を持てば
        一括して灰色になるようにする（アイコンはIconGlyph側のStroke。Icons.axaml参照）。
    -->
    <Style Selector="TextBlock:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    </Style>

    <!-- ========== ListBox（既定の書式のみ。ListBoxItemはControls.Input.axaml側） ========== -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ========== TreeView（既定の書式のみ。TreeViewItemはControls.Layout.axaml側） ========== -->
    <Style Selector="TreeView">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <!--
            hardening-perf: 明示しないとFluentThemeの既定パネルに依存してしまい、
            大量件数（ファイル横断検索の結果等）で仮想化が効かず描画が線形に遅くなる
            事例が実測で確認された。可視範囲だけをコンテナ化するVirtualizingStackPanelを
            明示することで、件数に依存しない体感速度を保証する。
        -->
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

</Styles>
