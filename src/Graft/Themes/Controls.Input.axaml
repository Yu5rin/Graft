<!--
  共通コントロールスタイル（入力編）。v2.0のWPF版 Themes/Controls.xaml（CheckBox/ListBox部分）・
  Controls.Input.xaml（ComboBox部分）の移植（附録A・20章L2）。構成・命名方針は
  Controls.axaml と同じ。9.1: フォーカスリングは:focus/:focus-within疑似クラスで
  常時可視にする。

  【v2.0のWPF版からのComboBoxの構成差分（値は変えていない）】
  v2.0のWPF版がカスタムControlTemplateのために必要としていた「閉じた状態でDisplayMemberPathが
  反映されない」問題への回避策（ComboBoxDisplayConverter）は、AvaloniaのSelectionBoxItemが
  最初から表示値を提供するため不要になった。
  一方、閉じた状態の幅が選択中の項目だけで決まってしまう点はAvaloniaでも同じであり、
  v2.0のWPF版と同様に高さ0の見えないItemsControlを重ねて「一番長い項目＋矢印」の幅を確保する。
  色・寸法・枠線・フォーカスリングの扱いはv2.0のWPF版のトークン値をそのまま踏襲する。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ComboBoxの項目テンプレート（よく使う3種）。DisplayMemberBinding ではなく
        ItemTemplate を使うのは、閉じた状態の幅を「一番長い項目＋矢印」に合わせる
        ComboBoxテーマ側の仕組みが ItemTemplate を参照するため
        （DisplayMemberBinding は同じ Binding インスタンスを2箇所へ結び付けられない）。
    -->
    <DataTemplate x:Key="LabelItemTemplate">
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="NameItemTemplate">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="DisplayTextItemTemplate">
        <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" />
    </DataTemplate>

    <!-- ========== CheckBox ========== -->
    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!--
                    フォーカスリングは箱の外周に描くが、負のMarginで外側へはみ出させると
                    コンテナ左端に置かれたとき枠が欠ける。リングの太さぶんを含めた22x22を
                    レイアウト上の占有領域とし、リングが常に境界内に収まるようにする
                    （v2.0のWPF版と同じ考え方）。
                -->
                <Grid ColumnDefinitions="Auto,*">
                    <Grid Width="22" Height="22" VerticalAlignment="Center">
                        <Border Name="PART_Box"
                                Margin="3"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                Background="{DynamicResource BgSurface}" />
                        <Path Name="PART_CheckMark"
                              Data="{DynamicResource IconCheckGeometry}"
                              Stretch="Uniform"
                              Margin="5"
                              Stroke="{DynamicResource Accent}"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              IsVisible="False" />
                        <Border Name="PART_FocusRing"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="{DynamicResource FocusRingBorderThickness}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ContentPresenter Grid.Column="1"
                                       Content="{TemplateBinding Content}"
                                       ContentTemplate="{TemplateBinding ContentTemplate}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Path#PART_CheckMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Box">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="^:focus /template/ Border#PART_FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
        </Style>
    </ControlTheme>

    <!-- ========== ListBoxItem（ListBox本体の既定書式はControls.Base.axaml側） ========== -->
    <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="PART_Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                    <Border Name="PART_FocusRing"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="{DynamicResource FocusRingBorderThickness}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
        </Style>
        <Style Selector="^:focus /template/ Border#PART_FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </ControlTheme>

    <!-- ========== ComboBox / ComboBoxItem（コマンドバーのプロジェクト選択等） ========== -->
    <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <!--
                        幅の確保: 閉じた状態のボックスは選択中の項目しか描かないため、
                        そのままでは幅が選択中の項目だけで決まり、他の項目を選ぶと
                        文字が切れる。高さ0の見えないItemsControlに全項目を並べて
                        計測にだけ参加させ、「一番長い項目＋矢印」の幅を常に確保する
                        （v2.0のWPF版 Themes/Controls.Input.xaml と同じ方針）。
                        IsVisible="False" ではレイアウトから外れて計測にも参加しないため、
                        Opacity="0" で見えなくする。
                    -->
                    <ItemsControl ItemsSource="{TemplateBinding ItemsSource}"
                                  ItemTemplate="{TemplateBinding ItemTemplate}"
                                  Height="0"
                                  Margin="9,0,37,0"
                                  Opacity="0"
                                  IsHitTestVisible="False"
                                  Focusable="False" />
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- 右側は矢印の占有領域。本文が矢印の下へ潜り込まないよう常に空ける。 -->
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding ItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                            <Path Grid.Column="1"
                                  Margin="0,0,10,0"
                                  Data="M4,6 L8,10 L12,6"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Popup Name="PART_Popup"
                           WindowManagerAddShadowHint="False"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           Placement="Bottom">
                        <Border Background="{DynamicResource BgElevated}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                MaxHeight="240"
                                MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer>
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                    <Border Name="PART_FocusRing"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="{DynamicResource FocusRingBorderThickness}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#PART_FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
