<!--
  共通コントロールスタイル（基礎編。ControlTemplateを差し替えるもの）。
  v2.0のWPF版 Themes/Controls.xaml の移植（附録A・20章L2）。9.1: OSのネイティブな見た目に
  寄せず、色はすべてDynamicResourceでトークン参照する。9.1: フォーカスリングは
  アクセント色の2px枠で常時可視にする（マウス操作でも消さない）。

  Window/TextBlock/ListBox/TreeViewなどSetterのみ（ControlTemplateを差し替えない）の
  項目はControls.Base.axamlへ分離した（構文上の理由。同ファイル冒頭のコメント参照）。
  CheckBox/ComboBox/ListBoxItemはControls.Input.axaml、TabControl/TreeViewItem/
  ScrollBar/GridSplitter/ProgressBarはControls.Layout.axamlに分割する
  （1ファイル400行の上限のため。v2.0のWPF版もControls.xaml/Controls.Input.xamlに分割していた
  構成を踏襲する）。

  【Avalonia化にあたっての構文の要点（WPFとの対応）】
  - ControlTemplateを差し替える場合は、Avalonia 11の正道である ControlTheme を使い、
    x:Key="{x:Type X}" という予約キーでApplication.Resourcesへ登録する。この形の
    キーはAvaloniaの既定テーマ解決の仕組みそのものであり、暗黙スタイルとして機能する
    （実測確認済み。FluentThemeより優先して解決される）。
  - フォーカスの可視化は、WPFのIsFocusedトリガーに対応するAvaloniaの:focus疑似クラスを
    使う。マウス操作時のみフォーカスリングを隠す:focus-visibleは意図的に使わない
    （9.1: 常時可視の要件のため）。
  - WPFのStrokeStartLineCap/StrokeEndLineCapはAvaloniaではStrokeLineCap 1つに、
    StrokeLineJoinはStrokeJoinという名前になる（値は変えていない）。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base">

    <!-- ========== Button ========== -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <!-- 9.1: フォーカスリングはIsFocusedならぬ:focusで反応させ、
                         マウスクリックによるフォーカスでも消さない。 -->
                    <Border Name="PART_FocusRing"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="{DynamicResource FocusRingBorderThickness}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
        </Style>
        <Style Selector="^:focus /template/ Border#PART_FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
        </Style>
    </ControlTheme>

    <!-- ========== ToggleButton ========== -->
    <!--
        差分ビューの「折り返し」「空白を表示」「すべて展開」などで使う。定義が無いと
        AvaloniaのFluent既定テーマが当たり、9.1のトークン参照から外れて浮いた見た目になる
        （ライトテーマで灰色の塗りつぶしになり、他のボタンと揃わない不具合として現れた）。
        通常時はButtonと同じ見た目にし、オンの状態だけ選択色で塗って区別する。
    -->
    <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <Border Name="PART_FocusRing"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="{DynamicResource FocusRingBorderThickness}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <!-- オン/オフは色だけに頼らず、枠の色もアクセントへ変えて区別する（8.14）。 -->
        <Style Selector="^:checked /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="^:focus /template/ Border#PART_FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
        </Style>
    </ControlTheme>

    <!-- ========== TextBox ========== -->
    <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BgSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <!-- 1行入力は枠の中央に置く。複数行のときは下のスタイルで上寄せへ切り替える。 -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <!--
                            スクロールバーの表示可否は、利用側が ScrollViewer の添付プロパティで
                            指定する。ここで固定値を書くと指定が届かず、複数行の入力欄で
                            内容がはみ出してもスクロールできないまま切れて見える。
                        -->
                        <ScrollViewer Name="PART_ScrollViewer"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                      VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                            <Panel>
                                <!-- 透かし文字。TextPresenterは描画しないため別に持つ。 -->
                                <TextBlock Name="PART_Watermark"
                                           Text="{TemplateBinding Watermark}"
                                           Foreground="{DynamicResource TextDisabled}"
                                           TextAlignment="{TemplateBinding TextAlignment}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           IsVisible="{TemplateBinding Text,
                                                       Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                                <TextPresenter Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretBrush="{TemplateBinding CaretBrush}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                               SelectionStart="{TemplateBinding SelectionStart}"
                                               SelectionEnd="{TemplateBinding SelectionEnd}"
                                               CaretIndex="{TemplateBinding CaretIndex}"
                                               PasswordChar="{TemplateBinding PasswordChar}"
                                               RevealPassword="{TemplateBinding RevealPassword}"
                                               TextAlignment="{TemplateBinding TextAlignment}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Panel>
                        </ScrollViewer>
                    </Border>
                    <Border Name="PART_FocusRing"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="{DynamicResource FocusRingBorderThickness}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <!--
            複数行の入力欄で中央寄せのままだと、内容が枠より高いときに上下が
            均等に隠れ、行の途中で切れて見える。上寄せにしてスクロールへ委ねる。
        -->
        <Style Selector="^[AcceptsReturn=True]">
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector="^:focus /template/ Border#PART_FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
        </Style>
    </ControlTheme>

    <!-- ========== ToolTip ========== -->
    <!-- WPFのHasDropShadow相当のプロパティはAvaloniaに存在しないため持たない
         （影の有無はAvaloniaのウィンドウ管理側の既定に委ねる）。 -->
    <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
    </ControlTheme>

</ResourceDictionary>
