<!--
  ライトテーマの色トークン（9.3）。v2.0のWPF版 Themes/Light.xaml の移植（附録A・20章L2）。
  値・キー名はv2.0のWPF版と完全に同一。Dark.axaml と全く同じキー名を持つ。
  構成・注意事項はDark.axaml冒頭のコメントを参照。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 背景（面の明度差3階層） ========== -->
    <Color x:Key="BgBaseColor">#FAFAF8</Color>
    <SolidColorBrush x:Key="BgBase" Color="{StaticResource BgBaseColor}" />

    <Color x:Key="BgSurfaceColor">#F1F1EE</Color>
    <SolidColorBrush x:Key="BgSurface" Color="{StaticResource BgSurfaceColor}" />

    <Color x:Key="BgElevatedColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="BgElevated" Color="{StaticResource BgElevatedColor}" />

    <Color x:Key="BgHoverColor">#E8E8E3</Color>
    <SolidColorBrush x:Key="BgHover" Color="{StaticResource BgHoverColor}" />

    <Color x:Key="BgSelectedColor">#E4EDFB</Color>
    <SolidColorBrush x:Key="BgSelected" Color="{StaticResource BgSelectedColor}" />

    <!-- ========== 文字 ========== -->
    <Color x:Key="TextPrimaryColor">#22252A</Color>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />

    <Color x:Key="TextSecondaryColor">#5C6269</Color>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />

    <!--
        UI点検（項目1）対応: 旧値#A0A5ACはBgBaseに対し実測2.37:1、実際に文字が乗る
        BgSurfaceに対しても2.19:1しかなく、コマンドバーの無効ボタン（「キューへ追加」
        「適用」等）や設定画面のチェックボックスが判読不能だった。同じ色相・彩度を保ったまま
        明度だけを下げ、新値#828892はBgBaseに対し3.41:1・BgSurfaceに対し3.15:1
        （いずれもUI部品の基準3:1以上）。TextSecondary（BgBase比5.90:1）よりは明らかに
        薄いままなので「押せない」印象は保たれる。 -->
    <Color x:Key="TextDisabledColor">#828892</Color>
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}" />

    <!-- ========== アクセント（1色のみ） ========== -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />

    <!-- ========== フォーカスリング（UI点検項目4対応） ========== -->
    <!-- このテーマはAccent自体がBgBase比4.95:1・BgSurface比4.57:1・BgSelected比4.38:1と
         いずれもUI部品の基準3:1を十分満たすため、独立したFocusRingColorは持たずAccentへ
         そのまま乗せる（Dark.axamlのIndentGuideHoverと同じ「差分が無い場合は新規キーを
         増やさない」規則を踏襲）。 -->
    <SolidColorBrush x:Key="FocusRing" Color="{StaticResource AccentColor}" />

    <!-- ========== 境界線（必要最小限） ========== -->
    <!-- UI点検（項目5）対応: 旧値#E3E2DCはBgBaseに対し実測1.24:1で、サイドバー・サイドビュー・
         エディタの区切り線やコマンドバー下端の線がほぼ視認できなかった。「主張しない区切り」
         という役割上3:1（UI部品の基準）まで上げると強すぎるため、1.5〜2.0程度を狙って
         同じ色相・彩度のまま明度だけ下げた。新値#C2C0B3はBgBaseに対し1.75:1
         （Nord1.69・Dracula1.85と同程度で、この2テーマは今回未修正でも「存在は分かる」と
         判断された水準）。 -->
    <Color x:Key="BorderSubtleColor">#C2C0B3</Color>
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" />

    <!-- ========== diff ========== -->
    <Color x:Key="DiffAddBgColor">#E6F6EC</Color>
    <SolidColorBrush x:Key="DiffAddBg" Color="{StaticResource DiffAddBgColor}" />

    <Color x:Key="DiffAddBarColor">#2E9E68</Color>
    <SolidColorBrush x:Key="DiffAddBar" Color="{StaticResource DiffAddBarColor}" />

    <Color x:Key="DiffDelBgColor">#FCEBEC</Color>
    <SolidColorBrush x:Key="DiffDelBg" Color="{StaticResource DiffDelBgColor}" />

    <Color x:Key="DiffDelBarColor">#D14350</Color>
    <SolidColorBrush x:Key="DiffDelBar" Color="{StaticResource DiffDelBarColor}" />

    <!-- ========== 状態 ========== -->
    <!-- UI点検（項目6）対応: 旧値#B77E14はBgSurfaceに対し実測3.09:1で、プロジェクト一覧の
         「未接続」ラベルやステータスバーの警告文（文字として使う）には4.5:1の基準に届いて
         いなかった。色相は変えず明度だけ下げた。新値#926410はBgSurfaceに対し4.58:1。 -->
    <Color x:Key="StateWarnColor">#926410</Color>
    <SolidColorBrush x:Key="StateWarn" Color="{StaticResource StateWarnColor}" />

    <Color x:Key="StateErrorColor">#D14350</Color>
    <SolidColorBrush x:Key="StateError" Color="{StaticResource StateErrorColor}" />

    <!--
        UI点検（項目6）対応: 旧値#2E9E68（diff.add.barと同値）はBgSurfaceに対し実測2.99:1で、
        アイコンとして使う場合の基準3:1にわずかに届いていなかった（適用可ブロックのチェック
        アイコン）。diff.add.bar/gutter.add側は今回指摘が無く、diff表示の見た目を変えたくない
        ため、この2箇所とは意図的に値を分離した（今後は「diff.add.barと同値」の規則から
        StateOkColorだけ例外）。新値#2E9D67（色相はそのまま、Gにわずか-1の誤差レベルの調整）は
        BgSurfaceに対し3.02:1。 -->
    <Color x:Key="StateOkColor">#2E9D67</Color>
    <SolidColorBrush x:Key="StateOk" Color="{StaticResource StateOkColor}" />

    <!-- ========== シンタックスハイライト配色（ライト） ========== -->
    <Color x:Key="SyntaxKeywordColor">#7B4FA8</Color>
    <SolidColorBrush x:Key="SyntaxKeyword" Color="{StaticResource SyntaxKeywordColor}" />

    <Color x:Key="SyntaxStringColor">#4F7A3A</Color>
    <SolidColorBrush x:Key="SyntaxString" Color="{StaticResource SyntaxStringColor}" />

    <Color x:Key="SyntaxNumberColor">#A5642A</Color>
    <SolidColorBrush x:Key="SyntaxNumber" Color="{StaticResource SyntaxNumberColor}" />

    <Color x:Key="SyntaxCommentColor">#8A9099</Color>
    <SolidColorBrush x:Key="SyntaxComment" Color="{StaticResource SyntaxCommentColor}" />

    <Color x:Key="SyntaxFunctionColor">#2F6FA8</Color>
    <SolidColorBrush x:Key="SyntaxFunction" Color="{StaticResource SyntaxFunctionColor}" />

    <Color x:Key="SyntaxTypeColor">#8A6A1F</Color>
    <SolidColorBrush x:Key="SyntaxType" Color="{StaticResource SyntaxTypeColor}" />

    <Color x:Key="SyntaxOperatorColor">#5C6269</Color>
    <SolidColorBrush x:Key="SyntaxOperator" Color="{StaticResource SyntaxOperatorColor}" />

    <!-- plainはtext.primaryと同値。 -->
    <SolidColorBrush x:Key="SyntaxPlain" Color="{StaticResource TextPrimaryColor}" />

    <!-- ========== Gitガター・エディタ ========== -->
    <Color x:Key="GutterAddColor">#2E9E68</Color>
    <SolidColorBrush x:Key="GutterAdd" Color="{StaticResource GutterAddColor}" />

    <Color x:Key="GutterModColor">#2563EB</Color>
    <SolidColorBrush x:Key="GutterMod" Color="{StaticResource GutterModColor}" />

    <Color x:Key="GutterDelColor">#D14350</Color>
    <SolidColorBrush x:Key="GutterDel" Color="{StaticResource GutterDelColor}" />

    <Color x:Key="EditorCurrentLineColor">#F1F1EE</Color>
    <SolidColorBrush x:Key="EditorCurrentLine" Color="{StaticResource EditorCurrentLineColor}" />

    <Color x:Key="EditorSelectionColor">#E4EDFB</Color>
    <SolidColorBrush x:Key="EditorSelection" Color="{StaticResource EditorSelectionColor}" />

    <!-- ========== インデントガイド（縦線、検討書「インデントガイド（縦線）」） ========== -->
    <!-- Dark.axamlと同じ方針（地色はBorderSubtle流用、ホバー強調は既定なのでAccentのまま）。
         詳細な根拠はDark.axaml側のコメント参照。 -->
    <SolidColorBrush x:Key="IndentGuide" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="IndentGuideHover" Color="{StaticResource AccentColor}" />


    <!-- ========== 検索ハイライト（Ctrl+F、依頼「検索ハイライト機能」A） ==========
         色の選定方法・実測コントラスト比の一覧はDark.axaml冒頭の同見出しのコメントを参照
         （9テーマ共通の算出方法のため、詳細な説明はそちらに集約している）。
         このテーマでの実測: 全ヒット塗りvs本文=4.61:1・vs背景=2.94:1、
         現在ヒット塗りvs本文=4.61:1・vs背景=2.95:1（いずれも4.5:1以上）。 -->

    <Color x:Key="SearchMatchColor">#A98928</Color>
    <SolidColorBrush x:Key="SearchMatch" Color="{StaticResource SearchMatchColor}" />

    <Color x:Key="SearchMatchBorderColor">#775B08</Color>
    <SolidColorBrush x:Key="SearchMatchBorder" Color="{StaticResource SearchMatchBorderColor}" />

    <Color x:Key="SearchCurrentMatchColor">#DA6F12</Color>
    <SolidColorBrush x:Key="SearchCurrentMatch" Color="{StaticResource SearchCurrentMatchColor}" />

    <Color x:Key="SearchCurrentMatchBorderColor">#793A03</Color>
    <SolidColorBrush x:Key="SearchCurrentMatchBorder" Color="{StaticResource SearchCurrentMatchBorderColor}" />

    <!-- ========== チュートリアルの覆い（UI点検項目9対応） ========== -->
    <!-- TutorialOverlay.axaml ScrimPath.Fill用。旧実装は全テーマ共通で固定の半透明黒
         #8A000000（不透明度約54%）を直値で使っていたが、明るいテーマではその分だけ画面全体が
         暗く沈み「意図より重く見える」という指摘があった。ライト系テーマは地の背景が元々
         明るいため、不透明度を約40%（#66）へ落としても「対象だけが明るく見える」という
         コーチマークの狙いは保たれる（暗幕の下に沈む背景が既に明るいぶん、同じ相対的な
         暗さの差を作るのに必要な不透明度が低くて済む）。ダーク系テーマ（Dark.axaml等）は
         元の#8A000000のまま据え置く。 -->
    <Color x:Key="TutorialScrimColor">#66000000</Color>
    <SolidColorBrush x:Key="TutorialScrim" Color="{StaticResource TutorialScrimColor}" />

</ResourceDictionary>
