<!--
  共通デザイントークン（色以外）。

  8.4 タイポグラフィの表、8.2/8.11 のレイアウト寸法、8.9 のモーション定義を
  リソース化する。色トークンは Dark.xaml / Light.xaml が担当し、このファイルには
  一切の色を持たない。参照側は必ず DynamicResource を使うこと（テーマ切り替え時に
  即時反映させるため。このファイル自体はテーマに依存しないが、他トークンと参照方法を
  揃えるために DynamicResource を推奨する）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ========== 8.4 タイポグラフィ：フォントファミリ ========== -->
    <!-- UIフォント本体はYu Gothic UI。未インストール環境ではSegoe UI Variableへ、
         さらにWPFの既定フォールバックで日本語グリフを補う。 -->
    <FontFamily x:Key="UiFontFamily">Yu Gothic UI, Segoe UI Variable</FontFamily>
    <!-- コードフォントはCascadia Monoを主とし、日本語部分はBIZ UDゴシックへ
         フォールバックする。 -->
    <FontFamily x:Key="CodeFontFamily">Cascadia Mono, BIZ UDGothic</FontFamily>

    <!-- ========== 8.4 タイポグラフィ：用途別サイズ・ウェイト・行間 ========== -->
    <!-- 行間（LineHeight）はTextBlock.LineHeightにそのまま設定できるよう、
         表の行間比率にフォントサイズを乗じた実ピクセル値として保持する。 -->

    <!-- ペイン見出し：12px / SemiBold / 行間1.4 -->
    <sys:Double x:Key="PaneHeadingFontSize">12</sys:Double>
    <FontWeight x:Key="PaneHeadingFontWeight">SemiBold</FontWeight>
    <sys:Double x:Key="PaneHeadingLineHeight">16.8</sys:Double>

    <!-- 本文・リスト：13px / Regular / 行間1.6 -->
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <FontWeight x:Key="BodyFontWeight">Regular</FontWeight>
    <sys:Double x:Key="BodyLineHeight">20.8</sys:Double>

    <!-- 変更説明・補助：12px / Regular / 行間1.5 -->
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <FontWeight x:Key="CaptionFontWeight">Regular</FontWeight>
    <sys:Double x:Key="CaptionLineHeight">18</sys:Double>

    <!-- コード・diff：13px / Regular / 行間1.5 -->
    <sys:Double x:Key="CodeFontSize">13</sys:Double>
    <FontWeight x:Key="CodeFontWeight">Regular</FontWeight>
    <sys:Double x:Key="CodeLineHeight">19.5</sys:Double>

    <!-- ステータスバー：12px / Regular / 行間1.4 -->
    <sys:Double x:Key="StatusBarFontSize">12</sys:Double>
    <FontWeight x:Key="StatusBarFontWeight">Regular</FontWeight>
    <sys:Double x:Key="StatusBarLineHeight">16.8</sys:Double>

    <!-- ========== 余白スケール ========== -->
    <!-- 仕様書は具体的な余白値の表を持たないため、8.2のレイアウト密度に沿った
         控えめな段階（4の倍数）を実装者判断で採用する。装飾を持たない設計原則
         （8.1）に沿い、コントロール内部の詰め・要素間の間隔に共通して使う。 -->
    <sys:Double x:Key="SpacingXs">4</sys:Double>
    <sys:Double x:Key="SpacingSm">8</sys:Double>
    <sys:Double x:Key="SpacingMd">12</sys:Double>
    <sys:Double x:Key="SpacingLg">16</sys:Double>
    <sys:Double x:Key="SpacingXl">24</sys:Double>

    <!-- Margin / Padding / BorderThickness は Thickness 型のため、上の Double を
         そのまま割り当てると実行時に例外になる。四辺同値の Thickness 版を用意する。 -->
    <Thickness x:Key="SpacingXsThickness">4</Thickness>
    <Thickness x:Key="SpacingSmThickness">8</Thickness>
    <Thickness x:Key="SpacingMdThickness">12</Thickness>
    <Thickness x:Key="SpacingLgThickness">16</Thickness>
    <Thickness x:Key="SpacingXlThickness">24</Thickness>

    <!-- ========== 8.2 / 8.11 レイアウト寸法 ========== -->
    <sys:Double x:Key="CommandBarHeight">40</sys:Double>
    <sys:Double x:Key="StatusBarHeight">48</sys:Double>

    <!-- RowDefinition.Height は GridLength 型のため、Double を割り当てると
         実行時に例外になる。同じ値の GridLength 版を用意する。 -->
    <GridLength x:Key="CommandBarRowHeight">40</GridLength>
    <GridLength x:Key="StatusBarRowHeight">48</GridLength>
    <sys:Double x:Key="MinWindowWidth">960</sys:Double>
    <sys:Double x:Key="MinWindowHeight">600</sys:Double>

    <!-- ========== 8.3 diff左端バー ========== -->
    <sys:Double x:Key="DiffBarWidth">3</sys:Double>

    <!-- ========== 8.5 アイコン共通寸法 ========== -->
    <sys:Double x:Key="IconViewboxSize">24</sys:Double>
    <sys:Double x:Key="IconStrokeThickness">1.5</sys:Double>
    <!-- 一覧・ツールバーでの既定表示サイズ。個々の利用箇所で上書き可。 -->
    <sys:Double x:Key="IconDisplaySize">16</sys:Double>

    <!-- ========== 8.10 / 8.14 フォーカスリング ========== -->
    <!-- 色はAccentトークン（Dark.xaml / Light.xaml）を使う。太さのみここで持つ。
         FocusRingThickness は数値そのもの（コードビハインドでの計算等に使う）、
         FocusRingBorderThickness は Border.BorderThickness（Thickness型）へ
         そのまま Setter で割り当てるための同じ値のThickness版。
         DynamicResourceは値の型変換を行わないため、Double型のリソースを
         Thickness型のプロパティへ直接割り当てると実行時エラーになる。 -->
    <sys:Double x:Key="FocusRingThickness">2</sys:Double>
    <Thickness x:Key="FocusRingBorderThickness">2</Thickness>

    <!-- ========== 8.9 モーション ========== -->
    <!-- 継続時間120ms、イージングはease-outのみ。対象はペイン開閉・ポップオーバー・
         テーマ切り替えのクロスフェードに限定する（ThemeManager.csおよび将来の
         各Viewから参照する）。 -->
    <Duration x:Key="MotionDuration">0:0:0.12</Duration>
    <sys:TimeSpan x:Key="MotionDurationTimeSpan">0:0:0.12</sys:TimeSpan>
    <QuadraticEase x:Key="MotionEaseOut" EasingMode="EaseOut" />

</ResourceDictionary>
