<!--
  4.1: AvaloniaEditのテーマ適用。既定配色を一切残さず、9.3のカラートークンへ完全に
  追従させる。App.axamlのMergedDictionariesから読み込まれ、アプリ全体で1つだけロードされる。
  v2.0のWPF版 Themes/Editor.xaml の移植（20章L3）。

  TextArea.SelectionBrush・TextView.CurrentLineBackground等はTextEditorの
  Setterからは設定できない（TextEditor自身ではなく子要素が持つプロパティ）ため、
  それらはViews/EditorPane.axaml.csから設定する。このファイルはControlThemeとして
  表現できる範囲を担当する。

  【v2.0のWPF版からの構文差分】
  - v2.0のWPF版はキー無しのStyle（TargetType="ae:TextEditor"）で暗黙適用していたが、
    Avaloniaでは x:Key="{x:Type ae:TextEditor}" のControlThemeとして登録する。
    TextEditorの内部テンプレートはAvaloniaEditの既定をそのまま使い、Setterのみ与える。
  - IsMouseOver/IsSelectedのTriggerは :pointerover / :selected 疑似クラスへ。
  - StrokeStartLineCap/StrokeEndLineCap は StrokeLineCap 1つに、StrokeLineJoin は
    StrokeJoin という名前になる（値は変えていない）。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
                     xmlns:views="clr-namespace:Graft.Views">

    <!-- ========== AvaloniaEdit TextEditor 本体 ========== -->
    <ControlTheme x:Key="{x:Type ae:TextEditor}" TargetType="ae:TextEditor"
                  BasedOn="{StaticResource {x:Type ae:TextEditor}}">
        <Setter Property="Background" Value="{DynamicResource BgBase}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
        <Setter Property="LineNumbersForeground" Value="{DynamicResource TextDisabled}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
    </ControlTheme>

    <!--
        ========== エディタタブの見出し部 ==========
        機能改善（タブが増えたときに到達できない問題、依頼1/2）: ItemsPanelは
        views:TabStripPanel（Views/TabStripPanel.cs）。タブ幅を自動で縮め、最小幅でも
        収まらない分は自前の水平オフセットで管理する（スクロールボタン・マウスホイールから
        EditorPane.axaml.cs経由で操作する）。そのためListBox自身の水平スクロールバーは
        使わない（Disabledのまま。CanHorizontallyScroll=falseとなり、TabStripPanelの
        MeasureOverrideへ「実際のビューポート幅」がそのまま渡ってくる＝タブ幅の
        計算に使える。もしAutoのままだとScrollViewerは常に無限幅を子へ渡してしまい、
        「収まる幅まで縮める」判定ができなくなる）。
    -->
    <ControlTheme x:Key="EditorTabStripTheme" TargetType="ListBox"
                  BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <views:TabStripPanel />
            </ItemsPanelTemplate>
        </Setter>
    </ControlTheme>

    <!-- タブ1件のコンテナ。選択中は下線と背景で示す（色だけに依存しない: 太字化も併用）。 -->
    <ControlTheme x:Key="EditorTabItemTheme" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTipText}" />
        <Setter Property="ToolTip.Tip" Value="{Binding ToolTipText}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root" Background="Transparent"
                        BorderBrush="Transparent" BorderThickness="0,0,0,2">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="10,6" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:selected /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource BgBase}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <!--
            機能改善（タブのドラッグ並べ替え）: 挿入位置の最小限の視覚フィードバック。
            ドラッグ先の左端（末尾ドロップ時は最後のタブの右端）に縦線を出す。
            EditorPane.axaml.cs の UpdateDragIndicator が Classes を都度付け替える。
        -->
        <Style Selector="^.dragInsertBefore /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="2,0,0,2" />
        </Style>
        <Style Selector="^.dragInsertAfter /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="0,0,2,2" />
        </Style>
    </ControlTheme>

    <!-- タブを閉じるボタン（9.4のxアイコンを使用）。 -->
    <ControlTheme x:Key="EditorTabCloseButtonTheme" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Bg" Background="{TemplateBinding Background}" CornerRadius="3">
                    <views:IconGlyph Data="{DynamicResource IconXGeometry}"
                                     Width="12" Height="12"
                                     Stroke="{DynamicResource TextSecondary}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
    </ControlTheme>

    <!--
        機能改善（タブが増えたときに到達できない問題、依頼2/3）: 左右スクロールボタン・
        タブ一覧ドロップダウンの共通の見た目。EditorTabCloseButtonThemeと似た軽量な
        アイコンボタンだが、Contentを差し替えられるようContentPresenterを使う点が異なる
        （閉じるボタンは常にxアイコン固定のため専用テーマのまま残す）。無効時
        （スクロール端に達した等）はOpacityを下げて操作できないことを示す。
        他エージェントが対応中の共有Buttonテーマ（Controls.axaml）には触れず、
        タブ見出し専用の独立したControlThemeとしてここに置く。
    -->
    <ControlTheme x:Key="EditorTabStripActionButtonTheme" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Bg" Background="{TemplateBinding Background}" CornerRadius="3">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
