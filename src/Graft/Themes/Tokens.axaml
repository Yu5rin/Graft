<!--
  共通デザイントークン（色以外）。v2.0のWPF版 Themes/Tokens.xaml の移植（附録A・20章L2）。

  8.4 タイポグラフィの表、8.2/8.11 のレイアウト寸法、8.9 のモーション定義を
  リソース化する。色トークンは Dark.axaml / Light.axaml が担当し、このファイルには
  一切の色を持たない。参照側は必ず DynamicResource を使うこと（テーマ切り替え時に
  即時反映させるため）。

  【v2.0のWPF版からの差分（意図的・仕様書の指示による）】
  - フォントは2.5節のとおり、プラットフォームのフォールバック列で指定し直す
    （v2.0のWPF版はWindows専用フォントのみを列挙していたため、そのままでは移植にならない）。
  - Duration型はAvaloniaに存在しないため、TimeSpanのみを持つ（v2.0のWPF版はDurationと
    TimeSpanの両方を持っていたが、Avalonia側で必要なのはTimeSpanのみ）。
  - イージングはAvaloniaの型体系（モードごとに別クラス）に合わせ、
    QuadraticEase(EasingMode=EaseOut) 相当の QuadraticEaseOut を使う。
  - 値・キー名はいずれもv2.0のWPF版と同一（プラットフォームで値を変えない、9.3/9.4）。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 9.4 タイポグラフィ：フォントファミリ（2.5 フォールバック列） ========== -->
    <FontFamily x:Key="UiFontFamily">Yu Gothic UI, Segoe UI Variable, Noto Sans CJK JP, IPAexGothic, sans-serif</FontFamily>
    <!--
        v1.0.21で新設。取扱説明書・Markdownプレビューの地の文専用のフォントキー（UiFontFamily・
        CodeFontFamilyに続く3つ目）。

        【なぜフォールバック列がUiFontFamilyと一字一句同じか】
        利用者が本文用に選んだフォント（源ノ角ゴシック JP）がメニュー・ボタン・一覧まで
        巻き込んでしまい、字の縦位置がずれて見える不具合の対応として設けたキーであり、
        「何も設定していない利用者の見た目は1ピクセルも変わらない」ことが最優先の要件。
        UiFontFamilyとBodyTextFontFamilyを最初から別々の既定フォールバック列にしてしまうと、
        設定を一度も開いたことのない利用者でも本文とUIとで見た目のフォントが変わってしまい、
        「今回の変更」自体が既定の見た目を変えることになる。既定値を意図的に重複させることで、
        AppFontManager側でどちらかのキーだけを上書きした場合にだけ違いが生まれる
        （tests/Graft.UiTests/FontSettingsTests.cs参照）。
    -->
    <FontFamily x:Key="BodyTextFontFamily">Yu Gothic UI, Segoe UI Variable, Noto Sans CJK JP, IPAexGothic, sans-serif</FontFamily>
    <FontFamily x:Key="CodeFontFamily">Cascadia Mono, JetBrains Mono, Noto Sans Mono CJK JP, DejaVu Sans Mono, monospace</FontFamily>

    <!-- ========== 9.4 タイポグラフィ：用途別サイズ・ウェイト・行間 ========== -->
    <!-- 行間（LineHeight）はTextBlock.LineHeightにそのまま設定できるよう、
         表の行間比率にフォントサイズを乗じた実ピクセル値として保持する。 -->

    <!-- ペイン見出し：12px / SemiBold / 行間1.4 -->
    <x:Double x:Key="PaneHeadingFontSize">12</x:Double>
    <FontWeight x:Key="PaneHeadingFontWeight">SemiBold</FontWeight>
    <x:Double x:Key="PaneHeadingLineHeight">16.8</x:Double>

    <!-- 本文・リスト：13px / Regular / 行間1.6 -->
    <x:Double x:Key="BodyFontSize">13</x:Double>
    <FontWeight x:Key="BodyFontWeight">Regular</FontWeight>
    <x:Double x:Key="BodyLineHeight">20.8</x:Double>

    <!-- 変更説明・補助：12px / Regular / 行間1.5 -->
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <FontWeight x:Key="CaptionFontWeight">Regular</FontWeight>
    <x:Double x:Key="CaptionLineHeight">18</x:Double>

    <!-- コード・diff：13px / Regular / 行間1.5 -->
    <x:Double x:Key="CodeFontSize">13</x:Double>
    <FontWeight x:Key="CodeFontWeight">Regular</FontWeight>
    <x:Double x:Key="CodeLineHeight">19.5</x:Double>

    <!-- ステータスバー：12px / Regular / 行間1.4 -->
    <x:Double x:Key="StatusBarFontSize">12</x:Double>
    <FontWeight x:Key="StatusBarFontWeight">Regular</FontWeight>
    <x:Double x:Key="StatusBarLineHeight">16.8</x:Double>

    <!--
        UI点検（項目13）で追加。仕様書8.4のタイポグラフィ表（上記5種）には無いが、
        OnboardingWindow・AboutViewの見出しに18px/20pxの直値がそれぞれ複数箇所（実測3+2件）
        散っており、しかも同じ18pxでもFontWeightだけ書き方が揃っていて値は都度手入力という
        状態だった。表自体を拡張するのではなく別枠として、大見出し・中見出しの2段だけを
        トークン化して寄せる（既存のPaneHeadingFontSize=12はペイン見出し専用で
        ウィンドウ内の大きな見出しには小さすぎるため、これとは別に用意する）。
    -->
    <x:Double x:Key="TitleFontSize">20</x:Double>
    <x:Double x:Key="SubheadingFontSize">18</x:Double>
    <FontWeight x:Key="TitleFontWeight">SemiBold</FontWeight>

    <!--
        GeneralSettingsView「画面のフォント／本文フォント／等幅フォント」の見本専用。
        BodyFontSize(13)より少しだけ大きく見せたい実物大サンプル表示のためのサイズで、見出しではないため
        上のTitle/Subheadingとは別に切り出す。以前は15だったが、周りの項目名（13px）より大きく
        見出しのように見えたため14へ下げた（本文＋1。実機Xvfbで確認。Settings側の「見本」の枠の説明参照）。
    -->
    <x:Double x:Key="PreviewSampleFontSize">14</x:Double>

    <!-- ========== 余白スケール ========== -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingLg">16</x:Double>
    <x:Double x:Key="SpacingXl">24</x:Double>

    <!-- Margin / Padding / BorderThickness は Thickness 型のため、上の Double を
         そのまま割り当てると実行時に例外になる。四辺同値の Thickness 版を用意する。 -->
    <Thickness x:Key="SpacingXsThickness">4</Thickness>
    <Thickness x:Key="SpacingSmThickness">8</Thickness>
    <Thickness x:Key="SpacingMdThickness">12</Thickness>
    <Thickness x:Key="SpacingLgThickness">16</Thickness>
    <Thickness x:Key="SpacingXlThickness">24</Thickness>

    <!-- ========== 9.2 / 附録A レイアウト寸法 ========== -->
    <x:Double x:Key="CommandBarHeight">40</x:Double>
    <!--
        項目13: 以前はここが48だったが、実際のステータスバーはShellWindow.axamlが
        Height="24"の直値で描画しており（同ファイルのコメントも「ステータスバー(24px)」と
        明記）、このトークンはどこからも参照されず実態と食い違ったまま放置されていた
        （実測: grep -rn StatusBarHeight src/Graft で参照0件を確認済み）。値を実態の24へ
        合わせ、下のStatusBarRowHeightと合わせてShellWindow.axaml側から参照させる
        （CommandBarRowHeightが同ファイル:36で正しく参照されているのに倣う）。
    -->
    <x:Double x:Key="StatusBarHeight">24</x:Double>

    <!-- RowDefinition.Height は GridLength 型のため、Double を割り当てると
         実行時に例外になる。同じ値の GridLength 版を用意する。 -->
    <GridLength x:Key="CommandBarRowHeight">40</GridLength>
    <GridLength x:Key="StatusBarRowHeight">24</GridLength>
    <x:Double x:Key="MinWindowWidth">960</x:Double>
    <x:Double x:Key="MinWindowHeight">600</x:Double>

    <!-- ========== 寸法トークン（見た目の整備で新設。画面ごとにばらばらだった高さ・角丸・余白を1か所へ） ========== -->
    <!--
        【なぜ作ったか】
        監査（実機の画面写真）で、ペイン見出しの高さが59/62/64px、一覧の行の高さが26/28/36/53pxと
        画面ごとにばらばらで、ボタンや入力欄にも角丸が無かった。値は各Viewの Margin / Padding から
        偶然決まっており、揃える手がかりが無かったため、意味のある単位をここへ集める。
        新しい画面・部品を作るときは、直値ではなく必ずこれらを DynamicResource で参照すること。
        （Double は Height / MinHeight / Width へ、CornerRadius 型は CornerRadius へ、Thickness は
         Margin / Padding へそのまま割り当てられる。型が違うと実行時エラーになるため3種を分けて持つ。）
    -->
    <!-- コントロール（ボタン・入力欄・ComboBox・タブの帯）の高さ。標準28px、密な並びの中は24px。 -->
    <x:Double x:Key="ControlHeight">28</x:Double>
    <x:Double x:Key="ControlHeightCompact">24</x:Double>
    <!-- 一覧の行の高さ。1行の項目は28px、2行（名前＋補足）の項目は44px。
         これ以外の高さ（26・36・53など）は作らない。2行の項目は「意味のある違い」なので別枠。 -->
    <x:Double x:Key="RowHeight">28</x:Double>
    <x:Double x:Key="RowHeightTwoLine">44</x:Double>
    <!-- ペイン見出し（エクスプローラ・履歴・検索・プロジェクト・接ぎ木パネル）の帯の高さ。
         以前は Margin の組み合わせで59/62/64pxに分かれていた。 -->
    <x:Double x:Key="PaneHeaderHeight">36</x:Double>
    <Thickness x:Key="PaneHeaderPadding">12,0,8,0</Thickness>

    <!-- 角丸。わずかな丸みにとどめる（小3px＝ボタン・入力欄・チェックボックス、中6px＝ダイアログ・ポップアップ）。 -->
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>

    <!-- ダイアログの内側の余白と、要素どうしの標準の間隔（SpacingMd=12 と同値の別名ではなく、
         「ダイアログ本体は16、その中の段落間は12」と役割で分けて持つ）。 -->
    <Thickness x:Key="DialogPadding">16</Thickness>
    <x:Double x:Key="DialogSpacing">12</x:Double>

    <!--
        セクション見出し（設定の各節・ダイアログの小見出し・空の状態の題など）の文字スタイル。
        ペイン見出し（12px）は補助的な帯の題、ここは本文より一段目立たせる題。
        アクセント色は「選択・主ボタン・フォーカス」に限り、見出しには使わない（TextPrimary）。
        TextBlock には Classes="section-heading" で一括適用できる（Controls.Buttons.axaml 末尾のスタイル）。
    -->
    <x:Double x:Key="SectionHeadingFontSize">14</x:Double>
    <FontWeight x:Key="SectionHeadingFontWeight">SemiBold</FontWeight>

    <!-- ========== diff左端バー ========== -->
    <x:Double x:Key="DiffBarWidth">3</x:Double>

    <!-- ========== 9.5 アイコン共通寸法 ========== -->
    <x:Double x:Key="IconViewboxSize">24</x:Double>
    <x:Double x:Key="IconStrokeThickness">1.5</x:Double>
    <!-- 一覧・ツールバーでの既定表示サイズ。個々の利用箇所で上書き可。 -->
    <x:Double x:Key="IconDisplaySize">16</x:Double>

    <!-- ========== フォーカスリング（9.1: 常時可視、アクセント色2px枠） ========== -->
    <!-- 色はAccentトークン（Dark.axaml / Light.axaml）を使う。太さのみここで持つ。
         FocusRingThickness は数値そのもの、FocusRingBorderThickness は
         Border.BorderThickness（Thickness型）へそのまま割り当てるための同じ値の
         Thickness版。DynamicResourceは値の型変換を行わないため、Double型のリソースを
         Thickness型のプロパティへ直接割り当てると実行時エラーになる。 -->
    <x:Double x:Key="FocusRingThickness">2</x:Double>
    <Thickness x:Key="FocusRingBorderThickness">2</Thickness>

    <!-- ========== モーション ========== -->
    <!-- 継続時間120ms、イージングはease-outのみ。対象はペイン開閉・ポップオーバー・
         テーマ切り替えのクロスフェードに限定する（ThemeManager.axaml.cs および将来の
         各Viewから参照する）。 -->
    <x:TimeSpan x:Key="MotionDuration">0:0:0.12</x:TimeSpan>
    <QuadraticEaseOut x:Key="MotionEaseOut" />

</ResourceDictionary>
