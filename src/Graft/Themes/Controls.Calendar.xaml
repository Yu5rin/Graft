<!--
  DatePicker関連の暗黙スタイル（暗黙スタイル）。

  Calendar/CalendarItemはWPF標準コントロールの中でも最もテンプレート契約が複雑な
  部類のため、このファイルに分離した（Controls.xaml / Controls.Input.xaml に含めると
  400行を大きく超える）。

  【重要】このファイルは Themes/App.xaml の ResourceDictionary.MergedDictionaries に
  まだ追加されていない。統合担当が App.xaml へ以下を追記する必要がある。
      <ResourceDictionary Source="Themes/Controls.Calendar.xaml" />

  【要検証】CalendarItem / Calendar のテンプレートは、フレームワークが要求する
  名前付きパーツ（PART_TextBox, PART_Button, PART_Popup, PART_Root, PART_CalendarItem,
  PART_HeaderButton, PART_PreviousButton, PART_NextButton, PART_MonthView,
  PART_YearView）の契約に従って実装したが、本リポジトリの開発環境はLinuxであり
  WPFランタイムでの実機確認ができていない。Windows実機での動作確認を推奨する。

  対象: DatePicker, DatePickerTextBox, Calendar, CalendarItem, CalendarDayButton
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== DatePickerTextBox ========== -->
    <!-- DatePickerTextBoxはTextBoxを継承するため、既定のTextBoxテンプレート契約
         （PART_ContentHostとしてのScrollViewer）に従う。 -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <!-- 標準のDatePickerTextBoxにはプレースホルダ表示機能（Watermark）が
                         存在しないため、TextBox同様のPART_ContentHostのみを持つ最小構成とする。 -->
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="8,6" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== DatePicker（履歴の日付範囲指定） ========== -->
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                            BorderThickness="0" Background="Transparent" />
                        <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                Width="28" Background="Transparent"
                                AutomationProperties.Name="カレンダーを開く">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Data="M4,2 L4,4 M12,2 L12,4 M2,6 L14,6
                                                    M3,4 L13,4 C13.6,4 14,4.4 14,5
                                                    L14,13 C14,13.6 13.6,14 13,14
                                                    L3,14 C2.4,14 2,13.6 2,13
                                                    L2,5 C2,4.4 2.4,4 3,4 Z"
                                              Stroke="{DynamicResource TextSecondary}"
                                              StrokeThickness="1.3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom"
                               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" />
                        <Border x:Name="FocusRing" Grid.ColumnSpan="2"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="{DynamicResource FocusRingBorderThickness}"
                                IsHitTestVisible="False" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Calendar ========== -->
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Grid x:Name="PART_Root">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <CalendarItem x:Name="PART_CalendarItem" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== CalendarItem ========== -->
    <Style TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ヘッダー：前月/翌月ボタンと年月表示 -->
                        <Grid Grid.Row="0" Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PART_PreviousButton" Grid.Column="0" Focusable="False"
                                    Width="24" Height="24" AutomationProperties.Name="前へ">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <Path Data="M9,3 L4,8 L9,13" Stroke="{DynamicResource TextSecondary}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="PART_HeaderButton" Grid.Column="1" Focusable="False"
                                    Foreground="{DynamicResource TextPrimary}"
                                    FontFamily="{DynamicResource UiFontFamily}"
                                    FontSize="{DynamicResource BodyFontSize}"
                                    HorizontalContentAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="PART_NextButton" Grid.Column="2" Focusable="False"
                                    Width="24" Height="24" AutomationProperties.Name="次へ">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <Path Data="M6,3 L11,8 L6,13" Stroke="{DynamicResource TextSecondary}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- 月表示（日付グリッド）。7列×7行（1行目は曜日ヘッダ）。
                             セルはCalendarクラスが実行時にCalendarDayButtonを追加する。 -->
                        <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" /><RowDefinition Height="*" />
                                <RowDefinition Height="*" /><RowDefinition Height="*" />
                                <RowDefinition Height="*" /><RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                        </Grid>

                        <!-- 年/年代表示（月または年の選択）。4列×3行。
                             セルはCalendarクラスが実行時にボタンを追加する。 -->
                        <Grid x:Name="PART_YearView" Grid.Row="1" Margin="6" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" /><RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== CalendarDayButton ========== -->
    <Style TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="{DynamicResource FocusRingBorderThickness}"
                                Margin="1" IsHitTestVisible="False" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgHover}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelected}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter TargetName="Bg" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
