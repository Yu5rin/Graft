<!--
    アプリ全体で共有する値コンバータ。

    各Viewが自分の Resources に同名のコンバータを個別定義していると、
    ルート要素の属性（例: UserControl自身の Visibility）から StaticResource で
    参照したときに解決できず、読み込み時に例外になる。ルート要素の属性は
    自身の Resources より先に評価されるためである。
    App.xaml でこの辞書を Application.Resources へマージしておくことで、
    ルート要素の属性からでも確実に解決できる。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Graft.Views">

    <!-- true を Visible、false を Collapsed へ。 -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- 同上。既存コードが別名で参照しているため両方の名前を用意する。 -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- true を Collapsed、false を Visible へ。 -->
    <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

    <!-- 同上の別名。 -->
    <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!-- 真偽値の反転。 -->
    <views:InverseBooleanConverter x:Key="InverseBool" />

    <!-- null を Collapsed、非null を Visible へ。 -->
    <views:NullToVisibilityConverter x:Key="NullToVis" />

    <!-- 空文字を Collapsed、非空を Visible へ。 -->
    <views:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />

    <!-- GraftIssue を「E101 SEARCH部が見つからない: 詳細」の表示文へ。 -->
    <views:IssueToDisplayTextConverter x:Key="IssueToText" />

</ResourceDictionary>
