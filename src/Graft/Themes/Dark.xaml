<!--
  ダークテーマの色トークン（8.3 / 8.6）。

  Light.xaml と全く同じキー名を持つこと。ThemeManager が
  MergedDictionaries 内のこのファイルを Light.xaml と差し替えることで
  テーマを切り替える（アプリ再起動は不要）。

  各トークンは "XxxColor"（Color）と "Xxx"（SolidColorBrush）の対で定義する。
  XAML側からは通常 Brush キー（例: BgBase）を DynamicResource で参照する。
  Color キーはアニメーションや自前描画（GDI的な計算）が必要な箇所のために残す。

  8.6 のシンタックス配色は、Syntax.xaml をテーマ非依存の共通キー置き場
  （SyntaxCommentStyle 等）として残すため、実体（実際の色）はこのファイルと
  Light.xaml に置く。Syntax.xaml 冒頭のコメントに同じ説明がある。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 8.3 背景（面の明度差3階層） ========== -->
    <Color x:Key="BgBaseColor">#151619</Color>
    <SolidColorBrush x:Key="BgBase" Color="{StaticResource BgBaseColor}" />

    <Color x:Key="BgSurfaceColor">#1C1E22</Color>
    <SolidColorBrush x:Key="BgSurface" Color="{StaticResource BgSurfaceColor}" />

    <Color x:Key="BgElevatedColor">#24272C</Color>
    <SolidColorBrush x:Key="BgElevated" Color="{StaticResource BgElevatedColor}" />

    <Color x:Key="BgHoverColor">#2B2F35</Color>
    <SolidColorBrush x:Key="BgHover" Color="{StaticResource BgHoverColor}" />

    <Color x:Key="BgSelectedColor">#2E3A4D</Color>
    <SolidColorBrush x:Key="BgSelected" Color="{StaticResource BgSelectedColor}" />

    <!-- ========== 8.3 文字 ========== -->
    <Color x:Key="TextPrimaryColor">#E6E8EB</Color>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />

    <Color x:Key="TextSecondaryColor">#9BA1A9</Color>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />

    <Color x:Key="TextDisabledColor">#5A6069</Color>
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}" />

    <!-- ========== 8.3 アクセント（1色のみ） ========== -->
    <Color x:Key="AccentColor">#4C8DFF</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />

    <!-- ========== 8.3 境界線（必要最小限） ========== -->
    <Color x:Key="BorderSubtleColor">#2A2E34</Color>
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" />

    <!-- ========== 8.3 diff ========== -->
    <Color x:Key="DiffAddBgColor">#14301F</Color>
    <SolidColorBrush x:Key="DiffAddBg" Color="{StaticResource DiffAddBgColor}" />

    <Color x:Key="DiffAddBarColor">#3FB27F</Color>
    <SolidColorBrush x:Key="DiffAddBar" Color="{StaticResource DiffAddBarColor}" />

    <Color x:Key="DiffDelBgColor">#351A1D</Color>
    <SolidColorBrush x:Key="DiffDelBg" Color="{StaticResource DiffDelBgColor}" />

    <Color x:Key="DiffDelBarColor">#E5646E</Color>
    <SolidColorBrush x:Key="DiffDelBar" Color="{StaticResource DiffDelBarColor}" />

    <!-- ========== 8.3 状態 ========== -->
    <Color x:Key="StateWarnColor">#E0A94A</Color>
    <SolidColorBrush x:Key="StateWarn" Color="{StaticResource StateWarnColor}" />

    <Color x:Key="StateErrorColor">#E5646E</Color>
    <SolidColorBrush x:Key="StateError" Color="{StaticResource StateErrorColor}" />

    <!-- 8.5のサンプルXAMLがStateOkを参照するため、diff.add.barと同値で定義する。 -->
    <Color x:Key="StateOkColor">#3FB27F</Color>
    <SolidColorBrush x:Key="StateOk" Color="{StaticResource StateOkColor}" />

    <!-- ========== 8.6 シンタックスハイライト配色（ダーク） ========== -->
    <Color x:Key="SyntaxKeywordColor">#A98BD1</Color>
    <SolidColorBrush x:Key="SyntaxKeyword" Color="{StaticResource SyntaxKeywordColor}" />

    <Color x:Key="SyntaxStringColor">#A3C293</Color>
    <SolidColorBrush x:Key="SyntaxString" Color="{StaticResource SyntaxStringColor}" />

    <Color x:Key="SyntaxNumberColor">#D8A76A</Color>
    <SolidColorBrush x:Key="SyntaxNumber" Color="{StaticResource SyntaxNumberColor}" />

    <Color x:Key="SyntaxCommentColor">#6B727C</Color>
    <SolidColorBrush x:Key="SyntaxComment" Color="{StaticResource SyntaxCommentColor}" />

    <Color x:Key="SyntaxFunctionColor">#7FB6E8</Color>
    <SolidColorBrush x:Key="SyntaxFunction" Color="{StaticResource SyntaxFunctionColor}" />

    <Color x:Key="SyntaxTypeColor">#E0C285</Color>
    <SolidColorBrush x:Key="SyntaxType" Color="{StaticResource SyntaxTypeColor}" />

    <Color x:Key="SyntaxOperatorColor">#9BA1A9</Color>
    <SolidColorBrush x:Key="SyntaxOperator" Color="{StaticResource SyntaxOperatorColor}" />

    <!-- plainはtext.primaryと同値（8.6の表のとおり）。 -->
    <SolidColorBrush x:Key="SyntaxPlain" Color="{StaticResource TextPrimaryColor}" />

    <!-- ========== 9.3 Gitガター・エディタ（v2.0追加） ========== -->
    <Color x:Key="GutterAddColor">#3FB27F</Color>
    <SolidColorBrush x:Key="GutterAdd" Color="{StaticResource GutterAddColor}" />

    <Color x:Key="GutterModColor">#4C8DFF</Color>
    <SolidColorBrush x:Key="GutterMod" Color="{StaticResource GutterModColor}" />

    <Color x:Key="GutterDelColor">#E5646E</Color>
    <SolidColorBrush x:Key="GutterDel" Color="{StaticResource GutterDelColor}" />

    <Color x:Key="EditorCurrentLineColor">#1C1E22</Color>
    <SolidColorBrush x:Key="EditorCurrentLine" Color="{StaticResource EditorCurrentLineColor}" />

    <Color x:Key="EditorSelectionColor">#2E3A4D</Color>
    <SolidColorBrush x:Key="EditorSelection" Color="{StaticResource EditorSelectionColor}" />

</ResourceDictionary>
